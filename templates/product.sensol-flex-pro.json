    "sp_reviews": {
      "type": "sensol-reviews",
      "blocks": {
        "review_1": {
          "type": "review",
          "settings": {
            "text": "I've been teaching reformer Pilates for 12 years and I've never experienced anything like the FLEX PRO. The 145° arm range allows me to perform and teach movements that are simply impossible on a traditional reformer — the snake, the twist, diagonal pull-throughs at extreme angles. The Off-centre training mode has become my secret weapon for clients with stability issues. This is the future of reformer training.",
            "name": "Victoria S.",
            "role": "Pilates Instructor, Byron Bay"
          }
        },
        "review_2": {
          "type": "review",
          "settings": {
            "text": "As a former rugby player, I need both strength and mobility. Traditional reformers maxed out at around 70 kg, which wasn't enough for my strength goals. The FLEX PRO's 150 kg max load is the real deal — heavy rows, chest presses, and overhead work that actually challenges my strength. Then I switch to Pilates mode for mobility and core work. It's like having a reformer, a cable machine, and a physical therapy tool all in one.",
            "name": "Jackson M.",
            "role": "Brisbane"
          }
        },
        "review_3": {
          "type": "review",
          "settings": {
            "text": "My physio recommended reformer Pilates for my chronic lower back pain, but at $120 per private session, it wasn't sustainable. The FLEX PRO's Constant Mode has been transformative — the even tension means I never get that scary 'catch' that springs can create. After 10 weeks of daily 30-minute sessions, my back pain has reduced by about 40%, I'm sleeping through the night, and I can play with my grandchildren without wincing.",
            "name": "Diane W.",
            "role": "Regional NSW"
          }
        }
      },
      "block_order": [
        "review_1",
