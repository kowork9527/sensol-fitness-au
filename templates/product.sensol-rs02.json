    "sp_qa": {
      "type": "sensol-product-qa",
      "blocks": {
        "qa_1": {
          "type": "qa",
          "settings": {
            "question": "What makes the RS02 different from a traditional Pilates reformer?",
            "answer": "The RS02 replaces metal springs with a digital weight system powered by servo motors. This means you can adjust resistance in precise 0.5 kg increments instantly, without physically changing springs. It also features a dual-function design — it is both a Pilates reformer and a strength training machine, switchable via the Sensol Control Dial™. No traditional reformer offers digital weight or dual-functionality."
          }
        },
        "qa_2": {
          "type": "qa",
          "settings": {
            "question": "How does the RS02 compare to the Your Reformer ($2,795)?",
            "answer": "The Your Reformer is a high-quality spring reformer with an app, but it uses traditional spring resistance (fixed increments, manual changes) and is Pilates-only. The RS02 is $795 cheaper, offers digital weight with 0.5 kg precision, dual-function (reformer + strength), AI coaching, three training modes, and a more compact footprint. The RS02 provides significantly more versatility and technology for less money."
          }
        },
        "qa_3": {
          "type": "qa",
          "settings": {
            "question": "Is the RS02 suitable for beginners?",
            "answer": "Absolutely. The 0.5 kg precision means you can start with very low resistance and progress gradually. The Vesta Sensol App includes beginner-friendly classes with clear instruction. The instant unload button on the remote provides a safety net — if a movement feels wrong, one press drops all resistance immediately. The app's AI coach adapts to your level and suggests appropriate progressions."
          }
        },
        "qa_4": {
          "type": "qa",
          "settings": {
            "question": "How much space do I need for the RS02?",
            "answer": "When in use, the RS02 measures 175.5 × 100 cm. When stored upright, it occupies just 0.2 square metres — roughly the size of a small chair. You need approximately 1 metre of clearance on each side during use. Unlike traditional reformers, the RS02 can be stored vertically against a wall, making it suitable for apartments and smaller homes."
          }
        },
        "qa_5": {
          "type": "qa",
          "settings": {
            "question": "Do I need a subscription to use the app?",
            "answer": "No. The Vesta Sensol App is included free with your RS02 purchase. You get full access to 300+ guided classes, AI-driven coaching, workout tracking, and all app features with no monthly fees. This is a significant advantage over competitors like NordicTrack ($60/month) and Frame Fitness ($39.99/month), which require paid memberships."
          }
        },
        "qa_6": {
          "type": "qa",
          "settings": {
            "question": "What is the warranty and return policy?",
            "answer": "The RS02 comes with a Lifetime Warranty covering manufacturing defects. We also offer a 30-Day Money-Back Guarantee — if you are not satisfied within 30 days of delivery, return it for a full refund. Free domestic shipping is included for all Australian orders."
          }
        },
        "qa_7": {
          "type": "qa",
          "settings": {
            "question": "Can I use the RS02 for rehabilitation after an injury?",
            "answer": "Yes. The RS02 is excellent for rehabilitation. The Constant training mode maintains even tension throughout the range of motion, ideal for controlled rehab exercises. The 0.5 kg precision allows for gradual progression, and the instant unload button provides a safety mechanism. 78% of Australian physiotherapists recommend Pilates reformers for injury recovery. Always consult your physiotherapist before beginning any rehabilitation programme."
          }
        },
        "qa_8": {
          "type": "qa",
          "settings": {
            "question": "How noisy is the RS02 during operation?",
            "answer": "The RS02 features a noiseless motor design. Unlike spring reformers that produce squeaking and clanging sounds, the RS02 operates at near-silent levels. You can comfortably use it in an apartment at any hour without disturbing housemates or neighbours."
          }
        },
        "qa_9": {
          "type": "qa",
          "settings": {
            "question": "What power supply does the RS02 need?",
            "answer": "The RS02 accepts 100–230V input, making it fully compatible with Australian power standards (230V, 50Hz). It ships with an Australian-compatible power cord. No adapters or transformers are required."
          }
        },
        "qa_10": {
          "type": "qa",
          "settings": {
            "question": "How long does delivery take within Australia?",
            "answer": "Orders are dispatched within 2–3 business days. Standard delivery takes 5–10 business days depending on your location. Shipping is free to all Australian addresses. You will receive tracking information once your order has been dispatched. The RS02 ships in a single package weighing approximately 63 kg."
          }
        }
      },
