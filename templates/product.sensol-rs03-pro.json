    "sp_reviews": {
      "type": "sensol-reviews",
      "blocks": {
        "review_1": {
          "type": "review",
          "settings": {
            "text": "I have been teaching Pilates for 15 years and have used every major reformer brand. The RS03 PRO is the first machine that made me question whether I need springs at all. The enhanced cables provide a smoothness and responsiveness that I have only felt on high-end studio equipment. The digital resistance is a revelation — I can set exactly 22.5 kg for a client and know it will not vary by a single gram.",
            "name": "Elena M.",
            "role": "Certified Pilates Instructor, Melbourne VIC"
          }
        },
        "review_2": {
          "type": "review",
          "settings": {
            "text": "I was paying $280/month for an unlimited membership at a premium reformer studio. I bought the RS03 PRO and cancelled my membership. The enhanced cables genuinely feel like studio equipment — smoother and more consistent than springs. The 300+ classes in the app are excellent. The break-even is about 10 months. Best fitness decision I have ever made.",
            "name": "Rachel D.",
            "role": "Sydney NSW"
          }
        },
        "review_3": {
          "type": "review",
          "settings": {
            "text": "I integrated the RS03 PRO into my physiotherapy practice six months ago. The 1 kg precision is important for post-surgical rehabilitation. Constant Mode provides the uniform resistance that is safest for rebuilding strength. The enhanced cables accommodate the gentle, controlled movements my patients need. At $2,800, it cost less than two months of equipment leasing for my previous reformer.",
            "name": "Dr. Lisa C.",
            "role": "Physiotherapist, Brisbane QLD"
          }
        }
      },
