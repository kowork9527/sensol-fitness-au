      "settings": {
        "color_scheme": "light",
        "image_position": "right",
        "eyebrow": "Product Overview",
        "title": "Double the Power. Twice the Possibility.",
        "text_1": "The Sensol RS03 represents a generational leap in home fitness technology. Where the RS02 pioneered the concept of a digital weight reformer, the RS03 doubles the motor output from 750W to 1500W per arm, delivering the kind of instantaneous, precise resistance that was previously only possible in commercial studio settings.",
        "text_2": "With 120 kg of total resistance adjustable in 0.5 kg increments, every movement is measured, controlled, and repeatable."
      }
    },
    "sp_feature_1": {
      "type": "sensol-product-feature",
      "blocks": {
        "stat_1": { "type": "stat", "settings": { "number": "0.5 kg", "label": "Increment Step" } },
        "stat_2": { "type": "stat", "settings": { "number": "120 kg", "label": "Max Resistance" } }
      },
      "block_order": ["stat_1", "stat_2"],
      "settings": {
        "color_scheme": "dark",
        "image_position": "left",
        "eyebrow": "01 — Digital Weight",
        "title": "0.5 kg precision. No springs. No guesswork.",
        "text_1": "Every rep is powered by Sensol's patent-pending digital weight system. Resistance is generated electronically, measured to within 0.5 kg, and adjusted instantly via the Sensol Control Dial or the Vesta Sensol App.",
        "text_2": "No manual spring changes, no stopping mid-set to swap hardware. Just dial it up or down and keep moving."
      }
    },
    "sp_feature_2": {
      "type": "sensol-product-feature",
      "blocks": {
        "stat_1": { "type": "stat", "settings": { "number": "145\u00b0", "label": "Arm Range (8 positions)" } },
        "stat_2": { "type": "stat", "settings": { "number": "3", "label": "Training Modes" } }
      },
      "block_order": ["stat_1", "stat_2"],
      "settings": {
        "color_scheme": "light",
        "image_position": "right",
        "eyebrow": "02 — Expanded Range & Modes",
        "title": "145\u00b0 of movement. Three ways to train.",
        "text_1": "The RS03 features an expanded arm adjustment range of 0\u2013145\u00b0 across eight positions \u2014 a significant upgrade over the RS02's 0\u2013132\u00b0. This wider arc unlocks new exercise angles, deeper rotational movements, and lateral training patterns.",
        "text_2": "Combined with three distinct training modes \u2014 Standard (progressive resistance), Off-centre (stabiliser focus), and Constant (uniform tension) \u2014 the RS03 adapts to your body, your goals, and your training philosophy."
      }
    },
    "sp_feature_3": {
      "type": "sensol-product-feature",
      "blocks": {
        "stat_1": { "type": "stat", "settings": { "number": "200+", "label": "Total Movements" } },
        "stat_2": { "type": "stat", "settings": { "number": "4", "label": "Included Accessories" } }
      },
      "block_order": ["stat_1", "stat_2"],
      "settings": {
        "color_scheme": "dark",
        "image_position": "left",
        "eyebrow": "03 — Dual Function",
        "title": "Pilates reformer. Strength station. One machine.",
        "text_1": "The RS03 is not just a reformer, and it is not just a strength bench. It is both. Switch between Pilates reformer mode and modular strength training mode using the Sensol Control Dial.",
        "text_2": "The same machine that takes you through a flowing footwork series can become a pressing, pulling, and squatting station \u2014 200+ movements in total, covering every major muscle group. All accessories included."
      }
    },
    "sp_feature_4": {
