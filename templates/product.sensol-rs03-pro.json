    "sp_qa": {
      "type": "sensol-product-qa",
      "blocks": {
        "qa_1": { "type": "qa", "settings": { "question": "How long does shipping take?", "answer": "We ship within 2\u20133 business days from our Sydney warehouse. Standard delivery takes 5\u20137 business days to metro areas across Australia and 7\u201310 days to NZ. Free shipping to all Australian addresses, metro and regional." } },
        "qa_2": { "type": "qa", "settings": { "question": "Do you offer Afterpay or payment plans?", "answer": "Yes. We support Afterpay (4 interest-free payments of $600), PayPal Pay in 4, Shop Pay Installments, and all major credit cards. All financing options are visible at checkout." } },
        "qa_3": { "type": "qa", "settings": { "question": "What's the warranty coverage?", "answer": "Lifetime Warranty covering all manufacturing defects for the life of the product \u2014 including the frame, motors, electronics, and all included accessories." } },
        "qa_4": { "type": "qa", "settings": { "question": "Is the Vesta Sensol App really free?", "answer": "Yes, genuinely free. No monthly fees, no locked content, no trial period. All 300+ guided classes, AI-driven coaching, progress tracking, and future updates are included with your RS03 purchase." } },
        "qa_5": { "type": "qa", "settings": { "question": "Is the RS03 suitable for beginners?", "answer": "Absolutely. The digital weight system lets you start as low as 0.5 kg and adjust in 0.5 kg increments \u2014 far more granular than spring reformers. The Vesta app includes beginner programmes and Standard mode provides familiar progressive resistance." } },
        "qa_6": { "type": "qa", "settings": { "question": "How noisy is it? Can I use it in an apartment?", "answer": "The RS03 operates at under 45 dB \u2014 quieter than a normal conversation. The motorised system eliminates the clanking and spring noise typical of traditional reformers. Designed specifically for apartment living." } },
        "qa_7": { "type": "qa", "settings": { "question": "Can I use it for both Pilates and strength training?", "answer": "Yes \u2014 that's the core design principle. Switch between Pilates reformer mode and strength training mode using the Sensol Control Dial. 200+ movements covering every major muscle group. All accessories included." } },
        "qa_8": { "type": "qa", "settings": { "question": "What happens if I don't like it?", "answer": "30-Day Money-Back Guarantee. Return the RS03 within 30 days for a full refund. Local Australian support via support@sensolfitness.com.au, based in Sydney." } }
