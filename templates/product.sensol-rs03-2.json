        "qa_4": {
          "type": "qa",
          "settings": {
            "question": "Is the Sensol app free?",
            "answer": "Yes. The Sensol app is free for the life of your RS03 - no subscription, no upsell, no data lock-in. It includes 300+ on-demand classes (Pilates, strength, mobility), live metric tracking (force, range, time under tension), and AI form coaching via your phone camera. Available on iOS 15+ and Android 12+."
          }
        },
