    "qa": {
      "type": "sensol-product-qa",
      "blocks": {
        "qa_1": {
          "type": "qa",
          "settings": {
            "question": "How long does shipping take?",
            "answer": "We ship within 2–3 business days from our Sydney warehouse. Standard delivery takes 5–7 business days to metro areas across Australia and 7–10 days to NZ. Free shipping to all Australian addresses, metro and regional."
          }
        },
        "qa_2": {
          "type": "qa",
          "settings": {
            "question": "Do you offer Afterpay or payment plans?",
            "answer": "Yes. We support Afterpay, Shop Pay, and PayPal Pay-in-4. All four-payment plans are interest-free, with no fees when you pay on time."
          }
        },
        "qa_3": {
          "type": "qa",
          "settings": {
            "question": "What's the warranty coverage?",
            "answer": "Lifetime on the frame, 5 years on the motors, and 2 years on electronics and accessories. Warranty is fully transferable if you sell or gift the unit."
          }
        },
        "qa_4": {
          "type": "qa",
          "settings": {
            "question": "Is the Vesta Sensol App really free?",
            "answer": "Yes. Every RS03 includes lifetime access to the Vesta Sensol App — 300+ classes, live tracking, and AI form coaching. No subscription, ever."
          }
        },
        "qa_5": {
          "type": "qa",
          "settings": {
            "question": "Is the RS03 suitable for beginners?",
            "answer": "Yes. Three training modes — Standard, Off-centre, and Constant — adapt to your level. Start with 1 kg increments and progress at your own pace."
          }
        },
        "qa_6": {
          "type": "qa",
          "settings": {
            "question": "How noisy is it? Can I use it in an apartment?",
            "answer": "The RS03 operates under 45 dB at full load — quieter than a normal conversation. Safe for apartment use at any hour."
          }
        },
        "qa_7": {
          "type": "qa",
          "settings": {
            "question": "Can I use it for both Pilates and strength training?",
            "answer": "Yes. Switch between Pilates reformer mode and modular strength training mode using the Sensol Control Dial. 200+ movements cover every major muscle group."
          }
        },
        "qa_8": {
          "type": "qa",
          "settings": {
            "question": "What happens if I don't like it?",
            "answer": "30-day money-back guarantee. Free return shipping within Australia. No restocking fees, no questions asked."
          }
        }
      },
