<div class="air-explorers">
{% render 'sensol-air-worlds', section: section %}
<section class="air-delivery" data-air-delivery aria-labelledby="air-delivery-title-{{ section.id }}">
<header class="air-delivery-heading"><div><p>03 / SPECIFICATIONS & INCLUDED KIT</p><h2 id="air-delivery-title-{{ section.id }}">Meet your FLEX AIR.<br>Know what arrives.</h2></div><p>Your reformer.<br>Its parts, accessories and essentials.</p></header>
<figure class="air-package"><img src="{{ 'sensol-air-package-v4-fit.webp' | asset_url }}" width="2079" height="756" alt="Horizontal FLEX AIR partly revealed through the side of its closed SENSOL carton, scaled to fit the opening" loading="lazy"><figcaption>Packaging visualisation. Actual packing arrangement may differ.</figcaption></figure>
<dl class="air-spec-highlights"><div><dt>Overall size · L × W × H</dt><dd>1645 × 616 × 439 <small>mm</small></dd></div><div><dt>Net weight</dt><dd>25 <small>kg</small></dd></div><div><dt>Maximum load</dt><dd>120 <small>kg</small></dd></div><div><dt>Platform travel · up to</dt><dd>840 <small>mm</small></dd></div></dl>
<details class="air-spec-details"><summary>View materials & full specifications <span aria-hidden="true">＋</span></summary><dl><div><dt>Rail</dt><dd>Aluminium</dd></div><div><dt>Platform</dt><dd>410 × 300 mm · leather-covered foam</dd></div><div><dt>Armrests</dt><dd>PU</dd></div><div><dt>Resistance mechanism</dt><dd>4 steel-wire springs · 2 × 15 lb and 2 × 30 lb · non-electric</dd></div><div><dt>Gross weight</dt><dd>30 kg</dd></div><div><dt>Packaging size</dt><dd>1720 × 625 × 190 mm</dd></div></dl></details>
<div class="air-kit-heading"><div><p>INCLUDED WITH YOUR REFORMER</p><h3>Open your kit.</h3></div><p>Tap an accessory to see its purpose and construction.</p></div>
<div class="air-kit-grid">
<button type="button" data-kit="side" aria-haspopup="dialog" aria-label="Explore SIDE HANDLES"><span class="air-kit-photo"><img src="{{ 'sensol-air-kit-side-pair-v1.webp' | asset_url }}" alt="Two SIDE HANDLES isolated from the supplied FLEX AIR detail photograph" width="1254" height="1254" loading="lazy"></span><span class="air-kit-name">SIDE HANDLES <b>×2 included</b></span><span class="air-kit-open" aria-hidden="true">＋</span></button>
<button type="button" data-kit="handle" aria-haspopup="dialog" aria-label="Explore HAND STRAPS"><span class="air-kit-photo"><img src="{{ 'sensol-air-kit-handle-hd-v2.webp' | asset_url }}" alt="Included textured hand grip with strap and attachment ring" width="2000" height="2000" loading="lazy"></span><span class="air-kit-name">HAND STRAPS <b>×2 included</b></span><span class="air-kit-open" aria-hidden="true">＋</span></button>
<button type="button" data-kit="ankle" aria-haspopup="dialog" aria-label="Explore ANKLE STRAP"><span class="air-kit-photo"><img src="{{ 'sensol-air-kit-ankle-hd-v2.webp' | asset_url }}" alt="Included ankle strap with padded contact surface and metal attachment ring" width="2000" height="2000" loading="lazy"></span><span class="air-kit-name">ANKLE STRAP <b>×1 included</b></span><span class="air-kit-open" aria-hidden="true">＋</span></button>
<button type="button" data-kit="bands" aria-haspopup="dialog" aria-label="Explore 15LB RESISTANCE BANDS"><span class="air-kit-photo air-kit-bands"><img src="{{ 'sensol-air-kit-bands-hd-v2.webp' | asset_url }}" alt="Four included sleeved elastic bands with clips" width="2000" height="2000" loading="lazy"></span><span class="air-kit-name">15LB RESISTANCE BANDS <b>×4 included</b></span><span class="air-kit-open" aria-hidden="true">＋</span></button>
<button type="button" data-kit="springs" aria-haspopup="dialog" aria-label="Explore SPRINGS"><span class="air-kit-photo"><img src="{{ 'sensol-air-kit-springs-hd-v1.webp' | asset_url }}" alt="Four steel springs: two labelled 15LB and two labelled 30LB" width="1472" height="878" loading="lazy"></span><span class="air-kit-name">SPRINGS <b>×4 included · 15LB ×2 / 30LB ×2</b></span><span class="air-kit-open" aria-hidden="true">＋</span></button>
<button type="button" data-kit="manual" aria-haspopup="dialog" aria-label="Explore PRODUCT MANUAL"><span class="air-kit-photo"><img src="{{ 'sensol-air-kit-manual-v1.webp' | asset_url }}" alt="Original black and white FLEX AIR product manual cover" width="3173" height="4491" loading="lazy"></span><span class="air-kit-name">PRODUCT MANUAL <b>×1 included</b></span><span class="air-kit-open" aria-hidden="true">＋</span></button>
</div>
<details class="air-spec-details air-packing-contents"><summary>Complete packing list <span aria-hidden="true">＋</span></summary><p class="air-kit-footnote">SIDE HANDLES ×2; SPRINGS ×4 (15LB ×2, 30LB ×2); 15LB RESISTANCE BANDS ×4 (60cm ×2, 80cm ×2); ANKLE STRAP ×1; HAND STRAPS ×2; TOOL KIT ×1 (Warranty Card ×1, Hex Wrench ×1, Screws ×6); PRODUCT MANUAL ×1.</p></details>
<dialog class="air-kit-dialog" aria-labelledby="air-kit-title-{{ section.id }}" data-kit-dialog>
<button type="button" class="air-kit-close" data-kit-close aria-label="Close accessory detail" autofocus>×</button>
<div class="air-kit-dialog-layout"><div class="air-kit-dialog-photo"><img data-kit-image src="{{ 'sensol-air-kit-handle-hd-v2.webp' | asset_url }}" alt="Included hand grip"></div><div class="air-kit-dialog-copy"><p class="air-kit-kicker" data-kit-quantity></p><h3 id="air-kit-title-{{ section.id }}" data-kit-title></h3><h4>What it is for</h4><p data-kit-purpose></p><h4>Materials & construction</h4><p data-kit-construction></p><p class="air-kit-dimensions" data-kit-dimensions hidden></p></div></div>
</dialog>
</section>
</div>
{{ 'sensol-air-explorer.css' | asset_url | stylesheet_tag }}
<script src="{{ 'sensol-air-explorer.js' | asset_url }}" defer></script>
