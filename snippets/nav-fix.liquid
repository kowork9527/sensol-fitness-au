<!-- nav-fix snippet -->
<style>
.shopify-section-group-header-group { position: relative !important; z-index: 1000 !important; }
.sensol-hero-section { position: relative !important; z-index: 1 !important; }
.sensol-header__nav a, .sensol-header__link, .sensol-header__shop-btn { pointer-events: auto !important; position: relative; z-index: 1002; }
</style>
<script>
(function(){function f(){var h=document.querySelector('.sensol-header-section-wrapper'),e=document.querySelector('.sensol-hero-section');if(h){h.style.cssText+=';position:relative!important;z-index:1000!important;';}if(e&&e.tagName==='SECTION'){e.style.cssText+=';position:relative!important;z-index:1!important;';}}if(document.readyState==='loading'){document.addEventListener('DOMContentLoaded',f);}else{f();}setTimeout(f,500);setTimeout(f,1500);})();
</script>
