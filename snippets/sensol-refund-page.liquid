{%- comment -%}Sensol Refund & Return Policy page — branded design{%- endcomment -%}

<style>
  /* Hide default page content */
  .main-page-title, .rte, .section-main-page-padding,
  .page-width--narrow.section-template--main-padding { display: none !important; }

  /* ── Hero ── */
  .sc-refund-hero {
    background: #1A1816;
    font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
    min-height: 70vh;
    display: flex; align-items: flex-end;
    overflow: hidden; position: relative;
  }
  .sc-refund-hero::before {
    content: ''; position: absolute; inset: 0;
    background: radial-gradient(ellipse at 70% 30%, rgba(181,173,164,0.06) 0%, transparent 60%),
                linear-gradient(180deg, rgba(26,24,22,0.4) 0%, rgba(26,24,22,0.9) 100%);
  }
  .sc-refund-hero__inner { position: relative; z-index: 1; width: 100%; max-width: 1400px; margin: 0 auto; padding: 0 3rem 6rem; }
  .sc-refund-hero__kicker { font-size: 11px; font-weight: 500; letter-spacing: 0.3em; text-transform: uppercase; color: #B5ADA4; margin-bottom: 1.5rem; }
  .sc-refund-hero__title { font-size: clamp(40px, 7vw, 80px); font-weight: 200; letter-spacing: 0.06em; line-height: 1.05; color: #F7F4F0; margin-bottom: 1.5rem; }
  .sc-refund-hero__sub { font-size: 15px; font-weight: 300; line-height: 1.7; color: rgba(247,244,240,0.55); max-width: 480px; margin-bottom: 3rem; }
  .sc-refund-hero__stats { display: flex; align-items: center; gap: 2.5rem; }
  .sc-refund-hero__stat-num { font-size: 28px; font-weight: 200; letter-spacing: 0.02em; color: #F7F4F0; display: block; line-height: 1; margin-bottom: 0.5rem; }
  .sc-refund-hero__stat-label { font-size: 10px; font-weight: 500; letter-spacing: 0.2em; text-transform: uppercase; color: #8A8279; }
  .sc-refund-hero__stat-divider { width: 1px; height: 36px; background: rgba(212,206,198,0.2); }

  /* ── Common section ── */
  .sc-refund-sec { background: #F7F4F0; font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif; color: #1A1816; }
  .sc-refund-sec__inner { max-width: 1200px; margin: 0 auto; padding: 6rem 3rem 0; }
  .sc-refund-sec__header { display: flex; align-items: center; gap: 1.5rem; margin-bottom: 2rem; }
  .sc-refund-sec__num { font-size: 11px; font-weight: 500; letter-spacing: 0.25em; color: #B5ADA4; }
  .sc-refund-sec__line { flex: 1; height: 1px; background: #D4CEC6; }
  .sc-refund-sec__title { font-size: clamp(28px, 4vw, 44px); font-weight: 200; letter-spacing: 0.06em; line-height: 1.2; margin-bottom: 2rem; }
  .sc-refund-sec__lead { font-size: 15px; font-weight: 300; line-height: 1.8; color: #4A4640; max-width: 700px; margin-bottom: 4rem; }
  .sc-refund-sec__bottom { padding-bottom: 6rem; }

  /* ── Guarantee cards ── */
  .sc-refund-guarantees { display: grid; grid-template-columns: 1fr 1fr; gap: 0; border-top: 1px solid #D4CEC6; }
  .sc-refund-guarantee { padding: 2.5rem 2rem 3rem; border-right: 1px solid #D4CEC6; }
  .sc-refund-guarantee:last-child { border-right: none; }
  .sc-refund-guarantee__tag { font-size: 11px; font-weight: 500; letter-spacing: 0.2em; color: #B5ADA4; display: block; margin-bottom: 1.25rem; }
  .sc-refund-guarantee__name { font-size: 17px; font-weight: 400; letter-spacing: 0.02em; color: #1A1816; margin-bottom: 0.75rem; }
  .sc-refund-guarantee__text { font-size: 13px; font-weight: 300; line-height: 1.7; color: #8A8279; }

  /* ── Conditions list ── */
  .sc-refund-conditions { display: grid; grid-template-columns: 1fr 1fr; gap: 0; border-top: 1px solid #D4CEC6; }
  .sc-refund-condition { padding: 2.5rem 2rem 3rem; border-right: 1px solid #D4CEC6; border-bottom: 1px solid #D4CEC6; }
  .sc-refund-condition:nth-child(2n) { border-right: none; }
  .sc-refund-condition__tag { font-size: 11px; font-weight: 500; letter-spacing: 0.2em; color: #B5ADA4; display: block; margin-bottom: 1.25rem; }
  .sc-refund-condition__name { font-size: 17px; font-weight: 400; letter-spacing: 0.02em; color: #1A1816; margin-bottom: 0.75rem; }
  .sc-refund-condition__text { font-size: 13px; font-weight: 300; line-height: 1.7; color: #8A8279; }

  /* ── Warning box ── */
  .sc-refund-warning {
    background: #1A1816;
    padding: 3rem;
    margin-top: 3rem;
    border-radius: 4px;
  }
  .sc-refund-warning__label { font-size: 10px; font-weight: 500; letter-spacing: 0.25em; text-transform: uppercase; color: #B5ADA4; margin-bottom: 1.5rem; display: flex; align-items: center; gap: 0.5rem; }
  .sc-refund-warning__label::before { content: '\26A0'; font-size: 14px; }
  .sc-refund-warning__items { display: grid; grid-template-columns: 1fr 1fr; gap: 0; }
  .sc-refund-warning__item { padding: 1.5rem 2rem 1.5rem 0; border-bottom: 1px solid rgba(212,206,198,0.12); }
  .sc-refund-warning__item:nth-child(2n) { padding-left: 2rem; padding-right: 0; border-right: none; }
  .sc-refund-warning__item-tag { font-size: 10px; font-weight: 500; letter-spacing: 0.2em; text-transform: uppercase; color: #B5ADA4; display: block; margin-bottom: 0.5rem; }
  .sc-refund-warning__item-text { font-size: 13px; font-weight: 300; line-height: 1.7; color: rgba(247,244,240,0.7); }
  .sc-refund-warning__item-text strong { color: #F7F4F0; font-weight: 400; }

  /* ── Steps ── */
  .sc-refund-steps { display: grid; grid-template-columns: repeat(4, 1fr); gap: 0; border-top: 1px solid #D4CEC6; }
  .sc-refund-step { padding: 2.5rem 1.5rem 3rem; border-right: 1px solid #D4CEC6; }
  .sc-refund-step:last-child { border-right: none; }
  .sc-refund-step__num { font-size: 11px; font-weight: 500; letter-spacing: 0.25em; color: #B5ADA4; display: block; margin-bottom: 1.5rem; }
  .sc-refund-step__title { font-size: 15px; font-weight: 400; color: #1A1816; margin-bottom: 0.75rem; }
  .sc-refund-step__text { font-size: 13px; font-weight: 300; line-height: 1.7; color: #8A8279; }

  /* ── Timeline ── */
  .sc-refund-timeline { display: grid; grid-template-columns: 1fr 1fr; gap: 5rem; align-items: start; }
  .sc-refund-timeline__item { display: flex; gap: 1.5rem; padding: 1.75rem 0; border-bottom: 1px solid #D4CEC6; }
  .sc-refund-timeline__item:first-child { padding-top: 0; }
  .sc-refund-timeline__item:last-child { border-bottom: none; }
  .sc-refund-timeline__item-tag { font-size: 10px; font-weight: 500; letter-spacing: 0.2em; text-transform: uppercase; color: #B5ADA4; flex-shrink: 0; min-width: 80px; padding-top: 3px; }
  .sc-refund-timeline__item-title { font-size: 15px; font-weight: 400; color: #1A1816; margin-bottom: 0.5rem; }
  .sc-refund-timeline__item-text { font-size: 13px; font-weight: 300; line-height: 1.7; color: #8A8279; }
  .sc-refund-timeline__proc { background: #1A1816; padding: 2.5rem 2rem; }
  .sc-refund-timeline__proc-label { font-size: 10px; font-weight: 500; letter-spacing: 0.25em; text-transform: uppercase; color: #B5ADA4; margin-bottom: 1.5rem; }
  .sc-refund-timeline__proc-item { display: flex; gap: 1rem; padding: 1rem 0; border-bottom: 1px solid rgba(212,206,198,0.12); }
  .sc-refund-timeline__proc-item:last-child { border-bottom: none; }
  .sc-refund-timeline__proc-num { font-size: 11px; font-weight: 500; letter-spacing: 0.15em; color: #B5ADA4; flex-shrink: 0; padding-top: 2px; }
  .sc-refund-timeline__proc-item p { font-size: 13px; font-weight: 300; line-height: 1.7; color: rgba(247,244,240,0.7); }
  .sc-refund-timeline__proc-item strong { color: #F7F4F0; font-weight: 400; }

  /* ── Damaged items (dark section) ── */
  .sc-refund-damaged { background: #1A1816; font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif; color: #F7F4F0; padding: 6rem 0; margin-top: 6rem; }
  .sc-refund-damaged__inner { max-width: 1200px; margin: 0 auto; padding: 0 3rem; }
  .sc-refund-damaged__grid { display: grid; grid-template-columns: 1fr 1fr; gap: 5rem; }
  .sc-refund-damaged__col-label { font-size: 10px; font-weight: 500; letter-spacing: 0.25em; text-transform: uppercase; color: #B5ADA4; display: block; margin-bottom: 1rem; }
  .sc-refund-damaged__col-label--mt { margin-top: 3rem; }
  .sc-refund-damaged__col-title { font-size: 24px; font-weight: 200; letter-spacing: 0.04em; color: #F7F4F0; margin-bottom: 1.5rem; }
  .sc-refund-damaged__col-text { font-size: 14px; font-weight: 300; line-height: 1.8; color: rgba(247,244,240,0.65); margin-bottom: 1.5rem; }
  .sc-refund-damaged__col-text strong { color: #F7F4F0; font-weight: 400; }

  /* ── CTA bar ── */
  .sc-refund-cta {
    background: #F7F4F0;
    font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
    padding: 5rem 3rem;
    text-align: center;
  }
  .sc-refund-cta__inner { max-width: 800px; margin: 0 auto; }
  .sc-refund-cta__label { font-size: 10px; font-weight: 500; letter-spacing: 0.3em; text-transform: uppercase; color: #B5ADA4; margin-bottom: 1.5rem; }
  .sc-refund-cta__title { font-size: clamp(24px, 3vw, 36px); font-weight: 200; letter-spacing: 0.04em; color: #1A1816; margin-bottom: 1.5rem; }
  .sc-refund-cta__text { font-size: 14px; font-weight: 300; line-height: 1.8; color: #8A8279; margin-bottom: 2.5rem; }
  .sc-refund-cta__contact { display: flex; justify-content: center; gap: 3rem; }
  .sc-refund-cta__contact-item { text-align: center; }
  .sc-refund-cta__contact-label { font-size: 10px; font-weight: 500; letter-spacing: 0.2em; text-transform: uppercase; color: #B5ADA4; display: block; margin-bottom: 0.5rem; }
  .sc-refund-cta__contact-value { font-size: 16px; font-weight: 400; color: #1A1816; }

  /* ── Footer note ── */
  .sc-refund-foot {
    background: #F7F4F0;
    font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
    padding: 0 3rem 4rem;
  }
  .sc-refund-foot__inner { max-width: 1200px; margin: 0 auto; }
  .sc-refund-foot__text { font-size: 12px; font-weight: 300; line-height: 1.8; color: #8A8279; padding-top: 2rem; border-top: 1px solid #D4CEC6; }

  /* ── Responsive ── */
  @media (max-width: 749px) {
    .sc-refund-hero__inner { padding: 0 1.5rem 4rem; }
    .sc-refund-hero__stats { flex-wrap: wrap; gap: 1.5rem; }
    .sc-refund-sec__inner { padding: 4rem 1.5rem 0; }
    .sc-refund-sec__bottom { padding-bottom: 4rem; }
    .sc-refund-guarantees { grid-template-columns: 1fr; }
    .sc-refund-guarantee { border-right: none; border-bottom: 1px solid #D4CEC6; }
    .sc-refund-guarantee:last-child { border-bottom: none; }
    .sc-refund-conditions { grid-template-columns: 1fr; }
    .sc-refund-condition { border-right: none; }
    .sc-refund-warning { padding: 2rem 1.5rem; }
    .sc-refund-warning__items { grid-template-columns: 1fr; }
    .sc-refund-warning__item:nth-child(2n) { padding-left: 0; }
    .sc-refund-steps { grid-template-columns: 1fr 1fr; }
    .sc-refund-step:nth-child(2n) { border-right: none; }
    .sc-refund-timeline { grid-template-columns: 1fr; gap: 2rem; }
    .sc-refund-damaged__grid { grid-template-columns: 1fr; gap: 2rem; }
    .sc-refund-cta { padding: 4rem 1.5rem; }
    .sc-refund-cta__contact { flex-direction: column; gap: 1.5rem; }
    .sc-refund-foot { padding: 0 1.5rem 3rem; }
  }
</style>

<!-- ═══════ HERO ═══════ -->
<section class="sc-refund-hero">
  <div class="sc-refund-hero__inner">
    <div class="sc-refund-hero__content">
      <p class="sc-refund-hero__kicker">Refund &amp; Returns</p>
      <h1 class="sc-refund-hero__title">Refund<br>Policy</h1>
      <p class="sc-refund-hero__sub">Our Refund &amp; Return Policy complies fully with the Australian Consumer Law. Due to the heavy and oversized nature of our fitness equipment, distinct conditions apply to returns.</p>
      <div class="sc-refund-hero__stats">
        <div class="sc-refund-hero__stat">
          <span class="sc-refund-hero__stat-num">30</span>
          <span class="sc-refund-hero__stat-label">Day Change of Mind</span>
        </div>
        <div class="sc-refund-hero__stat-divider"></div>
        <div class="sc-refund-hero__stat">
          <span class="sc-refund-hero__stat-num">24h</span>
          <span class="sc-refund-hero__stat-label">Report Damage</span>
        </div>
        <div class="sc-refund-hero__stat-divider"></div>
        <div class="sc-refund-hero__stat">
          <span class="sc-refund-hero__stat-num">ACL</span>
          <span class="sc-refund-hero__stat-label">Compliant</span>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- ═══════ 01 — ACL GUARANTEES ═══════ -->
<section class="sc-refund-sec">
  <div class="sc-refund-sec__inner sc-refund-sec__bottom">
    <div class="sc-refund-sec__header">
      <span class="sc-refund-sec__num">01</span>
      <div class="sc-refund-sec__line"></div>
    </div>
    <h2 class="sc-refund-sec__title">Australian Consumer<br>Law Guarantees</h2>
    <p class="sc-refund-sec__lead">Our goods come with guarantees that cannot be excluded under the Australian Consumer Law. You are entitled to a replacement or refund for a major failure and compensation for any other reasonably foreseeable loss or damage.</p>
    <div class="sc-refund-guarantees">
      <div class="sc-refund-guarantee">
        <span class="sc-refund-guarantee__tag">A</span>
        <h3 class="sc-refund-guarantee__name">Major Failure</h3>
        <p class="sc-refund-guarantee__text">A major failure occurs when the product has a serious defect, is unsafe, or is substantially unfit for its intended purpose and cannot be easily fixed within a reasonable time. In this case, you can choose between a refund or a replacement.</p>
      </div>
      <div class="sc-refund-guarantee">
        <span class="sc-refund-guarantee__tag">B</span>
        <h3 class="sc-refund-guarantee__name">Minor Failure</h3>
        <p class="sc-refund-guarantee__text">If the defect or failure is minor, we reserve the right to offer a free repair within a reasonable timeframe, or provide a replacement or refund at our discretion.</p>
      </div>
    </div>
  </div>
</section>

<!-- ═══════ 02 — CHANGE OF MIND ═══════ -->
<section class="sc-refund-sec" style="background: #EDEAE5;">
  <div class="sc-refund-sec__inner sc-refund-sec__bottom">
    <div class="sc-refund-sec__header">
      <span class="sc-refund-sec__num">02</span>
      <div class="sc-refund-sec__line"></div>
    </div>
    <h2 class="sc-refund-sec__title">Change of Mind<br>Returns</h2>
    <p class="sc-refund-sec__lead">We understand that your fitness needs may change. We offer a 30-day Change of Mind Return Policy, subject to the following strict conditions:</p>
    <div class="sc-refund-conditions">
      <div class="sc-refund-condition">
        <span class="sc-refund-condition__tag">Timeframe</span>
        <h3 class="sc-refund-condition__name">30 Days from Delivery</h3>
        <p class="sc-refund-condition__text">You must notify our customer support team at +61 480 899 797 or via our official email within 30 days from the date your order was delivered.</p>
      </div>
      <div class="sc-refund-condition">
        <span class="sc-refund-condition__tag">Product Condition</span>
        <h3 class="sc-refund-condition__name">Unused &amp; Unassembled</h3>
        <p class="sc-refund-condition__text">The item must be unused, unassembled, free from any cosmetic or structural damage, and in the exact same condition that you received it.</p>
      </div>
      <div class="sc-refund-condition">
        <span class="sc-refund-condition__tag">Original Packaging</span>
        <h3 class="sc-refund-condition__name">Unopened Commercial Packaging</h3>
        <p class="sc-refund-condition__text">The item must be in its original, unopened commercial packaging (including all pallets, straps, protective foam, and internal boxing). Items cannot be safely transported without their structured original packaging.</p>
      </div>
      <div class="sc-refund-condition">
        <span class="sc-refund-condition__tag">Exclusions</span>
        <h3 class="sc-refund-condition__name">Non-Refundable Fees</h3>
        <p class="sc-refund-condition__text">Delivery fees paid at the time of purchase (such as Remote Surcharge Area fees) are non-refundable.</p>
      </div>
    </div>

    <div class="sc-refund-warning">
      <div class="sc-refund-warning__label">Important: Change of Mind Freight &amp; Restocking Costs</div>
      <div class="sc-refund-warning__items">
        <div class="sc-refund-warning__item">
          <span class="sc-refund-warning__item-tag">Return Freight</span>
          <p class="sc-refund-warning__item-text">The buyer is entirely responsible for arranging and paying for the return shipping to our designated warehouse in Australia (e.g., Victoria/New South Wales partners).</p>
        </div>
        <div class="sc-refund-warning__item">
          <span class="sc-refund-warning__item-tag">Specialist Pickup</span>
          <p class="sc-refund-warning__item-text">Standard courier networks will not accept items over 30kg. You must use our authorized heavy freight carriers. If a tail-lift or two-man delivery team is required, surcharges ranging from <strong>$65 to $200+ AUD</strong> will be deducted from your refund.</p>
        </div>
        <div class="sc-refund-warning__item">
          <span class="sc-refund-warning__item-tag">Restocking Fee</span>
          <p class="sc-refund-warning__item-text">A restocking fee of <strong>15%</strong> of the original purchase price will be deducted from your refund to cover warehouse receiving, heavy-pallet handling, safety inspections, and repackaging evaluation.</p>
        </div>
        <div class="sc-refund-warning__item">
          <span class="sc-refund-warning__item-tag">Non-Refundable</span>
          <p class="sc-refund-warning__item-text">Original delivery fees and remote surcharges paid at checkout are <strong>non-refundable</strong> under Change of Mind returns.</p>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- ═══════ 03 — DAMAGED / FAULTY (DARK) ═══════ -->
<section class="sc-refund-damaged">
  <div class="sc-refund-damaged__inner">
    <div class="sc-refund-sec__header" style="margin-bottom: 2rem;">
      <span class="sc-refund-sec__num" style="color: #B5ADA4;">03</span>
      <div class="sc-refund-sec__line" style="background: rgba(212,206,198,0.2);"></div>
    </div>
    <h2 class="sc-refund-sec__title" style="color: #F7F4F0; margin-bottom: 3rem;">Damaged, Faulty, or<br>Incorrect Items</h2>
    <div class="sc-refund-damaged__grid">
      <div>
        <span class="sc-refund-damaged__col-label">Report Immediately</span>
        <h3 class="sc-refund-damaged__col-title">Within 24 Hours</h3>
        <p class="sc-refund-damaged__col-text">Stop using the item immediately. Contact us within <strong>24 hours</strong> of delivery with clear photographs and video evidence detailing the issue, along with your original order invoice.</p>
      </div>
      <div>
        <span class="sc-refund-damaged__col-label">Return Shipping for Faulty Goods</span>
        <h3 class="sc-refund-damaged__col-title">We Cover the Cost</h3>
        <p class="sc-refund-damaged__col-text">If the item is confirmed to have a structural or manufacturing defect under the ACL, <strong>we will cover the return freight costs</strong>. We will coordinate with our heavy-freight courier partners to arrange a scheduled pickup at our expense. You will be required to assist in ensuring the product is securely positioned at the ground floor or curbside access point for the freight driver.</p>
      </div>
    </div>
  </div>
</section>

<!-- ═══════ 04 — HOW TO INITIATE A RETURN ═══════ -->
<section class="sc-refund-sec">
  <div class="sc-refund-sec__inner sc-refund-sec__bottom">
    <div class="sc-refund-sec__header">
      <span class="sc-refund-sec__num">04</span>
      <div class="sc-refund-sec__line"></div>
    </div>
    <h2 class="sc-refund-sec__title">How to Initiate<br>a Return</h2>
    <p class="sc-refund-sec__lead">To start a return process, please follow these steps:</p>
    <div class="sc-refund-steps">
      <div class="sc-refund-step">
        <span class="sc-refund-step__num">Step 01</span>
        <h3 class="sc-refund-step__title">Contact Support</h3>
        <p class="sc-refund-step__text">Call +61 480 899 797 or email our support desk with your Shopify Order Number (e.g., #AU1001).</p>
      </div>
      <div class="sc-refund-step">
        <span class="sc-refund-step__num">Step 02</span>
        <h3 class="sc-refund-step__title">Provide Evidence</h3>
        <p class="sc-refund-step__text">Provide your reasons for return along with photographic proof of the unopened, boxed product state.</p>
      </div>
      <div class="sc-refund-step">
        <span class="sc-refund-step__num">Step 03</span>
        <h3 class="sc-refund-step__title">Receive RMA</h3>
        <p class="sc-refund-step__text">Once approved, we will issue a Return Merchandise Authorization (RMA) document and provide the designated warehouse address.</p>
      </div>
      <div class="sc-refund-step">
        <span class="sc-refund-step__num">Step 04</span>
        <h3 class="sc-refund-step__title">Ship with RMA</h3>
        <p class="sc-refund-step__text">Do not send products back to our warehouse without an authorized RMA. Ship only after approval.</p>
      </div>
    </div>
  </div>
</section>

<!-- ═══════ 05 — REFUND PROCESSING TIME ═══════ -->
<section class="sc-refund-sec" style="background: #EDEAE5;">
  <div class="sc-refund-sec__inner sc-refund-sec__bottom">
    <div class="sc-refund-sec__header">
      <span class="sc-refund-sec__num">05</span>
      <div class="sc-refund-sec__line"></div>
    </div>
    <h2 class="sc-refund-sec__title">Refund Processing<br>Time</h2>
    <p class="sc-refund-sec__lead">Once your returned item is received at our Australian fulfillment center, the refund process begins immediately.</p>
    <div class="sc-refund-timeline">
      <div>
        <div class="sc-refund-timeline__item">
          <span class="sc-refund-timeline__item-tag">Step 1</span>
          <div>
            <h3 class="sc-refund-timeline__item-title">Safety &amp; Quality Inspection</h3>
