  }
  .sc-sz-dark__num {
    font-size: 11px; font-weight: 500; letter-spacing: 0.25em;
    color: #B5ADA4; text-transform: uppercase;
  }
  .sc-sz-dark__line { flex: 1; height: 1px; background: rgba(212,206,198,0.2); }
  .sc-sz-dark__kicker {
    font-size: 11px; font-weight: 500; letter-spacing: 0.2em;
    text-transform: uppercase; color: #8A8279;
    margin-bottom: 1rem;
  }
  .sc-sz-dark__title {
    font-size: clamp(28px, 4vw, 48px); font-weight: 200;
