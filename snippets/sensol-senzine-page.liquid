  }
  .sc-sz-cta__btn:hover { opacity: 0.85; }
  .sc-sz-cta__btn--outline {
    background: transparent; color: #1A1816;
    border: 1px solid #1A1816;
  }
  .sc-sz-cta__btn--outline:hover { background: #1A1816; color: #F7F4F0; opacity: 1; }

  /* ═══ FOOTER ═══ */
  .sc-sz-foot {
    background: #1A1816; padding: 2.5rem 3rem;
  }
  .sc-sz-foot__inner {
    max-width: 1200px; margin: 0 auto;
    display: flex; justify-content: space-between; align-items: center;
    gap: 2rem;
  }
  .sc-sz-foot__text {
    font-size: 12px; font-weight: 300; line-height: 1.7;
    color: rgba(247,244,240,0.5);
  }
  .sc-sz-foot__brand {
    font-size: 13px; font-weight: 400; letter-spacing: 0.1em;
    color: #F7F4F0;
  }

  /* ═══ RESPONSIVE ═══ */
  @media (max-width: 900px) {
    .sc-sz-article { grid-template-columns: 1fr; gap: 2rem; }
    .sc-sz-article__side { border-left: none; border-top: 1px solid #D4CEC6; padding-left: 0; padding-top: 2rem; }
    .sc-sz-callouts { grid-template-columns: 1fr; }
    .sc-sz-matrix__row { grid-template-columns: 1fr 1fr; gap: 0.75rem; }
    .sc-sz-matrix__desc { grid-column: 1 / -1; }
  }
  @media (max-width: 749px) {
    .sc-sz-hero__inner { padding: 7rem 1.5rem 4rem; }
