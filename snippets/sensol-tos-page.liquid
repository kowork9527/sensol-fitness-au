  .sc-tos-card { padding: 2.5rem 2rem 3rem; border-right: 1px solid #D4CEC6; border-bottom: 1px solid #D4CEC6; }
  .sc-tos-card:nth-child(2n) { border-right: none; }
  .sc-tos-card__tag { font-size: 11px; font-weight: 500; letter-spacing: 0.2em; color: #B5ADA4; display: block; margin-bottom: 1.25rem; }
  .sc-tos-card__name { font-size: 17px; font-weight: 400; letter-spacing: 0.02em; color: #1A1816; margin-bottom: 0.75rem; }
  .sc-tos-card__text { font-size: 13px; font-weight: 300; line-height: 1.7; color: #8A8279; }

