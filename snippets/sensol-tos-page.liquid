  .sc-tos-hero__inner { position: relative; z-index: 1; width: 100%; max-width: 1400px; margin: 0 auto; padding: 0 3rem 6rem; }
  .sc-tos-hero__kicker { font-size: 11px; font-weight: 500; letter-spacing: 0.3em; text-transform: uppercase; color: #B5ADA4; margin-bottom: 1.5rem; }
  .sc-tos-hero__title { font-size: clamp(40px, 7vw, 80px); font-weight: 200; letter-spacing: 0.06em; line-height: 1.05; color: #F7F4F0; margin-bottom: 1.5rem; }
  .sc-tos-hero__sub { font-size: 15px; font-weight: 300; line-height: 1.7; color: rgba(247,244,240,0.55); max-width: 480px; margin-bottom: 3rem; }
  .sc-tos-hero__stats { display: flex; align-items: center; gap: 2.5rem; }
  .sc-tos-hero__stat-num { font-size: 28px; font-weight: 200; letter-spacing: 0.02em; color: #F7F4F0; display: block; line-height: 1; margin-bottom: 0.5rem; }
  .sc-tos-hero__stat-label { font-size: 10px; font-weight: 500; letter-spacing: 0.2em; text-transform: uppercase; color: #8A8279; }
  .sc-tos-hero__stat-divider { width: 1px; height: 36px; background: rgba(212,206,198,0.2); }

  /* ── Common section ── */
  .sc-tos-sec { background: #F7F4F0; font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif; color: #1A1816; }
  .sc-tos-sec--alt { background: #EDEAE5; }
  .sc-tos-sec__inner { max-width: 1200px; margin: 0 auto; padding: 6rem 3rem 0; }
  .sc-tos-sec__bottom { padding-bottom: 6rem; }
  .sc-tos-sec__header { display: flex; align-items: center; gap: 1.5rem; margin-bottom: 2rem; }
  .sc-tos-sec__num { font-size: 11px; font-weight: 500; letter-spacing: 0.25em; color: #B5ADA4; }
  .sc-tos-sec__line { flex: 1; height: 1px; background: #D4CEC6; }
  .sc-tos-sec__title { font-size: clamp(28px, 4vw, 44px); font-weight: 200; letter-spacing: 0.06em; line-height: 1.2; margin-bottom: 2rem; }
  .sc-tos-sec__lead { font-size: 15px; font-weight: 300; line-height: 1.8; color: #4A4640; max-width: 700px; margin-bottom: 4rem; }

  /* ── Info cards ── */
