{%- comment -%}Sensol Engineering — Technical editorial page{%- endcomment -%}

<style>
  /* Hide default page content */
  .main-page-title, .rte, .section-main-page-padding,
  .page-width--narrow.section-template--main-padding { display: none !important; }

  /* ═══ ROOT ═══ */
  .sc-eng { font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif; color: #1A1816; }

  /* ═══ HERO ═══ */
  .sc-eng-hero {
    background: #1A1816;
    overflow: hidden; position: relative;
    min-height: 85vh; display: flex; align-items: flex-end;
  }
  .sc-eng-hero::before {
    content: ''; position: absolute; inset: 0;
    background: radial-gradient(ellipse at 50% 30%, rgba(181,173,164,0.06) 0%, transparent 55%),
                linear-gradient(180deg, rgba(26,24,22,0.5) 0%, rgba(26,24,22,0.95) 100%);
  }
  .sc-eng-hero__grid {
    position: absolute; inset: 0;
    background-image:
      linear-gradient(rgba(181,173,164,0.04) 1px, transparent 1px),
      linear-gradient(90deg, rgba(181,173,164,0.04) 1px, transparent 1px);
    background-size: 80px 80px;
    z-index: 0;
  }
  .sc-eng-hero__inner {
    position: relative; z-index: 1; width: 100%;
    max-width: 1200px; margin: 0 auto;
    padding: 9rem 3rem 5rem;
  }
  .sc-eng-hero__breadcrumb {
    display: flex; align-items: center; gap: 0.5rem;
    font-size: 11px; font-weight: 500; letter-spacing: 0.2em;
    text-transform: uppercase; color: #B5ADA4;
    margin-bottom: 2.5rem;
  }
  .sc-eng-hero__breadcrumb span { color: rgba(247,244,240,0.4); }
  .sc-eng-hero__breadcrumb-dot { width: 4px; height: 4px; border-radius: 50%; background: rgba(212,206,198,0.3); }
  .sc-eng-hero__label {
    font-size: 11px; font-weight: 500; letter-spacing: 0.3em;
    text-transform: uppercase; color: #8A8279;
    margin-bottom: 1.5rem;
  }
  .sc-eng-hero__title {
    font-size: clamp(44px, 8vw, 96px); font-weight: 200;
    letter-spacing: 0.02em; line-height: 1; color: #F7F4F0;
    margin-bottom: 1.5rem;
  }
  .sc-eng-hero__sub {
    font-size: clamp(16px, 1.6vw, 22px); font-weight: 300;
    line-height: 1.6; color: rgba(247,244,240,0.55);
    max-width: 620px; margin-bottom: 3rem;
  }
  .sc-eng-hero__specs {
    display: flex; align-items: stretch; gap: 0;
    border-top: 1px solid rgba(212,206,198,0.15);
    padding-top: 2rem;
  }
  .sc-eng-hero__spec {
    flex: 1; padding-right: 2rem;
  }
  .sc-eng-hero__spec:not(:last-child) {
