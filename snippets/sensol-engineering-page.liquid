    text-transform: uppercase; color: #8A8279;
  }

  /* ═══ SECTION COMMON ═══ */
  .sc-eng-sec { background: #F7F4F0; overflow: hidden; }
  .sc-eng-sec--alt { background: #EDEAE5; }
  .sc-eng-sec--dark { background: #1A1816; }
  .sc-eng-sec__inner {
    max-width: 1200px; margin: 0 auto;
    padding: 7rem 3rem;
  }
  .sc-eng-sec__header {
    display: flex; align-items: center; gap: 1.5rem;
    margin-bottom: 2rem;
  }
  .sc-eng-sec__num {
    font-size: 11px; font-weight: 500; letter-spacing: 0.25em;
