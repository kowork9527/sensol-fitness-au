  }
  .sc-eng-sec__line { flex: 1; height: 1px; background: #D4CEC6; }
  .sc-eng-sec--dark .sc-eng-sec__line { background: rgba(212,206,198,0.2); }
  .sc-eng-sec__title {
    font-size: clamp(28px, 4vw, 48px); font-weight: 200;
    letter-spacing: 0.03em; line-height: 1.12; color: #1A1816;
    margin-bottom: 1.5rem;
  }
  .sc-eng-sec--dark .sc-eng-sec__title { color: #F7F4F0; }
  .sc-eng-sec__lead {
    font-size: 16px; font-weight: 300; line-height: 1.85;
    color: #4A4640; max-width: 720px;
  }
  .sc-eng-sec--dark .sc-eng-sec__lead { color: rgba(247,244,240,0.55); }

  /* ═══ Feature list ═══ */
  .sc-eng-features {
    margin-top: 3rem;
    border-top: 1px solid #D4CEC6;
  }
  .sc-eng-sec--dark .sc-eng-features { border-color: rgba(212,206,198,0.15); }
  .sc-eng-feature {
    display: grid; grid-template-columns: 180px 1fr;
    gap: 2rem; padding: 2rem 0;
    border-bottom: 1px solid #D4CEC6;
  }
  .sc-eng-sec--dark .sc-eng-feature { border-color: rgba(212,206,198,0.12); }
  .sc-eng-feature__label {
    font-size: 13px; font-weight: 500; letter-spacing: 0.08em;
    color: #1A1816;
  }
  .sc-eng-sec--dark .sc-eng-feature__label { color: #F7F4F0; }
  .sc-eng-feature__body {
    font-size: 14px; font-weight: 300; line-height: 1.8;
    color: #8A8279;
  }
  .sc-eng-sec--dark .sc-eng-feature__body { color: rgba(247,244,240,0.55); }
  .sc-eng-feature__body strong {
    font-weight: 500; color: #1A1816;
  }
  .sc-eng-sec--dark .sc-eng-feature__body strong { color: #F7F4F0; }

  /* ═══ Mode cards (dark) ═══ */
  .sc-eng-modes {
    display: grid; grid-template-columns: 1fr 1fr 1fr;
    gap: 1px; background: rgba(212,206,198,0.15);
    border: 1px solid rgba(212,206,198,0.15);
    border-radius: 12px; overflow: hidden;
    margin-top: 3rem;
  }
  .sc-eng-mode {
    background: #1A1816; padding: 2.5rem 2rem;
