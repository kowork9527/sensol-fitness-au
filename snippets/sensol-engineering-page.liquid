  }

  /* ═══ Split layout ═══ */
  .sc-eng-split {
    display: grid; grid-template-columns: 1fr 1fr;
    gap: 4rem; align-items: start;
    margin-top: 3rem;
  }
  .sc-eng-split__col-title {
    font-size: 14px; font-weight: 500; letter-spacing: 0.1em;
    text-transform: uppercase; color: #B5ADA4;
    margin-bottom: 1.5rem;
  }
  .sc-eng-split__list { list-style: none; padding: 0; margin: 0; }
  .sc-eng-split__item {
    display: flex; align-items: baseline; gap: 0.75rem;
    padding: 0.75rem 0;
    border-bottom: 1px solid rgba(212,206,198,0.12);
    font-size: 14px; font-weight: 300; line-height: 1.6;
    color: rgba(247,244,240,0.6);
  }
  .sc-eng-split__item::before {
    content: ''; flex-shrink: 0;
    width: 5px; height: 5px; border-radius: 50%;
    background: #B5ADA4;
  }

  /* ═══ Blueprint spec table ═══ */
  .sc-eng-blueprint {
    margin-top: 3rem;
    border: 1px solid #D4CEC6; border-radius: 12px;
    overflow: hidden;
  }
  .sc-eng-sec--dark .sc-eng-blueprint { border-color: rgba(212,206,198,0.15); }
  .sc-eng-bp-row {
    display: grid; grid-template-columns: 200px 1fr 1fr;
    gap: 0; padding: 1.25rem 1.75rem;
    border-bottom: 1px solid #D4CEC6;
    align-items: center;
  }
  .sc-eng-sec--dark .sc-eng-bp-row { border-color: rgba(212,206,198,0.12); }
  .sc-eng-bp-row:last-child { border-bottom: none; }
  .sc-eng-bp-row--head {
    background: #EDEAE5;
  }
  .sc-eng-sec--dark .sc-eng-bp-row--head { background: rgba(212,206,198,0.08); }
  .sc-eng-bp-label {
    font-size: 11px; font-weight: 500; letter-spacing: 0.15em;
    text-transform: uppercase; color: #8A8279;
  }
  .sc-eng-bp-value {
    font-size: 14px; font-weight: 400; color: #1A1816;
  }
  .sc-eng-sec--dark .sc-eng-bp-value { color: #F7F4F0; }
  .sc-eng-bp-row--head .sc-eng-bp-value {
    font-size: 11px; font-weight: 500; letter-spacing: 0.15em;
    text-transform: uppercase; color: #8A8279;
  }

  /* ═══ Material cards ═══ */
  .sc-eng-materials {
    display: grid; grid-template-columns: 1fr 1fr 1fr;
    gap: 1.5rem; margin-top: 3rem;
  }
  .sc-eng-material {
    border: 1px solid #D4CEC6; border-radius: 12px;
    padding: 2rem; background: #F7F4F0;
  }
  .sc-eng-material__icon {
    width: 36px; height: 36px; border-radius: 8px;
    background: #EDEAE5; margin-bottom: 1.5rem;
    display: flex; align-items: center; justify-content: center;
    font-size: 16px; font-weight: 300; color: #8A8279;
  }
  .sc-eng-material__name {
    font-size: 15px; font-weight: 500; letter-spacing: 0.02em;
    color: #1A1816; margin-bottom: 0.75rem;
  }
  .sc-eng-material__text {
    font-size: 13px; font-weight: 300; line-height: 1.7;
    color: #8A8279;
  }

  /* ═══ App feature grid ═══ */
  .sc-eng-app-grid {
    display: grid; grid-template-columns: 1fr 1fr;
    gap: 0; border-top: 1px solid #D4CEC6;
    margin-top: 3rem;
  }
  .sc-eng-app-item {
    padding: 2rem 2rem 2rem 0;
    border-bottom: 1px solid #D4CEC6;
  }
  .sc-eng-app-item:nth-child(2n) { padding-left: 2rem; padding-right: 0; border-left: 1px solid #D4CEC6; }
  .sc-eng-app-item__name {
    font-size: 14px; font-weight: 500; letter-spacing: 0.02em;
    color: #1A1816; margin-bottom: 0.75rem;
  }
  .sc-eng-app-item__text {
    font-size: 13px; font-weight: 300; line-height: 1.75;
    color: #8A8279;
  }

  /* ═══ Safety cards ═══ */
  .sc-eng-safety {
    display: grid; grid-template-columns: 1fr 1fr;
    gap: 1px; background: rgba(212,206,198,0.15);
    border: 1px solid rgba(212,206,198,0.15);
    border-radius: 12px; overflow: hidden;
    margin-top: 3rem;
  }
  .sc-eng-safety-item {
    background: #1A1816; padding: 2.5rem 2rem;
  }
  .sc-eng-safety-item__num {
    font-size: 28px; font-weight: 200; letter-spacing: 0.02em;
    color: #F7F4F0; display: block; line-height: 1; margin-bottom: 1rem;
  }
  .sc-eng-safety-item__name {
    font-size: 10px; font-weight: 500; letter-spacing: 0.2em;
    text-transform: uppercase; color: #B5ADA4;
    margin-bottom: 0.75rem;
  }
  .sc-eng-safety-item__text {
    font-size: 13px; font-weight: 300; line-height: 1.7;
    color: rgba(247,244,240,0.5);
  }

  /* ═══ QA steps ═══ */
  .sc-eng-qa-steps {
    margin-top: 3rem;
    display: grid; grid-template-columns: 1fr 1fr;
    gap: 0;
  }
  .sc-eng-qa-step {
    padding: 2.5rem 2rem;
    border-right: 1px solid #D4CEC6;
    border-bottom: 1px solid #D4CEC6;
  }
  .sc-eng-qa-step:nth-child(2n) { border-right: none; }
  .sc-eng-qa-step:nth-last-child(-n+2) { border-bottom: none; }
  .sc-eng-qa-step__num {
    font-size: 11px; font-weight: 500; letter-spacing: 0.2em;
    color: #B5ADA4; display: block; margin-bottom: 1rem;
  }
  .sc-eng-qa-step__name {
    font-size: 16px; font-weight: 400; letter-spacing: 0.02em;
    color: #1A1816; margin-bottom: 0.75rem;
  }
  .sc-eng-qa-step__text {
    font-size: 13px; font-weight: 300; line-height: 1.7;
    color: #8A8279;
  }

  /* ═══ Closing stats ═══ */
  .sc-eng-closing-stats {
    display: flex; flex-wrap: wrap; justify-content: center;
    gap: 0; margin: 3rem 0;
  }
  .sc-eng-closing-stat {
    text-align: center; padding: 0 2rem;
    border-right: 1px solid rgba(212,206,198,0.2);
  }
  .sc-eng-closing-stat:last-child { border-right: none; }
  .sc-eng-closing-stat__num {
    font-size: clamp(24px, 3vw, 36px); font-weight: 200;
    letter-spacing: 0.02em; color: #F7F4F0;
    display: block; line-height: 1; margin-bottom: 0.5rem;
  }
  .sc-eng-closing-stat__label {
    font-size: 10px; font-weight: 500; letter-spacing: 0.18em;
    text-transform: uppercase; color: #B5ADA4;
  }

  /* ═══ CTA ═══ */
  .sc-eng-cta {
    background: #F7F4F0;
    border-top: 1px solid #D4CEC6;
    padding: 5rem 3rem;
    text-align: center;
  }
  .sc-eng-cta__inner { max-width: 700px; margin: 0 auto; }
  .sc-eng-cta__label {
    font-size: 10px; font-weight: 500; letter-spacing: 0.3em;
    text-transform: uppercase; color: #B5ADA4;
    margin-bottom: 1.5rem;
  }
  .sc-eng-cta__title {
    font-size: clamp(24px, 3vw, 40px); font-weight: 200;
    letter-spacing: 0.03em; color: #1A1816;
    margin-bottom: 1.5rem;
  }
  .sc-eng-cta__text {
    font-size: 15px; font-weight: 300; line-height: 1.8;
    color: #8A8279; margin-bottom: 2.5rem;
  }
  .sc-eng-cta__btn {
    display: inline-block; padding: 1rem 2.5rem;
    background: #1A1816; color: #F7F4F0;
    font-size: 14px; font-weight: 400; letter-spacing: 0.1em;
    text-decoration: none; border-radius: 100px;
    transition: opacity 0.2s ease;
  }
  .sc-eng-cta__btn:hover { opacity: 0.85; }

  /* ═══ FOOTER ═══ */
  .sc-eng-foot {
    background: #1A1816;
    padding: 2.5rem 3rem;
  }
  .sc-eng-foot__inner {
    max-width: 1200px; margin: 0 auto;
    display: flex; justify-content: space-between; align-items: center;
    gap: 2rem;
  }
  .sc-eng-foot__text {
    font-size: 12px; font-weight: 300; line-height: 1.7;
    color: rgba(247,244,240,0.5);
  }
  .sc-eng-foot__brand {
    font-size: 13px; font-weight: 400; letter-spacing: 0.1em;
    color: #F7F4F0;
  }

  /* ═══ RESPONSIVE ═══ */
  @media (max-width: 900px) {
    .sc-eng-modes { grid-template-columns: 1fr; }
    .sc-eng-materials { grid-template-columns: 1fr 1fr; }
    .sc-eng-app-grid { grid-template-columns: 1fr; }
    .sc-eng-app-item:nth-child(2n) { padding-left: 0; border-left: none; }
    .sc-eng-bp-row { grid-template-columns: 160px 1fr; }
    .sc-eng-bp-row .sc-eng-bp-value:last-child { display: none; }
  }
  @media (max-width: 749px) {
    .sc-eng-hero__inner { padding: 6rem 1.5rem 4rem; }
    .sc-eng-hero__specs { flex-direction: column; gap: 1.5rem; }
    .sc-eng-hero__spec { border-right: none !important; margin-right: 0 !important; padding-right: 0; padding-bottom: 1.5rem; border-bottom: 1px solid rgba(212,206,198,0.12); }
    .sc-eng-hero__spec:last-child { border-bottom: none; padding-bottom: 0; }
    .sc-eng-sec__inner { padding: 4rem 1.5rem; }
    .sc-eng-feature { grid-template-columns: 1fr; gap: 0.5rem; }
    .sc-eng-split { grid-template-columns: 1fr; gap: 2rem; }
    .sc-eng-materials { grid-template-columns: 1fr; }
    .sc-eng-safety { grid-template-columns: 1fr; }
    .sc-eng-qa-steps { grid-template-columns: 1fr; }
    .sc-eng-qa-step { border-right: none; }
    .sc-eng-qa-step:nth-last-child(2) { border-bottom: 1px solid #D4CEC6; }
    .sc-eng-closing-stats { flex-direction: column; gap: 1.5rem; }
    .sc-eng-closing-stat { border-right: none; border-bottom: 1px solid rgba(212,206,198,0.2); padding-bottom: 1.5rem; }
    .sc-eng-closing-stat:last-child { border-bottom: none; }
    .sc-eng-cta { padding: 4rem 1.5rem; }
    .sc-eng-foot { padding: 2rem 1.5rem; }
    .sc-eng-foot__inner { flex-direction: column; text-align: center; }
  }
</style>

<!-- ═══════ HERO ═══════ -->
<section class="sc-eng sc-eng-hero">
  <div class="sc-eng-hero__grid"></div>
  <div class="sc-eng-hero__inner">
    <div class="sc-eng-hero__breadcrumb">
      <span>Sensol Fitness</span>
      <span class="sc-eng-hero__breadcrumb-dot"></span>
      <span>Engineering</span>
    </div>
    <div class="sc-eng-hero__label">Technical Documentation</div>
    <h1 class="sc-eng-hero__title">Engineering.</h1>
    <p class="sc-eng-hero__sub">Not more features. More intention. Every specification exists for a reason. Nothing is decorative. Nothing is arbitrary.</p>
    <div class="sc-eng-hero__specs">
      <div class="sc-eng-hero__spec">
        <span class="sc-eng-hero__spec-num">500W</span>
        <span class="sc-eng-hero__spec-label">Servo Motor</span>
      </div>
      <div class="sc-eng-hero__spec">
        <span class="sc-eng-hero__spec-num">45 kg</span>
        <span class="sc-eng-hero__spec-label">Digital Resistance</span>
      </div>
      <div class="sc-eng-hero__spec">
        <span class="sc-eng-hero__spec-num">1 kg</span>
        <span class="sc-eng-hero__spec-label">Precision</span>
      </div>
      <div class="sc-eng-hero__spec">
        <span class="sc-eng-hero__spec-num">&lt;8 ms</span>
        <span class="sc-eng-hero__spec-label">Response Time</span>
      </div>
      <div class="sc-eng-hero__spec">
        <span class="sc-eng-hero__spec-num">&lt;25 dB</span>
        <span class="sc-eng-hero__spec-label">Operating Noise</span>
      </div>
    </div>
  </div>
</section>

<!-- ═══════ SECTION 2 — DIGITAL WEIGHT SYSTEM ═══════ -->
<section class="sc-eng sc-eng-sec">
  <div class="sc-eng-sec__inner">
    <div class="sc-eng-sec__header">
      <span class="sc-eng-sec__num">01</span>
      <span class="sc-eng-sec__line"></span>
    </div>
    <h2 class="sc-eng-sec__title">The Digital Weight System</h2>
    <p class="sc-eng-sec__lead">This is where Sensol began &mdash; and where it still lives. Traditional fitness equipment relies on weights, springs, or pneumatic cylinders. Each has trade-offs: weights are heavy and dangerous, springs lose tension, pneumatic systems drift. None of them give you real precision. Sensol's digital weight system replaces all of that with a motor-driven resistance engine controlled by intelligent algorithms.</p>

    <div class="sc-eng-features">
      <div class="sc-eng-feature">
        <div class="sc-eng-feature__label">Resistance</div>
        <div class="sc-eng-feature__body"><strong>Up to 45 kg of digital resistance</strong> &mdash; generated electronically by a 500W servo motor, not by stacking plates. The resistance is real. You feel it in your muscles, not in a simulation. Adjustable in <strong>1 kg increments</strong> with the touch of a button.</div>
      </div>
      <div class="sc-eng-feature">
        <div class="sc-eng-feature__label">Instant Load / Unload</div>
        <div class="sc-eng-feature__body">No racking, no pins, no walking away from a barbell you can't lift. Hit the remote, and the resistance drops to zero. Immediately. Safely. <strong>This alone changes the psychology of training.</strong> You can push to your actual limit, knowing the machine will catch you.</div>
      </div>
      <div class="sc-eng-feature">
        <div class="sc-eng-feature__label">Acoustic</div>
        <div class="sc-eng-feature__body">The motor operates at <strong>under 25 dB</strong> &mdash; quieter than a library. Train at midnight in an apartment. Your neighbours will never know.</div>
      </div>
    </div>

    <div class="sc-eng-modes">
      <div class="sc-eng-mode">
        <div class="sc-eng-mode__num">Mode 01</div>
        <div class="sc-eng-mode__name">Standard</div>
        <p class="sc-eng-mode__text">Mirrors natural strength curves, providing more resistance where you are stronger and less where you are weaker.</p>
        <div class="sc-eng-mode__curve">
          <div class="sc-eng-mode__bar" style="height:30%"></div>
          <div class="sc-eng-mode__bar" style="height:55%"></div>
          <div class="sc-eng-mode__bar" style="height:80%"></div>
          <div class="sc-eng-mode__bar" style="height:95%"></div>
          <div class="sc-eng-mode__bar" style="height:75%"></div>
          <div class="sc-eng-mode__bar" style="height:50%"></div>
          <div class="sc-eng-mode__bar" style="height:25%"></div>
        </div>
      </div>
      <div class="sc-eng-mode">
        <div class="sc-eng-mode__num">Mode 02</div>
        <div class="sc-eng-mode__name">Off-centre</div>
        <p class="sc-eng-mode__text">Deliberately shifts the resistance off-axis, challenging your stabiliser muscles and core control. Forces you to own the movement, not just survive it.</p>
        <div class="sc-eng-mode__curve">
          <div class="sc-eng-mode__bar" style="height:60%"></div>
          <div class="sc-eng-mode__bar" style="height:35%"></div>
          <div class="sc-eng-mode__bar" style="height:85%"></div>
          <div class="sc-eng-mode__bar" style="height:45%"></div>
          <div class="sc-eng-mode__bar" style="height:70%"></div>
          <div class="sc-eng-mode__bar" style="height:30%"></div>
          <div class="sc-eng-mode__bar" style="height:55%"></div>
        </div>
      </div>
      <div class="sc-eng-mode">
