{%- liquid
  assign og_title = page_title | default: shop.name | replace: 'Sensol Fitness', 'Sensol'
  assign og_url = canonical_url | default: request.origin
  assign og_type = 'website'
  if request.page_type == 'index'
    assign og_description = 'Sensol Pilates reformers in Australia: FLEX AIR and FLEX PRO spring reformers, plus RS03 and RS03 PRO smart motorised reformers. Compare specifications and choose your setup.'
  else
    assign og_description = page_description | default: shop.description | default: shop.name | replace: 'Sensol Fitness', 'Sensol'
  endif

  if request.page_type == 'product'
    assign og_type = 'product'
  elsif request.page_type == 'article'
    assign og_type = 'article'
  elsif request.page_type == 'password'
    assign og_url = request.origin
  endif
%}

<meta property="og:site_name" content="Sensol">
<meta property="og:url" content="{{ og_url }}">
<meta property="og:title" content="{{ og_title | escape }}">
<meta property="og:type" content="{{ og_type }}">
<meta property="og:description" content="{{ og_description | escape }}">

{%- if page_image -%}
  <meta property="og:image" content="http:{{ page_image | image_url }}">
  <meta property="og:image:secure_url" content="https:{{ page_image | image_url }}">
  <meta property="og:image:width" content="{{ page_image.width }}">
  <meta property="og:image:height" content="{{ page_image.height }}">
{%- endif -%}

{%- if request.page_type == 'product' -%}
  <meta property="og:price:amount" content="{{ product.selected_or_first_available_variant.price | money_without_currency | strip_html }}">
  <meta property="og:price:currency" content="{{ cart.currency.iso_code }}">
{%- endif -%}

{%- if settings.social_twitter_link != blank -%}
  <meta name="twitter:site" content="{{ settings.social_twitter_link | split: 'twitter.com/' | last | prepend: '@' }}">
{%- endif -%}
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ og_title | escape }}">
<meta name="twitter:description" content="{{ og_description | escape }}">

{%- comment -%}
  GEO/entity layer: keep structured data aligned with Shopify's live product data.
  Technical specifications remain governed by the BOM and are intentionally not
  duplicated here to avoid creating a second technical source of truth.
{%- endcomment -%}

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Organization",
  "@id": "{{ request.origin }}/#organization",
  "name": "Sensol",
  "legalName": "Sensol Fitness",
  "url": "{{ request.origin }}",
  "description": "Sensol designs Pilates reformers and smart training equipment for strength, control and precision movement.",
  "email": "support@sensolfitness.com.au"{% if settings.logo != blank %},
  "logo": {
    "@type": "ImageObject",
    "url": "{{ settings.logo | image_url: width: 600 }}"
  }{% endif %}
}
</script>

{%- if request.page_type == 'product' and product != blank -%}
  {%- assign schema_variant = product.selected_or_first_available_variant -%}
  {%- assign product_availability = 'https://schema.org/OutOfStock' -%}
  {%- if schema_variant.available -%}
    {%- assign product_availability = 'https://schema.org/InStock' -%}
  {%- endif -%}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Product",
    "@id": "{{ canonical_url }}#product",
    "name": {{ product.title | json }},
    "url": {{ canonical_url | json }},
    "description": {{ product.description | strip_html | strip_newlines | truncate: 5000 | json }},
    "brand": {
      "@type": "Brand",
      "name": "Sensol"
    },
    "category": "Pilates reformer",
    "sku": {{ schema_variant.sku | default: product.handle | json }},
    "image": [
      {%- for image in product.images limit: 8 -%}
        {{ image | image_url: width: 1200 | prepend: 'https:' | json }}{% unless forloop.last %},{% endunless %}
      {%- endfor -%}
    ],
    "offers": {
      "@type": "Offer",
      "url": {{ canonical_url | json }},
      "priceCurrency": {{ cart.currency.iso_code | json }},
      "price": {{ schema_variant.price | divided_by: 100.0 | json }},
      "availability": {{ product_availability | json }},
      "itemCondition": "https://schema.org/NewCondition"
    }
  }
  </script>

  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Home",
        "item": {{ request.origin | append: '/' | json }}
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": "Products",
        "item": {{ request.origin | append: '/collections/all' | json }}
      },
      {
        "@type": "ListItem",
        "position": 3,
        "name": {{ product.title | json }},
        "item": {{ canonical_url | json }}
      }
    ]
  }
  </script>
{%- endif -%}
