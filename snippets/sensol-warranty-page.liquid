  .sc-legal-cta__contact-divider { width: 1px; height: 20px; background: rgba(212,206,198,0.3); }

  /* ═══ FOOTER ═══ */
  .sc-legal-foot {
    background: #1A1816;
    padding: 2.5rem 3rem;
    font-family: 'Inter', sans-serif;
  }
  .sc-legal-foot__inner {
    max-width: 1200px; margin: 0 auto;
    display: flex; justify-content: space-between; align-items: center;
    gap: 2rem;
