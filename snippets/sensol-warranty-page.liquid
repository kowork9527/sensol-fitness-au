    .sc-legal-sidebar__nav a { font-size: 12px; padding: 0.375rem 0.625rem; }
    .sc-legal-content { padding: 2rem 1.5rem 4rem; }
    .sc-legal-hero__inner { padding: 6rem 1.5rem 2.5rem; }
    .sc-legal-facts { grid-template-columns: 1fr; }
    .sc-warranty-tiers { grid-template-columns: 1fr; }
    .sc-warranty-steps { grid-template-columns: 1fr; }
    .sc-warranty-exclusions { grid-template-columns: 1fr; }
    .sc-warranty-exclusions li:nth-child(2n) { padding-left: 0; border-left: none; }
    .sc-legal-cta { padding: 3rem 1.5rem; }
    .sc-legal-cta__contact { flex-direction: column; gap: 1rem; padding: 1.25rem 1.5rem; }
    .sc-legal-cta__contact-divider { display: none; }
    .sc-legal-foot { padding: 2rem 1.5rem; }
    .sc-legal-foot__inner { flex-direction: column; text-align: center; }
