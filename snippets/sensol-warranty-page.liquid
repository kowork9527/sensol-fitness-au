    border-top: 1px solid #D4CEC6;
    padding: 4rem 3rem;
    text-align: center;
  }
  .sc-legal-cta__inner { max-width: 600px; margin: 0 auto; }
  .sc-legal-cta__label {
    font-size: 10px; font-weight: 600; letter-spacing: 0.25em;
    text-transform: uppercase; color: #B5ADA4;
    margin-bottom: 1rem;
  }
  .sc-legal-cta__title {
    font-size: clamp(22px, 3vw, 32px); font-weight: 200;
    letter-spacing: 0.04em; color: #1A1816;
    margin-bottom: 1rem;
  }
  .sc-legal-cta__text {
    font-size: 14px; font-weight: 300; line-height: 1.7;
