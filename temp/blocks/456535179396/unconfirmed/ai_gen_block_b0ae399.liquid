{% doc %}
  @prompt
    Create a premium fitness/Pilates equipment product page section with a luxury, minimalist aesthetic. The design should feature: 1) A full-width hero banner with dark overlay and large product title text in elegant serif font; 2) Alternating image-text rows with generous white space - left image/right text, then right image/left text layout; 3) Full-width lifestyle photography sections showing people using the equipment in beautiful studio settings; 4) A clean product specifications/features list with minimal typography; 5) An accessories showcase section with small product images and descriptions; 6) A bottom CTA section with product image and purchase button. Color palette: off-white/cream background (#F5F0EB), near-black text (#1A1A1A), with dark accent sections. Typography should be elegant with serif headings and clean sans-serif body text. Overall feel: high-end, editorial, lots of breathing room between elements.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-premium-product-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    background-color: {{ block.settings.background_color }};
  }

  .ai-premium-product-hero-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    min-height: {{ block.settings.hero_height }}px;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  .ai-premium-product-hero-image-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-premium-product-hero-overlay-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, {{ block.settings.hero_overlay_opacity }});
  }

  .ai-premium-product-hero-content-{{ ai_gen_id }} {
    position: relative;
    z-index: 2;
    text-align: center;
    padding: 40px 20px;
    max-width: 900px;
  }

  .ai-premium-product-hero-title-{{ ai_gen_id }} {
    font-family: {{ block.settings.heading_font.family }}, {{ block.settings.heading_font.fallback_families }};
    font-weight: {{ block.settings.heading_font.weight }};
    font-size: {{ block.settings.hero_title_size }}px;
    color: {{ block.settings.hero_text_color }};
    margin: 0;
    line-height: 1.2;
    letter-spacing: -0.02em;
  }

  .ai-premium-product-hero-subtitle-{{ ai_gen_id }} {
    font-size: {{ block.settings.hero_subtitle_size }}px;
    color: {{ block.settings.hero_text_color }};
    margin-top: 20px;
    opacity: 0.9;
    line-height: 1.6;
  }

  .ai-premium-product-section-{{ ai_gen_id }} {
    padding: {{ block.settings.section_spacing }}px 0;
  }

  .ai-premium-product-container-{{ ai_gen_id }} {
    max-width: {{ block.settings.content_max_width }}px;
    margin: 0 auto;
    padding: 0 {{ block.settings.side_padding }}px;
  }

  .ai-premium-product-image-text-row-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: {{ block.settings.row_gap }}px;
    align-items: center;
    margin-bottom: {{ block.settings.row_spacing }}px;
  }

  .ai-premium-product-image-text-row-reverse-{{ ai_gen_id }} {
    direction: rtl;
  }

  .ai-premium-product-image-text-row-reverse-{{ ai_gen_id }} > * {
    direction: ltr;
  }

  .ai-premium-product-row-image-{{ ai_gen_id }} {
    width: 100%;
    height: auto;
    display: block;
  }

  .ai-premium-product-row-image-wrapper-{{ ai_gen_id }} {
    width: 100%;
  }

  .ai-premium-product-row-image-wrapper-{{ ai_gen_id }} svg {
    width: 100%;
    height: auto;
    background-color: #e8e8e8;
  }

  .ai-premium-product-row-text-{{ ai_gen_id }} {
    padding: 0 {{ block.settings.text_padding }}px;
  }

  .ai-premium-product-row-heading-{{ ai_gen_id }} {
    font-family: {{ block.settings.heading_font.family }}, {{ block.settings.heading_font.fallback_families }};
    font-weight: {{ block.settings.heading_font.weight }};
    font-size: {{ block.settings.row_heading_size }}px;
    color: {{ block.settings.text_color }};
    margin: 0 0 24px 0;
    line-height: 1.3;
    letter-spacing: -0.01em;
  }

  .ai-premium-product-row-description-{{ ai_gen_id }} {
    font-size: {{ block.settings.body_text_size }}px;
    color: {{ block.settings.text_color }};
    line-height: 1.8;
    opacity: 0.85;
  }

  .ai-premium-product-lifestyle-{{ ai_gen_id }} {
    width: 100%;
    margin: {{ block.settings.lifestyle_spacing }}px 0;
  }

  .ai-premium-product-lifestyle-image-{{ ai_gen_id }} {
    width: 100%;
    height: auto;
    display: block;
  }

  .ai-premium-product-lifestyle-wrapper-{{ ai_gen_id }} {
    width: 100%;
  }

  .ai-premium-product-lifestyle-wrapper-{{ ai_gen_id }} svg {
    width: 100%;
    height: auto;
    background-color: #e8e8e8;
  }

  .ai-premium-product-specs-{{ ai_gen_id }} {
    background-color: {{ block.settings.specs_bg_color }};
    padding: {{ block.settings.specs_padding }}px {{ block.settings.side_padding }}px;
  }

  .ai-premium-product-specs-title-{{ ai_gen_id }} {
    font-family: {{ block.settings.heading_font.family }}, {{ block.settings.heading_font.fallback_families }};
    font-weight: {{ block.settings.heading_font.weight }};
    font-size: {{ block.settings.specs_title_size }}px;
    color: {{ block.settings.text_color }};
    text-align: center;
    margin: 0 0 {{ block.settings.specs_title_margin }}px 0;
    letter-spacing: -0.01em;
  }

  .ai-premium-product-specs-grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: {{ block.settings.specs_gap }}px;
    max-width: {{ block.settings.content_max_width }}px;
    margin: 0 auto;
  }

  .ai-premium-product-spec-item-{{ ai_gen_id }} {
    text-align: center;
    padding: 20px;
  }

  .ai-premium-product-spec-label-{{ ai_gen_id }} {
    font-size: {{ block.settings.spec_label_size }}px;
    color: {{ block.settings.text_color }};
    opacity: 0.6;
    margin-bottom: 8px;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-weight: 500;
  }

  .ai-premium-product-spec-value-{{ ai_gen_id }} {
    font-size: {{ block.settings.spec_value_size }}px;
    color: {{ block.settings.text_color }};
    font-weight: 400;
  }

  .ai-premium-product-accessories-{{ ai_gen_id }} {
    padding: {{ block.settings.section_spacing }}px {{ block.settings.side_padding }}px;
  }

  .ai-premium-product-accessories-title-{{ ai_gen_id }} {
    font-family: {{ block.settings.heading_font.family }}, {{ block.settings.heading_font.fallback_families }};
    font-weight: {{ block.settings.heading_font.weight }};
    font-size: {{ block.settings.accessories_title_size }}px;
    color: {{ block.settings.text_color }};
    text-align: center;
    margin: 0 0 {{ block.settings.accessories_title_margin }}px 0;
    letter-spacing: -0.01em;
  }

  .ai-premium-product-accessories-grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: {{ block.settings.accessories_gap }}px;
    max-width: {{ block.settings.content_max_width }}px;
    margin: 0 auto;
  }

  .ai-premium-product-accessory-item-{{ ai_gen_id }} {
    text-align: center;
  }

  .ai-premium-product-accessory-image-{{ ai_gen_id }} {
    width: 100%;
    height: auto;
    margin-bottom: 16px;
    display: block;
  }

  .ai-premium-product-accessory-image-wrapper-{{ ai_gen_id }} {
    width: 100%;
    margin-bottom: 16px;
  }

  .ai-premium-product-accessory-image-wrapper-{{ ai_gen_id }} svg {
    width: 100%;
    height: auto;
    background-color: #e8e8e8;
  }

  .ai-premium-product-accessory-name-{{ ai_gen_id }} {
    font-size: {{ block.settings.accessory_name_size }}px;
    color: {{ block.settings.text_color }};
    margin-bottom: 8px;
    font-weight: 500;
  }

  .ai-premium-product-accessory-description-{{ ai_gen_id }} {
    font-size: {{ block.settings.accessory_desc_size }}px;
    color: {{ block.settings.text_color }};
    opacity: 0.7;
    line-height: 1.6;
  }

  .ai-premium-product-cta-{{ ai_gen_id }} {
    background-color: {{ block.settings.cta_bg_color }};
    padding: {{ block.settings.cta_padding }}px {{ block.settings.side_padding }}px;
  }

  .ai-premium-product-cta-content-{{ ai_gen_id }} {
    max-width: {{ block.settings.content_max_width }}px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: {{ block.settings.cta_gap }}px;
    align-items: center;
  }

  .ai-premium-product-cta-image-{{ ai_gen_id }} {
    width: 100%;
    height: auto;
    display: block;
  }

  .ai-premium-product-cta-image-wrapper-{{ ai_gen_id }} {
    width: 100%;
  }

  .ai-premium-product-cta-image-wrapper-{{ ai_gen_id }} svg {
    width: 100%;
    height: auto;
    background-color: #e8e8e8;
  }

  .ai-premium-product-cta-text-{{ ai_gen_id }} {
    padding: 0 40px;
  }

  .ai-premium-product-cta-heading-{{ ai_gen_id }} {
    font-family: {{ block.settings.heading_font.family }}, {{ block.settings.heading_font.fallback_families }};
    font-weight: {{ block.settings.heading_font.weight }};
    font-size: {{ block.settings.cta_heading_size }}px;
    color: {{ block.settings.cta_text_color }};
    margin: 0 0 24px 0;
    line-height: 1.3;
    letter-spacing: -0.01em;
  }

  .ai-premium-product-cta-description-{{ ai_gen_id }} {
    font-size: {{ block.settings.body_text_size }}px;
    color: {{ block.settings.cta_text_color }};
    line-height: 1.8;
    opacity: 0.85;
    margin-bottom: 32px;
  }

  .ai-premium-product-cta-button-{{ ai_gen_id }} {
    display: inline-block;
    padding: {{ block.settings.button_padding_vertical }}px {{ block.settings.button_padding_horizontal }}px;
    background-color: {{ block.settings.button_bg_color }};
    color: {{ block.settings.button_text_color }};
    text-decoration: none;
    font-size: {{ block.settings.button_text_size }}px;
    font-weight: 500;
    border: {{ block.settings.button_border_width }}px solid {{ block.settings.button_border_color }};
    cursor: pointer;
    transition: all 0.3s ease;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .ai-premium-product-cta-button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_bg_color }};
    color: {{ block.settings.button_hover_text_color }};
    border-color: {{ block.settings.button_hover_border_color }};
  }

  @media screen and (max-width: 989px) {
    .ai-premium-product-hero-title-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.hero_title_size }}px * 0.7);
    }

    .ai-premium-product-hero-subtitle-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.hero_subtitle_size }}px * 0.9);
    }

    .ai-premium-product-image-text-row-{{ ai_gen_id }},
    .ai-premium-product-image-text-row-reverse-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
      gap: 40px;
      direction: ltr;
    }

    .ai-premium-product-row-text-{{ ai_gen_id }} {
      padding: 0;
    }

    .ai-premium-product-row-heading-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.row_heading_size }}px * 0.85);
    }

    .ai-premium-product-cta-content-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
      gap: 40px;
    }

    .ai-premium-product-cta-text-{{ ai_gen_id }} {
      padding: 0;
    }

    .ai-premium-product-cta-heading-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.cta_heading_size }}px * 0.85);
    }

    .ai-premium-product-specs-grid-{{ ai_gen_id }},
    .ai-premium-product-accessories-grid-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
    }
  }
{% endstyle %}

<premium-product-{{ ai_gen_id }} class="ai-premium-product-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  {% if block.settings.show_hero %}
    <div class="ai-premium-product-hero-{{ ai_gen_id }}">
      {% if block.settings.hero_image %}
        <img
          src="{{ block.settings.hero_image | image_url: width: 2400 }}"
          alt="{{ block.settings.hero_image.alt | escape }}"
          class="ai-premium-product-hero-image-{{ ai_gen_id }}"
          loading="lazy"
          width="{{ block.settings.hero_image.width }}"
          height="{{ block.settings.hero_image.height }}"
        >
      {% else %}
        <div class="ai-premium-product-hero-image-{{ ai_gen_id }}">
          {{ 'lifestyle-1' | placeholder_svg_tag }}
        </div>
      {% endif %}
      <div class="ai-premium-product-hero-overlay-{{ ai_gen_id }}"></div>
      <div class="ai-premium-product-hero-content-{{ ai_gen_id }}">
        {% if block.settings.hero_title != blank %}
          <h1 class="ai-premium-product-hero-title-{{ ai_gen_id }}">{{ block.settings.hero_title }}</h1>
        {% endif %}
        {% if block.settings.hero_subtitle != blank %}
          <div class="ai-premium-product-hero-subtitle-{{ ai_gen_id }}">{{ block.settings.hero_subtitle }}</div>
        {% endif %}
      </div>
    </div>
  {% endif %}

  {% if block.settings.show_row_1 %}
    <div class="ai-premium-product-section-{{ ai_gen_id }}">
      <div class="ai-premium-product-container-{{ ai_gen_id }}">
        <div class="ai-premium-product-image-text-row-{{ ai_gen_id }}">
          <div class="ai-premium-product-row-image-wrapper-{{ ai_gen_id }}">
            {% if block.settings.row_1_image %}
              <img
                src="{{ block.settings.row_1_image | image_url: width: 1200 }}"
                alt="{{ block.settings.row_1_image.alt | escape }}"
                class="ai-premium-product-row-image-{{ ai_gen_id }}"
                loading="lazy"
                width="{{ block.settings.row_1_image.width }}"
                height="{{ block.settings.row_1_image.height }}"
              >
            {% else %}
              {{ 'product-1' | placeholder_svg_tag }}
            {% endif %}
          </div>
          <div class="ai-premium-product-row-text-{{ ai_gen_id }}">
            {% if block.settings.row_1_heading != blank %}
              <h2 class="ai-premium-product-row-heading-{{ ai_gen_id }}">{{ block.settings.row_1_heading }}</h2>
            {% endif %}
            {% if block.settings.row_1_description != blank %}
              <div class="ai-premium-product-row-description-{{ ai_gen_id }}">{{ block.settings.row_1_description }}</div>
            {% endif %}
          </div>
        </div>
      </div>
    </div>
  {% endif %}

  {% if block.settings.show_row_2 %}
    <div class="ai-premium-product-section-{{ ai_gen_id }}">
      <div class="ai-premium-product-container-{{ ai_gen_id }}">
        <div class="ai-premium-product-image-text-row-{{ ai_gen_id }} ai-premium-product-image-text-row-reverse-{{ ai_gen_id }}">
          <div class="ai-premium-product-row-image-wrapper-{{ ai_gen_id }}">
            {% if block.settings.row_2_image %}
              <img
                src="{{ block.settings.row_2_image | image_url: width: 1200 }}"
                alt="{{ block.settings.row_2_image.alt | escape }}"
                class="ai-premium-product-row-image-{{ ai_gen_id }}"
                loading="lazy"
                width="{{ block.settings.row_2_image.width }}"
                height="{{ block.settings.row_2_image.height }}"
              >
            {% else %}
              {{ 'product-2' | placeholder_svg_tag }}
            {% endif %}
          </div>
          <div class="ai-premium-product-row-text-{{ ai_gen_id }}">
            {% if block.settings.row_2_heading != blank %}
              <h2 class="ai-premium-product-row-heading-{{ ai_gen_id }}">{{ block.settings.row_2_heading }}</h2>
            {% endif %}
            {% if block.settings.row_2_description != blank %}
              <div class="ai-premium-product-row-description-{{ ai_gen_id }}">{{ block.settings.row_2_description }}</div>
            {% endif %}
          </div>
        </div>
      </div>
    </div>
  {% endif %}

  {% if block.settings.show_lifestyle %}
    <div class="ai-premium-product-lifestyle-{{ ai_gen_id }}">
      {% if block.settings.lifestyle_image %}
        <img
          src="{{ block.settings.lifestyle_image | image_url: width: 2400 }}"
          alt="{{ block.settings.lifestyle_image.alt | escape }}"
          class="ai-premium-product-lifestyle-image-{{ ai_gen_id }}"
          loading="lazy"
          width="{{ block.settings.lifestyle_image.width }}"
          height="{{ block.settings.lifestyle_image.height }}"
        >
      {% else %}
        <div class="ai-premium-product-lifestyle-wrapper-{{ ai_gen_id }}">
          {{ 'lifestyle-2' | placeholder_svg_tag }}
        </div>
      {% endif %}
    </div>
  {% endif %}

  {% if block.settings.show_specs %}
    <div class="ai-premium-product-specs-{{ ai_gen_id }}">
      {% if block.settings.specs_title != blank %}
        <h2 class="ai-premium-product-specs-title-{{ ai_gen_id }}">{{ block.settings.specs_title }}</h2>
      {% endif %}
      <div class="ai-premium-product-specs-grid-{{ ai_gen_id }}">
        {% if block.settings.spec_1_label != blank %}
          <div class="ai-premium-product-spec-item-{{ ai_gen_id }}">
            <div class="ai-premium-product-spec-label-{{ ai_gen_id }}">{{ block.settings.spec_1_label }}</div>
            <div class="ai-premium-product-spec-value-{{ ai_gen_id }}">{{ block.settings.spec_1_value }}</div>
          </div>
        {% endif %}
        {% if block.settings.spec_2_label != blank %}
          <div class="ai-premium-product-spec-item-{{ ai_gen_id }}">
            <div class="ai-premium-product-spec-label-{{ ai_gen_id }}">{{ block.settings.spec_2_label }}</div>
            <div class="ai-premium-product-spec-value-{{ ai_gen_id }}">{{ block.settings.spec_2_value }}</div>
          </div>
        {% endif %}
        {% if block.settings.spec_3_label != blank %}
          <div class="ai-premium-product-spec-item-{{ ai_gen_id }}">
            <div class="ai-premium-product-spec-label-{{ ai_gen_id }}">{{ block.settings.spec_3_label }}</div>
            <div class="ai-premium-product-spec-value-{{ ai_gen_id }}">{{ block.settings.spec_3_value }}</div>
          </div>
        {% endif %}
        {% if block.settings.spec_4_label != blank %}
          <div class="ai-premium-product-spec-item-{{ ai_gen_id }}">
            <div class="ai-premium-product-spec-label-{{ ai_gen_id }}">{{ block.settings.spec_4_label }}</div>
            <div class="ai-premium-product-spec-value-{{ ai_gen_id }}">{{ block.settings.spec_4_value }}</div>
          </div>
        {% endif %}
      </div>
    </div>
  {% endif %}

  {% if block.settings.show_accessories %}
    <div class="ai-premium-product-accessories-{{ ai_gen_id }}">
      {% if block.settings.accessories_title != blank %}
        <h2 class="ai-premium-product-accessories-title-{{ ai_gen_id }}">{{ block.settings.accessories_title }}</h2>
      {% endif %}
      <div class="ai-premium-product-accessories-grid-{{ ai_gen_id }}">
        {% if block.settings.accessory_1_name != blank %}
          <div class="ai-premium-product-accessory-item-{{ ai_gen_id }}">
            {% if block.settings.accessory_1_image %}
              <img
                src="{{ block.settings.accessory_1_image | image_url: width: 400 }}"
                alt="{{ block.settings.accessory_1_image.alt | escape }}"
                class="ai-premium-product-accessory-image-{{ ai_gen_id }}"
                loading="lazy"
                width="{{ block.settings.accessory_1_image.width }}"
                height="{{ block.settings.accessory_1_image.height }}"
              >
            {% else %}
              <div class="ai-premium-product-accessory-image-wrapper-{{ ai_gen_id }}">
                {{ 'product-3' | placeholder_svg_tag }}
              </div>
            {% endif %}
            <div class="ai-premium-product-accessory-name-{{ ai_gen_id }}">{{ block.settings.accessory_1_name }}</div>
            {% if block.settings.accessory_1_description != blank %}
              <div class="ai-premium-product-accessory-description-{{ ai_gen_id }}">{{ block.settings.accessory_1_description }}</div>
            {% endif %}
          </div>
        {% endif %}
        {% if block.settings.accessory_2_name != blank %}
          <div class="ai-premium-product-accessory-item-{{ ai_gen_id }}">
            {% if block.settings.accessory_2_image %}
              <img
                src="{{ block.settings.accessory_2_image | image_url: width: 400 }}"
                alt="{{ block.settings.accessory_2_image.alt | escape }}"
                class="ai-premium-product-accessory-image-{{ ai_gen_id }}"
                loading="lazy"
                width="{{ block.settings.accessory_2_image.width }}"
                height="{{ block.settings.accessory_2_image.height }}"
              >
            {% else %}
              <div class="ai-premium-product-accessory-image-wrapper-{{ ai_gen_id }}">
                {{ 'product-4' | placeholder_svg_tag }}
              </div>
            {% endif %}
            <div class="ai-premium-product-accessory-name-{{ ai_gen_id }}">{{ block.settings.accessory_2_name }}</div>
            {% if block.settings.accessory_2_description != blank %}
              <div class="ai-premium-product-accessory-description-{{ ai_gen_id }}">{{ block.settings.accessory_2_description }}</div>
            {% endif %}
          </div>
        {% endif %}
        {% if block.settings.accessory_3_name != blank %}
          <div class="ai-premium-product-accessory-item-{{ ai_gen_id }}">
            {% if block.settings.accessory_3_image %}
              <img
                src="{{ block.settings.accessory_3_image | image_url: width: 400 }}"
                alt="{{ block.settings.accessory_3_image.alt | escape }}"
                class="ai-premium-product-accessory-image-{{ ai_gen_id }}"
                loading="lazy"
                width="{{ block.settings.accessory_3_image.width }}"
                height="{{ block.settings.accessory_3_image.height }}"
              >
            {% else %}
              <div class="ai-premium-product-accessory-image-wrapper-{{ ai_gen_id }}">
                {{ 'product-5' | placeholder_svg_tag }}
              </div>
            {% endif %}
            <div class="ai-premium-product-accessory-name-{{ ai_gen_id }}">{{ block.settings.accessory_3_name }}</div>
            {% if block.settings.accessory_3_description != blank %}
              <div class="ai-premium-product-accessory-description-{{ ai_gen_id }}">{{ block.settings.accessory_3_description }}</div>
            {% endif %}
          </div>
        {% endif %}
      </div>
    </div>
  {% endif %}

  {% if block.settings.show_cta %}
    <div class="ai-premium-product-cta-{{ ai_gen_id }}">
      <div class="ai-premium-product-cta-content-{{ ai_gen_id }}">
        <div class="ai-premium-product-cta-image-wrapper-{{ ai_gen_id }}">
          {% if block.settings.cta_image %}
            <img
              src="{{ block.settings.cta_image | image_url: width: 1200 }}"
              alt="{{ block.settings.cta_image.alt | escape }}"
              class="ai-premium-product-cta-image-{{ ai_gen_id }}"
              loading="lazy"
              width="{{ block.settings.cta_image.width }}"
              height="{{ block.settings.cta_image.height }}"
            >
          {% else %}
            {{ 'product-6' | placeholder_svg_tag }}
          {% endif %}
        </div>
        <div class="ai-premium-product-cta-text-{{ ai_gen_id }}">
          {% if block.settings.cta_heading != blank %}
            <h2 class="ai-premium-product-cta-heading-{{ ai_gen_id }}">{{ block.settings.cta_heading }}</h2>
          {% endif %}
          {% if block.settings.cta_description != blank %}
            <div class="ai-premium-product-cta-description-{{ ai_gen_id }}">{{ block.settings.cta_description }}</div>
          {% endif %}
          {% if block.settings.cta_button_text != blank %}
            <a href="{{ block.settings.cta_button_link }}" class="ai-premium-product-cta-button-{{ ai_gen_id }}">
              {{ block.settings.cta_button_text }}
            </a>
          {% endif %}
        </div>
      </div>
    </div>
  {% endif %}
</premium-product-{{ ai_gen_id }}>

<script>
  (function() {
    class PremiumProduct{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.style.display = 'block';
      }
    }

    customElements.define('premium-product-{{ ai_gen_id }}', PremiumProduct{{ ai_gen_id }});
  })();
</script>

