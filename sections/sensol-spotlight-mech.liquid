{%- style -%}
  .sc-spt-mech-{{ section.id }} {
    font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
    width: 100%;
    background: #1A1816; color: #F7F4F0;
  }
  .sc-spt-mech-{{ section.id }}__inner {
    max-width: 1400px; margin: 0 auto;
    padding: 80px 40px;
    display: grid;
    grid-template-columns: 1.5fr 1fr;
    gap: 80px;
    align-items: center;
  }
  .sc-spt-mech-{{ section.id }}__label {
    font-size: 11px; font-weight: 500;
    letter-spacing: 0.3em; text-transform: uppercase;
    color: #B5ADA4; margin-bottom: 12px;
  }
  .sc-spt-mech-{{ section.id }}__title {
    font-size: clamp(28px, 4vw, 42px);
    font-weight: 300; letter-spacing: 0.08em;
    text-transform: uppercase; margin: 0 0 20px;
  }
  .sc-spt-mech-{{ section.id }}__desc {
    font-size: 14px; line-height: 1.8;
    margin: 0 0 28px; color: #B5ADA4;
  }
  .sc-spt-mech-{{ section.id }}__features {
    list-style: none; padding: 0; margin: 0;
  }
  .sc-spt-mech-{{ section.id }}__features li {
    font-size: 13px; font-weight: 400;
    letter-spacing: 0.02em;
    padding: 12px 0;
    display: flex; align-items: center; gap: 12px;
    color: #F7F4F0;
    border-top: 1px solid rgba(247,244,240,0.15);
  }
  .sc-spt-mech-{{ section.id }}__features li:last-child {
    border-bottom: 1px solid rgba(247,244,240,0.15);
  }
  .sc-spt-mech-{{ section.id }}__features li::before {
    content: '';
    width: 4px; height: 4px;
    background: #F7F4F0;
    flex-shrink: 0;
  }
  .sc-spt-mech-{{ section.id }}__visual {
    aspect-ratio: 16/10;
    background: rgba(247,244,240,0.05);
    overflow: hidden;
  }
  .sc-spt-mech-{{ section.id }}__visual-placeholder {
    width: 100%; height: 100%;
    display: flex; align-items: center; justify-content: center;
    font-family: 'JetBrains Mono', monospace;
    font-size: 14px; letter-spacing: 0.2em;
    text-transform: uppercase;
    color: #B5ADA4;
  }

  @media screen and (max-width: 1024px) {
    .sc-spt-mech-{{ section.id }}__inner {
      grid-template-columns: 1fr; gap: 40px;
    }
  }
  @media screen and (max-width: 768px) {
    .sc-spt-mech-{{ section.id }}__inner { padding: 60px 20px; }
  }
{%- endstyle -%}

<section class="sc-spt-mech-{{ section.id }}">
  <div class="sc-spt-mech-{{ section.id }}__inner">
    <div class="sc-spt-mech-{{ section.id }}__content">
      <p class="sc-spt-mech-{{ section.id }}__label">Series 02</p>
      <h2 class="sc-spt-mech-{{ section.id }}__title">Mechanical Series</h2>
      <p class="sc-spt-mech-{{ section.id }}__desc">Elastic band and spring-based reformers built for accessibility. Foldable, lightweight, and beginner-friendly.</p>
      <ul class="sc-spt-mech-{{ section.id }}__features">
        <li>Elastic band & spring resistance system</li>
        <li>Foldable design - 0.2 m2 storage</li>
        <li>Lightweight: from 25 kg</li>
        <li>Full Vesta Sensol App compatibility</li>
      </ul>
    </div>
    <div class="sc-spt-mech-{{ section.id }}__visual">
      <div class="sc-spt-mech-{{ section.id }}__visual-placeholder">Mechanical Series</div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Collection Spotlight Mech",
  "tag": "section",
  "class": "sensol-spotlight-mech",
  "settings": [],
  "presets": [{ "name": "Collection Spotlight Mech" }]
}
{% endschema %}
