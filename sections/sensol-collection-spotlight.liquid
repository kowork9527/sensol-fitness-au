{%- style -%}
  .sc-spot-{{ section.id }} {
    font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
    width: 100%;
  }
  {%- if section.settings.dark_bg -%}
  .sc-spot-{{ section.id }} { background: #1A1816; color: #F7F4F0; }
  {%- else -%}
  .sc-spot-{{ section.id }} { background: #F7F4F0; color: #1A1816; border-top: 1px solid #D4CEC6; border-bottom: 1px solid #D4CEC6; }
  {%- endif -%}

  .sc-spot-{{ section.id }}__inner {
    max-width: 1400px; margin: 0 auto;
    padding: 80px 40px;
    display: grid;
    grid-template-columns: 1fr 1.5fr;
    gap: 80px;
    align-items: center;
  }
  {%- if section.settings.image_position == 'left' -%}
  .sc-spot-{{ section.id }}__inner { grid-template-columns: 1.5fr 1fr; }
  .sc-spot-{{ section.id }}__visual { order: -1; }
  {%- endif -%}

  .sc-spot-{{ section.id }}__label {
    font-size: 11px; font-weight: 500;
    letter-spacing: 0.3em; text-transform: uppercase;
    {%- if section.settings.dark_bg -%}
    color: #B5ADA4;
    {%- else -%}
    color: #8A8279;
    {%- endif -%}
    margin-bottom: 12px;
  }
  .sc-spot-{{ section.id }}__title {
    font-size: clamp(28px, 4vw, 42px);
    font-weight: 300; letter-spacing: 0.08em;
    text-transform: uppercase; margin: 0 0 20px;
  }
  .sc-spot-{{ section.id }}__desc {
    font-size: 14px; line-height: 1.8;
    margin: 0 0 28px;
    {%- if section.settings.dark_bg -%}
    color: #B5ADA4;
    {%- else -%}
    color: #8A8279;
    {%- endif -%}
  }
  .sc-spot-{{ section.id }}__features {
    list-style: none; padding: 0; margin: 0;
  }
  .sc-spot-{{ section.id }}__features li {
    font-size: 13px; font-weight: 400;
    letter-spacing: 0.02em;
    padding: 12px 0;
    display: flex; align-items: center; gap: 12px;
    {%- if section.settings.dark_bg -%}
    color: #F7F4F0;
    border-top: 1px solid rgba(247,244,240,0.15);
    {%- else -%}
    color: #1A1816;
    border-top: 1px solid #D4CEC6;
    {%- endif -%}
  }
  .sc-spot-{{ section.id }}__features li:last-child {
    {%- if section.settings.dark_bg -%}
    border-bottom: 1px solid rgba(247,244,240,0.15);
    {%- else -%}
    border-bottom: 1px solid #D4CEC6;
    {%- endif -%}
  }
  .sc-spot-{{ section.id }}__features li::before {
    content: '';
    width: 4px; height: 4px;
    {%- if section.settings.dark_bg -%}
    background: #F7F4F0;
    {%- else -%}
    background: #1A1816;
    {%- endif -%}
    flex-shrink: 0;
  }
  .sc-spot-{{ section.id }}__visual {
    aspect-ratio: 16/10;
    {%- if section.settings.dark_bg -%}
    background: rgba(247,244,240,0.05);
    {%- else -%}
    background: #fff;
    {%- endif -%}
    overflow: hidden;
  }
  .sc-spot-{{ section.id }}__visual img {
    width: 100%; height: 100%;
    object-fit: cover;
  }
  .sc-spot-{{ section.id }}__visual-placeholder {
    width: 100%; height: 100%;
    display: flex; align-items: center; justify-content: center;
    font-family: 'JetBrains Mono', monospace;
    font-size: 14px; letter-spacing: 0.2em;
    text-transform: uppercase;
    {%- if section.settings.dark_bg -%}
    color: #B5ADA4;
    {%- else -%}
    color: #8A8279;
    {%- endif -%}
  }

  @media screen and (max-width: 1024px) {
    .sc-spot-{{ section.id }}__inner {
      grid-template-columns: 1fr; gap: 40px;
    }
    {%- if section.settings.image_position == 'left' -%}
    .sc-spot-{{ section.id }}__visual { order: 0; }
    {%- endif -%}
  }
  @media screen and (max-width: 768px) {
    .sc-spot-{{ section.id }}__inner { padding: 60px 20px; }
  }
{%- endstyle -%}

{%- assign spot_hide = '' -%}
{%- assign spot_is_smart = true -%}
{%- if section.settings.dark_bg -%}
  {%- assign spot_is_smart = false -%}
{%- endif -%}

{%- case collection.handle -%}
  {%- when 'flex-series' -%}
    {%- assign spot_hide = 'display:none;' -%}
{%- endcase -%}

{%- if collection.handle == 'smart-series' and section.settings.dark_bg -%}
  {%- assign spot_hide = 'display:none;' -%}
{%- endif -%}

{%- if collection.handle == 'mechanical-series' and spot_is_smart -%}
  {%- assign spot_hide = 'display:none;' -%}
{%- endif -%}

<section class="sc-spot-{{ section.id }}" style="{{ spot_hide }}">
  <div class="sc-spot-{{ section.id }}__inner">
    <div class="sc-spot-{{ section.id }}__content">
      <p class="sc-spot-{{ section.id }}__label">{{ section.settings.label }}</p>
      <h2 class="sc-spot-{{ section.id }}__title">{{ section.settings.title }}</h2>
      <p class="sc-spot-{{ section.id }}__desc">{{ section.settings.description }}</p>
      <ul class="sc-spot-{{ section.id }}__features">
        {%- if section.settings.feature_1 != blank -%}
          <li>{{ section.settings.feature_1 }}</li>
        {%- endif -%}
        {%- if section.settings.feature_2 != blank -%}
          <li>{{ section.settings.feature_2 }}</li>
        {%- endif -%}
        {%- if section.settings.feature_3 != blank -%}
          <li>{{ section.settings.feature_3 }}</li>
        {%- endif -%}
        {%- if section.settings.feature_4 != blank -%}
          <li>{{ section.settings.feature_4 }}</li>
        {%- endif -%}
      </ul>
    </div>
    <div class="sc-spot-{{ section.id }}__visual">
      {%- if section.settings.image != blank -%}
        <img src="{{ section.settings.image | image_url: width: 1000 }}" alt="{{ section.settings.title | escape }}" loading="lazy" style="width:100%;height:100%;object-fit:cover;">
      {%- else -%}
        <div class="sc-spot-{{ section.id }}__visual-placeholder">{{ section.settings.title }}</div>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Collection Spotlight",
  "tag": "section",
  "class": "sensol-collection-spotlight",
  "settings": [
    { "type": "checkbox", "id": "dark_bg", "label": "Dark Background", "default": false },
    { "type": "select", "id": "image_position", "label": "Image Position", "options": [{ "value": "right", "label": "Right" }, { "value": "left", "label": "Left" }], "default": "right" },
    { "type": "text", "id": "label", "label": "Series Label", "default": "Series 01" },
    { "type": "text", "id": "title", "label": "Series Title", "default": "Smart Series" },
    { "type": "textarea", "id": "description", "label": "Description", "default": "Digital weight reformers powered by servo motors. 0.5 kg precision, dual-function Pilates and strength training, AI-driven coaching." },
    { "type": "image_picker", "id": "image", "label": "Visual Image" },
    { "type": "text", "id": "feature_1", "label": "Feature 1", "default": "Digital weight control - 0.5 kg increments" },
    { "type": "text", "id": "feature_2", "label": "Feature 2", "default": "Dual-function: Pilates + Strength training" },
    { "type": "text", "id": "feature_3", "label": "Feature 3", "default": "Servo motor driven resistance system" },
    { "type": "text", "id": "feature_4", "label": "Feature 4", "default": "Vesta Sensol App with AI coaching" }
  ],
  "presets": [{ "name": "Collection Spotlight" }]
}
{% endschema %}
