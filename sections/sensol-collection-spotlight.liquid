{%- assign spot_variant = '' -%}
{%- case collection.handle -%}
  {%- when 'all' -%}
    {%- assign spot_variant = 'smart' -%}
  {%- when 'products' -%}
    {%- assign spot_variant = 'smart' -%}
  {%- when 'smart-series' -%}
    {%- assign spot_variant = 'smart' -%}
  {%- when 'mechanical-series' -%}
    {%- assign spot_variant = 'mech' -%}
  {%- when 'flex-series' -%}
    {%- assign spot_variant = 'flex' -%}
{%- endcase -%}


{%- style -%}
  .sc-spot-{{ section.id }} {
    font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
    padding: 100px 40px;
    border-top: 1px solid #D4CEC6;
  }
  .sc-spot-{{ section.id }}--dark { background: #1A1816; color: #F7F4F0; }
  .sc-spot-{{ section.id }}--light { background: #F7F4F0; color: #1A1816; }
  .sc-spot-{{ section.id }}__inner {
    max-width: 1400px; margin: 0 auto;
    display: grid; grid-template-columns: 1fr 1fr;
    gap: 80px; align-items: center;
  }
  .sc-spot-{{ section.id }}__eyebrow {
    font-size: 11px; font-weight: 500;
    letter-spacing: 0.3em; text-transform: uppercase;
    margin-bottom: 20px;
  }
  .sc-spot-{{ section.id }}--dark .sc-spot-{{ section.id }}__eyebrow { color: #B5ADA4; }
  .sc-spot-{{ section.id }}--light .sc-spot-{{ section.id }}__eyebrow { color: #8A8279; }
  .sc-spot-{{ section.id }}__title {
    font-size: clamp(28px, 4vw, 48px);
    font-weight: 200; letter-spacing: 0.1em;
    text-transform: uppercase; line-height: 1.15;
    margin: 0 0 24px;
  }
  .sc-spot-{{ section.id }}__text {
    font-size: 15px; font-weight: 400;
    line-height: 1.8; max-width: 480px;
    margin: 0 0 32px;
  }
  .sc-spot-{{ section.id }}--dark .sc-spot-{{ section.id }}__text { color: #B5ADA4; }
  .sc-spot-{{ section.id }}--light .sc-spot-{{ section.id }}__text { color: #8A8279; }
  .sc-spot-{{ section.id }}__features {
    display: flex; flex-wrap: wrap; gap: 24px 40px; margin-bottom: 36px;
  }
  .sc-spot-{{ section.id }}__feature { font-size: 12px; font-weight: 400; letter-spacing: 0.1em; }
  .sc-spot-{{ section.id }}__feature-num {
    font-family: 'JetBrains Mono', 'Courier New', monospace;
    font-size: 20px; font-weight: 300;
    display: block; margin-bottom: 2px;
  }
  .sc-spot-{{ section.id }}--dark .sc-spot-{{ section.id }}__feature-num { color: #F7F4F0; }
  .sc-spot-{{ section.id }}--light .sc-spot-{{ section.id }}__feature-num { color: #1A1816; }
  .sc-spot-{{ section.id }}__feature-label { color: #8A8279; }
  .sc-spot-{{ section.id }}__cta {
    display: inline-flex; align-items: center; gap: 12px;
    font-size: 11px; font-weight: 500;
    letter-spacing: 0.2em; text-transform: uppercase;
    text-decoration: none; padding-bottom: 8px;
    border-bottom: 1px solid currentColor;
    transition: gap 0.3s cubic-bezier(0.25,0.1,0.25,1);
  }
  .sc-spot-{{ section.id }}__cta:hover { gap: 20px; }
  .sc-spot-{{ section.id }}__media {
    aspect-ratio: 4/5; background: #D4CEC6; overflow: hidden;
  }
  .sc-spot-{{ section.id }}__media img {
    width: 100%; height: 100%; object-fit: cover;
    transition: transform 0.6s cubic-bezier(0.25,0.1,0.25,1);
  }
  .sc-spot-{{ section.id }}__media:hover img { transform: scale(1.03); }
  @media screen and (max-width: 768px) {
    .sc-spot-{{ section.id }} { padding: 60px 20px; }
    .sc-spot-{{ section.id }}__inner { grid-template-columns: 1fr; gap: 40px; }
  }
{%- endstyle -%}

{%- if spot_variant == 'smart' -%}
<section class="sc-spot-{{ section.id }} sc-spot-{{ section.id }}--light">
  <div class="sc-spot-{{ section.id }}__inner">
    <div>
      <p class="sc-spot-{{ section.id }}__eyebrow">Series 01 / Smart</p>
      <h2 class="sc-spot-{{ section.id }}__title">Engineered for<br>precision.</h2>
      <p class="sc-spot-{{ section.id }}__text">Digital servo motors deliver 1 kg increment weight control. Dual-function Pilates and strength training with AI-driven coaching through the Vesta app.</p>
      <div class="sc-spot-{{ section.id }}__features">
        <div class="sc-spot-{{ section.id }}__feature">
          <span class="sc-spot-{{ section.id }}__feature-num">1kg</span>
          <span class="sc-spot-{{ section.id }}__feature-label">Precision</span>
        </div>
        <div class="sc-spot-{{ section.id }}__feature">
          <span class="sc-spot-{{ section.id }}__feature-num">128+</span>
          <span class="sc-spot-{{ section.id }}__feature-label">Movements</span>
        </div>
        <div class="sc-spot-{{ section.id }}__feature">
          <span class="sc-spot-{{ section.id }}__feature-num">4.3"</span>
          <span class="sc-spot-{{ section.id }}__feature-label">Touch Display</span>
        </div>
      </div>
      <a href="/collections/smart-series" class="sc-spot-{{ section.id }}__cta">View Smart Series &rarr;</a>
    </div>
    <div class="sc-spot-{{ section.id }}__media">
      {%- if collection.image -%}
        <img src="{{ collection.image | image_url: width: 800 }}" alt="Smart Series" loading="lazy">
      {%- else -%}
        <img src="{{ 'contact-hero.jpg' | asset_url }}" alt="Smart Series" loading="lazy">
      {%- endif -%}
    </div>
  </div>
</section>
{%- elsif spot_variant == 'mech' -%}
<section class="sc-spot-{{ section.id }} sc-spot-{{ section.id }}--dark">
  <div class="sc-spot-{{ section.id }}__inner">
    <div class="sc-spot-{{ section.id }}__media">
      {%- if collection.image -%}
        <img src="{{ collection.image | image_url: width: 800 }}" alt="Mechanical Series" loading="lazy">
      {%- else -%}
        <img src="{{ 'contact-desk.jpg' | asset_url }}" alt="Mechanical Series" loading="lazy">
      {%- endif -%}
    </div>
    <div>
      <p class="sc-spot-{{ section.id }}__eyebrow">Series 02 / Mechanical</p>
      <h2 class="sc-spot-{{ section.id }}__title">Built for<br>accessibility.</h2>
      <p class="sc-spot-{{ section.id }}__text">Spring-based resistance in a foldable, lightweight frame. Beginner-friendly without compromising on build quality or training depth.</p>
      <div class="sc-spot-{{ section.id }}__features">
        <div class="sc-spot-{{ section.id }}__feature">
          <span class="sc-spot-{{ section.id }}__feature-num">150+</span>
          <span class="sc-spot-{{ section.id }}__feature-label">Movements</span>
        </div>
        <div class="sc-spot-{{ section.id }}__feature">
          <span class="sc-spot-{{ section.id }}__feature-num">25kg</span>
          <span class="sc-spot-{{ section.id }}__feature-label">Starting Weight</span>
        </div>
        <div class="sc-spot-{{ section.id }}__feature">
          <span class="sc-spot-{{ section.id }}__feature-num">5min</span>
          <span class="sc-spot-{{ section.id }}__feature-label">Setup Time</span>
        </div>
      </div>
      <a href="/collections/mechanical-series" class="sc-spot-{{ section.id }}__cta">View Mechanical Series &rarr;</a>
    </div>
  </div>
</section>
{%- elsif spot_variant == 'flex' -%}
<section class="sc-spot-{{ section.id }} sc-spot-{{ section.id }}--light">
  <div class="sc-spot-{{ section.id }}__inner">
    <div>
      <p class="sc-spot-{{ section.id }}__eyebrow">Flex Collection</p>
      <h2 class="sc-spot-{{ section.id }}__title">Foldable.<br>Uncompromising.</h2>
      <p class="sc-spot-{{ section.id }}__text">Spring-based resistance in a foldable, space-saving frame. German and Chinese steel wire springs deliver smooth, consistent resistance for home practice where space matters.</p>
      <div class="sc-spot-{{ section.id }}__features">
        <div class="sc-spot-{{ section.id }}__feature">
          <span class="sc-spot-{{ section.id }}__feature-num">150+</span>
          <span class="sc-spot-{{ section.id }}__feature-label">Movements</span>
        </div>
        <div class="sc-spot-{{ section.id }}__feature">
          <span class="sc-spot-{{ section.id }}__feature-num">Spring</span>
          <span class="sc-spot-{{ section.id }}__feature-label">Resistance</span>
        </div>
        <div class="sc-spot-{{ section.id }}__feature">
          <span class="sc-spot-{{ section.id }}__feature-num">Foldable</span>
          <span class="sc-spot-{{ section.id }}__feature-label">Design</span>
        </div>
      </div>
      <a href="/collections/flex-series" class="sc-spot-{{ section.id }}__cta">View Flex Series &rarr;</a>
    </div>
    <div class="sc-spot-{{ section.id }}__media">
      {%- if collection.image -%}
        <img src="{{ collection.image | image_url: width: 800 }}" alt="Flex Series" loading="lazy">
      {%- else -%}
        <img src="{{ 'contact-hero.jpg' | asset_url }}" alt="Flex Series" loading="lazy">
      {%- endif -%}
    </div>
  </div>
</section>
{%- endif -%}

{% schema %}
{
  "name": "Series Spotlight",
  "tag": "section",
  "class": "sensol-collection-spotlight",
  "settings": [
    { "type": "checkbox", "id": "show_section", "label": "Show Spotlight", "default": true }
  ]
}
{% endschema %}
