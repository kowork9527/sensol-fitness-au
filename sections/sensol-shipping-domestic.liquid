<section class="sensol-shipping-domestic-section">
  <div class="sensol-shipping-domestic">
    <div class="sensol-shipping-domestic__divider"></div>
    <p class="sensol-shipping-domestic__label">01</p>
    <h2 class="sensol-shipping-domestic__title">Domestic Shipping &mdash; Australia</h2>
    <div class="sensol-shipping-domestic__body">
      <p>We currently ship to all addresses within Australia, including metropolitan, regional, and remote areas across all states and territories. Due to the size and weight of Sensol fitness equipment, all orders are dispatched via <strong>specialized heavy-goods courier services</strong>. We do not use standard parcel carriers.</p>
    </div>
    <div class="sensol-shipping-domestic__methods">
      <div class="sensol-shipping-domestic__method">
        <div class="sensol-shipping-domestic__method-icon">&#128666;</div>
        <div class="sensol-shipping-domestic__method-name">Standard Delivery</div>
        <div class="sensol-shipping-domestic__method-coverage">Metro areas: Melbourne, Sydney, Brisbane, Adelaide, Perth, Hobart, Canberra, Darwin</div>
        <div class="sensol-shipping-domestic__method-detail">2&ndash;5 business days. Door-to-door courier with tracking.</div>
      </div>
      <div class="sensol-shipping-domestic__method">
        <div class="sensol-shipping-domestic__method-icon">&#128506;</div>
        <div class="sensol-shipping-domestic__method-name">Regional &amp; Country</div>
        <div class="sensol-shipping-domestic__method-coverage">Regional areas across all states and territories</div>
        <div class="sensol-shipping-domestic__method-detail">3&ndash;9 business days. Delivery times vary by location; remote areas may take longer.</div>
      </div>
      <div class="sensol-shipping-domestic__method">
        <div class="sensol-shipping-domestic__method-icon">&#128230;</div>
        <div class="sensol-shipping-domestic__method-name">Authority to Leave (ATL)</div>
        <div class="sensol-shipping-domestic__method-coverage">All areas, subject to safe location availability</div>
        <div class="sensol-shipping-domestic__method-detail">If no one is available, the courier may leave the item at a safe location and photograph as proof. Redelivery may incur additional fees if ATL is not possible.</div>
      </div>
    </div>
  </div>
</section>
{% schema %}{"name":"SENSOL Shipping Domestic","tag":"section","class":"sensol-shipping-domestic-section","settings":[],"presets":[{"name":"SENSOL Shipping Domestic"}]}{% endschema %}
{%- style -%}
.sensol-shipping-domestic-section{background:#F7F4F0;padding:0}
.sensol-shipping-domestic-section .sensol-shipping-domestic{max-width:1040px;margin:0 auto;padding:100px 2rem 0}
.sensol-shipping-domestic-section .sensol-shipping-domestic__divider{width:48px;height:1px;background:#D4CEC6;margin-bottom:48px}
.sensol-shipping-domestic-section .sensol-shipping-domestic__label{font-size:0.75rem;font-weight:600;letter-spacing:0.2em;text-transform:uppercase;color:#B5ADA4;margin-bottom:1rem}
.sensol-shipping-domestic-section .sensol-shipping-domestic__title{font-size:clamp(2rem,3vw,2.75rem);font-weight:300;letter-spacing:-0.01em;line-height:1.2;margin-bottom:32px;color:#1A1816}
.sensol-shipping-domestic-section .sensol-shipping-domestic__body{font-size:1.5rem;font-weight:400;color:#8A8279;line-height:1.75;margin-bottom:32px}
.sensol-shipping-domestic-section .sensol-shipping-domestic__body strong{color:#1A1816;font-weight:500}
.sensol-shipping-domestic-section .sensol-shipping-domestic__methods{display:grid;grid-template-columns:repeat(3,1fr);gap:1px;background:#D4CEC6}
.sensol-shipping-domestic-section .sensol-shipping-domestic__method{background:#F7F4F0;padding:40px 32px}
.sensol-shipping-domestic-section .sensol-shipping-domestic__method-icon{font-size:1.5rem;margin-bottom:1rem;opacity:0.5}
.sensol-shipping-domestic-section .sensol-shipping-domestic__method-name{font-size:1.125rem;font-weight:500;color:#1A1816;margin-bottom:0.5rem}
.sensol-shipping-domestic-section .sensol-shipping-domestic__method-coverage{font-size:0.9375rem;color:#8A8279;margin-bottom:0.75rem;line-height:1.5}
.sensol-shipping-domestic-section .sensol-shipping-domestic__method-detail{font-size:0.875rem;color:#8A8279;line-height:1.6}
@media(max-width:900px){.sensol-shipping-domestic-section .sensol-shipping-domestic__methods{grid-template-columns:1fr}}
@media(max-width:749px){.sensol-shipping-domestic-section .sensol-shipping-domestic{padding:64px 1.5rem 0}.sensol-shipping-domestic-section .sensol-shipping-domestic__title{font-size:1.75rem}.sensol-shipping-domestic-section .sensol-shipping-domestic__body{font-size:1.25rem}}
{%- endstyle -%}
