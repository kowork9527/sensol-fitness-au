{{ 'sensol-contact.css' | asset_url | stylesheet_tag }}

<div class="sensol-contact">
  <section class="sc-imprint">
    <h2 class="sc-imprint-h">{{ section.settings.heading }}</h2>
    <div class="sc-imprint-grid">
      {%- for block in section.blocks -%}
        <div class="col" {{ block.shopify_attributes }}>
          <div class="col-h">{{ block.settings.head }}</div>
          <div class="col-v">{{ block.settings.content | newline_to_br }}</div>
        </div>
      {%- endfor -%}
    </div>
    <div class="sc-imprint-foot">
      <span>{{ section.settings.foot_left }}</span>
      <span>{{ section.settings.foot_center }}</span>
      <span>{{ section.settings.foot_right }}</span>
    </div>
  </section>
</div>

{% schema %}
{
  "name": "Contact Imprint",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Legal, physical, postal." },
    { "type": "text", "id": "foot_left", "label": "Footer left", "default": "SENSOL PTY LTD" },
    { "type": "text", "id": "foot_center", "label": "Footer center", "default": "ABN 42 081 337 956" },
    { "type": "text", "id": "foot_right", "label": "Footer right", "default": "EST. MELBOURNE, 2021" }
  ],
  "blocks": [
    {
      "type": "column",
      "name": "Imprint column",
      "settings": [
        { "type": "text", "id": "head", "label": "Column heading", "default": "ENTITY" },
        { "type": "textarea", "id": "content", "label": "Column content (HTML allowed)", "default": "SENSOL Pty Ltd\nStudio 04, 35 Easey St\nCollingwood VIC 3066 AU" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Contact Imprint",
      "blocks": [
        { "type": "column", "settings": { "head": "ENTITY", "content": "SENSOL Pty Ltd\nStudio 04, 35 Easey St\nCollingwood VIC 3066 AU" } },
        { "type": "column", "settings": { "head": "POSTAL", "content": "Reply Paid 4210\nCollingwood VIC 3066\nAustralia" } },
        { "type": "column", "settings": { "head": "REGISTERED", "content": "ABN 42 081 337 956\nACN 081 337 956\n<a href=\"https://abr.business.gov.au/\">ABN lookup</a>" } },
        { "type": "column", "settings": { "head": "DIGITAL", "content": "<a href=\"mailto:support@sensolfitness.com.au\">support@sensolfitness.com.au</a>\n<a href=\"https://instagram.com/sensol\">@sensol</a>" } }
      ]
    }
  ]
}
{% endschema %}
