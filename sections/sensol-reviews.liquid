{%- style -%}
  .sensol-reviews {
    padding: 100px 24px;
    background: #F7F4F0;
    font-family: 'Inter', sans-serif;
  }

  .sensol-reviews__inner {
    max-width: 1600px;
    margin: 0 auto;
  }

  .sensol-reviews__header {
    margin-bottom: 60px;
    text-align: left;
  }

  .sensol-reviews__label {
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: #8A8279;
    margin-bottom: 16px;
  }

  .sensol-reviews__title {
    font-size: clamp(1.75rem, 4vw, 3rem);
    font-weight: 200;
    letter-spacing: 0.1em;
    color: #1A1816;
    line-height: 1.2;
  }

  .sensol-reviews__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 32px;
  }

  @media (max-width: 968px) {
    .sensol-reviews__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 640px) {
    .sensol-reviews {
      padding: 60px 20px;
    }
    .sensol-reviews__grid {
      grid-template-columns: 1fr;
      gap: 24px;
    }
  }

  .sensol-reviews__card {
    background: #FFFFFF;
    padding: 40px 32px;
    position: relative;
  }

  .sensol-reviews__stars {
    display: flex;
    gap: 4px;
    margin-bottom: 20px;
  }

  .sensol-reviews__star {
    width: 16px;
    height: 16px;
    color: #1A1816;
  }

  .sensol-reviews__text {
    font-size: 15px;
    font-weight: 300;
    line-height: 1.7;
    color: #1A1816;
    margin-bottom: 24px;
  }

  .sensol-reviews__author {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .sensol-reviews__avatar {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    object-fit: cover;
    background: #D4CEC6;
  }

  .sensol-reviews__author-info {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .sensol-reviews__name {
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 0.05em;
    color: #1A1816;
  }

  .sensol-reviews__role {
    font-size: 11px;
    font-weight: 400;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #8A8279;
  }

  .sensol-reviews__quote {
    position: absolute;
    top: 32px;
    right: 32px;
    width: 32px;
    height: 32px;
    color: #D4CEC6;
    opacity: 0.5;
  }
{%- endstyle -%}

{%- if section.settings.show_section -%}
<section class="sensol-reviews" id="sensol-reviews-{{ section.id }}">
  <div class="sensol-reviews__inner">
    {%- if section.settings.label != blank or section.settings.title != blank -%}
    <div class="sensol-reviews__header">
      {%- if section.settings.label != blank -%}
      <p class="sensol-reviews__label">{{ section.settings.label }}</p>
      {%- endif -%}
      {%- if section.settings.title != blank -%}
      <h2 class="sensol-reviews__title">{{ section.settings.title }}</h2>
      {%- endif -%}
    </div>
    {%- endif -%}

    <div class="sensol-reviews__grid">
      {%- for block in section.blocks -%}
        {%- if block.type == 'review' -%}
        <div class="sensol-reviews__card" {{ block.shopify_attributes }}>
          <svg class="sensol-reviews__quote" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
            <path d="M10 11H6C6 7.686 8.686 5 12 5V3C7.582 3 4 6.582 4 11V19H10V11ZM20 11H16C16 7.686 18.686 5 22 5V3C17.582 3 14 6.582 14 11V19H20V11Z"/>
          </svg>
          <div class="sensol-reviews__stars">
            {%- for i in (1..5) -%}
            <svg class="sensol-reviews__star" viewBox="0 0 20 20" fill="currentColor">
              <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
            </svg>
            {%- endfor -%}
          </div>
          <p class="sensol-reviews__text">{{ block.settings.text }}</p>
          <div class="sensol-reviews__author">
            {%- if block.settings.avatar != blank -%}
            <img class="sensol-reviews__avatar" src="{{ block.settings.avatar | image_url: width: 80 }}" alt="{{ block.settings.name }}" loading="lazy" width="80" height="80">
            {%- else -%}
            <div class="sensol-reviews__avatar"></div>
            {%- endif -%}
            <div class="sensol-reviews__author-info">
              <span class="sensol-reviews__name">{{ block.settings.name }}</span>
              {%- if block.settings.role != blank -%}
              <span class="sensol-reviews__role">{{ block.settings.role }}</span>
              {%- endif -%}
            </div>
          </div>
        </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</section>
{%- endif -%}

{% schema %}
{
  "name": "SENSOL Reviews",
  "tag": "section",
  "class": "sensol-reviews-section",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_section",
      "label": "Show section",
      "default": true
    },
    {
      "type": "text",
      "id": "label",
      "label": "Label",
      "default": "What they say"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Trained by design."
    }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        {
          "type": "textarea",
          "id": "text",
          "label": "Review text",
          "default": "The precision of this machine is unlike anything I've used before. It feels like it was designed specifically for how my body moves."
        },
        {
          "type": "text",
          "id": "name",
          "label": "Reviewer name",
          "default": "Sarah M."
        },
        {
          "type": "text",
          "id": "role",
          "label": "Role / Title",
          "default": "Pilates Instructor"
        },
        {
          "type": "image_picker",
          "id": "avatar",
          "label": "Avatar image"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "SENSOL Reviews",
      "blocks": [
        {
          "type": "review",
          "settings": {
            "text": "The precision of this machine is unlike anything I've used before. It feels like it was designed specifically for how my body moves.",
            "name": "Sarah M.",
            "role": "Pilates Instructor"
          }
        },
        {
          "type": "review",
          "settings": {
            "text": "I didn't expect a piece of fitness equipment to change my entire morning routine. The quiet operation means I can train before anyone wakes up.",
            "name": "James L.",
            "role": "Architect"
          }
        },
        {
          "type": "review",
          "settings": {
            "text": "Sensol lives in my living room like a piece of sculpture. Guests always ask about it — and then they try it.",
            "name": "Elena K.",
            "role": "Creative Director"
          }
        }
      ]
    }
  ]
}
{% endschema %}
