<section class="sensol-app-section" id="app">
  <div class="sensol-app">
    <div class="sensol-app__grid">
      <!-- Left: Phone Mockup (5 cols) — matching Next.js layout -->
      <div class="sensol-app__phone-col">
        {%- if section.settings.phone_image != blank -%}
          <div class="sensol-app__phone-image-wrap">
            <img 
              src="{{ section.settings.phone_image | image_url: width: 600 }}"
              alt="Sensol App"
              class="sensol-app__phone-image"
              loading="lazy"
              width="600"
              height="800"
            />
          </div>
        {%- else -%}
        <div class="sensol-app__phone-mockup">
          <!-- SVG Ring -->
          <svg class="sensol-app__ring-svg" viewBox="0 0 200 200" xmlns="http://www.w3.org/2000/svg">
            <circle cx="100" cy="100" r="90" fill="none" stroke="#D4CEC6" stroke-width="0.5"/>
            <circle cx="100" cy="100" r="90" fill="none" stroke="#1A1816" stroke-width="2" stroke-dasharray="565.48" stroke-dashoffset="197.92" stroke-linecap="round" transform="rotate(-90 100 100)"/>
          </svg>
          <!-- Phone Image -->
          <div class="sensol-app__phone-frame">
            <div class="sensol-app__phone-status">
              <span>9:41</span>
            </div>
            <div class="sensol-app__phone-content">
              <p class="sensol-app__phone-brand">Sensol</p>
              <div class="sensol-app__phone-stats">
                <div class="sensol-app__phone-stat">
                  <span class="sensol-app__phone-stat-value">65</span>
                  <span class="sensol-app__phone-stat-label">Resistance</span>
                </div>
              </div>
              <div class="sensol-app__phone-info">
                <p>Mode</p><span>Pilates</span>
                <p>Time</p><span>32:00</span>
                <p>Cal</p><span>186</span>
              </div>
              <div class="sensol-app__phone-start">Start Session</div>
            </div>
          </div>
        </div>
        {%- endif -%}
      </div>

      <!-- Right: Content (7 cols) -->
      <div class="sensol-app__content-col">
        <p class="sensol-app__label">Sensol App</p>
        <h2 class="sensol-app__title">{{ section.settings.title }}</h2>
        <p class="sensol-app__desc">{{ section.settings.description }}</p>

        <!-- 3 Feature Blocks -->
        <div class="sensol-app__features">
          <div class="sensol-app__feature">
            <p class="sensol-app__feature-name">{{ section.settings.feature1_name }}</p>
            <p class="sensol-app__feature-desc">{{ section.settings.feature1_desc }}</p>
          </div>
          <div class="sensol-app__feature">
            <p class="sensol-app__feature-name">{{ section.settings.feature2_name }}</p>
            <p class="sensol-app__feature-desc">{{ section.settings.feature2_desc }}</p>
          </div>
          <div class="sensol-app__feature">
            <p class="sensol-app__feature-name">{{ section.settings.feature3_name }}</p>
            <p class="sensol-app__feature-desc">{{ section.settings.feature3_desc }}</p>
          </div>
        </div>

        <!-- Store Buttons -->
        <div class="sensol-app__stores">
          <a href="{{ section.settings.appstore_link }}" class="sensol-app__store-btn">
            <span class="sensol-app__store-small">Download on the</span>
            <span class="sensol-app__store-big">App Store</span>
          </a>
          <a href="{{ section.settings.playstore_link }}" class="sensol-app__store-btn">
            <span class="sensol-app__store-small">Get it on</span>
            <span class="sensol-app__store-big">Google Play</span>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "SENSOL App Download",
  "tag": "section",
  "class": "sensol-app-section",
  "settings": [
    { "type": "image_picker", "id": "phone_image", "label": "App Screenshot Image" },
    { "type": "text", "id": "title", "label": "Title", "default": "Your intelligent training companion" },
    { "type": "textarea", "id": "description", "label": "Description", "default": "The Sensol App connects seamlessly to your reformer, providing real-time resistance control, guided workout programs, and performance tracking — all from your phone." },
    { "type": "text", "id": "feature1_name", "label": "Feature 1 Name", "default": "Real-time Resistance Control" },
    { "type": "text", "id": "feature1_desc", "label": "Feature 1 Description", "default": "Adjust resistance levels instantly during your session" },
    { "type": "text", "id": "feature2_name", "label": "Feature 2 Name", "default": "100+ Guided Workouts" },
    { "type": "text", "id": "feature2_desc", "label": "Feature 2 Description", "default": "Expert-led pilates and strength programs for every level" },
    { "type": "text", "id": "feature3_name", "label": "Feature 3 Name", "default": "Performance Analytics" },
    { "type": "text", "id": "feature3_desc", "label": "Feature 3 Description", "default": "Track your progress with detailed session insights" },
    { "type": "url", "id": "appstore_link", "label": "App Store Link", "default": "/" },
    { "type": "url", "id": "playstore_link", "label": "Google Play Link", "default": "/" }
  ],
  "presets": [{ "name": "SENSOL App Download" }]
}
{% endschema %}

{%- style -%}
/* ===== SENsol App Download — matching Next.js: dark background #1A1816 ===== */
.sensol-app-section {
  margin: 0;
  padding: 0;
  background: #1A1816;
  overflow: hidden;
}

.sensol-app {
  max-width: 1600px;
  margin: 0 auto;
  padding: 6rem 2rem;
  font-family: 'Inter', sans-serif;
}

@media (min-width: 768px) {
  .sensol-app {
    padding: 9rem 4rem;
  }
}

.sensol-app__grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: 4rem;
  align-items: center;
}

@media (min-width: 768px) {
  .sensol-app__grid {
    grid-template-columns: 1fr 1fr;
    gap: 5rem;
  }
}

/* Phone Mockup */
.sensol-app__phone-col {
  display: flex;
  justify-content: center;
}

/* Phone Image (when uploaded) */
.sensol-app__phone-image-wrap {
  width: 280px;
  max-width: 100%;
}

@media (min-width: 768px) {
  .sensol-app__phone-image-wrap {
    width: 340px;
  }
}

.sensol-app__phone-image {
  width: 100%;
  height: auto;
  border-radius: 20px;
  display: block;
}

.sensol-app__phone-mockup {
  position: relative;
  width: 280px;
}

@media (min-width: 768px) {
  .sensol-app__phone-mockup {
    width: 320px;
  }
}

.sensol-app__ring-svg {
  position: absolute;
  top: -30px;
  right: -30px;
  width: 200px;
  height: 200px;
  z-index: 0;
  animation: sensol-ring-spin 20s linear infinite;
}

@keyframes sensol-ring-spin {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

.sensol-app__phone-frame {
  position: relative;
  z-index: 1;
  width: 260px;
  background: #2a2724;
  border-radius: 40px;
  padding: 12px;
  margin: 0 auto;
  box-shadow: 0 25px 50px -12px rgba(0,0,0,0.5);
}

.sensol-app__phone-status {
  display: flex;
  align-items: center;
  justify-content: space-between;
  color: rgba(255,255,255,0.5);
  font-size: 11px;
  padding: 0.5rem 1.5rem 0.25rem;
  font-weight: 300;
}

.sensol-app__phone-content {
  background: #1A1816;
  padding: 1.25rem 1.25rem;
  border-radius: 0 0 28px 28px;
  aspect-ratio: 9/19.5;
  display: flex;
  flex-direction: column;
}

.sensol-app__phone-brand {
  font-size: 11px;
  font-weight: 300;
  letter-spacing: 0.15em;
  text-transform: uppercase;
  color: #F7F4F0;
  text-align: left;
  margin-bottom: 1.5rem;
}

/* Resistance Ring (SVG in liquid) */
.sensol-app__phone-stats {
  text-align: center;
  margin-bottom: 1.5rem;
  position: relative;
}

.sensol-app__phone-stat-value {
  display: block;
  font-size: 3rem;
  font-weight: 200;
  color: #F7F4F0;
  line-height: 1;
}

.sensol-app__phone-stat-label {
  display: block;
  font-size: 8px;
  letter-spacing: 0.2em;
  text-transform: uppercase;
  color: #8A8279;
  margin-top: 0.25rem;
}

.sensol-app__phone-info {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 0.5rem;
  margin-bottom: 1rem;
  text-align: center;
}

.sensol-app__phone-info p {
  margin: 0;
  font-size: 7px;
  letter-spacing: 0.15em;
  text-transform: uppercase;
  color: #8A8279;
  margin-bottom: 0.125rem;
}

.sensol-app__phone-info span {
  font-size: 11px;
  color: #F7F4F0;
  font-weight: 300;
}

.sensol-app__phone-start {
  text-align: center;
  background: #8A8279;
  color: #1A1816;
  font-size: 11px;
  letter-spacing: 0.2em;
  text-transform: uppercase;
  padding: 0.75rem;
  border-radius: 12px;
  font-weight: 500;
}

/* Content Column */
.sensol-app__content-col {
  padding-left: 0;
  text-align: left;
}

@media (min-width: 768px) {
  .sensol-app__content-col {
    padding-left: 2rem;
  }
}

.sensol-app__label {
  font-size: 11px;
  letter-spacing: 0.2em;
  text-transform: uppercase;
  color: #8A8279;
  margin-bottom: 1.5rem;
}

.sensol-app__title {
  font-size: clamp(1.875rem, 4vw, 2.5rem);
  font-weight: 200;
  letter-spacing: 0.08em;
  color: #F7F4F0;
  line-height: 1.2;
  margin-bottom: 1.5rem;
}

.sensol-app__desc {
  font-size: 15px;
  color: #8A8279;
  line-height: 1.8;
  font-weight: 300;
  margin-bottom: 2.5rem;
  max-width: 28rem;
  margin-left: 0;
  margin-right: 0;
}

@media (min-width: 768px) {
  .sensol-app__desc {
  }
}

/* Features — matching Next.js: left border decoration */
.sensol-app__features {
  display: flex;
  flex-direction: column;
  gap: 1.25rem;
  margin-bottom: 3rem;
}

.sensol-app__feature {
  display: flex;
  align-items: flex-start;
  gap: 1rem;
}

.sensol-app__feature-name {
  font-size: 12px;
  font-weight: 400;
  letter-spacing: 0.05em;
  color: #F7F4F0;
  margin-bottom: 0.25rem;
}

.sensol-app__feature-desc {
  font-size: 11px;
  color: rgba(138,130,121,0.7);
  line-height: 1.6;
  font-weight: 300;
}

/* Store Buttons — matching Next.js: border style */
.sensol-app__stores {
  display: flex;
  gap: 1rem;
  justify-content: flex-start;
}

@media (min-width: 768px) {
  .sensol-app__stores {
  }
}

.sensol-app__store-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border: 1px solid rgba(138,130,121,0.3);
  color: #F7F4F0;
  padding: 0.75rem 1.75rem;
  text-decoration: none;
  transition: all 0.5s;
  min-width: 140px;
}

.sensol-app__store-btn:hover {
  border-color: #F7F4F0;
  background: rgba(247,244,240,0.05);
}

.sensol-app__store-small {
  font-size: 11px;
  letter-spacing: 0.1em;
  color: #8A8279;
}

.sensol-app__store-big {
  font-size: 16px;
  font-weight: 500;
  letter-spacing: 0.05em;
}
{%- endstyle -%}
