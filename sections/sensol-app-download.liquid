{%- comment -%}
  Sensol App Page - Download Section (block-based)
  Each block = one app download card with replaceable QR images + store links.
  Theme asset fallbacks keep the live page working before any editor setup.
{%- endcomment -%}

<style>
  .sc-appdl { background: #0a0a0c; padding: 5.5rem 1.5rem 6.5rem; }
  .sc-appdl__inner { max-width: 1180px; margin: 0 auto; }
  .sc-appdl__head { text-align: center; margin-bottom: 3.2rem; }
  .sc-appdl__label {
    font-size: 0.76rem; letter-spacing: 0.2em; text-transform: uppercase;
    color: #8a8696; margin: 0 0 0.8rem;
  }
  .sc-appdl__title {
    font-size: clamp(1.9rem, 3.6vw, 2.9rem); font-weight: 600; line-height: 1.12;
    letter-spacing: -0.01em; color: #ffffff; margin: 0 0 0.9rem;
  }
  .sc-appdl__sub { font-size: 1rem; color: #a5a1b0; margin: 0 auto; max-width: 560px; line-height: 1.6; }

  .sc-appdl__cards {
    display: grid;
    grid-template-columns: repeat({% if section.settings.card_width == 'half' %}2{% else %}1{% endif %}, 1fr);
    gap: 1.4rem;
  }
  .sc-appdl__card {
    position: relative;
    background: #121216;
    border: 1px solid #2a2a31;
    border-radius: 22px;
    padding: 2.4rem 2.2rem 2.2rem;
    overflow: hidden;
  }
  .sc-appdl__card::before {
    content: '';
    position: absolute; top: 0; left: 0; right: 0; height: 1px;
    background: linear-gradient(90deg, transparent, rgba(184,166,211,0.45), transparent);
  }
  .sc-appdl__badge {
    display: inline-block;
    font-size: 0.68rem; letter-spacing: 0.14em; text-transform: uppercase;
    color: #b8a6d3; border: 1px solid #3a3646; border-radius: 999px;
    padding: 0.34rem 0.85rem; margin-bottom: 1.05rem;
  }
  .sc-appdl__app-name {
    font-size: 1.55rem; font-weight: 600; color: #ffffff; margin: 0 0 0.4rem;
  }
  .sc-appdl__models {
    font-size: 0.82rem; letter-spacing: 0.06em; text-transform: uppercase;
    color: #8a8696; margin: 0 0 0.9rem;
  }
  .sc-appdl__desc { font-size: 0.92rem; line-height: 1.65; color: #a5a1b0; margin: 0 0 1.9rem; }

  .sc-appdl__qr-row { display: flex; gap: 1.2rem; }
  .sc-appdl__qr {
    flex: 1 1 0;
    background: #ffffff;
    border-radius: 16px;
    padding: 0.9rem;
    text-decoration: none;
    text-align: center;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }
  .sc-appdl__qr:hover { transform: translateY(-2px); box-shadow: 0 10px 28px rgba(0,0,0,0.4); }
  .sc-appdl__qr img {
    display: block; width: 100%; aspect-ratio: 1; object-fit: contain;
    border-radius: 8px; background: #fff;
  }
  .sc-appdl__qr-name {
    display: block; margin-top: 0.6rem;
    font-size: 0.74rem; font-weight: 600; letter-spacing: 0.04em;
    text-transform: uppercase; color: #16161a;
  }
  .sc-appdl__qr-sub { display: block; font-size: 0.62rem; color: #6f6c78; margin-top: 0.12rem; }

  .sc-appdl__note {
    margin-top: 2.6rem; text-align: center;
    font-size: 0.78rem; color: #6f6c78; line-height: 1.7;
  }
  .sc-appdl__note a { color: #b8a6d3; text-decoration: none; border-bottom: 1px solid rgba(184,166,211,0.4); }

  @media (max-width: 640px) {
    .sc-appdl { padding: 3.5rem 1.25rem 4.5rem; }
    .sc-appdl__cards { grid-template-columns: 1fr; }
    .sc-appdl__card { padding: 1.9rem 1.5rem 1.7rem; }
    .sc-appdl__qr-row { flex-direction: column; }
  }
</style>

<section class="sc-appdl">
  <div class="sc-appdl__inner">
    <div class="sc-appdl__head">
      {%- if section.settings.eyebrow != blank -%}
        <p class="sc-appdl__label">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      <h2 class="sc-appdl__title">{{ section.settings.title | escape }}</h2>
      {%- if section.settings.subtitle != blank -%}
        <p class="sc-appdl__sub">{{ section.settings.subtitle | escape }}</p>
      {%- endif -%}
    </div>

    <div class="sc-appdl__cards">
      {%- for block in section.blocks -%}
        <div class="sc-appdl__card" {{ block.shopify_attributes }}>
          {%- if block.settings.badge != blank -%}
            <span class="sc-appdl__badge">{{ block.settings.badge | escape }}</span>
          {%- endif -%}
          <h3 class="sc-appdl__app-name">{{ block.settings.app_name | escape }}</h3>
          {%- if block.settings.models != blank -%}
            <p class="sc-appdl__models">{{ block.settings.models | escape }}</p>
          {%- endif -%}
          {%- if block.settings.description != blank -%}
            <p class="sc-appdl__desc">{{ block.settings.description | escape }}</p>
          {%- endif -%}

          <div class="sc-appdl__qr-row">
            {%- liquid
              if block.settings.qr_fallback == 'flex'
                assign fb_ios = 'SENSOL_FLEX_iOS.png'
                assign fb_android = 'SENSOL_FLEX_Android.png'
              else
                assign fb_ios = 'SENSOL_iOS.png'
                assign fb_android = 'SENSOL_Android.png'
              endif
            -%}
            {%- comment -%} --- iOS --- {%- endcomment -%}
            {%- if block.settings.ios_link != blank or block.settings.ios_qr != blank -%}
              <a class="sc-appdl__qr" href="{{ block.settings.ios_link | default: '#' }}">
                {%- if block.settings.ios_qr != blank -%}
                  {{ block.settings.ios_qr | image_url: width: 400 | image_tag: loading: 'lazy', widths: '150,300,400', alt: block.settings.app_name }}
                {%- else -%}
                  <img src="{{ fb_ios | asset_url }}" alt="{{ block.settings.app_name | escape }} iOS QR" loading="lazy" width="150" height="150">
                {%- endif -%}
                <span class="sc-appdl__qr-name">iOS &middot; App Store</span>
                <span class="sc-appdl__qr-sub">{% if block.settings.ios_hint != blank %}{{ block.settings.ios_hint | escape }}{% else %}Scan to download{% endif %}</span>
              </a>
            {%- endif -%}

            {%- comment -%} --- Android --- {%- endcomment -%}
            {%- if block.settings.android_link != blank or block.settings.android_qr != blank -%}
              <a class="sc-appdl__qr" href="{{ block.settings.android_link | default: '#' }}">
                {%- if block.settings.android_qr != blank -%}
                  {{ block.settings.android_qr | image_url: width: 400 | image_tag: loading: 'lazy', widths: '150,300,400', alt: block.settings.app_name }}
                {%- else -%}
                  <img src="{{ fb_android | asset_url }}" alt="{{ block.settings.app_name | escape }} Android QR" loading="lazy" width="150" height="150">
                {%- endif -%}
                <span class="sc-appdl__qr-name">Android &middot; Google Play</span>
                <span class="sc-appdl__qr-sub">{% if block.settings.android_hint != blank %}{{ block.settings.android_hint | escape }}{% else %}Scan to download{% endif %}</span>
              </a>
            {%- endif -%}
          </div>
        </div>
      {%- endfor -%}
    </div>

    {%- if section.settings.note != blank -%}
      <p class="sc-appdl__note">{{ section.settings.note }}</p>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "App Download",
  "tag": "section",
  "max_blocks": 4,
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow label",
      "default": "Get the app"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Two apps. One system."
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Pick the app that matches your reformer and start training today."
    },
    {
      "type": "select",
      "id": "card_width",
      "label": "Card width",
      "options": [
        { "value": "half", "label": "Half (two cards per row)" },
        { "value": "full", "label": "Full (one card per row)" }
      ],
      "default": "half"
    },
    {
      "type": "richtext",
      "id": "note",
      "label": "Footnote",
      "default": "<p>Free to download. Full course library requires a SENSOL reformer with Bluetooth connection.</p>"
    }
  ],
  "blocks": [
    {
      "type": "app",
      "name": "App card",
      "settings": [
        {
          "type": "text",
          "id": "badge",
          "label": "Badge label",
          "default": "App"
        },
        {
          "type": "text",
          "id": "app_name",
          "label": "App name",
          "default": "SENSOL App"
        },
        {
          "type": "text",
          "id": "models",
          "label": "Compatible models",
          "default": "Smart Series"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description"
        },
        {
          "type": "select",
          "id": "qr_fallback",
          "label": "Default QR set (when no image is uploaded)",
          "options": [
            { "value": "smart", "label": "SENSOL App (Smart Series)" },
            { "value": "flex", "label": "SENSOL FLEX App" }
          ],
          "default": "smart"
        },
        {
          "type": "image_picker",
          "id": "ios_qr",
          "label": "iOS QR image",
          "info": "Leave empty to use the default SENSOL iOS QR from theme assets."
        },
        {
          "type": "url",
          "id": "ios_link",
          "label": "iOS App Store link"
        },
        {
          "type": "text",
          "id": "ios_hint",
          "label": "iOS hint text"
        },
        {
          "type": "image_picker",
          "id": "android_qr",
          "label": "Android QR image",
          "info": "Leave empty to use the default SENSOL Android QR from theme assets."
        },
        {
          "type": "url",
          "id": "android_link",
          "label": "Android Google Play link"
        },
        {
          "type": "text",
          "id": "android_hint",
          "label": "Android hint text"
        }
      ]
    }
  ],
  "default": {
    "settings": {
      "eyebrow": "Two apps. One system.",
      "title": "Get the app",
      "subtitle": "Scan the QR code with your phone camera to download. Free with your SENSOL reformer."
    },
    "blocks": [
      {
        "type": "app",
        "settings": {
          "badge": "Smart Series",
          "app_name": "SENSOL App",
          "models": "RS02 &middot; RS02 PRO &middot; RS03 PRO",
          "description": "Digital resistance training platform for RS02, RS02 PRO and RS03 PRO. 0.5&ndash;32 kg digital resistance, real-time training, structured programs.",
          "qr_fallback": "smart",
          "ios_hint": "Scan for App Store",
          "android_hint": "Scan for Google Play",
          "ios_link": "https://apps.apple.com/app/id6747697213",
          "android_link": "https://play.google.com/store/apps/details?id=com.xfq.sensol.vesta"
        }
      },
      {
        "type": "app",
        "settings": {
          "badge": "FLEX Series",
          "app_name": "SENSOL FLEX App",
          "models": "FLEX &middot; FLEX AIR &middot; FLEX PRO",
          "description": "Two-resistance spring training platform for FLEX, FLEX AIR and FLEX PRO. Guided classes, progress tracking, fold-and-store friendly.",
          "qr_fallback": "flex",
          "ios_hint": "Scan for App Store",
          "android_hint": "Scan for Google Play",
          "ios_link": "https://apps.apple.com/app/id6784491021",
          "android_link": "https://play.google.com/store/apps/details?id=com.xfq.sensol.flex"
        }
      }
    ]
  }
}
{% endschema %}
