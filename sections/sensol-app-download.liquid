{{ 'sensol-app-download.css' | asset_url | stylesheet_tag }}

<section class="sensol-app">
  <div class="sensol-app__inner">
    <!-- Left — Phone Mockup -->
    <div class="sensol-app__phone">
      {%- if section.settings.phone_image != blank -%}
      <img src="{{ section.settings.phone_image | image_url: width: 600 }}" alt="Sensol App" class="sensol-app__phone-img" loading="lazy">
      {%- else -%}
      <div class="sensol-app__phone-mockup">
        <div class="sensol-app__screen">
          <!-- Status Bar -->
          <div class="sensol-app__status">
            <span class="sensol-app__status-time">9:41</span>
            <div class="sensol-app__status-notch"></div>
            <div class="sensol-app__status-icons">
              <div class="sensol-app__status-signal"></div>
              <div class="sensol-app__status-dot"></div>
            </div>
          </div>
          <!-- App Header -->
          <div class="sensol-app__app-header">
            <span class="sensol-app__app-name">Sensol</span>
            <div class="sensol-app__app-icons">
              <div class="sensol-app__app-icon-circle"></div>
              <div class="sensol-app__app-icon-circle"></div>
            </div>
          </div>
          <!-- Resistance Ring -->
          <div class="sensol-app__ring-wrap">
            <svg class="sensol-app__ring-svg" viewBox="0 0 160 160">
              <circle cx="80" cy="80" r="70" fill="none" stroke="#2a2724" stroke-width="6"/>
              <circle cx="80" cy="80" r="70" fill="none" stroke="#8A8279" stroke-width="6" stroke-linecap="round" stroke-dasharray="330 440"/>
            </svg>
            <div class="sensol-app__ring-center">
              <span class="sensol-app__ring-value">65</span>
              <span class="sensol-app__ring-label">Resistance</span>
            </div>
          </div>
          <!-- Quick Controls -->
          <div class="sensol-app__controls">
            <div class="sensol-app__control">
              <p class="sensol-app__control-label">Mode</p>
              <p class="sensol-app__control-value">Pilates</p>
            </div>
            <div class="sensol-app__control">
              <p class="sensol-app__control-label">Time</p>
              <p class="sensol-app__control-value">32:00</p>
            </div>
            <div class="sensol-app__control">
              <p class="sensol-app__control-label">Cal</p>
              <p class="sensol-app__control-value">186</p>
            </div>
          </div>
          <!-- Session Button -->
          <div class="sensol-app__start-btn">Start Session</div>
        </div>
      </div>
      {%- endif -%}
    </div>

    <!-- Right — Content -->
    <div class="sensol-app__content">
      <p class="sensol-app__label">{{ section.settings.label | default: 'Sensol App' }}</p>
      <h2 class="sensol-app__heading">{{ section.settings.heading | default: 'Your intelligent<br>training companion' }}</h2>
      <p class="sensol-app__description">{{ section.settings.description | default: 'The Sensol App connects seamlessly to your reformer, providing real-time resistance control, guided workout programs, and performance tracking — all from your phone.' }}</p>

      <div class="sensol-app__features">
        {%- for block in section.blocks -%}
        <div class="sensol-app__feature" {{ block.shopify_attributes }}>
          <div class="sensol-app__feature-line"></div>
          <div>
            <p class="sensol-app__feature-title">{{ block.settings.title }}</p>
            <p class="sensol-app__feature-desc">{{ block.settings.description }}</p>
          </div>
        </div>
        {%- endfor -%}
      </div>

      <div class="sensol-app__buttons">
        {%- if section.settings.ios_link != blank -%}
        <a href="{{ section.settings.ios_link }}" class="sensol-app__store-btn">
          <span class="sensol-app__store-small">Download on the</span>
          <span class="sensol-app__store-big">App Store</span>
        </a>
        {%- endif -%}
        {%- if section.settings.android_link != blank -%}
        <a href="{{ section.settings.android_link }}" class="sensol-app__store-btn">
          <span class="sensol-app__store-small">Get it on</span>
          <span class="sensol-app__store-big">Google Play</span>
        </a>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "SENSOL App Download",
  "tag": "section",
  "class": "sensol-app-section",
  "settings": [
    {"type":"text","id":"label","label":"Section Label","default":"Sensol App"},
    {"type":"text","id":"heading","label":"Heading","default":"Your intelligent<br>training companion"},
    {"type":"textarea","id":"description","label":"Description","default":"The Sensol App connects seamlessly to your reformer, providing real-time resistance control, guided workout programs, and performance tracking — all from your phone."},
    {"type":"image_picker","id":"phone_image","label":"Phone Image (overrides mockup)"},
    {"type":"url","id":"ios_link","label":"iOS App Store Link"},
    {"type":"url","id":"android_link","label":"Google Play Link"}
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "App Feature",
      "settings": [
        {"type":"text","id":"title","label":"Title","default":"Real-time Resistance Control"},
        {"type":"text","id":"description","label":"Description","default":"Adjust resistance levels instantly during your session"}
      ]
    }
  ],
  "presets":[{"name":"SENSOL App Download","blocks":[{"type":"feature","settings":{"title":"Real-time Resistance Control","description":"Adjust resistance levels instantly during your session"}},{"type":"feature","settings":{"title":"100+ Guided Workouts","description":"Expert-led pilates and strength programs for every level"}},{"type":"feature","settings":{"title":"Performance Analytics","description":"Track your progress with detailed session insights"}}]}]
}
{% endschema %}
