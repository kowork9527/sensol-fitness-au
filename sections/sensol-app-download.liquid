<section class="sensol-app" style="background-color: {{ section.settings.bg_color }}; color: {{ section.settings.text_color }};">
  <div class="sensol-app__inner">
    <div class="sensol-app__phone">
      {%- if section.settings.phone_image != blank -%}
        {{ section.settings.phone_image | image_url: width: 600 | image_tag: loading: 'lazy', class: 'sensol-app__phone-img' }}
      {%- else -%}
        <div class="sensol-app__phone-mockup">
          <div class="sensol-app__screen">
            <div class="sensol-app__screen-ring"></div>
            <p class="sensol-app__screen-mode">TRAINING MODE</p>
            <div class="sensol-app__screen-stats">
              <span>12:30</span>
              <span>128 cal</span>
            </div>
            <div class="sensol-app__screen-btn">START</div>
          </div>
        </div>
      {%- endif -%}
    </div>

    <div class="sensol-app__content">
      {%- if section.settings.label != blank -%}
        <p class="sensol-app__label">{{ section.settings.label }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="sensol-app__heading">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.description != blank -%}
        <p class="sensol-app__description">{{ section.settings.description }}</p>
      {%- endif -%}

      <ul class="sensol-app__features">
        {%- if section.settings.feature_1 != blank -%}
          <li class="sensol-app__feature">{{ section.settings.feature_1 }}</li>
        {%- endif -%}
        {%- if section.settings.feature_2 != blank -%}
          <li class="sensol-app__feature">{{ section.settings.feature_2 }}</li>
        {%- endif -%}
        {%- if section.settings.feature_3 != blank -%}
          <li class="sensol-app__feature">{{ section.settings.feature_3 }}</li>
        {%- endif -%}
        {%- if section.settings.feature_4 != blank -%}
          <li class="sensol-app__feature">{{ section.settings.feature_4 }}</li>
        {%- endif -%}
      </ul>

      <div class="sensol-app__buttons">
        {%- if section.settings.ios_link != blank -%}
          <a href="{{ section.settings.ios_link }}" class="sensol-app__store-btn">
            <span class="sensol-app__store-small">Download on the</span>
            <span class="sensol-app__store-big">App Store</span>
          </a>
        {%- endif -%}
        {%- if section.settings.android_link != blank -%}
          <a href="{{ section.settings.android_link }}" class="sensol-app__store-btn">
            <span class="sensol-app__store-small">Get it on</span>
            <span class="sensol-app__store-big">Google Play</span>
          </a>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

<style>
  .sensol-app {
    padding: 120px 60px;
  }
  .sensol-app__inner {
    max-width: 1400px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 80px;
    align-items: center;
  }
  .sensol-app__phone {
    display: flex;
    justify-content: center;
  }
  .sensol-app__phone-img {
    max-width: 300px;
    height: auto;
  }
  .sensol-app__phone-mockup {
    width: 280px;
    height: 560px;
    background: #0a0a0a;
    border-radius: 40px;
    padding: 12px;
    position: relative;
  }
  .sensol-app__screen {
    width: 100%;
    height: 100%;
    background: #111;
    border-radius: 30px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 20px;
    padding: 40px 20px;
  }
  .sensol-app__screen-ring {
    width: 120px;
    height: 120px;
    border: 3px solid #8A8279;
    border-radius: 50%;
    border-top-color: #F7F4F0;
    position: relative;
  }
  .sensol-app__screen-mode {
    font-family: 'Inter', sans-serif;
    font-size: 11px;
    letter-spacing: 0.15em;
    color: #8A8279;
    text-transform: uppercase;
  }
  .sensol-app__screen-stats {
    display: flex;
    gap: 24px;
    font-family: 'Inter', sans-serif;
    font-size: 12px;
    color: #8A8279;
  }
  .sensol-app__screen-btn {
    padding: 10px 40px;
    background: #F7F4F0;
    color: #1A1816;
    font-family: 'Inter', sans-serif;
    font-size: 11px;
    letter-spacing: 0.15em;
    border-radius: 20px;
  }
  .sensol-app__label {
    font-family: 'Inter', sans-serif;
    font-size: 12px;
    font-weight: 300;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: #8A8279;
    margin-bottom: 16px;
  }
  .sensol-app__heading {
    font-family: 'Inter', sans-serif;
    font-size: clamp(28px, 4vw, 42px);
    font-weight: 300;
    letter-spacing: 0.08em;
    margin-bottom: 24px;
  }
  .sensol-app__description {
    font-family: 'Inter', sans-serif;
    font-size: 16px;
    font-weight: 300;
    line-height: 1.8;
    color: #8A8279;
    margin-bottom: 32px;
  }
  .sensol-app__features {
    list-style: none;
    padding: 0;
    margin: 0 0 40px;
  }
  .sensol-app__feature {
    font-family: 'Inter', sans-serif;
    font-size: 14px;
    font-weight: 300;
    padding: 10px 0;
    border-bottom: 1px solid #2a2826;
    color: #B5ADA4;
  }
  .sensol-app__feature::before {
    content: '+';
    margin-right: 12px;
    color: #8A8279;
  }
  .sensol-app__buttons {
    display: flex;
    gap: 16px;
  }
  .sensol-app__store-btn {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 12px 28px;
    border: 1px solid #B5ADA4;
    border-radius: 8px;
    text-decoration: none;
    color: #F7F4F0;
    transition: background 0.3s ease;
  }
  .sensol-app__store-btn:hover {
    background: rgba(181, 173, 164, 0.1);
  }
  .sensol-app__store-small {
    font-family: 'Inter', sans-serif;
    font-size: 10px;
    letter-spacing: 0.05em;
  }
  .sensol-app__store-big {
    font-family: 'Inter', sans-serif;
    font-size: 16px;
    font-weight: 500;
    letter-spacing: 0.02em;
  }

  @media (max-width: 768px) {
    .sensol-app {
      padding: 80px 24px;
    }
    .sensol-app__inner {
      grid-template-columns: 1fr;
      gap: 48px;
    }
    .sensol-app__phone-mockup {
      width: 220px;
      height: 440px;
    }
  }
</style>

{% schema %}
{
  "name": "SENSOL App Download",
  "tag": "section",
  "class": "sensol-app-section",
  "settings": [
    {
      "type": "image_picker",
      "id": "phone_image",
      "label": "Phone Mockup Image (optional, replaces built-in mockup)"
    },
    {
      "type": "text",
      "id": "label",
      "label": "Label",
      "default": "SENSOL APP"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Your training companion"
    },
    {
      "type": "text",
      "id": "description",
      "label": "Description",
      "default": "Track your progress, access guided workouts, and control your Sensol machine — all from one app. Available on iOS and Android."
    },
    {
      "type": "text",
      "id": "feature_1",
      "label": "Feature 1",
      "default": "Real-time resistance control"
    },
    {
      "type": "text",
      "id": "feature_2",
      "label": "Feature 2",
      "default": "100+ guided workouts"
    },
    {
      "type": "text",
      "id": "feature_3",
      "label": "Feature 3",
      "default": "Progress tracking"
    },
    {
      "type": "text",
      "id": "feature_4",
      "label": "Feature 4",
      "default": "Personalized training plans"
    },
    {
      "type": "url",
      "id": "ios_link",
      "label": "App Store Link"
    },
    {
      "type": "url",
      "id": "android_link",
      "label": "Google Play Link"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#1A1816"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#F7F4F0"
    }
  ],
  "presets": [
    {
      "name": "SENSOL App Download"
    }
  ]
}
{% endschema %}
