{% assign flex_product = section.settings.product %}
{% if flex_product == blank %}{% assign flex_product = all_products['sensol-flex-air'] %}{% endif %}
{% assign flex_url = flex_product.url | default: '/products/sensol-flex-air' %}
<section id="air-hd-{{ section.id }}" class="air-hd">
<div class="hd-scroll"><div class="hd-scene">
<img class="hd-poster" src="{{ 'air-full-000.webp' | asset_url }}" width="1920" height="1080" alt="A woman preparing her beige FLEX AIR Pilates reformer in a bright studio" fetchpriority="high">
<canvas aria-label="FLEX AIR Pilates practice, controlled by scrolling" role="img"></canvas>
<div class="hd-title"><p>SENSOL FLEX AIR / NON-ELECTRIC REFORMER</p><h1>{{ section.settings.heading | escape }}</h1><span>{{ section.settings.description | escape }}</span></div>
<div class="hd-copy"><span class="hd-count">01 / 05</span><h2>Meet FLEX AIR.</h2><p>A foldable, spring-resistance Pilates reformer. A sliding platform, support handles and resistance attachments — in one non-electric machine.</p></div>
<div class="hd-bar"><span class="hd-hint" role="status">Preparing the movement…</span><nav aria-label="FLEX AIR features"><button data-chapter="0" aria-current="step">Equipment</button><button data-chapter="1">Rail</button><button data-chapter="2">Resistance</button><button data-chapter="3">Support</button><button data-chapter="4">Versatility</button></nav><div class="hd-track"><i></i></div></div>
</div></div>
{% render 'sensol-air-story', section: section %}
{% render 'sensol-air-explorer', flex_product: flex_product, section: section %}
{% render 'sensol-air-colours', flex_product: flex_product, section: section %}
<div id="flex-air-purchase" class="motion-purchase-anchor" tabindex="-1"></div>
{% if request.page_type == 'product' %}<a class="motion-floating-cta" href="{{ routes.cart_url }}" aria-haspopup="dialog"><span class="motion-cta-product"><small>SENSOL</small><b>FLEX AIR</b></span><span class="motion-cta-divider" aria-hidden="true"></span><strong>ADD TO CART</strong><svg class="motion-cta-icon" width="34" height="34" viewBox="0 0 34 34" aria-hidden="true"><circle cx="17" cy="17" r="17" fill="currentColor"/><path d="M11 12h12l1 12H10l1-12Zm3 0V9a3 3 0 0 1 6 0v3" fill="none" stroke="#192019" stroke-width="1.5" stroke-linejoin="round"/></svg></a>{% endif %}
<script type="application/json" class="hd-urls">[{% for i in (0..486) %}{% capture number %}00{{ i }}{% endcapture %}{% assign number = number | slice: -3, 3 %}{% capture filename %}air-full-{{ number }}.webp{% endcapture %}{{ filename | asset_url | json }}{% unless forloop.last %},{% endunless %}{% endfor %}]</script>
</section>
<style>
.air-hd{background:#deddd7;color:#232922;--motion-accent:#81664b}.hd-scroll{height:650vh}.hd-scene{position:sticky;top:0;height:100svh;overflow:hidden;isolation:isolate}.hd-poster,.hd-scene canvas{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}.hd-scene canvas{z-index:1}.hd-title{position:absolute;z-index:2;top:17%;left:55%;right:5%;max-width:600px;pointer-events:none}.hd-title>p,.hd-count,.hd-ending>p:first-child{font-size:11px;letter-spacing:.2em;text-transform:uppercase}.hd-title h1{font-size:clamp(48px,6vw,94px);line-height:.98;letter-spacing:-.065em;margin:24px 0;max-width:600px}.hd-title>span{display:block;font-size:15px;line-height:1.7;max-width:320px}.hd-copy{position:absolute;z-index:2;left:var(--copy-x,62%);top:var(--copy-y,64%);width:32%;max-width:410px;background:transparent;padding:0;border:0;transition:left .75s cubic-bezier(.22,1,.36,1),top .75s cubic-bezier(.22,1,.36,1),color .5s;pointer-events:none;color:var(--copy-color,#232922);text-shadow:var(--copy-shadow,0 1px 16px rgba(255,255,255,.28))}.hd-copy h2{font-size:clamp(30px,3.8vw,55px);line-height:1.02;letter-spacing:-.045em;margin:18px 0;color:inherit}.hd-copy p{font-size:14px;line-height:1.7;margin:0;max-width:290px}.hd-count{color:inherit;opacity:.8}.hd-bar{position:absolute;z-index:3;bottom:0;left:0;right:0;padding:24px 160px 30px 5%;display:flex;align-items:center;justify-content:space-between;gap:20px;color:#232922;background:transparent}.hd-hint{font-size:11px;letter-spacing:.08em;text-shadow:0 1px 12px #fff}.hd-bar nav{display:flex;gap:20px}.hd-bar button{background:none;border:0;border-bottom:1px solid transparent;padding:8px 0;font:inherit;font-size:11px;text-transform:uppercase;letter-spacing:.08em;color:inherit;cursor:pointer;text-shadow:0 1px 10px #fff}.hd-bar button[aria-current]{border-color:currentColor}.hd-bar button:focus-visible{outline:2px solid #81664b;outline-offset:3px}.hd-track{height:1px;position:absolute;left:5%;right:160px;bottom:20px;background:rgba(35,41,34,.18)}.hd-track i{display:block;width:0;height:100%;background:#81664b}.hd-ending{background:#232922;color:#f6f3eb;padding:110px 8%}.hd-ending h2{color:inherit;font-size:clamp(38px,6vw,84px);letter-spacing:-.055em;line-height:1.02;margin:28px 0}.hd-ending>p{max-width:480px;line-height:1.8}.hd-ending a{display:inline-block;border-bottom:1px solid #d5bb94;color:#f6f3eb;padding:14px 0;text-decoration:none;margin:24px 30px 0 0}.hd-ending>span{font-size:14px;color:#d5bb94}
body:has(.air-hd) .header-wrapper{background:#deddd7}body:has(.air-hd) .header{padding-top:14px;padding-bottom:14px}body:has(.air-hd) .header__heading-logo{width:100px}body:has(.air-hd) .header__menu-item{text-transform:uppercase;font-size:11px;letter-spacing:.1em}
@media(max-width:749px){.hd-scroll{height:500vh}.hd-title{top:8%;left:7%;right:7%;max-width:330px}.hd-title h1{font-size:48px}.hd-title>span{font-size:13px;max-width:270px}.hd-copy{left:7%!important;top:66%!important;width:86%;max-width:none;transition:transform .65s,color .5s;transform:translateX(var(--mobile-shift,0));text-align:var(--mobile-align,left)}.hd-copy h2{font-size:32px;max-width:330px;margin:12px 0}.hd-copy p{font-size:12px;max-width:280px;display:inline-block}.air-hd[data-current="1"] .hd-copy,.air-hd[data-current="4"] .hd-copy{left:auto!important;right:7%;text-align:right}.air-hd[data-current="1"] .hd-copy h2,.air-hd[data-current="4"] .hd-copy h2{margin-left:auto}.hd-bar{display:block;padding:12px 7% 82px}.hd-bar nav{justify-content:space-between;gap:5px}.hd-bar button{font-size:9px;letter-spacing:.03em}.hd-hint{display:block;margin-bottom:6px}.hd-track{left:7%;right:7%;bottom:72px}.hd-ending{padding:75px 7%}.hd-poster{object-fit:contain}.hd-count{font-size:9px}}
