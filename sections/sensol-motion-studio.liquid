body:has(.air-hd) .section-header{position:fixed!important;top:0;width:100%;z-index:30}body:has(.air-hd) .header-wrapper{background:transparent!important}body:has(.air-hd) .header{mix-blend-mode:difference}body:has(.air-hd) .header__heading-logo{filter:brightness(0) invert(1)}body:has(.air-hd) .header__menu-item,body:has(.air-hd) .header__icon{color:#fff}body:has(.air-hd) .header details[open] .header__submenu{background:#deddd7}body:has(.air-hd) .header details[open] .header__submenu .header__menu-item{color:#232922}
.hd-copy{transition:opacity .14s linear}.motion-floating-cta{position:fixed;z-index:25;bottom:24px;left:50%;transform:translateX(-50%);display:flex;align-items:center;gap:22px;padding:17px 25px;background:#232922;color:#f6f3eb;border-radius:100px;text-decoration:none;box-shadow:0 8px 30px rgba(0,0,0,.15);white-space:nowrap;font-size:12px}.motion-floating-cta span{font-size:10px;letter-spacing:.12em;color:#d5bb94}.motion-floating-cta:focus-visible{outline:2px solid #81664b;outline-offset:4px}.motion-purchase-anchor{scroll-margin-top:100px}.motion-details{background:#f4f1e9;color:#232922;padding:100px 7%}.motion-dimensions{display:grid;grid-template-columns:.9fr 1.1fr;gap:7%;align-items:center}.motion-eyebrow{font-size:10px;letter-spacing:.2em}.motion-details h2{font-size:clamp(36px,5vw,68px);line-height:1.04;letter-spacing:-.05em;margin:28px 0}.motion-intro{font-size:15px}.motion-details dl{margin-top:42px}.motion-details dl div{padding:17px 0;border-bottom:1px solid #d2cec4}.motion-details dt{font-size:11px;letter-spacing:.06em;margin-bottom:7px}.motion-details dd{margin:0;font-size:25px;letter-spacing:-.02em}.motion-details dd small{font-size:14px}.motion-details figure{margin:0}.motion-details figure img{width:100%;height:auto;display:block;mix-blend-mode:multiply}.motion-details figcaption{font-size:10px;letter-spacing:.12em;margin-top:16px}.motion-materials{padding-top:110px}.motion-material-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:25px;margin-top:45px}.motion-material-grid article{border-top:1px solid #81664b;padding-top:22px}.motion-material-grid article>span{font-size:9px;letter-spacing:.12em}.motion-material-grid h3{font-size:24px;line-height:1.15;margin:24px 0 16px}.motion-material-grid p{font-size:13px;line-height:1.8}
@media(max-width:749px){.hd-copy{transition:opacity .14s linear;top:61%!important;transform:none}.hd-copy h2{font-size:34px}.hd-bar nav{display:none}.hd-bar{padding-bottom:154px}.hd-track{bottom:146px}.motion-floating-cta{bottom:90px;padding:15px 20px;gap:15px;font-size:11px}.motion-details{padding:65px 7%}.motion-dimensions{grid-template-columns:1fr;gap:45px}.motion-materials{padding-top:65px}.motion-material-grid{grid-template-columns:1fr 1fr;gap:30px 20px}.motion-material-grid h3{font-size:22px}.motion-material-grid p{font-size:12px}}
body:has(.air-hd) .section-header{mix-blend-mode:difference}body:has(.air-hd) .header{mix-blend-mode:normal}body:has(.section-header details[open]) .section-header{mix-blend-mode:normal}body:has(.section-header details[open]) .header__heading-logo{filter:none}body:has(.section-header details[open]) .header__menu-item,body:has(.section-header details[open]) .header__icon{color:#232922}.hd-bar{bottom:84px}
@media(max-width:749px){.hd-bar{bottom:0}}
.hd-copy{mix-blend-mode:difference;color:#fff!important;text-shadow:none!important}
@media(max-width:749px){.hd-title{left:43%;right:6%;top:14%}.hd-title h1{font-size:34px;line-height:1.04}.hd-title>p{font-size:8px;letter-spacing:.09em}.hd-title>span{display:none}}
@media(max-width:749px) and (prefers-reduced-motion:reduce){.hd-bar nav{display:flex}}
</style>
<style>[id^="ProductInfo-"]{scroll-margin-top:100px}@media(max-width:749px){.motion-floating-cta{bottom:160px}.hd-bar{padding-bottom:224px}.hd-track{bottom:216px}}</style>
<script>
(()=>{const root=document.getElementById('air-hd-{{ section.id }}');if(!root)return;
const urls=JSON.parse(root.querySelector('.hd-urls').textContent),canvas=root.querySelector('canvas'),ctx=canvas.getContext('2d'),wrap=root.querySelector('.hd-scroll'),scene=root.querySelector('.hd-scene'),hint=root.querySelector('.hd-hint'),title=root.querySelector('.hd-title'),copy=root.querySelector('.hd-copy'),buttons=[...root.querySelectorAll('[data-chapter]')];
const starts=[0,45,170,239,351,urls.length],chapters=[["Meet FLEX AIR.","A foldable, spring-resistance Pilates reformer. A sliding platform, support handles and resistance attachments — in one non-electric machine."],["A rail that guides the slide.","The platform travels along an aluminium rail, with up to 840 mm of carriage travel. This guided path is the basis of the sliding movements you see."],["Spring resistance. No motor.","Pulling the handles works against mechanical resistance. FLEX AIR uses steel-wire springs rather than a powered drive, so it needs no electrical outlet."],["Support at each contact point.","PU-covered armrests provide hand contact points. The leather-covered foam platform cushions the surface used for kneeling and seated movements."],["One machine. More positions.","The rail, platform and handles support standing, kneeling and seated movements. Choose FLEX AIR for a reformer that combines sliding and resistance work."]];
const shots=[[0,.34,.50],[1.76,.46,.55],[3.32,.60,.60],[4.2,.54,.60],[5.6,.58,.55],[6.68,.57,.50],[7.88,.56,.62],[9.08,.54,.5],[11.2,.63,.61],[12.76,.62,.5],[13.84,.55,.55],[15.64,.55,.58],[17.32,.58,.45],[19.24,.52,.55],[21.24,.60,.52],[23.52,.52,.52],[25.24,.54,.45],[27.8,.52,.55],[29.88,.62,.61],[33.4,.60,.45],[35.4,.50,.48],[37.76,.54,.52],[41.8,.56,.48],[43.8,.50,.55],[48.04,.54,.53],[49.88,.57,.44],[52.44,.54,.49],[56.6,.58,.60],[58.6,.52,.55]];
const reduced=matchMedia('(prefers-reduced-motion: reduce)').matches,cache=new Map(),pending=new Set(),attempts=new Map(),anchors=starts.slice(0,5).map((n,i)=>n+Math.round((starts[i+1]-n)*.22));
let target=0,position=0,shown=-1,lastChapter=-1,active=0,queue=[],raf=0,disposed=false,lastTime=0,lastRequested=-1;
function chapterFor(index){for(let i=4;i>=0;i--)if(index>=starts[i])return i;return 0;}
function layoutCopy(){const height=scene.getBoundingClientRect().height,mobile=scene.clientWidth<750,ch=Math.max(0,lastChapter),p=[[62,26],[7,20],[63,18],[7,40],[61,38]][ch],bar=root.querySelector('.hd-bar'),barTop=bar?bar.offsetTop:height-210,copyHeight=copy.offsetHeight||200,preferred=height*(mobile?.31:p[1]/100);root.style.setProperty('--copy-top',Math.max(100,Math.min(preferred,barTop-copyHeight-36))+'px');}
function size(){const r=scene.getBoundingClientRect(),dpr=Math.min(devicePixelRatio||1,1.5),w=Math.round(r.width*dpr),h=Math.round(r.height*dpr);if(!w||!h)return;if(canvas.width!==w||canvas.height!==h){canvas.width=w;canvas.height=h;}layoutCopy();wake();}
function updateCopy(index){const ch=chapterFor(index),local=(index-starts[ch])/(starts[ch+1]-starts[ch]-1);if(ch!==lastChapter){lastChapter=ch;root.dataset.current=String(ch);const p=[[62,60],[7,20],[63,18],[7,52],[61,55]][ch];root.style.setProperty('--copy-x',p[0]+'%');root.style.setProperty('--copy-y',p[1]+'%');root.querySelector('.hd-count').textContent=String(ch+1).padStart(2,'0')+' / 05';root.querySelector('.hd-copy h2').textContent=chapters[ch][0];root.querySelector('.hd-copy p').textContent=chapters[ch][1];buttons.forEach((b,i)=>{if(i===ch)b.setAttribute('aria-current','step');else b.removeAttribute('aria-current');});}
copy.style.opacity=String(reduced?1:Math.max(0,Math.min(1,local/.06,(1-local)/.07)));title.style.opacity=String(Math.max(0,1-index/24));root.querySelector('.hd-track i').style.width=(index/(urls.length-1)*100)+'%';layoutCopy();}
function draw(index,cameraPosition){const img=cache.get(index);if(!img)return;const w=canvas.width,h=canvas.height,mobile=scene.clientWidth<750,time=cameraPosition/8;let si=0;for(let i=1;i<shots.length;i++)if(time>=shots[i][0])si=i;const shot=shots[si],end=shots[si+1]?.[0]||60.84,t=Math.max(0,Math.min(1,(time-shot[0])/(end-shot[0])));
const zoom=reduced?1:si%2?1.15-.15*t:1+.12*t,scale=Math.max(w/1920,h/1080)*zoom,iw=1920*scale,ih=1080*scale,fx=(mobile?shot[1]:si<3?.40:.5)+(reduced?0:(si%2?-.035:.035)*Math.sin(t*Math.PI));let x=w*.5-iw*fx,y=h*.5-ih*(mobile?shot[2]:.5);x=Math.max(w-iw,Math.min(0,x));y=Math.max(h-ih,Math.min(0,y));ctx.filter='saturate(.85) sepia(.08)';ctx.drawImage(img,x,y,iw,ih);ctx.filter='none';shown=index;root.dataset.frame=String(index);root.querySelector('.hd-poster').style.visibility='hidden';}
function nearest(index){if(cache.has(index))return index;const ch=chapterFor(index);let best=-1,d=Infinity;for(const k of cache.keys())if(chapterFor(k)===ch&&Math.abs(k-index)<d){best=k;d=Math.abs(k-index);}return best;}
function trim(){const limit=scene.clientWidth<750?32:64;while(cache.size>limit){let far=-1,d=-1;for(const k of cache.keys()){if(k===shown||anchors.includes(k))continue;const distance=Math.abs(k-position);if(distance>d){far=k;d=distance;}}if(far<0)break;cache.delete(far);}}
function pump(){while(active<6&&queue.length){const i=queue.shift();if(cache.has(i)||pending.has(i)||(attempts.get(i)||0)>=3)continue;active++;pending.add(i);attempts.set(i,(attempts.get(i)||0)+1);const img=new Image();img.decoding='async';img.onload=()=>{active--;pending.delete(i);if(disposed)return;cache.set(i,img);trim();wake();pump();};img.onerror=()=>{active--;pending.delete(i);if(disposed)return;if((attempts.get(i)||0)<3)queue.push(i);root.dataset.loadErrors=String([...attempts.values()].filter(n=>n>1).length);wake();pump();};img.src=urls[i];}}
function request(index){const n=Math.max(0,Math.min(urls.length-1,Math.round(index)));if(n===lastRequested)return;lastRequested=n;const direction=target>=position?1:-1;queue=[n,Math.round(target),anchors[chapterFor(n)]];for(let d=1;d<=24;d++){const a=n+d*direction,b=n-d*direction;if(a>=0&&a<urls.length)queue.push(a);if(b>=0&&b<urls.length)queue.push(b);}queue.push(...anchors);pump();}
function tick(now){raf=0;if(disposed)return;const dt=Math.min(40,now-(lastTime||now-16.7));lastTime=now;const delta=target-position;if(reduced)position=target;else if(Math.abs(delta)<.08)position=target;else position+=delta*(1-Math.exp(-dt/100));position=Math.max(0,Math.min(urls.length-1,position));const n=Math.round(position);request(n);updateCopy(position);const ready=nearest(n);if(ready>=0){draw(ready,ready===n?position:ready);hint.textContent=reduced?'Choose a chapter to explore':'Scroll to explore FLEX AIR ↓';}else hint.textContent='Loading this movement…';root.dataset.targetFrame=String(Math.round(target));if(Math.abs(target-position)>.08)wake();}
function wake(){if(!raf&&!disposed)raf=requestAnimationFrame(tick);}
function update(){if(reduced)return;const r=wrap.getBoundingClientRect(),range=wrap.offsetHeight-scene.offsetHeight;target=Math.max(0,Math.min(1,-r.top/Math.max(1,range)))*(urls.length-1);wake();}
buttons.forEach((b,i)=>b.addEventListener('click',()=>{target=anchors[i];position=target;lastRequested=-1;request(target);wake();if(!reduced){const y=scrollY+wrap.getBoundingClientRect().top+(wrap.offsetHeight-scene.offsetHeight)*(target/(urls.length-1));window.scrollTo({top:y,behavior:'instant'});}}));
const purchase=root.querySelector('.motion-floating-cta');purchase?.addEventListener('click',e=>{const drawer=document.querySelector('cart-drawer');if(drawer){e.preventDefault();drawer.open(purchase);}});
copy.style.opacity='0';size();request(0);window.addEventListener('scroll',update,{passive:true});window.addEventListener('resize',size);update();
document.addEventListener('shopify:section:unload',e=>{if(e.detail.sectionId==='{{ section.id }}'){disposed=true;window.removeEventListener('scroll',update);window.removeEventListener('resize',size);if(raf)cancelAnimationFrame(raf);cache.clear();}});
})();
</script>
