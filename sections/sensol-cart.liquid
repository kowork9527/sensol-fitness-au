{%- comment -%} Sensol Cart Page {%- endcomment -%}
<section id="SensolCartRoot" class="sc-cart" data-cart-count="{{ cart.item_count }}">
  <style>
    .sc-cart { font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif; }
    .sc-cart *, .sc-cart *::before, .sc-cart *::after { box-sizing: border-box; }

    /* ---------- Header (dark) ---------- */
    .sc-cart__header { background: #1A1816; color: #F7F4F0; padding: 88px 0 64px; }
    .sc-cart__header-inner { max-width: 1120px; margin: 0 auto; padding: 0 24px; }
    .sc-cart__eyebrow { font-family: 'JetBrains Mono', monospace; font-size: 12px; letter-spacing: 0.35em; text-transform: uppercase; color: #8A8279; margin: 0 0 18px; }
    .sc-cart__title { font-size: clamp(48px, 7.5vw, 96px); font-weight: 600; line-height: 0.95; letter-spacing: -0.03em; margin: 0; color: #F7F4F0; }
    .sc-cart__meta { margin: 22px 0 0; color: #8A8279; font-size: 15px; }
    .sc-cart__meta strong { color: #F7F4F0; font-weight: 600; }
    .sc-cart__rule { height: 1px; background: rgba(247, 244, 240, 0.14); margin: 40px 0 0; }

    /* ---------- Empty state ---------- */
    .sc-cart__empty { background: #1A1816; color: #F7F4F0; padding: 140px 24px; text-align: center; }
    .sc-cart__empty-inner { max-width: 560px; margin: 0 auto; }
    .sc-cart__empty-icon { width: 56px; height: 56px; margin: 0 auto 28px; border: 1px solid rgba(247, 244, 240, 0.2); border-radius: 50%; display: flex; align-items: center; justify-content: center; }
    .sc-cart__empty-icon svg { width: 24px; height: 24px; stroke: #8A8279; }
    .sc-cart__empty-title { font-size: clamp(32px, 4vw, 48px); font-weight: 600; letter-spacing: -0.02em; margin: 0 0 14px; }
    .sc-cart__empty-text { color: #8A8279; font-size: 15px; line-height: 1.7; margin: 0 0 36px; }
    .sc-cart__empty-btn { display: inline-block; background: #F7F4F0; color: #1A1816; text-decoration: none; font-size: 13px; font-weight: 600; letter-spacing: 0.14em; text-transform: uppercase; padding: 18px 40px; transition: opacity 0.25s; }
    .sc-cart__empty-btn:hover { opacity: 0.85; }

    /* ---------- Body ---------- */
    .sc-cart__body { background: #F7F4F0; padding: 72px 0 120px; }
    .sc-cart__grid { max-width: 1120px; margin: 0 auto; padding: 0 24px; display: grid; grid-template-columns: 1fr 400px; gap: 56px; align-items: start; }

    /* Rows */
    .sc-cart__items-head { display: flex; justify-content: space-between; align-items: baseline; border-bottom: 1px solid #D4CEC6; padding-bottom: 18px; margin-bottom: 0; }
    .sc-cart__items-label { font-family: 'JetBrains Mono', monospace; font-size: 12px; letter-spacing: 0.2em; text-transform: uppercase; color: #8A8279; }
    .sc-cart__row { display: grid; grid-template-columns: 104px 1fr auto; gap: 28px; padding: 36px 0; border-bottom: 1px solid #D4CEC6; align-items: start; }
    .sc-cart__row.is-busy { opacity: 0.45; pointer-events: none; }
    .sc-cart__row-media { display: block; background: #FFFFFF; border: 1px solid #D4CEC6; aspect-ratio: 4/5; overflow: hidden; }
    .sc-cart__row-media img { width: 100%; height: 100%; object-fit: cover; display: block; }
    .sc-cart__row-info { min-width: 0; }
    .sc-cart__row-name { margin: 0 0 6px; font-size: 19px; font-weight: 600; letter-spacing: -0.01em; color: #1A1816; text-decoration: none; display: inline-block; }
    .sc-cart__row-name:hover { text-decoration: underline; text-underline-offset: 4px; }
    .sc-cart__row-variant { margin: 0 0 12px; font-size: 13px; color: #8A8279; }
    .sc-cart__row-price-each { font-family: 'JetBrains Mono', monospace; font-size: 12px; color: #8A8279; margin: 0; }

    /* Quantity stepper */
    .sc-cart__qty { display: inline-flex; align-items: center; border: 1px solid #1A1816; margin-top: 4px; }
    .sc-cart__qty-btn { width: 44px; height: 44px; border: 0; background: transparent; font-size: 18px; line-height: 1; color: #1A1816; cursor: pointer; transition: background 0.2s; }
    .sc-cart__qty-btn:hover { background: rgba(26, 24, 22, 0.06); }
    .sc-cart__qty-input { width: 48px; height: 44px; border: 0; background: transparent; text-align: center; font-family: 'JetBrains Mono', monospace; font-size: 14px; color: #1A1816; -moz-appearance: textfield; }
    .sc-cart__qty-input::-webkit-outer-spin-button, .sc-cart__qty-input::-webkit-inner-spin-button { -webkit-appearance: none; margin: 0; }
    .sc-cart__row-remove { margin-left: 18px; background: none; border: 0; padding: 0; font-size: 13px; color: #8A8279; text-decoration: underline; text-underline-offset: 3px; cursor: pointer; transition: color 0.2s; vertical-align: middle; }
    .sc-cart__row-remove:hover { color: #1A1816; }

    .sc-cart__row-total { text-align: right; }
    .sc-cart__row-total-num { font-family: 'JetBrains Mono', monospace; font-size: 16px; color: #1A1816; margin: 0; }

    .sc-cart__update { margin-top: 28px; background: none; border: 1px solid #D4CEC6; padding: 12px 26px; font-size: 12px; letter-spacing: 0.12em; text-transform: uppercase; color: #8A8279; cursor: pointer; transition: all 0.2s; }
    .sc-cart__update:hover { border-color: #1A1816; color: #1A1816; }
    .sc-cart__continue { display: inline-block; margin-left: 16px; color: #8A8279; font-size: 13px; text-decoration: underline; text-underline-offset: 3px; }
    .sc-cart__continue:hover { color: #1A1816; }

    /* Summary */
    .sc-cart__summary { background: #1A1816; color: #F7F4F0; padding: 40px 36px; position: sticky; top: 96px; }
    .sc-cart__summary-title { font-family: 'JetBrains Mono', monospace; font-size: 12px; letter-spacing: 0.3em; text-transform: uppercase; color: #8A8279; margin: 0 0 28px; padding-bottom: 20px; border-bottom: 1px solid rgba(247, 244, 240, 0.14); }
    .sc-cart__summary-line { display: flex; justify-content: space-between; align-items: baseline; margin: 0 0 12px; font-size: 14px; color: #8A8279; }
    .sc-cart__summary-line strong { font-family: 'JetBrains Mono', monospace; font-size: 17px; color: #F7F4F0; font-weight: 500; }
    .sc-cart__summary-note { margin: 22px 0 0; font-size: 12.5px; line-height: 1.6; color: #8A8279; }
    .sc-cart__checkout { display: block; width: 100%; margin-top: 32px; background: #F7F4F0; color: #1A1816; border: 0; padding: 20px; font-size: 13px; font-weight: 600; letter-spacing: 0.16em; text-transform: uppercase; cursor: pointer; transition: opacity 0.25s; font-family: inherit; }
    .sc-cart__checkout:hover { opacity: 0.85; }
    .sc-cart__trust { list-style: none; margin: 32px 0 0; padding: 28px 0 0; border-top: 1px solid rgba(247, 244, 240, 0.14); display: grid; gap: 16px; }
    .sc-cart__trust-item { display: flex; gap: 12px; align-items: flex-start; font-size: 13px; color: #8A8279; line-height: 1.5; }
    .sc-cart__trust-item svg { flex: none; width: 16px; height: 16px; stroke: #8A8279; margin-top: 2px; }
    .sc-cart__trust-item strong { color: #F7F4F0; font-weight: 600; display: block; }

    .sc-cart__footnote { max-width: 1120px; margin: 56px auto 0; padding: 0 24px; font-size: 12px; color: #8A8279; display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
    .sc-cart__footnote-lock { width: 13px; height: 13px; flex: none; color: #8A8279; }
    .sc-cart__pay-icons { display: flex; align-items: center; gap: 6px; margin-left: 4px; }
    .sc-cart__pay-icon { width: 34px; height: 21px; flex: none; border-radius: 3px; box-shadow: 0 0 0 1px #D4CEC6; }

    @media (max-width: 989px) {
      .sc-cart__header { padding: 64px 0 48px; }
      .sc-cart__body { padding: 40px 0 80px; }
      .sc-cart__grid { grid-template-columns: 1fr; gap: 40px; }
      .sc-cart__summary { position: static; }
      .sc-cart__row { grid-template-columns: 88px 1fr; grid-template-rows: auto auto; gap: 16px 20px; }
      .sc-cart__row-total { grid-column: 2; text-align: left; margin-top: 4px; }
      .sc-cart__row-total-num { font-size: 15px; }
    }
    @media (max-width: 480px) {
      .sc-cart__row { grid-template-columns: 72px 1fr; }
      .sc-cart__qty-btn { width: 40px; height: 40px; }
      .sc-cart__qty-input { width: 40px; height: 40px; }
    }
  </style>

  {%- if cart.item_count == 0 -%}
    <div class="sc-cart__empty">
      <div class="sc-cart__empty-inner">
        <div class="sc-cart__empty-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z"/><path d="M3 6h18"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>
        </div>
        <h1 class="sc-cart__empty-title">Your cart is empty</h1>
        <p class="sc-cart__empty-text">Explore the Sensol lineup — digital and mechanical reformers engineered for studio-grade training at home.</p>
        <a href="/collections" class="sc-cart__empty-btn">Explore Collections</a>
      </div>
    </div>
  {%- else -%}
    <div class="sc-cart__header">
      <div class="sc-cart__header-inner">
        <p class="sc-cart__eyebrow">Sensol Fitness</p>
        <h1 class="sc-cart__title">Your Cart</h1>
        <p class="sc-cart__meta">
          {%- if cart.item_count == 1 -%}1 item{%- else -%}<strong>{{ cart.item_count }} items</strong>{%- endif -%}
          &nbsp;&middot;&nbsp; Free shipping on all orders
        </p>
        <div class="sc-cart__rule"></div>
      </div>
    </div>

    <div class="sc-cart__body">
      <div class="sc-cart__grid">
        <form action="{{ routes.cart_url }}" method="post" id="SensolCartForm" class="sc-cart__form">
          <div class="sc-cart__items-head">
            <span class="sc-cart__items-label">Products</span>
            <span class="sc-cart__items-label">Quantity</span>
          </div>

          {%- for item in cart.items -%}
            <div class="sc-cart__row" data-scart-row="{{ forloop.index }}">
              <a href="{{ item.url }}" class="sc-cart__row-media">
                {%- if item.image -%}
                  <img src="{{ item.image | image_url: width: 300 }}" alt="{{ item.title | escape }}" loading="lazy" width="104" height="130">
                {%- endif -%}
              </a>
              <div class="sc-cart__row-info">
                <a href="{{ item.url }}" class="sc-cart__row-name">{{ item.product.title }}</a>
                {%- unless item.variant.title == 'Default Title' or item.variant.title == blank -%}
                  <p class="sc-cart__row-variant">{{ item.variant.title }}</p>
                {%- endunless -%}
                <p class="sc-cart__row-price-each">{{ item.final_price | money }} each</p>
                <div class="sc-cart__qty">
                  <button type="button" class="sc-cart__qty-btn" data-scart-qty="down" data-line="{{ forloop.index }}" aria-label="Decrease quantity">&minus;</button>
                  <input class="sc-cart__qty-input" data-scart-input="{{ forloop.index }}" name="updates[{{ item.variant.id }}]" value="{{ item.quantity }}" min="0" inputmode="numeric" type="number" aria-label="Quantity">
                  <button type="button" class="sc-cart__qty-btn" data-scart-qty="up" data-line="{{ forloop.index }}" aria-label="Increase quantity">+</button>
                </div>
                <button type="button" class="sc-cart__row-remove" data-scart-remove data-line="{{ forloop.index }}">Remove</button>
              </div>
              <div class="sc-cart__row-total">
                <p class="sc-cart__row-total-num">{{ item.final_line_price | money }}</p>
              </div>
            </div>
          {%- endfor -%}

          <button type="submit" class="sc-cart__update" data-scart-update>Update cart</button>
          <a href="/collections" class="sc-cart__continue">Continue shopping</a>
        </form>

        <aside class="sc-cart__summary">
          <h2 class="sc-cart__summary-title">Order Summary</h2>
          <div class="sc-cart__summary-line">
            <span>Subtotal</span>
            <strong>{{ cart.total_price | money }}</strong>
          </div>
          <div class="sc-cart__summary-line">
            <span>Shipping</span>
            <span>Free</span>
          </div>
          <p class="sc-cart__summary-note">Taxes and duties are calculated at checkout.</p>
          <button type="submit" form="SensolCartForm" name="checkout" class="sc-cart__checkout">Checkout &rarr;</button>
          <ul class="sc-cart__trust">
            <li class="sc-cart__trust-item">
              <svg viewBox="0 0 24 24" fill="none" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 18H3c-.6 0-1-.4-1-1V7c0-.6.4-1 1-1h10c.6 0 1 .4 1 1v10c0 .6-.4 1-1 1H5"/><path d="M14 9h4l4 4v4c0 .6-.4 1-1 1h-2.5"/><circle cx="7" cy="18" r="2"/><circle cx="17" cy="18" r="2"/></svg>
              <span><strong>Free shipping</strong>Australia-wide, on every order</span>
            </li>
            <li class="sc-cart__trust-item">
              <svg viewBox="0 0 24 24" fill="none" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10Z"/></svg>
              <span><strong>Warranty protected</strong>Covered against manufacturing defects</span>
            </li>
            <li class="sc-cart__trust-item">
              <svg viewBox="0 0 24 24" fill="none" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12a9 9 0 1 0 9-9"/><path d="M3 4v5h5"/><path d="M12 7v5l3 3"/></svg>
              <span><strong>30-day returns</strong>Try it at home, risk free</span>
            </li>
          </ul>
        </aside>
      </div>
      <div class="sc-cart__footnote">
        <svg class="sc-cart__footnote-lock" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="4" y="10" width="16" height="11" rx="2.5"/><path d="M8 10V7a4 4 0 1 1 8 0v3"/></svg>
        <span>Secure checkout powered by Shopify</span>
        <span class="sc-cart__pay-icons" aria-label="Supported payment methods">
          <svg class="sc-cart__pay-icon" viewBox="0 0 40 24" role="img" aria-label="Visa"><rect x="0.5" y="0.5" width="39" height="23" rx="3" fill="#FFFFFF" stroke="#D4CEC6"/><path fill="#1A1F71" d="M15.5 8.2 12.9 15.8h-1.8L9.8 9.9c-.1-.4-.2-.5-.5-.7-.4-.2-1-.4-1.5-.5l.1-.5h2.7c.4 0 .7.3.8.8l.7 4 1.9-4.7h1.5Zm3.4 0-1.4 7.6h-1.7l1.4-7.6h1.7Zm5.4 2.1c-.6-.3-1-.5-.9-.8 0-.3.4-.6 1.1-.6.5 0 1 .1 1.3.3l.2.1.3-1.4c-.4-.1-.9-.3-1.6-.3-1.7 0-2.9.9-2.9 2.2 0 .9.8 1.4 1.5 1.8.6.3.9.5.8.8 0 .4-.5.6-1.1.6-.7 0-1.3-.2-1.7-.4l-.2-.1-.3 1.4c.4.2 1.2.4 1.9.4 1.9 0 3-.9 3-2.3 0-.8-.5-1.4-1.4-1.7Zm5.7-2.1h-1.3c-.4 0-.7.1-.9.5l-2.5 5h1.7l.3-.9h2.1l.2.9h1.5l-1.1-5.5Zm-2 4.5.7-2.1.4 2.1h-1.1Zm-6.9-4.5-1.4 7.6h-1.6l1.4-7.6h1.6Z" transform="translate(3,2)"/></svg>
          <svg class="sc-cart__pay-icon" viewBox="0 0 40 24" role="img" aria-label="Mastercard"><rect x="0.5" y="0.5" width="39" height="23" rx="3" fill="#FFFFFF" stroke="#D4CEC6"/><circle cx="17" cy="12" r="6.5" fill="#EB001B"/><circle cx="24" cy="12" r="6.5" fill="#F79E1B"/><path fill="#FF5F00" d="M20.5 7.2a6.5 6.5 0 0 0 0 9.6 6.5 6.5 0 0 0 0-9.6Z"/></svg>
          <svg class="sc-cart__pay-icon" viewBox="0 0 40 24" role="img" aria-label="Amex"><rect x="0.5" y="0.5" width="39" height="23" rx="3" fill="#2E77BC"/><path fill="#FFFFFF" d="M9 8.5h3l1.2 2.6L14.4 8.5h3l-2.4 4.2 2.5 4.3h-3l-1.3-2.7-1.3 2.7h-3l2.5-4.3L9 8.5Zm8 0h6v1.6h-2v6.9h-2v-6.9h-2V8.5Zm7.5 0h2.9l1.4 2.7 1.4-2.7H34l-3 5.2v3.3h-2v-3.3l-3-5.2Z"/></svg>
          <svg class="sc-cart__pay-icon" viewBox="0 0 40 24" role="img" aria-label="Apple Pay"><rect x="0.5" y="0.5" width="39" height="23" rx="3" fill="#000000"/><path fill="#FFFFFF" d="M20.7 8.9c-.5 0-1.1.5-1.6.5-.6 0-1.2-.5-1.8-.4-1.1 0-2 .6-2.5 1.6-1 1.8-.3 4.5.7 6 .5.7 1.1 1.5 1.9 1.5.7 0 1-.5 1.8-.5s1.1.5 1.8.5c.8 0 1.4-.8 1.9-1.5.5-.8.7-1.6.7-1.6s-1.5-.6-1.5-2.3c0-1.4 1.1-2.1 1.2-2.1-.6-.9-1.6-1.7-2.6-1.7Zm.5-1.1c.4-.5.7-1.2.6-1.9-.6 0-1.3.4-1.7.9-.4.4-.7 1.1-.6 1.8.7.1 1.3-.3 1.7-.8Z" transform="translate(1,1)"/><text x="26" y="16.5" font-family="Helvetica" font-size="7" font-weight="600" fill="#FFFFFF">Pay</text></svg>
          <svg class="sc-cart__pay-icon" viewBox="0 0 40 24" role="img" aria-label="Google Pay"><rect x="0.5" y="0.5" width="39" height="23" rx="3" fill="#FFFFFF" stroke="#D4CEC6"/><path d="M9.5 10.5c.9 0 1.6.6 1.6 1.5s-.7 1.5-1.6 1.5H7.5v-3h2Zm-.1 5.2c1 0 1.8.7 1.8 1.7s-.8 1.6-1.8 1.6H7.5v-3.3h1.9Zm4.1 2.6-2-2.9c1-.3 1.6-1.2 1.6-2.3 0-1.5-1.1-2.6-2.7-2.6H6v8.9h1.5v-3h1.3l1.8 3h1.9Z" fill="#3C4043"/><path d="M14.5 9.5c0 .5.2.8.6 1.1l-.3.4c-.7-.3-1.1-1-1.1-1.8 0-.8.5-1.4 1.1-1.8l.3.4c-.4.3-.6.9-.6 1.7Z" fill="#5F6368" opacity="0"/><path d="M15.6 8.5c1 0 1.8.6 2 1.5l-.5.1c-.2-.7-.8-1.1-1.5-1.1-.9 0-1.6.7-1.6 1.6s.7 1.6 1.6 1.6c.7 0 1.3-.4 1.5-1.1l.5.1c-.2.9-1 1.5-2 1.5-1.2 0-2.1-.9-2.1-2.1s.9-2.2 2.1-2.2Z" fill="#3C4043"/><text x="24" y="15.5" font-family="Arial" font-size="6.5" font-weight="700" fill="#5F6368">Pay</text></svg>
          <svg class="sc-cart__pay-icon" viewBox="0 0 40 24" role="img" aria-label="PayPal"><rect x="0.5" y="0.5" width="39" height="23" rx="3" fill="#FFFFFF" stroke="#D4CEC6"/><path fill="#003087" d="M15.2 7.5h2.7c1.5 0 2.5.7 2.2 2.3l-.7 4c-.2 1.2-1.2 1.9-2.4 1.9h-1.6l-.5 2.7c-.1.4-.3.6-.7.6h-1c-.3 0-.5-.2-.4-.6l1.5-8.9c.1-.4.3-.6.7-.6h.2Zm1.4 2.4-.5 3.4h1c.6 0 1-.3 1.1-1l.2-1.3c.1-.7-.2-1.1-.9-1.1h-.9Z"/><path fill="#009cde" d="M24.3 7.5h2.7c1.5 0 2.5.7 2.2 2.3l-.7 4c-.2 1.2-1.2 1.9-2.4 1.9h-1.6l-.5 2.7c-.1.4-.3.6-.7.6h-1c-.3 0-.5-.2-.4-.6l1.5-8.9c.1-.4.3-.6.7-.6h.2Zm1.4 2.4-.5 3.4h1c.6 0 1-.3 1.1-1l.2-1.3c.1-.7-.2-1.1-.9-1.1h-.9Z" transform="translate(2,0)"/><path fill="#002F86" d="M22.5 5.5h-3.2c-.5 0-.9.3-1 .8l-1.4 8c-.1.5.2.8.6.8h1.7c.3 0 .5-.2.6-.5l.4-2.4h1.4c1.7 0 2.8-.9 3.1-2.7l.2-1c.3-1.9-.7-3-2.4-3Zm.7 3.2-.2 1c-.1.9-.6 1.3-1.5 1.3h-.9l.5-3.5h1c.8 0 1.2.4 1.1 1.2Z"/></svg>
        </span>
      </div>
    </div>
  {%- endif -%}

  <script>
    (function () {
      var root = document.getElementById('SensolCartRoot');
      if (!root || !window.fetch) return;

      function replaceWith(html) {
        var doc = new DOMParser().parseFromString(html, 'text/html');
        var fresh = doc.getElementById('SensolCartRoot');
        if (fresh) root.replaceWith(fresh);
        else window.location.reload();
      }

      function updateHeaderCount(count) {
        document.querySelectorAll('[data-cart-count], .cart-count-bubble span[aria-hidden]').forEach(function (el) { el.textContent = count; });
      }

      function update(line, quantity) {
        var row = root.querySelector('[data-scart-row="' + line + '"]');
        if (row) row.classList.add('is-busy');
        fetch('/cart/change.js', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest' },
          body: JSON.stringify({ line: line, quantity: quantity, sections: 'sensol-cart', sections_url: window.location.pathname })
        })
          .then(function (r) { return r.json(); })
          .then(function (state) {
            if (state.status) { window.location.reload(); return; }
            if (state.sections && state.sections['sensol-cart']) {
              replaceWith(state.sections['sensol-cart']);
              updateHeaderCount(state.item_count);
            } else {
              window.location.reload();
            }
          })
          .catch(function () { window.location.reload(); });
      }

      root.addEventListener('click', function (e) {
        var qtyBtn = e.target.closest('[data-scart-qty]');
        if (qtyBtn) {
          var line = qtyBtn.dataset.line;
          var input = root.querySelector('[data-scart-input="' + line + '"]');
          var next = parseInt(input.value, 10) + (qtyBtn.dataset.scartQty === 'up' ? 1 : -1);
          if (isNaN(next) || next < 0) next = 0;
          input.value = next;
          update(line, next);
          return;
        }
        var removeBtn = e.target.closest('[data-scart-remove]');
        if (removeBtn) {
          e.preventDefault();
          update(removeBtn.dataset.line, 0);
        }
      });

      root.addEventListener('change', function (e) {
        var input = e.target.closest('[data-scart-input]');
        if (!input) return;
        var q = parseInt(input.value, 10);
        if (isNaN(q) || q < 0) q = 0;
        update(input.dataset.scartInput, q);
      });
    })();
  </script>
</section>

