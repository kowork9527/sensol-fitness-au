<section class="sensol-warranty-contact-section">
  <div class="sensol-warranty-contact">
    <p class="sensol-warranty-contact__label">{{ section.settings.label }}</p>
    <h2 class="sensol-warranty-contact__title">{{ section.settings.title }}</h2>
    <p class="sensol-warranty-contact__text">{{ section.settings.text }}</p>
    <a class="sensol-warranty-contact__email" href="mailto:{{ section.settings.email }}">{{ section.settings.email }}</a>
    <div class="sensol-warranty-contact__info">{{ section.settings.company_info | newline_to_br }}</div>
  </div>
</section>
<section class="sensol-warranty-footer">
  <p class="sensol-warranty-footer__text">Last updated: July 2026 &middot; See also: <a class="sensol-warranty-footer__link" href="/pages/terms-of-service">Terms of Service</a> &middot; <a class="sensol-warranty-footer__link" href="/pages/refund-policy">Refund Policy</a> &middot; <a class="sensol-warranty-footer__link" href="/pages/shipping-policy">Shipping Policy</a></p>
</section>
{% schema %}{"name":"SENSOL Warranty Contact","tag":"section","class":"sensol-warranty-contact-section","settings":[{"type":"text","id":"label","label":"Label","default":"Need assistance?"},{"type":"text","id":"title","label":"Title","default":"We're here to help."},{"type":"text","id":"text","label":"Text","default":"Monday - Friday, 9:00 AM - 6:00 PM AEST"},{"type":"text","id":"email","label":"Email","default":"support@sensolfitness.com.au"},{"type":"textarea","id":"company_info","label":"Company Info","default":"Dute Fitness (Australia) Pty. Ltd.\nsensolfitness.com.au  /  sensolfitness.com"}],"presets":[{"name":"SENSOL Warranty Contact"}]}{% endschema %}
{%- style -%}
.sensol-warranty-contact-section{margin:0;padding:0;background:#F7F4F0}.sensol-warranty-contact{background:#1A1816;color:#F7F4F0;padding:80px 2rem;text-align:center;font-family:'Inter',sans-serif}.sensol-warranty-contact__label{font-size:.6875rem;letter-spacing:.2em;text-transform:uppercase;color:#B5ADA4;margin-bottom:1rem}.sensol-warranty-contact__title{font-size:clamp(1.5rem,3vw,2.25rem);font-weight:300;letter-spacing:-.01em;margin-bottom:1rem}.sensol-warranty-contact__text{font-size:.9375rem;font-weight:300;color:#8A8279;margin-bottom:2rem}.sensol-warranty-contact__email{display:inline-block;font-size:1.25rem;font-weight:300;color:#F7F4F0;text-decoration:none;border-bottom:1px solid rgba(247,244,240,.3);padding-bottom:2px}.sensol-warranty-contact__email:hover{border-color:#F7F4F0}.sensol-warranty-contact__info{margin-top:2rem;font-size:.75rem;color:#8A8279;font-weight:300;line-height:1.8}.sensol-warranty-footer{text-align:center;padding:60px 2rem;border-top:1px solid #D4CEC6;background:#F7F4F0;font-family:'Inter',sans-serif}.sensol-warranty-footer__text{font-size:.75rem;font-weight:300;color:#8A8279;max-width:650px;margin:0 auto;line-height:1.8}.sensol-warranty-footer__link{color:#1A1816;text-decoration:underline;text-underline-offset:2px;text-decoration-thickness:.5px;text-decoration-color:#B5ADA4}@media(max-width:749px){.sensol-warranty-contact{padding:60px 1.5rem}}
{%- endstyle -%}
