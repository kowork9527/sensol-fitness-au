{%- comment -%}
  Sensol — Instagram photo wall
  Cream section between the dark App section and the dark footer.
  Square tiles in a 2-col (mobile) / 5-col (desktop) grid, hover overlay
  with Instagram glyph, every tile links to the profile.
  Tiles are theme assets: upload ig-wall-XX.jpg to the theme's assets,
  then reference the filename in each "tile" block (asset_name).
{%- endcomment -%}

<section class="sensol-instagram" data-sensol-instagram>
  <div class="sensol-instagram__inner">
    {%- if section.settings.label != blank or section.settings.heading != blank -%}
      <header class="sensol-instagram__header">
        {%- if section.settings.label != blank -%}
          <p class="sensol-instagram__eyebrow">
            <svg class="sensol-instagram__glyph" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
              <rect x="2.5" y="2.5" width="19" height="19" rx="5.5"></rect>
              <circle cx="12" cy="12" r="4.4"></circle>
              <circle cx="17.6" cy="6.4" r="0.4" fill="currentColor" stroke="none"></circle>
            </svg>
            <span>{{ section.settings.label | escape }}</span>
          </p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="sensol-instagram__heading">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}
        {%- if section.settings.subheading != blank -%}
          <p class="sensol-instagram__subheading">{{ section.settings.subheading | escape }}</p>
        {%- endif -%}
        {%- if section.settings.follow_link != blank and section.settings.follow_label != blank -%}
          <a class="sensol-instagram__follow" href="{{ section.settings.follow_link }}" target="_blank" rel="noopener">
            {{ section.settings.follow_label | escape }}
            <svg class="sensol-instagram__arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
              <path d="M5 12h13"></path>
              <path d="M13 6l6 6-6 6"></path>
            </svg>
          </a>
        {%- endif -%}
      </header>
    {%- endif -%}

    {%- assign tiles = section.blocks | where: 'type', 'tile' -%}
    {%- if tiles.size > 0 -%}
      <div class="sensol-instagram__grid">
        {%- for block in tiles -%}
          {%- if block.settings.asset_name != blank -%}
            {%- assign tile_src = block.settings.asset_name | asset_url -%}
            {%- assign tile_link = block.settings.link | default: section.settings.follow_link -%}
            {%- assign tile_alt = block.settings.alt | default: section.settings.label -%}
            <a class="sensol-instagram__tile" href="{{ tile_link }}" target="_blank" rel="noopener" {{ block.shopify_attributes }}>
              <img
                src="{{ tile_src }}"
                alt="{{ tile_alt | escape }}"
                width="800"
                height="800"
                loading="lazy"
                decoding="async"
              >
              <span class="sensol-instagram__overlay" aria-hidden="true">
                <svg class="sensol-instagram__overlay-glyph" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
                  <rect x="2.5" y="2.5" width="19" height="19" rx="5.5"></rect>
                  <circle cx="12" cy="12" r="4.4"></circle>
                  <circle cx="17.6" cy="6.4" r="0.4" fill="currentColor" stroke="none"></circle>
                </svg>
              </span>
            </a>
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>

{%- style -%}
  .sensol-instagram {
    background: #F7F4F0;
    padding: 110px 24px;
    font-family: 'Inter', -apple-system, 'Segoe UI', sans-serif;
  }
  .sensol-instagram__inner {
    max-width: 1280px;
    margin: 0 auto;
  }
  .sensol-instagram__header {
    text-align: center;
    margin-bottom: 52px;
  }
  .sensol-instagram__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin: 0 0 22px;
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: #8B8B8B;
  }
  .sensol-instagram__glyph {
    width: 15px;
    height: 15px;
    flex: none;
  }
  .sensol-instagram__heading {
    margin: 0;
    font-size: clamp(1.9rem, 4vw, 3.2rem);
    font-weight: 200;
    letter-spacing: -0.015em;
    line-height: 1.12;
    color: #1A1816;
  }
  .sensol-instagram__subheading {
    margin: 18px auto 0;
    max-width: 540px;
    font-size: 15px;
    font-weight: 300;
    line-height: 1.7;
    color: #6B6B6B;
  }
  .sensol-instagram__follow {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    margin-top: 30px;
    padding: 13px 30px;
    border: 1px solid #1A1816;
    border-radius: 999px;
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    text-decoration: none;
    color: #1A1816;
    transition: background 0.3s ease, color 0.3s ease;
  }
  .sensol-instagram__follow:hover {
    background: #1A1816;
    color: #F7F4F0;
  }
  .sensol-instagram__arrow {
    width: 15px;
    height: 15px;
    transition: transform 0.3s ease;
  }
  .sensol-instagram__follow:hover .sensol-instagram__arrow {
    transform: translateX(3px);
  }
  .sensol-instagram__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 10px;
  }
  .sensol-instagram__tile {
    position: relative;
    display: block;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    border-radius: 2px;
    background: #EDE9E3;
    -webkit-tap-highlight-color: transparent;
  }
  .sensol-instagram__tile img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.55s cubic-bezier(0.22, 0.61, 0.36, 1);
  }
  .sensol-instagram__overlay {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(26, 24, 22, 0.34);
    opacity: 0;
    transition: opacity 0.35s ease;
  }
  .sensol-instagram__overlay-glyph {
    width: 26px;
    height: 26px;
    color: #FFFFFF;
    transform: scale(0.86);
    transition: transform 0.35s ease;
  }
  @media (hover: hover) {
    .sensol-instagram__tile:hover img {
      transform: scale(1.06);
    }
    .sensol-instagram__tile:hover .sensol-instagram__overlay {
      opacity: 1;
    }
    .sensol-instagram__tile:hover .sensol-instagram__overlay-glyph {
      transform: scale(1);
    }
  }
  .sensol-instagram__tile:focus-visible {
    outline: 2px solid #1A1816;
    outline-offset: 3px;
  }
  @media screen and (min-width: 968px) {
    .sensol-instagram__grid {
      grid-template-columns: repeat(5, 1fr);
      gap: 12px;
    }
    .sensol-instagram__header {
      margin-bottom: 60px;
    }
  }
  @media screen and (max-width: 640px) {
    .sensol-instagram {
      padding: 56px 16px;
    }
    .sensol-instagram__header {
      margin-bottom: 36px;
    }
    .sensol-instagram__eyebrow {
      margin-bottom: 16px;
    }
    .sensol-instagram__subheading {
      font-size: 14px;
    }
    .sensol-instagram__follow {
      margin-top: 24px;
      padding: 11px 24px;
    }
    .sensol-instagram__grid {
      gap: 8px;
    }
  }
{%- endstyle -%}

{% schema %}
{
  "name": "Sensol Instagram Wall",
  "tag": "section",
  "class": "sensol-instagram-section",
  "settings": [
    {
      "type": "text",
      "id": "label",
      "label": "Eyebrow (handle)",
      "default": "@sensol_fitness"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Sensol in the world"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Across spaces, cities, and routines — sensol becomes part of how people move, train, and live."
    },
    {
      "type": "text",
      "id": "follow_label",
      "label": "Follow button label",
      "default": "Follow us"
    },
    {
      "type": "url",
      "id": "follow_link",
      "label": "Follow button link"
    }
  ],
  "blocks": [
    {
      "type": "tile",
      "name": "Tile",
      "settings": [
        {
          "type": "text",
          "id": "asset_name",
          "label": "Theme asset filename",
          "info": "e.g. ig-wall-01.jpg — file must exist in the theme's assets."
        },
        {
          "type": "url",
          "id": "link",
          "label": "Tile link (optional)",
          "info": "Defaults to the follow button link."
        },
        {
          "type": "text",
          "id": "alt",
          "label": "Alt text",
          "default": "Sensol training moment"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Sensol Instagram Wall"
    }
  ]
}
{% endschema %}
