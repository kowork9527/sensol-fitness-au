<section class="sensol-reviews" aria-labelledby="sensol-reviews-title"><p>{{ product.title | upcase | escape }} / CUSTOMER FEEDBACK</p><h2 id="sensol-reviews-title">Customer reviews.</h2><div class="jdgm-widget jdgm-review-widget" id="judgeme_product_reviews" data-product-title="{{ product.title | escape }}" data-id="{{ product.id }}" data-product-id="{{ product.id }}" data-widget="review" data-auto-install="false" data-shop-reviews-count="{{ shop.metafields.judgeme.shop_reviews_count | default: 0 | escape }}" data-entry-point="review_widget.js" data-entry-key="review-widget/main.js">{% if product.metafields.judgeme.widget.size > 20 %}<div class="jdgm-legacy-widget-content" style="display:none">{{ product.metafields.judgeme.widget }}</div>{% endif %}</div>{% if product.metafields.judgeme.review_widget_data %}<script>window.jdgm=window.jdgm||{};jdgm.data=jdgm.data||{};jdgm.data.reviewWidget=jdgm.data.reviewWidget||{};jdgm.data.reviewWidget[{{ product.id }}]={{ product.metafields.judgeme.review_widget_data }};</script>{% endif %}</section><style>.sensol-reviews{padding:80px 6%;background:#efede6;color:#192019;font-family:Arial,Helvetica,sans-serif}.sensol-reviews>p{font-size:11px;font-weight:700;letter-spacing:.1em}.sensol-reviews h2{font-size:clamp(36px,4vw,58px);line-height:1.1;letter-spacing:-.035em;margin:22px 0 40px}</style>
{% schema %}
{
  "name": "SENSOL Native Reviews",
  "tag": "section",
  "class": "sensol-native-section",
  "settings": [],
  "presets": [
    {
      "name": "SENSOL Native Reviews"
    }
  ]
}
{% endschema %}