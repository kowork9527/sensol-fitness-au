{% assign flex_product = section.settings.product %}
{% if flex_product == blank %}{% assign flex_product = all_products['sensol-flex-air'] %}{% endif %}
{% assign flex_url = flex_product.url | default: '/products/sensol-flex-air' %}
<section id="flex-{{ section.id }}" class="sf-air">
  <div class="sf-hero">
    <div class="sf-copy"><p class="sf-eyebrow">{{ section.settings.eyebrow | escape }}</p><h1>{{ section.settings.heading | escape }}</h1><p class="sf-intro">{{ section.settings.description | escape }}</p>
    <div class="sf-actions"><a class="sf-button" href="{{ flex_url }}">{{ section.settings.button_label | escape }} <span aria-hidden="true">↗</span></a><a class="sf-link" href="#sf-explore-{{ section.id }}">Explore the details ↓</a></div>
    <p class="sf-caption">FLEX AIR · Movement, made part of home.</p></div>
    <div class="sf-stage" aria-label="FLEX AIR product presentation">
      <div class="sf-orbit" aria-hidden="true"></div><span class="sf-watermark" aria-hidden="true">AIR</span>
      <div class="sf-product"><img class="sf-state-a" src="{{ 'https://raw.githubusercontent.com/kowork9527/sensol-fitness-au/9f7ca6a3e1e728e59e9459f0db7e5369de3ce83b/images/flex-air-0-f8bbc1ee.webp' }}" alt="FLEX AIR with the carriage close to the fixed platform" width="1400" height="788" fetchpriority="high"><img class="sf-state-b" src="{{ 'https://raw.githubusercontent.com/kowork9527/sensol-fitness-au/9f7ca6a3e1e728e59e9459f0db7e5369de3ce83b/images/flex-air-1-16dd9e8e.webp' }}" alt="FLEX AIR with the carriage extended along the rail" width="1400" height="788" hidden></div>
      <div class="sf-stage-bottom"><span>Designed for everyday movement.</span><button class="sf-toggle" type="button" aria-pressed="false">Show extended carriage ↔</button></div>
    </div>
  </div>
  <div class="sf-strip"><span>MAKE IT EASY.</span><span>DO IT REAL.</span><span>MEET FLEX AIR.</span></div>
  <div class="sf-explore" id="sf-explore-{{ section.id }}">
    <div class="sf-section-head"><p class="sf-eyebrow">01 / Form meets movement</p><h2>Every detail.<br>A reason to move.</h2><p>Get closer to the elements that shape your training experience.</p></div>
    <div class="sf-detail-layout"><div class="sf-detail-image"><img src="{{ 'https://raw.githubusercontent.com/kowork9527/sensol-fitness-au/9f7ca6a3e1e728e59e9459f0db7e5369de3ce83b/images/flex-air-1-16dd9e8e.webp' }}" alt="FLEX AIR rail, padded carriage and support handles" width="1400" height="788" loading="lazy"></div><div class="sf-details">
      <details open><summary><span>01</span> Moving carriage</summary><p>A padded carriage travels along the central rail. Explore its position above, then see the product page for setup and training guidance.</p></details>
      <details><summary><span>02</span> Support handles</summary><p>Take a closer look at the handle arrangement and supported positions. Follow the product instructions for safe use.</p></details>
      <details><summary><span>03</span> Compact form</summary><p>A considered profile for home training. Check the product dimensions and allow adequate clear space around the equipment.</p></details>
    </div></div>
  </div>
  <div class="sf-editorial"><p class="sf-eyebrow">02 / Your everyday practice</p><h2>A little space.<br>A new routine.</h2><p>Make room for movement at home. Discover FLEX AIR, explore the equipment and find a practice that fits your day.</p><a class="sf-button sf-button-light" href="{{ flex_url }}">Discover FLEX AIR ↗</a><span class="sf-editorial-word" aria-hidden="true">MOVE</span></div>
  <div class="sf-shop"><div><p class="sf-eyebrow">03 / Meet your reformer</p><h2>Sensol FLEX AIR</h2><p>See specifications, included accessories and availability.</p></div><div class="sf-shop-action">{% if flex_product != blank %}<p class="sf-price">{{ flex_product.price | money_with_currency }}</p>{% endif %}<a class="sf-button" href="{{ flex_url }}">View product ↗</a></div></div>
</section>
<style>
#flex-{{ section.id }}{--sf-bg:#f7f4f0;--sf-ink:#1a1816;--sf-muted:#736b63;background:var(--sf-bg);color:var(--sf-ink);overflow:hidden;font-family:inherit}
.sf-air *{box-sizing:border-box}.sf-air h1,.sf-air h2,.sf-air p{margin:0}.sf-hero{display:grid;grid-template-columns: .85fr 1.15fr;min-height:690px;align-items:center;max-width:1600px;margin:auto;padding:70px 5vw 55px;gap:12px}.sf-copy{z-index:2}.sf-eyebrow{font-size:11px;letter-spacing:.2em;text-transform:uppercase;margin-bottom:25px!important}.sf-air h1{font-size:clamp(48px,5.5vw,86px);line-height:1.02;letter-spacing:-.055em;max-width:620px}.sf-intro{font-size:17px;line-height:1.7;max-width:370px;margin-top:26px!important;color:var(--sf-muted)}.sf-actions{display:flex;align-items:center;flex-wrap:wrap;gap:24px;margin-top:34px}.sf-button{display:inline-flex;align-items:center;justify-content:space-between;gap:34px;padding:18px 24px;background:var(--sf-ink);color:var(--sf-bg);text-decoration:none;font-size:13px;min-height:52px;border:1px solid var(--sf-ink)}.sf-button:hover{background:#39342e}.sf-link{font-size:12px;color:var(--sf-ink);text-underline-offset:6px}.sf-caption{margin-top:60px!important;font-size:10px;letter-spacing:.08em;color:var(--sf-muted)}.sf-stage{position:relative;min-height:480px;display:flex;align-items:center;perspective:1000px}.sf-watermark{position:absolute;top:0;left:5%;font-size:clamp(140px,19vw,290px);line-height:1;color:#e8e2da;font-weight:300;letter-spacing:-.08em}.sf-orbit{position:absolute;width:85%;height:70%;border:1px solid #dfd7ce;border-radius:50%;transform:rotate(-24deg)}.sf-product{position:relative;width:115%;margin-left:-5%;transform:rotateX(var(--rx,0deg)) rotateY(var(--ry,0deg)) translateY(var(--sy,0px));transition:transform .25s ease;filter:drop-shadow(0 30px 20px #1a181615)}.sf-product img,.sf-detail-image img{display:block;width:100%;height:auto;mix-blend-mode:multiply}.sf-product img[hidden]{display:none}.sf-stage-bottom{position:absolute;bottom:0;left:0;right:0;display:flex;justify-content:space-between;gap:14px;align-items:center;font-size:10px;color:var(--sf-muted)}.sf-toggle{font:inherit;font-size:11px;background:transparent;border:1px solid #bbb1a5;padding:12px 14px;cursor:pointer;color:var(--sf-ink)}.sf-strip{display:flex;justify-content:space-around;gap:20px;border-top:1px solid #dcd5cd;border-bottom:1px solid #dcd5cd;padding:22px;font-size:11px;letter-spacing:.16em}.sf-explore{padding:100px 6vw;max-width:1600px;margin:auto;scroll-margin-top:100px}.sf-section-head{display:grid;grid-template-columns:1fr 1.7fr 1fr;align-items:start;gap:30px}.sf-air h2{font-size:clamp(34px,4vw,60px);line-height:1.08;letter-spacing:-.045em}.sf-section-head>p:last-child{font-size:14px;line-height:1.8;color:var(--sf-muted);padding-top:10px}.sf-detail-layout{display:grid;grid-template-columns:1.7fr 1fr;gap:70px;align-items:center;margin-top:60px}.sf-details details{border-top:1px solid #d6cdc2;padding:22px 0}.sf-details summary{font-size:17px;cursor:pointer;list-style:none;display:flex;gap:24px}.sf-details summary::after{content:'+';margin-left:auto}.sf-details details[open] summary::after{content:'−'}.sf-details summary span{font-size:10px;color:var(--sf-muted);padding-top:5px}.sf-details details p{font-size:13px;line-height:1.8;color:var(--sf-muted);padding:18px 0 0 38px}.sf-editorial{position:relative;overflow:hidden;background:var(--sf-ink);color:var(--sf-bg);padding:90px 8vw 110px}.sf-editorial h2{font-size:clamp(50px,7vw,100px);position:relative;z-index:1}.sf-editorial>p:not(.sf-eyebrow){max-width:400px;font-size:15px;line-height:1.8;color:#c0b9b0;margin-top:25px}.sf-button-light{background:var(--sf-bg);color:var(--sf-ink);margin-top:30px}.sf-button-light:hover{background:#e1d8cc}.sf-editorial-word{position:absolute;right:-2%;bottom:-50px;font-size:25vw;color:#ffffff06;line-height:1;letter-spacing:-.08em}.sf-shop{padding:75px 8vw;display:flex;justify-content:space-between;align-items:center;gap:30px}.sf-shop p:not(.sf-eyebrow){font-size:14px;color:var(--sf-muted);margin-top:16px}.sf-shop-action{text-align:right}.sf-shop .sf-price{font-size:21px;color:var(--sf-ink);margin-bottom:20px}.sf-air a:focus-visible,.sf-air button:focus-visible,.sf-air summary:focus-visible{outline:2px solid #8a8279;outline-offset:5px}
@media(max-width:749px){.sf-hero{grid-template-columns:1fr;padding:45px 6vw 30px;min-height:auto}.sf-air h1{font-size:54px}.sf-caption{margin-top:25px!important}.sf-stage{min-height:330px;margin-top:15px}.sf-product{width:100%;margin:0}.sf-watermark{font-size:180px}.sf-stage-bottom{font-size:9px}.sf-strip{font-size:8px;letter-spacing:.08em;padding:18px 10px}.sf-explore{padding:60px 6vw}.sf-section-head{grid-template-columns:1fr;gap:15px}.sf-section-head .sf-eyebrow{margin-bottom:0!important}.sf-detail-layout{grid-template-columns:1fr;gap:20px;margin-top:30px}.sf-editorial{padding:65px 6vw}.sf-shop{padding:50px 6vw;display:block}.sf-shop-action{text-align:left;margin-top:24px}.sf-editorial-word{bottom:0}}
@media(prefers-reduced-motion:reduce){.sf-product{transform:none!important;transition:none}}
</style>
<script>
(()=>{const root=document.getElementById('flex-{{ section.id }}');if(!root||root.dataset.ready)return;root.dataset.ready='true';const stage=root.querySelector('.sf-stage'),product=root.querySelector('.sf-product'),toggle=root.querySelector('.sf-toggle');toggle.addEventListener('click',()=>{const extended=toggle.getAttribute('aria-pressed')!=='true';toggle.setAttribute('aria-pressed',String(extended));root.querySelector('.sf-state-a').hidden=extended;root.querySelector('.sf-state-b').hidden=!extended;toggle.textContent=extended?'Show resting carriage ↔':'Show extended carriage ↔';});if(!matchMedia('(prefers-reduced-motion: reduce)').matches&&matchMedia('(pointer:fine)').matches){stage.addEventListener('pointermove',e=>{const b=stage.getBoundingClientRect();product.style.setProperty('--ry',((e.clientX-b.left)/b.width-.5)*10+'deg');product.style.setProperty('--rx',-((e.clientY-b.top)/b.height-.5)*7+'deg');});stage.addEventListener('pointerleave',()=>{product.style.setProperty('--rx','0deg');product.style.setProperty('--ry','0deg');});}})();
</script>
{% schema %}
{"name":"FLEX AIR experience","settings":[{"type":"product","id":"product","label":"Featured product"},{"type":"text","id":"eyebrow","label":"Eyebrow","default":"Sensol / FLEX AIR"},{"type":"text","id":"heading","label":"Heading","default":"Real Pilates. Your space."},{"type":"textarea","id":"description","label":"Description","default":"Meet FLEX AIR. A compact reformer that makes movement feel at home."},{"type":"text","id":"button_label","label":"Button label","default":"Discover FLEX AIR"}],"presets":[{"name":"FLEX AIR experience"}]}
{% endschema %}