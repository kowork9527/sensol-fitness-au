<section class="sensol-video" style="background-color: {{ section.settings.bg_color }};">
  <div class="sensol-video__container">
    <div class="sensol-video__header">
      {%- if section.settings.label != blank -%}
        <p class="sensol-video__label">{{ section.settings.label }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="sensol-video__heading">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.subheading != blank -%}
        <p class="sensol-video__subheading">{{ section.settings.subheading }}</p>
      {%- endif -%}
    </div>

    <div class="sensol-video__player">
      {%- if section.settings.video_url != blank -%}
        <video class="sensol-video__el" autoplay muted loop playsinline>
          <source src="{{ section.settings.video_url }}" type="video/mp4">
        </video>
      {%- else -%}
        <div class="sensol-video__placeholder">
          <img src="{{ 'banner-4.webp' | asset_url }}" alt="SENSOL" class="sensol-video__placeholder-img">
          <div class="sensol-video__play-btn">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none"><polygon points="5,3 19,12 5,21" fill="#F7F4F0"/></svg>
          </div>
        </div>
      {%- endif -%}
    </div>

    {%- if section.blocks.size > 0 -%}
      <div class="sensol-video__specs">
        {%- for block in section.blocks -%}
          <div class="sensol-video__spec" {{ block.shopify_attributes }}>
            <p class="sensol-video__spec-value">{{ block.settings.value }}</p>
            <p class="sensol-video__spec-label">{{ block.settings.label }}</p>
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>

<style>
  .sensol-video { padding: 100px 5%; }
  .sensol-video__container { max-width: 1400px; margin: 0 auto; }
  .sensol-video__header { text-align: center; margin-bottom: 3rem; }
  .sensol-video__label { font-size: 10px; letter-spacing: 0.3em; text-transform: uppercase; color: #8A8279; margin-bottom: 1rem; }
  .sensol-video__heading { font-size: clamp(28px, 3vw, 40px); font-weight: 300; letter-spacing: 0.1em; color: #1A1816; margin: 0 0 1rem 0; }
  .sensol-video__subheading { font-size: 15px; color: #8A8279; line-height: 1.6; max-width: 600px; margin: 0 auto; }
  .sensol-video__player { position: relative; width: 100%; aspect-ratio: 16/9; overflow: hidden; background: #1A1816; }
  .sensol-video__el, .sensol-video__placeholder-img { width: 100%; height: 100%; object-fit: cover; }
  .sensol-video__placeholder { position: relative; width: 100%; height: 100%; }
  .sensol-video__play-btn { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; }
  .sensol-video__play-btn svg { opacity: 0.8; }
  .sensol-video__specs { display: grid; grid-template-columns: repeat(4, 1fr); gap: 2rem; margin-top: 3rem; text-align: center; }
  .sensol-video__spec-value { font-size: 28px; font-weight: 200; color: #1A1816; margin: 0 0 0.5rem 0; letter-spacing: 0.05em; }
  .sensol-video__spec-label { font-size: 10px; letter-spacing: 0.2em; text-transform: uppercase; color: #8A8279; margin: 0; }
  @media (max-width: 749px) {
    .sensol-video { padding: 60px 5%; }
    .sensol-video__specs { grid-template-columns: repeat(2, 1fr); }
  }
</style>

{% schema %}
{
  "name": "SENSOL Video",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "label", "label": "Label", "default": "ENGINEERED MOVEMENT" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "The first All-in-one smart training reformer" },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "See how Sensol works in real movement — simple, precise, and intuitive." },
    { "type": "url", "id": "video_url", "label": "Video URL (MP4)", "info": "Leave empty for default image" },
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#F7F4F0" }
  ],
  "blocks": [
    {
      "type": "spec",
      "name": "Specification",
      "limit": 4,
      "settings": [
        { "type": "text", "id": "value", "label": "Value", "default": "360°" },
        { "type": "text", "id": "label", "label": "Label", "default": "Motion Range" }
      ]
    }
  ],
  "presets": [
    {
      "name": "SENSOL Video",
      "blocks": [
        { "type": "spec", "settings": { "value": "360°", "label": "Motion Range" } },
        { "type": "spec", "settings": { "value": "<8ms", "label": "Response Time" } },
        { "type": "spec", "settings": { "value": "0–100%", "label": "Resistance" } },
        { "type": "spec", "settings": { "value": "<25dB", "label": "Silent Operation" } }
      ]
    }
  ]
}
{% endschema %}
