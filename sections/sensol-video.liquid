{{ 'sensol-video.css' | asset_url | stylesheet_tag }}

<section class="sensol-video">
  <div class="sensol-video__container">
    <div class="sensol-video__content">
      <p class="sensol-video__label">{{ section.settings.label | default: 'THE FIRST ALL-IN-ONE SMART TRAINING REFORMER' }}</p>
      <h2 class="sensol-video__title">{{ section.settings.title | default: 'See how Sensol works in real movement' }}</h2>
      <p class="sensol-video__subtitle">{{ section.settings.subtitle | default: 'See how Sensol works in real movement — simple, precise, and intuitive.' }}</p>
      <div class="sensol-video__specs">
        <div class="sensol-video__spec">
          <span class="sensol-video__spec-value">360°</span>
          <span class="sensol-video__spec-label">Motion Range</span>
        </div>
        <div class="sensol-video__spec">
          <span class="sensol-video__spec-value">&lt;8ms</span>
          <span class="sensol-video__spec-label">Response</span>
        </div>
        <div class="sensol-video__spec">
          <span class="sensol-video__spec-value">0–100%</span>
          <span class="sensol-video__spec-label">Resistance</span>
        </div>
        <div class="sensol-video__spec">
          <span class="sensol-video__spec-value">&lt;25dB</span>
          <span class="sensol-video__spec-label">Quiet</span>
        </div>
      </div>
    </div>
    <div class="sensol-video__media">
      <img src="{{ 'banner-4.webp' | asset_url }}" alt="SENSOL Smart Reformer" loading="lazy">
    </div>
  </div>
</section>

{% schema %}
{
  "name": "SENSOL Video",
  "tag": "section",
  "class": "sensol-video-section",
  "settings": [
    {"type":"text","id":"label","label":"Label","default":"THE FIRST ALL-IN-ONE SMART TRAINING REFORMER"},
    {"type":"text","id":"title","label":"Title","default":"See how Sensol works in real movement"},
    {"type":"textarea","id":"subtitle","label":"Subtitle","default":"See how Sensol works in real movement — simple, precise, and intuitive."},
    {"type":"image_picker","id":"image","label":"Image (overrides default)"}
  ],
  "presets":[{"name":"SENSOL Video Showcase"}]
}
{% endschema %}
