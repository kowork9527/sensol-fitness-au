<section class="sensol-shipping-fees-section">
  <div class="sensol-shipping-fees">
    <div class="sensol-shipping-fees__divider"></div>
    <p class="sensol-shipping-fees__label">02</p>
    <h2 class="sensol-shipping-fees__title">Shipping Fees &amp; Order Processing</h2>
    <div class="sensol-shipping-fees__grid">
      <div class="sensol-shipping-fees__list">
        <div class="sensol-shipping-fees__item"><span class="sensol-shipping-fees__icon">&#10003;</span><span><strong>Metro areas (VIC, NSW, QLD, SA, WA, TAS, ACT)</strong><br>Free domestic shipping on all Sensol products</span></div>
        <div class="sensol-shipping-fees__item"><span class="sensol-shipping-fees__icon">&#9992;</span><span><strong>Regional and remote areas</strong><br>A shipping surcharge may apply. The exact amount will be displayed at checkout before you complete your purchase.</span></div>
        <div class="sensol-shipping-fees__item"><span class="sensol-shipping-fees__icon">&#128230;</span><span>We do not charge separate handling or packaging fees &mdash; shipping costs are fully included in the price shown at checkout.</span></div>
      </div>
      <div class="sensol-shipping-fees__image"><span class="sensol-shipping-fees__image-text">PACKAGING</span></div>
    </div>
    <div class="sensol-shipping-fees__processing">
      <p class="sensol-shipping-fees__processing-title">Order Processing</p>
      <ul class="sensol-shipping-fees__processing-list">
        <li>Orders are processed within <strong>1&ndash;2 business days</strong> of payment confirmation</li>
        <li>You will receive a tracking notification via email once your order has been dispatched</li>
        <li>Delivery times are estimates and may vary due to carrier schedules, weather, or remote location access</li>
      </ul>
    </div>
  </div>
</section>
{% schema %}{"name":"SENSOL Shipping Fees","tag":"section","class":"sensol-shipping-fees-section","settings":[],"presets":[{"name":"SENSOL Shipping Fees"}]}{% endschema %}
{%- style -%}
.sensol-shipping-fees-section{background:#F7F4F0;padding:0}
.sensol-shipping-fees-section .sensol-shipping-fees{max-width:1040px;margin:0 auto;padding:80px 2rem 0}
.sensol-shipping-fees-section .sensol-shipping-fees__divider{width:48px;height:1px;background:#D4CEC6;margin-bottom:48px}
.sensol-shipping-fees-section .sensol-shipping-fees__label{font-size:0.75rem;font-weight:600;letter-spacing:0.2em;text-transform:uppercase;color:#B5ADA4;margin-bottom:1rem}
.sensol-shipping-fees-section .sensol-shipping-fees__title{font-size:clamp(2rem,3vw,2.75rem);font-weight:300;letter-spacing:-0.01em;line-height:1.2;margin-bottom:32px;color:#1A1816}
.sensol-shipping-fees-section .sensol-shipping-fees__grid{display:grid;grid-template-columns:1fr 1fr;gap:64px;align-items:center}
.sensol-shipping-fees-section .sensol-shipping-fees__item{padding:20px 0;border-bottom:1px solid #D4CEC6;font-size:1.25rem;color:#8A8279;line-height:1.6;display:flex;gap:16px}
.sensol-shipping-fees-section .sensol-shipping-fees__item:first-child{padding-top:0}
.sensol-shipping-fees-section .sensol-shipping-fees__item:last-child{border-bottom:none}
.sensol-shipping-fees-section .sensol-shipping-fees__item strong{color:#1A1816;font-weight:500}
.sensol-shipping-fees-section .sensol-shipping-fees__icon{font-size:1.25rem;flex-shrink:0;opacity:0.5;margin-top:2px}
.sensol-shipping-fees-section .sensol-shipping-fees__image{background:#1A1816;aspect-ratio:4/3;display:flex;align-items:center;justify-content:center;color:rgba(247,244,240,0.04);font-size:4rem;font-weight:200}
.sensol-shipping-fees-section .sensol-shipping-fees__processing{margin-top:48px}
.sensol-shipping-fees-section .sensol-shipping-fees__processing-title{font-size:1.5rem;font-weight:500;color:#1A1816;margin-bottom:1rem}
.sensol-shipping-fees-section .sensol-shipping-fees__processing-list{font-size:1.5rem;font-weight:400;color:#8A8279;line-height:1.75;padding-left:1.5rem}
.sensol-shipping-fees-section .sensol-shipping-fees__processing-list li{margin-bottom:0.5rem}
.sensol-shipping-fees-section .sensol-shipping-fees__processing-list strong{color:#1A1816;font-weight:500}
@media(max-width:900px){.sensol-shipping-fees-section .sensol-shipping-fees-section .sensol-shipping-fees__grid{grid-template-columns:1fr;gap:40px}}
@media(max-width:749px){.sensol-shipping-fees-section .sensol-shipping-fees-section .sensol-shipping-fees{padding:56px 1.5rem 0}.sensol-shipping-fees-section .sensol-shipping-fees__title{font-size:1.75rem}}
{%- endstyle -%}
