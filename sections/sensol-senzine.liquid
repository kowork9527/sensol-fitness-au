<section class="sensol-senzine" style="background-color: {{ section.settings.bg_color }};">
  <div class="sensol-senzine__container">
    <div class="sensol-senzine__text">
      {%- if section.settings.label != blank -%}
        <p class="sensol-senzine__label">{{ section.settings.label }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="sensol-senzine__heading">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.description != blank -%}
        <p class="sensol-senzine__description">{{ section.settings.description }}</p>
      {%- endif -%}
      {%- if section.settings.button_label != blank -%}
        <a href="{{ section.settings.button_link }}" class="sensol-senzine__button" style="color: {{ section.settings.text_color }};">{{ section.settings.button_label }}</a>
      {%- endif -%}
    </div>

    <div class="sensol-senzine__images">
      {%- if section.settings.image_1 != blank -%}
        {{ section.settings.image_1 | image_url: width: 1200 | image_tag: loading: 'lazy', class: 'sensol-senzine__img' }}
      {%- else -%}
        <img src="{{ 'editorial-1.webp' | asset_url }}" alt="SENZINE" class="sensol-senzine__img" loading="lazy">
      {%- endif -%}
      {%- if section.settings.image_2 != blank -%}
        {{ section.settings.image_2 | image_url: width: 1200 | image_tag: loading: 'lazy', class: 'sensol-senzine__img' }}
      {%- else -%}
        <img src="{{ 'editorial-2.webp' | asset_url }}" alt="SENZINE" class="sensol-senzine__img" loading="lazy">
      {%- endif -%}
    </div>
  </div>
</section>

<style>
  .sensol-senzine { padding: 100px 5%; }
  .sensol-senzine__container { max-width: 1400px; margin: 0 auto; display: grid; grid-template-columns: 1fr 1fr; gap: 80px; align-items: center; }
  .sensol-senzine__label { font-size: 10px; letter-spacing: 0.3em; text-transform: uppercase; color: #8A8279; margin-bottom: 1.5rem; }
  .sensol-senzine__heading { font-size: clamp(32px, 4vw, 48px); font-weight: 300; letter-spacing: 0.1em; color: #1A1816; margin: 0 0 1.5rem 0; }
  .sensol-senzine__description { font-size: 16px; color: #8A8279; line-height: 1.7; margin: 0 0 2rem 0; }
  .sensol-senzine__button { font-size: 11px; letter-spacing: 0.2em; text-transform: uppercase; text-decoration: none; border-bottom: 1px solid #D4CEC6; padding-bottom: 4px; transition: border-color 0.3s; }
  .sensol-senzine__button:hover { border-color: #1A1816; }
  .sensol-senzine__images { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
  .sensol-senzine__img { width: 100%; height: auto; display: block; }
  @media (max-width: 749px) {
    .sensol-senzine { padding: 60px 5%; }
    .sensol-senzine__container { grid-template-columns: 1fr; gap: 40px; }
  }
</style>

{% schema %}
{
  "name": "SENSOL SENZINE",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "label", "label": "Label", "default": "SENZINE" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Distilled ideas, tactile moments" },
    { "type": "textarea", "id": "description", "label": "Description", "default": "Senzine is Sensol's internal publication, distills a single idea — control, resistance, stillness — into a tactile experience, designed to be felt as much as it is read." },
    { "type": "text", "id": "button_label", "label": "Button text", "default": "JOIN US" },
    { "type": "url", "id": "button_link", "label": "Button link", "default": "/pages/contact" },
    { "type": "image_picker", "id": "image_1", "label": "Image 1 (leave empty for default)" },
    { "type": "image_picker", "id": "image_2", "label": "Image 2 (leave empty for default)" },
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#F7F4F0" },
    { "type": "color", "id": "text_color", "label": "Text color", "default": "#1A1816" }
  ],
  "presets": [{ "name": "SENSOL SENZINE" }]
}
{% endschema %}
