{{ 'sensol-senzine.css' | asset_url | stylesheet_tag }}

<section class="sensol-senzine">
  <div class="sensol-senzine__container">
    <div class="sensol-senzine__text">
      <p class="sensol-senzine__label">SENZINE</p>
      <h2 class="sensol-senzine__title">{{ section.settings.title | default: 'Senzine' }}</h2>
      <p class="sensol-senzine__body">{{ section.settings.body | default: 'Senzine is Sensol\'s internal publication, distills a single idea—control, resistance, stillness—into a tactile experience, designed to be felt as much as it is read. Released in quiet intervals, each issue carries a fragment of movement, a trace of scent, and a moment of attention.' }}</p>
      <a href="{{ section.settings.button_link | default: '/pages/contact' }}" class="sensol-senzine__btn">{{ section.settings.button_text | default: 'JOIN US' }}</a>
    </div>
    <div class="sensol-senzine__images">
      <img src="{{ 'editorial-1.webp' | asset_url }}" alt="SENZINE Issue" class="sensol-senzine__img" loading="lazy">
      <img src="{{ 'editorial-2.webp' | asset_url }}" alt="SENZINE Issue" class="sensol-senzine__img" loading="lazy">
    </div>
  </div>
</section>

{% schema %}
{
  "name": "SENSOL Senzine",
  "tag": "section",
  "class": "sensol-senzine-section",
  "settings": [
    {"type":"text","id":"title","label":"Title","default":"Senzine"},
    {"type":"textarea","id":"body","label":"Body Text","default":"Senzine is Sensol's internal publication."},
    {"type":"text","id":"button_text","label":"Button Text","default":"JOIN US"},
    {"type":"url","id":"button_link","label":"Button Link"},
    {"type":"image_picker","id":"image1","label":"Image 1 (overrides default)"},
    {"type":"image_picker","id":"image2","label":"Image 2 (overrides default)"}
  ],
  "presets":[{"name":"SENSOL Senzine"}]
}
{% endschema %}
