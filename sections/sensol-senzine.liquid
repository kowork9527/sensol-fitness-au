<section class="sensol-senzine" style="background-color: {{ section.settings.bg_color }};">
  <div class="sensol-senzine__inner">
    <div class="sensol-senzine__text">
      {%- if section.settings.label != blank -%}
        <p class="sensol-senzine__label">{{ section.settings.label }}</p>
      {%- endif -%}
      
      {%- if section.settings.heading != blank -%}
        <h2 class="sensol-senzine__heading">{{ section.settings.heading }}</h2>
      {%- endif -%}
      
      {%- if section.settings.description != blank -%}
        <div class="sensol-senzine__description">{{ section.settings.description }}</div>
      {%- endif -%}
      
      {%- if section.settings.button_label != blank -%}
        <a href="{{ section.settings.button_link }}" class="sensol-senzine__button" style="background-color: {{ section.settings.button_bg_color }}; color: {{ section.settings.button_text_color }};">
          {{ section.settings.button_label }}
        </a>
      {%- endif -%}
    </div>
    
    <div class="sensol-senzine__media">
      {%- if section.settings.image_1 != blank -%}
        <div class="sensol-senzine__image-wrapper">
          {{ section.settings.image_1 | image_url: width: 1200 | image_tag: width: section.settings.image_1.width, height: section.settings.image_1.height, alt: section.settings.image_1.alt, class: 'sensol-senzine__image', loading: 'lazy' }}
        </div>
      {%- endif -%}
      
      {%- if section.settings.image_2 != blank -%}
        <div class="sensol-senzine__image-wrapper sensol-senzine__image-wrapper--secondary">
          {{ section.settings.image_2 | image_url: width: 1200 | image_tag: width: section.settings.image_2.width, height: section.settings.image_2.height, alt: section.settings.image_2.alt, class: 'sensol-senzine__image', loading: 'lazy' }}
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

<style>
  .sensol-senzine {
    padding: 80px 0;
  }
  
  .sensol-senzine__inner {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 2rem;
    display: grid;
    grid-template-columns: 1fr 1.2fr;
    gap: 4rem;
    align-items: center;
  }
  
  .sensol-senzine__label {
    font-size: 10px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: #8A8279;
    margin: 0 0 1rem 0;
  }
  
  .sensol-senzine__heading {
    font-size: clamp(28px, 4vw, 42px);
    font-weight: 200;
    letter-spacing: 0.1em;
    color: #1A1816;
    margin: 0 0 2rem 0;
    line-height: 1.2;
  }
  
  .sensol-senzine__description {
    font-size: 15px;
    line-height: 1.8;
    color: #5A5249;
    margin-bottom: 2.5rem;
  }
  
  .sensol-senzine__description p {
    margin: 0 0 1rem 0;
  }
  
  .sensol-senzine__button {
    display: inline-block;
    padding: 14px 36px;
    font-size: 11px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    text-decoration: none;
    border: none;
    cursor: pointer;
    transition: opacity 0.3s ease;
  }
  
  .sensol-senzine__button:hover {
    opacity: 0.8;
  }
  
  .sensol-senzine__media {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
  }
  
  .sensol-senzine__image-wrapper {
    overflow: hidden;
  }
  
  .sensol-senzine__image-wrapper--secondary {
    margin-top: 2rem;
  }
  
  .sensol-senzine__image {
    width: 100%;
    height: auto;
    display: block;
    transition: transform 0.6s ease;
  }
  
  .sensol-senzine__image-wrapper:hover .sensol-senzine__image {
    transform: scale(1.03);
  }
  
  @media (max-width: 991px) {
    .sensol-senzine__inner {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
    
    .sensol-senzine__media {
      order: -1;
    }
  }
</style>

{% schema %}
{
  "name": "SENSOl SENZINE",
  "tag": "section",
  "class": "sensol-senzine-wrapper",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "背景色",
      "default": "#F7F4F0"
    },
    {
      "type": "header",
      "content": "图片"
    },
    {
      "type": "image_picker",
      "id": "image_1",
      "label": "图片 1"
    },
    {
      "type": "image_picker",
      "id": "image_2",
      "label": "图片 2"
    },
    {
      "type": "header",
      "content": "文字内容"
    },
    {
      "type": "text",
      "id": "label",
      "label": "标签",
      "default": "SENZINE"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "标题",
      "default": "Senzine"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "描述",
      "default": "<p>Senzine is Sensol's internal publication, distills a single idea—control, resistance, stillness—into a tactile experience, designed to be felt as much as it is read.</p><p>Released in quiet intervals, each issue carries a fragment of movement, a trace of scent, and a moment of attention.</p>"
    },
    {
      "type": "header",
      "content": "按钮"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "按钮文字",
      "default": "JOIN US"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "按钮链接"
    },
    {
      "type": "color",
      "id": "button_bg_color",
      "label": "按钮背景色",
      "default": "#1A1816"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "按钮文字色",
      "default": "#F7F4F0"
    }
  ],
  "presets": [
    {
      "name": "SENSOl SENZINE"
    }
  ]
}
{% endschema %}
