{{ 'sensol-marquee.css' | asset_url | stylesheet_tag }}

<section class="sensol-marquee" style="background-color:{{ section.settings.bg_color | default: '#1A1816' }};color:{{ section.settings.text_color | default: '#F7F4F0' }}">
  <div class="sensol-marquee__track">
    {%- for i in (1..6) -%}
    <span class="sensol-marquee__item">{{ section.settings.text | default: 'Make it easy · Do it real' }}</span>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "SENSOL Marquee",
  "tag": "section",
  "class": "sensol-marquee-section",
  "settings": [
    {"type":"text","id":"text","label":"Scrolling Text","default":"Make it easy · Do it real"},
    {"type":"color","id":"bg_color","label":"Background Color","default":"#1A1816"},
    {"type":"color","id":"text_color","label":"Text Color","default":"#F7F4F0"}
  ],
  "presets":[{"name":"SENSOL Marquee"}]
}
{% endschema %}
