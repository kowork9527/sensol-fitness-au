<section class="sensol-marquee" style="background-color: {{ section.settings.bg_color }};">
  <div class="sensol-marquee__track">
    <div class="sensol-marquee__inner">
      {%- for i in (1..8) -%}
        <span class="sensol-marquee__text" style="color: {{ section.settings.text_color }};">{{ section.settings.text }}</span>
        <span class="sensol-marquee__dot" style="background-color: {{ section.settings.text_color }};"></span>
      {%- endfor -%}
    </div>
  </div>
</section>

<style>
  .sensol-marquee {
    overflow: hidden;
    padding: 28px 0;
  }
  .sensol-marquee__track {
    display: flex;
    width: max-content;
  }
  .sensol-marquee__inner {
    display: flex;
    align-items: center;
    gap: 3rem;
    animation: sensol-scroll 20s linear infinite;
  }
  .sensol-marquee__text {
    font-size: 14px;
    font-weight: 300;
    letter-spacing: 0.25em;
    text-transform: uppercase;
    white-space: nowrap;
  }
  .sensol-marquee__dot {
    width: 4px;
    height: 4px;
    border-radius: 50%;
    flex-shrink: 0;
  }
  @keyframes sensol-scroll {
    0% { transform: translateX(0); }
    100% { transform: translateX(-50%); }
  }
  @media (prefers-reduced-motion: reduce) {
    .sensol-marquee__inner { animation: none; }
  }
</style>

{% schema %}
{
  "name": "SENSOL Marquee",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "text", "label": "Scrolling text", "default": "MAKE IT EASY · DO IT REAL" },
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#1A1816" },
    { "type": "color", "id": "text_color", "label": "Text color", "default": "#F7F4F0" }
  ],
  "presets": [{ "name": "SENSOL Marquee" }]
}
{% endschema %}
