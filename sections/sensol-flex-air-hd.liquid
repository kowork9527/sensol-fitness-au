{% assign flex_product = section.settings.product %}
{% if flex_product == blank %}{% assign flex_product = all_products['sensol-flex-air'] %}{% endif %}
{% assign flex_url = flex_product.url | default: '/products/sensol-flex-air' %}
<section id="air-hd-{{ section.id }}" class="air-hd">
<div class="hd-scroll"><div class="hd-scene">
<img class="hd-poster" src="{{ 'air-hd-000.webp' | asset_url }}" width="1920" height="1080" alt="A woman preparing her beige FLEX AIR Pilates reformer in a bright studio" fetchpriority="high">
<canvas aria-label="FLEX AIR Pilates practice, controlled by scrolling" role="img"></canvas>
<div class="hd-title"><p>PILATES, CONTINUED / FLEX AIR</p><h1>{{ section.settings.heading | escape }}</h1><span>{{ section.settings.description | escape }}</span></div>
<div class="hd-copy"><span class="hd-count">01 / 05</span><h2>Make room for your practice.</h2><p>Bring FLEX AIR into position. Your next movement starts here.</p></div>
<div class="hd-bar"><span class="hd-hint" role="status">Preparing the movement…</span><nav aria-label="Practice chapters"><button data-chapter="0" aria-current="step">Prepare</button><button data-chapter="1">Move</button><button data-chapter="2">Connect</button><button data-chapter="3">Control</button><button data-chapter="4">Continue</button></nav><div class="hd-track"><i></i></div></div>
</div></div>
<div class="hd-ending"><p>FROM CLASS TO YOUR OWN PRACTICE</p><h2>The movement you learn.<br>The time you make your own.</h2><p>FLEX AIR is a non-electric Pilates reformer. Continue the movements you have learned, in a space that works for you.</p><a href="{{ flex_url }}">{{ section.settings.button_label | escape }} ↗</a>{% if flex_product != blank %}<span>{{ flex_product.price | money_with_currency }}</span>{% endif %}</div>
<script type="application/json" class="hd-urls">[{% for i in (0..119) %}{% capture number %}00{{ i }}{% endcapture %}{% assign number = number | slice: -3, 3 %}{% capture filename %}air-hd-{{ number }}.webp{% endcapture %}{{ filename | asset_url | json }}{% unless forloop.last %},{% endunless %}{% endfor %}]</script>
</section>
<style>
.air-hd{background:#eef0ed;color:#191c19}.hd-scroll{height:550vh}.hd-scene{position:sticky;top:0;height:100svh;overflow:hidden;isolation:isolate}.hd-poster,.hd-scene canvas{position:absolute;inset:0;width:100%;height:100%;object-fit:contain}.hd-scene canvas{z-index:1}.hd-title{position:absolute;z-index:2;top:14%;left:55%;right:5%;max-width:550px;pointer-events:none}.hd-title>p,.hd-count,.hd-ending>p:first-child{font-size:11px;letter-spacing:.18em}.hd-title h1{font-size:clamp(42px,5vw,72px);line-height:1.05;letter-spacing:-.055em;max-width:680px;margin:20px 0}.hd-title>span{display:block;font-size:15px;max-width:340px;line-height:1.6}.hd-copy{position:absolute;z-index:2;bottom:110px;right:5%;max-width:360px;padding:24px;background:rgba(247,248,245,.91);backdrop-filter:blur(12px);border-left:2px solid #697264}.hd-copy h2{font-size:clamp(25px,3vw,38px);line-height:1.12;letter-spacing:-.03em;margin:12px 0}.hd-copy p{font-size:14px;line-height:1.6;margin:0;max-width:310px}.hd-count{color:#535d51}.hd-bar{position:absolute;z-index:3;bottom:0;left:0;right:0;background:rgba(238,240,237,.95);padding:18px 160px 24px 5%;display:flex;align-items:center;justify-content:space-between;gap:20px}.hd-hint{font-size:11px;letter-spacing:.04em}.hd-bar nav{display:flex;gap:20px}.hd-bar button{background:none;border:0;border-bottom:1px solid transparent;padding:8px 0;font:inherit;font-size:12px;color:#535d51;cursor:pointer}.hd-bar button[aria-current]{border-color:#191c19;color:#191c19}.hd-bar button:focus-visible{outline:2px solid #697264;outline-offset:3px}.hd-track{height:2px;position:absolute;left:5%;right:5%;bottom:12px;background:#ccd0c9}.hd-track i{display:block;width:0;height:100%;background:#697264}.hd-ending{background:#191c19;color:#f6f5ef;padding:100px 8%}.hd-ending h2{color:inherit;font-size:clamp(34px,5vw,70px);letter-spacing:-.04em;line-height:1.1;margin:24px 0}.hd-ending>p{max-width:480px;line-height:1.7}.hd-ending a{display:inline-block;background:#f6f5ef;color:#191c19;padding:18px 28px;text-decoration:none;margin:20px 24px 0 0}.hd-ending>span{font-size:14px}
@media(max-width:749px){.hd-scroll{height:450vh}.hd-title{top:12%;left:6%;right:6%}.hd-title h1{font-size:42px;max-width:330px}.hd-title>span{max-width:280px}.hd-copy{left:6%;right:6%;bottom:120px;max-width:none;padding:16px}.hd-copy h2{font-size:25px;margin:8px 0}.hd-copy p{font-size:12px}.hd-bar{display:block;padding:12px 6% 22px}.hd-bar nav{justify-content:space-between;gap:8px}.hd-bar button{font-size:11px}.hd-hint{display:block;margin-bottom:4px}.hd-ending{padding:65px 6%}}
@media(prefers-reduced-motion:reduce){.hd-scroll{height:100svh}.hd-scene{position:relative}.hd-title{opacity:1!important}}
body:has(.air-hd) #sensolHeader{background:#eef0ed!important;color:#191c19!important}body:has(.air-hd) #sensolHeader .sensol-header__logo-img{filter:none!important}body:has(.air-hd) #sensolHeader a:not(.sensol-header__shop-btn):not(.sensol-header__drawer-shop-btn),body:has(.air-hd) #sensolHeader button{color:#191c19!important}body:has(.air-hd) #sensolHeader .sensol-header__hamburger span{background:#191c19!important}
body:has(.air-hd) #sensolHeader .sensol-header__shop-btn,body:has(.air-hd) #sensolHeader .sensol-header__drawer-shop-btn{color:#f6f5ef!important}body:has(.air-hd) #sensolHeader svg{color:#191c19!important;stroke:#191c19!important}
@media(max-width:749px){.hd-title{top:11%}.hd-title>span{font-size:14px;line-height:1.5}.hd-copy{bottom:180px;padding:12px}.hd-copy h2{font-size:22px}.hd-bar{padding-bottom:80px}.hd-track{bottom:70px}}
</style>
<script>
(()=>{const root=document.getElementById('air-hd-{{ section.id }}');if(!root)return;
const urls=JSON.parse(root.querySelector('.hd-urls').textContent),canvas=root.querySelector('canvas'),ctx=canvas.getContext('2d'),wrap=root.querySelector('.hd-scroll'),scene=root.querySelector('.hd-scene'),hint=root.querySelector('.hd-hint'),title=root.querySelector('.hd-title'),buttons=[...root.querySelectorAll('[data-chapter]')];
const chapters=[['Make room for your practice.','Bring FLEX AIR into position. Your next movement starts here.'],['Find your movement.','The carriage slides with your movement. Take time to find your rhythm.'],['Connect to resistance.','Follow the setup shown here before moving into the next exercise.'],['Move with control.','Supported movement, a steady return. Focus on how you move.'],['Your practice continues.','Make space for a final stretch. Carry the practice beyond your class.']];
const reduced=matchMedia('(prefers-reduced-motion: reduce)').matches,cache=new Map(),pending=new Set(),failed=new Set();let desired=0,shown=-1,lastChapter=-1,active=0,queue=[],raf=0,disposed=false;
function size(){const r=scene.getBoundingClientRect(),dpr=Math.min(devicePixelRatio||1,1.5);canvas.width=Math.round(r.width*dpr);canvas.height=Math.round(r.height*dpr);if(shown>=0)draw(shown);}
function draw(index){const img=cache.get(index);if(!img)return;const w=canvas.width,h=canvas.height,mobile=scene.clientWidth<750,local=(desired%24)/23,zoom=reduced?1:1+.04*Math.sin(local*Math.PI),scale=Math.min(w/1920,h/1080)*zoom;
const iw=1920*scale,ih=1080*scale;let x=(w-iw)/2,y=(h-ih)/2;if(!mobile&&!reduced)x+=Math.sin(local*Math.PI*2)*w*.012;ctx.fillStyle='#eef0ed';ctx.fillRect(0,0,w,h);ctx.drawImage(img,x,y,iw,ih);shown=index;root.querySelector('.hd-poster').style.visibility='hidden';
const ch=Math.floor(index/24);if(ch!==lastChapter){lastChapter=ch;root.querySelector('.hd-count').textContent=String(ch+1).padStart(2,'0')+' / 05';root.querySelector('.hd-copy h2').textContent=chapters[ch][0];root.querySelector('.hd-copy p').textContent=chapters[ch][1];buttons.forEach((b,i)=>{if(i===ch)b.setAttribute('aria-current','step');else b.removeAttribute('aria-current');});}
title.style.opacity=String(Math.max(0,1-desired/18));root.querySelector('.hd-track i').style.width=(desired/119*100)+'%';hint.textContent=reduced?'Choose a chapter to explore':'Scroll to follow the movement ↓';}
function pump(){while(active<4&&queue.length){const i=queue.shift();if(cache.has(i)||pending.has(i)||failed.has(i))continue;active++;pending.add(i);const img=new Image();img.decoding='async';img.onload=()=>{active--;pending.delete(i);if(disposed)return;cache.set(i,img);if(i===desired||shown<0)draw(i);for(const k of cache.keys())if(Math.abs(k-desired)>30)cache.delete(k);pump();};img.onerror=()=>{active--;pending.delete(i);failed.add(i);if(i===desired)hint.textContent='This frame could not load. Choose another chapter.';pump();};img.src=urls[i];}}
function request(i){desired=Math.max(0,Math.min(119,Math.round(i)));queue=[desired];for(let d=1;d<=12;d++){if(desired+d<120)queue.push(desired+d);if(desired-d>=0)queue.push(desired-d);}if(cache.has(desired))draw(desired);pump();}
function update(){raf=0;if(reduced)return;const r=wrap.getBoundingClientRect(),range=wrap.offsetHeight-scene.offsetHeight;request(Math.max(0,Math.min(1,-r.top/Math.max(1,range)))*119);}
function onscroll(){if(!raf)raf=requestAnimationFrame(update);}
buttons.forEach((b,i)=>b.addEventListener('click',()=>{if(reduced){request(i*24);return;}const y=scrollY+wrap.getBoundingClientRect().top+(wrap.offsetHeight-scene.offsetHeight)*(i*24/119);window.scrollTo({top:y,behavior:'auto'});request(i*24);}));
size();request(0);window.addEventListener('scroll',onscroll,{passive:true});window.addEventListener('resize',size);
document.addEventListener('shopify:section:unload',e=>{if(e.detail.sectionId==='{{ section.id }}'){disposed=true;window.removeEventListener('scroll',onscroll);window.removeEventListener('resize',size);if(raf)cancelAnimationFrame(raf);cache.clear();}});
})();
</script>
{% schema %}
{"name":"FLEX AIR HD Story","settings":[{"type":"product","id":"product","label":"Product"},{"type":"text","id":"heading","label":"Heading","default":"Your practice continues."},{"type":"text","id":"description","label":"Description","default":"The movement you learn. The practice you make your own."},{"type":"text","id":"button_label","label":"Button label","default":"Explore FLEX AIR"}],"presets":[{"name":"FLEX AIR HD Story"}]}
{% endschema %}