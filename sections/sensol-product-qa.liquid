{%- liquid
  assign s = section.settings
-%}
<style>
#shopify-section-{{ section.id }} .sp-qa{font-family:'Inter',sans-serif;background:#1A1816;color:#F7F4F0;padding:100px 40px}
#shopify-section-{{ section.id }} .sp-qa__inner{max-width:800px;margin:0 auto}
#shopify-section-{{ section.id }} .sp-qa__eyebrow{font-size:10px;font-weight:500;letter-spacing:0.3em;text-transform:uppercase;color:#B5ADA4;margin-bottom:20px}
#shopify-section-{{ section.id }} .sp-qa__title{font-size:clamp(28px,4vw,40px);font-weight:300;letter-spacing:0.04em;margin-bottom:48px}
#shopify-section-{{ section.id }} .sp-qa__item{border-bottom:1px solid #2A2826}
#shopify-section-{{ section.id }} .sp-qa__item:first-of-type{border-top:1px solid #2A2826}
#shopify-section-{{ section.id }} .sp-qa__summary{display:flex;justify-content:space-between;align-items:center;padding:24px 0;cursor:pointer;list-style:none;user-select:none}
#shopify-section-{{ section.id }} .sp-qa__summary::-webkit-details-marker{display:none}
#shopify-section-{{ section.id }} .sp-qa__q{font-size:17px;font-weight:500;letter-spacing:0.02em}
#shopify-section-{{ section.id }} .sp-qa__toggle{width:20px;height:20px;position:relative;flex-shrink:0;margin-left:16px}
#shopify-section-{{ section.id }} .sp-qa__toggle::before,#shopify-section-{{ section.id }} .sp-qa__toggle::after{content:'';position:absolute;top:50%;left:50%;background:#B5ADA4;transition:transform 0.4s cubic-bezier(0.25,0.1,0.25,1)}
#shopify-section-{{ section.id }} .sp-qa__toggle::before{width:12px;height:1px;transform:translate(-50%,-50%)}
#shopify-section-{{ section.id }} .sp-qa__toggle::after{width:1px;height:12px;transform:translate(-50%,-50%)}
#shopify-section-{{ section.id }} .sp-qa__item[open] .sp-qa__toggle::after{transform:translate(-50%,-50%) rotate(90deg);opacity:0}
#shopify-section-{{ section.id }} .sp-qa__a{font-size:14px;line-height:1.7;color:#B5ADA4;padding:0 0 24px}
@media(max-width:768px){
#shopify-section-{{ section.id }} .sp-qa{padding:60px 20px}
#shopify-section-{{ section.id }} .sp-qa__q{font-size:15px}
}
</style>

<section class="sp-qa">
  <div class="sp-qa__inner">
    {%- if s.eyebrow != blank -%}
    <div class="sp-qa__eyebrow">{{ s.eyebrow }}</div>
    {%- endif -%}
    {%- if s.title != blank -%}
    <h2 class="sp-qa__title">{{ s.title }}</h2>
    {%- endif -%}
    {%- for block in section.blocks -%}
      {%- if block.type == 'qa' -%}
      <details class="sp-qa__item"{% if forloop.first and s.open_first %} open{% endif %} {{ block.shopify_attributes }}>
        <summary class="sp-qa__summary">
          <span class="sp-qa__q">{{ block.settings.question }}</span>
          <span class="sp-qa__toggle"></span>
        </summary>
        <p class="sp-qa__a">{{ block.settings.answer }}</p>
      </details>
      {%- endif -%}
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "SP Q&A",
  "tag": "section",
  "class": "sp-qa-section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Questions & Answers" },
    { "type": "text", "id": "title", "label": "Title", "default": "Common questions." },
    { "type": "checkbox", "id": "open_first", "label": "Open first item by default", "default": true }
  ],
  "blocks": [
    {
      "type": "qa",
      "name": "Q&A",
      "settings": [
        { "type": "text", "id": "question", "label": "Question", "default": "How long does shipping take?" },
        { "type": "textarea", "id": "answer", "label": "Answer", "default": "We ship within 2-3 business days from our Sydney warehouse." }
      ]
    }
  ],
  "presets": [{ "name": "SP Q&A", "blocks": [{ "type": "qa" }, { "type": "qa" }, { "type": "qa" }] }]
}
{% endschema %}
