{%- style -%}
  .sensol-header-section {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 1000;
    {%- if template.name == 'index' -%}
      background-color: transparent;
      transition: background-color 0.5s ease, box-shadow 0.5s ease;
    {%- else -%}
      background-color: #F7F4F0;
      box-shadow: 0 1px 0 #E3DFD9;
    {%- endif -%}
  }

  .sensol-header-section.scrolled {
    background-color: #F7F4F0;
    box-shadow: 0 1px 0 #E3DFD9;
  }

  [id^="shopify-section-sensol-header"] {
    background: transparent !important;
  }

  .sensol-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    max-width: 1600px;
    margin: 0 auto;
    padding: 0 48px;
    height: 80px;
  }

  .sensol-header__logo {
    display: flex;
    align-items: center;
    text-decoration: none;
    flex-shrink: 0;
  }

  .sensol-header__logo-img {
    max-height: 56px;
    max-width: {{ section.settings.logo_width }}px;
    height: auto;
    object-fit: contain;
  }

  .sensol-header__logo-text {
    font-family: 'Inter', sans-serif;
    font-size: 18px;
    font-weight: 300;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: #1A1816;
  }

  .sensol-header__nav {
    display: flex;
    align-items: center;
    gap: 32px;
    align-self: stretch;
  }

  .sensol-header__link {
    font-family: 'Inter', sans-serif;
    font-size: 11px;
    font-weight: 400;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: #1A1816;
    text-decoration: none;
    transition: color 0.3s ease;
  }

  .sensol-header__link:hover {
    color: #8A8279;
  }

  /* === DESKTOP MEGA MENU === */
  .sensol-header__nav-item {
    position: relative;
    display: flex;
    align-items: center;
    align-self: stretch;
  }

  .sensol-header__link--has-dropdown {
    display: flex;
    align-items: center;
    gap: 5px;
  }

  .sensol-header__chevron {
    display: inline-block;
    width: 7px;
    height: 7px;
    border-right: 1.5px solid currentColor;
    border-bottom: 1.5px solid currentColor;
    transform: rotate(45deg);
    margin-top: -3px;
    transition: transform 0.3s ease, margin-top 0.3s ease;
  }

  .sensol-header__nav-item:hover .sensol-header__chevron,
  .sensol-header__nav-item.active .sensol-header__chevron {
    transform: rotate(-135deg);
    margin-top: 1px;
  }

  .sensol-header__mega {
    position: absolute;
    top: calc(100% + 12px);
    left: 50%;
    transform: translateX(-50%) translateY(-8px);
    min-width: 560px;
    background: #F7F4F0;
    border: 1px solid #E3DFD9;
    box-shadow: 0 12px 40px rgba(26, 24, 22, 0.1);
    padding: 20px;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.3s ease, visibility 0.3s ease, transform 0.3s ease;
    z-index: 1002;
  }

  .sensol-header__nav-item:hover .sensol-header__mega,
  .sensol-header__nav-item.active .sensol-header__mega {
    opacity: 1;
    visibility: visible;
    transform: translateX(-50%) translateY(0);
  }

  .sensol-header__mega-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 16px;
  }

  .sensol-header__mega-card {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    border-radius: 8px;
    overflow: hidden;
    background: #FFFFFF;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .sensol-header__mega-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(26, 24, 22, 0.12);
  }

  .sensol-header__mega-img {
    width: 100%;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: #E3DFD9;
  }

  .sensol-header__mega-img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }

  .sensol-header__mega-card:hover .sensol-header__mega-img img {
    transform: scale(1.05);
  }

  .sensol-header__mega-info {
    padding: 14px 16px;
  }

  .sensol-header__mega-title {
    display: block;
    font-family: 'Inter', sans-serif;
    font-size: 14px;
    font-weight: 600;
    letter-spacing: 0.03em;
    color: #1A1816;
    margin-bottom: 4px;
  }

  .sensol-header__mega-desc {
    display: block;
    font-family: 'Inter', sans-serif;
    font-size: 12px;
    font-weight: 400;
    color: #8A8279;
    line-height: 1.4;
  }

  .sensol-header__mega-all {
    display: block;
    text-align: center;
    margin-top: 16px;
    padding-top: 14px;
    border-top: 1px solid #E3DFD9;
    font-family: 'Inter', sans-serif;
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: #1A1816;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .sensol-header__mega-all:hover {
    color: #8A8279;
  }

  .sensol-header__shop-btn {
    font-family: 'Inter', sans-serif;
    font-size: 11px;
    font-weight: 400;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: #F7F4F0;
    background-color: #1A1816;
    padding: 10px 24px;
    text-decoration: none;
    transition: background-color 0.3s ease;
    margin-left: 16px;
  }

  .sensol-header__shop-btn:hover {
    background-color: #2A2826;
  }

  .sensol-header__actions {
    display: flex;
    align-items: center;
    gap: 20px;
  }

  .sensol-header__icon-link {
    display: flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
    position: relative;
  }

  .cart-count-bubble {
    position: absolute;
    top: -6px;
    right: -8px;
    background: #1A1816;
    color: #F7F4F0;
    font-size: 9px;
    font-weight: 600;
    line-height: 1;
    min-width: 14px;
    height: 14px;
    border-radius: 7px;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0 3px;
    font-family: 'Inter', sans-serif;
  }

  .sensol-header__icon {
    color: #1A1816;
    transition: color 0.3s ease;
  }

  .sensol-header__icon-link:hover .sensol-header__icon {
    color: #8A8279;
  }

  .sensol-header__hamburger {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 24px;
    height: 24px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 0;
    position: relative;
    z-index: 1010;
  }

  .sensol-header__hamburger span {
    display: block;
    width: 100%;
    height: 1.5px;
    background-color: #1A1816;
    transition: all 0.4s ease;
  }

  .sensol-header__hamburger.active span:nth-child(1) {
    transform: rotate(45deg) translate(4px, 4px);
  }

  .sensol-header__hamburger.active span:nth-child(2) {
    opacity: 0;
  }

  .sensol-header__hamburger.active span:nth-child(3) {
    transform: rotate(-45deg) translate(4px, -4px);
  }

  /* Mobile drawer */
  .sensol-header__drawer {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: #F7F4F0;
    z-index: 999;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.5s cubic-bezier(0.25, 0.1, 0.25, 1), visibility 0.5s;
    padding: 100px 48px 48px;
    overflow-y: auto;
  }

  .sensol-header__drawer.open {
    opacity: 1;
    visibility: visible;
  }

  .sensol-header__drawer-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 36px;
    height: 100%;
  }

  .sensol-header__drawer-link {
    font-family: 'Inter', sans-serif;
    font-size: 18px;
    font-weight: 300;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: #1A1816;
    text-decoration: none;
  }

  .sensol-header__drawer-shop-btn {
    font-family: 'Inter', sans-serif;
    font-size: 13px;
    font-weight: 400;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: #F7F4F0;
    background-color: #1A1816;
    padding: 14px 40px;
    text-decoration: none;
    margin-top: 16px;
  }

  /* === MOBILE ACCORDION (text only) === */
  .sensol-header__drawer-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 100%;
  }

  .sensol-header__drawer-toggle {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    background: none;
    border: none;
    cursor: pointer;
    font-family: 'Inter', sans-serif;
    font-size: 18px;
    font-weight: 300;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: #1A1816;
    padding: 0;
  }

  .sensol-header__drawer-chevron {
    display: inline-block;
    width: 10px;
    height: 10px;
    border-right: 1.5px solid currentColor;
    border-bottom: 1.5px solid currentColor;
    transform: rotate(45deg);
    margin-top: -4px;
    transition: transform 0.3s ease, margin-top 0.3s ease;
  }

  .sensol-header__drawer-item.open .sensol-header__drawer-chevron {
    transform: rotate(-135deg);
    margin-top: 2px;
  }

  .sensol-header__drawer-children {
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.4s cubic-bezier(0.25, 0.1, 0.25, 1);
    display: flex;
    flex-direction: column;
    gap: 20px;
    align-items: center;
    width: 100%;
  }

  .sensol-header__drawer-item.open .sensol-header__drawer-children {
    max-height: 400px;
    padding-top: 24px;
  }

  .sensol-header__drawer-child-link {
    font-family: 'Inter', sans-serif;
    font-size: 15px;
    font-weight: 300;
    color: #8A8279;
    text-decoration: none;
    letter-spacing: 0.1em;
    text-align: center;
  }

  .sensol-header__drawer-actions {
    display: flex;
    gap: 32px;
    margin-top: 8px;
  }

  .sensol-header__drawer-actions a {
    font-family: 'Inter', sans-serif;
    font-size: 12px;
    font-weight: 400;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #8A8279;
    text-decoration: none;
  }

  body.drawer-open {
    overflow: hidden;
  }

  @media screen and (max-width: 767px) {
    .sensol-header__inner {
      padding: 0 24px;
      height: 64px;
    }
    .sensol-header__nav {
      display: none;
    }
    .sensol-header__hamburger {
      display: flex;
    }
    .sensol-header__logo-img {
      max-height: 40px;
      max-width: 140px;
    }
  }


  /* === NAV CLICK FIX === */
  .sensol-header-section-wrapper {
    position: relative !important;
    z-index: 1000 !important;
  }
  .sensol-header-section {
    pointer-events: auto !important;
  }
  .sensol-header__inner {
    position: relative;
    z-index: 1001;
  }
  .sensol-header__nav a,
  .sensol-header__link,
  .sensol-header__shop-btn,
  .sensol-header__actions a,
  .sensol-header__actions button {
    pointer-events: auto !important;
    position: relative;
    z-index: 1002;
  }
  .sensol-hero-section {
    position: relative !important;
    z-index: 1 !important;
  }

  /* === GLOBAL HEADER PADDING === */
  /* Push content below fixed header for templates without their own padding */
  #MainContent[data-template="collection"],
  #MainContent[data-template="search"],
  #MainContent[data-template="blog"],
  #MainContent[data-template="article"],
  #MainContent[data-template="cart"],
  #MainContent[data-template="page"],
  #MainContent[data-template="404"],
  #MainContent[data-template="list-collections"] {
    padding-top: 80px;
  }
  @media screen and (max-width: 767px) {
    #MainContent[data-template="collection"],
    #MainContent[data-template="search"],
    #MainContent[data-template="blog"],
    #MainContent[data-template="article"],
    #MainContent[data-template="cart"],
    #MainContent[data-template="page"],
    #MainContent[data-template="404"],
    #MainContent[data-template="list-collections"] {
      padding-top: 64px;
    }
  }
{%- endstyle -%}

<header class="sensol-header-section" id="sensolHeader">
  <div class="sensol-header__inner">
    <button type="button" class="sensol-header__hamburger" id="sensolHamburger" aria-label="Open menu" aria-expanded="false">
      <span></span>
      <span></span>
      <span></span>
    </button>

    <a href="/" class="sensol-header__logo">
      {%- if section.settings.logo != blank -%}
        <img
          src="{{ section.settings.logo | image_url: width: 400 }}"
          alt="{{ shop.name | escape }}"
          class="sensol-header__logo-img"
          width="{{ section.settings.logo_width }}"
          height="56"
          loading="eager"
        >
      {%- else -%}
        <span class="sensol-header__logo-text">SENSOL</span>
      {%- endif -%}
    </a>

    <nav class="sensol-header__nav">
      {%- for link in linklists[section.settings.menu].links -%}
        {%- if link.links != blank -%}
        <div class="sensol-header__nav-item" data-nav-dropdown>
          <a href="{{ link.url }}" class="sensol-header__link sensol-header__link--has-dropdown">{{ link.title | upcase }}<span class="sensol-header__chevron"></span></a>
          <div class="sensol-header__mega">
            <div class="sensol-header__mega-grid">
              {%- for child_link in link.links -%}
                {%- assign child_collection = child_link.object -%}
                {%- case child_collection.handle -%}
                  {%- when 'smart-series' -%}
                    {%- assign card_desc = 'Digital weight reformers with 1 kg precision, AI coaching' -%}
                  {%- when 'mechanical-series' -%}
                    {%- assign card_desc = 'Spring-based foldable reformers, beginner-friendly' -%}
                  {%- when 'flex-series' -%}
                    {%- assign card_desc = 'Space-saving foldable reformers for home practice' -%}
                  {%- else -%}
                    {%- assign card_desc = child_collection.description | strip_html | truncate: 60 -%}
                {%- endcase -%}
                <a href="{{ child_link.url }}" class="sensol-header__mega-card">
                  <div class="sensol-header__mega-img">
                    {%- if child_collection.image -%}
                      <img src="{{ child_collection.image | image_url: width: 400 }}" alt="{{ child_link.title | escape }}" loading="lazy" width="280" height="175">
                    {%- elsif child_collection.products.first.featured_image -%}
                      <img src="{{ child_collection.products.first.featured_image | image_url: width: 400 }}" alt="{{ child_link.title | escape }}" loading="lazy" width="280" height="175">
                    {%- endif -%}
                  </div>
                  <div class="sensol-header__mega-info">
                    <span class="sensol-header__mega-title">{{ child_link.title }}</span>
                    <span class="sensol-header__mega-desc">{{ card_desc }}</span>
                  </div>
                </a>
              {%- endfor -%}
            </div>
            <a href="/collections/all" class="sensol-header__mega-all">View All Products &rarr;</a>
          </div>
        </div>
        {%- else -%}
        <a href="{{ link.url }}" class="sensol-header__link">{{ link.title | upcase }}</a>
        {%- endif -%}
      {%- endfor -%}
      <a href="/collections/all" class="sensol-header__shop-btn">SHOP ALL</a>
    </nav>

    <div class="sensol-header__actions">
      {%- if section.settings.show_search -%}
        <a href="/search" class="sensol-header__icon-link" aria-label="Search">
          <svg class="sensol-header__icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="11" cy="11" r="7"/><path d="m21 21-4.35-4.35"/></svg>
        </a>
      {%- endif -%}
      <a href="/account" class="sensol-header__icon-link" aria-label="Account">
        <svg class="sensol-header__icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
      </a>
      <a href="/cart" id="cart-icon-bubble" class="sensol-header__icon-link" aria-label="Cart">
        <svg class="sensol-header__icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z"/><path d="M3 6h18"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>
        <span class="cart-count-bubble" id="cart-count-bubble" {% if cart.item_count == 0 %}style="display:none;"{% endif %}>{{ cart.item_count }}</span>
      </a>
    </div>
  </div>

  <div class="sensol-header__drawer" id="sensolDrawer" aria-hidden="true">
    <div class="sensol-header__drawer-inner">
      {%- for link in linklists[section.settings.menu].links -%}
        {%- if link.links != blank -%}
        <div class="sensol-header__drawer-item" data-drawer-accordion>
          <button type="button" class="sensol-header__drawer-toggle" onclick="var item=this.parentElement; item.classList.toggle('open'); this.setAttribute('aria-expanded', item.classList.contains('open'));">{{ link.title | upcase }}<span class="sensol-header__drawer-chevron"></span></button>
          <div class="sensol-header__drawer-children">
            {%- for child_link in link.links -%}
              <a href="{{ child_link.url }}" class="sensol-header__drawer-child-link">{{ child_link.title }}</a>
            {%- endfor -%}
            <a href="/collections/all" class="sensol-header__drawer-child-link">View All Products</a>
          </div>
        </div>
        {%- else -%}
        <a href="{{ link.url }}" class="sensol-header__drawer-link">{{ link.title | upcase }}</a>
        {%- endif -%}
      {%- endfor -%}
      <a href="/collections/all" class="sensol-header__drawer-shop-btn">SHOP ALL</a>
      <div class="sensol-header__drawer-actions">
        <a href="/account">ACCOUNT</a>
        <a href="/cart">CART</a>
      </div>
    </div>
  </div>
</header>

<script>
  (function() {
    var header = document.getElementById('sensolHeader');
    var hamburger = document.getElementById('sensolHamburger');
    var drawer = document.getElementById('sensolDrawer');

    if (!header) return;

    /* Scroll: add subtle bottom border */
    window.addEventListener('scroll', function() {
      if (window.scrollY > 10) {
        header.classList.add('scrolled');
      } else {
        header.classList.remove('scrolled');
      }
    }, { passive: true });

    /* Hamburger: toggle mobile menu */
    if (hamburger && drawer) {
      hamburger.addEventListener('click', function(e) {
        e.stopPropagation();
        var isOpen = drawer.classList.contains('open');
        if (isOpen) {
          drawer.classList.remove('open');
          hamburger.classList.remove('active');
          hamburger.setAttribute('aria-expanded', 'false');
          drawer.setAttribute('aria-hidden', 'true');
          document.body.classList.remove('drawer-open');
        } else {
          drawer.classList.add('open');
          hamburger.classList.add('active');
          hamburger.setAttribute('aria-expanded', 'true');
          drawer.setAttribute('aria-hidden', 'false');
          document.body.classList.add('drawer-open');
        }
      });

      /* Close drawer when clicking a link inside */
      drawer.addEventListener('click', function(e) {
        if (e.target.tagName === 'A' && !e.target.closest('[data-drawer-accordion] .sensol-header__drawer-toggle')) {
          drawer.classList.remove('open');
          hamburger.classList.remove('active');
          hamburger.setAttribute('aria-expanded', 'false');
          drawer.setAttribute('aria-hidden', 'true');
          document.body.classList.remove('drawer-open');
        }
      });
    }

    /* === DESKTOP DROPDOWN: click/touch support === */
    var navDropdowns = document.querySelectorAll('.sensol-header__nav-item[data-nav-dropdown]');
    navDropdowns.forEach(function(item) {
      var link = item.querySelector('.sensol-header__link--has-dropdown');
      if (!link) return;
      link.addEventListener('click', function(e) {
        /* On touch devices, toggle dropdown instead of navigating */
        if (window.matchMedia('(hover: none)').matches) {
          e.preventDefault();
          navDropdowns.forEach(function(other) {
            if (other !== item) other.classList.remove('active');
          });
          item.classList.toggle('active');
        }
      });
    });

    /* Close dropdown when clicking outside */
    document.addEventListener('click', function(e) {
      if (!e.target.closest('.sensol-header__nav-item[data-nav-dropdown]')) {
        navDropdowns.forEach(function(item) {
          item.classList.remove('active');
        });
      }
    });
  })();
</script>

<script>
  /* === AJAX ADD TO CART → OPENS CART DRAWER === */
  (function() {
    function updateCartCount(count) {
      var bubble = document.getElementById('cart-count-bubble');
      if (!bubble) return;
      bubble.textContent = count;
      bubble.style.display = count > 0 ? '' : 'none';
    }

    document.addEventListener('submit', function(evt) {
      var form = evt.target;
      if (!form || form.tagName !== 'FORM') return;
      var action = form.getAttribute('action') || '';
      if (action.indexOf('/cart/add') === -1) return;
      /* Skip if inside a <product-form> element (handled by product-form.js) */
      if (form.closest('product-form')) return;

      evt.preventDefault();

      var submitBtn = form.querySelector('[type="submit"]');
      var originalText = submitBtn ? submitBtn.innerHTML : '';
      if (submitBtn) {
        submitBtn.setAttribute('aria-disabled', 'true');
        submitBtn.style.opacity = '0.6';
        submitBtn.style.pointerEvents = 'none';
      }

      var formData = new FormData(form);

      fetch(window.routes.cart_add_url + '.js', {
        method: 'POST',
        body: formData,
        headers: { 'X-Requested-With': 'XMLHttpRequest' }
      })
      .then(function(resp) { return resp.json(); })
      .then(function(data) {
        if (data.status && data.status !== 200) {
          console.error('Cart error:', data.description || data.message);
          alert(data.description || data.message || 'Error adding to cart');
          return;
        }

        /* Publish cart update event for pubsub subscribers */
        if (window.publish && window.PUB_SUB_EVENTS) {
          window.publish(window.PUB_SUB_EVENTS.cartUpdate, {
            source: 'ajax-cart',
            productVariantId: formData.get('id'),
            cartData: data
          });
        }

        /* Open cart drawer */
        var cartDrawer = document.querySelector('cart-drawer');
        if (cartDrawer) {
          /* Fetch fresh cart-drawer section HTML */
          fetch('/cart?section_id=cart-drawer')
            .then(function(r) { return r.text(); })
            .then(function(html) {
              var parsed = new DOMParser().parseFromString(html, 'text/html');
              var newItems = parsed.querySelector('cart-drawer-items');
              var newFooter = parsed.querySelector('.cart-drawer__footer');
              if (newItems) {
                var existing = cartDrawer.querySelector('cart-drawer-items');
                if (existing) existing.replaceWith(newItems);
              }
              if (newFooter) {
                var existingFooter = cartDrawer.querySelector('.cart-drawer__footer');
                if (existingFooter) existingFooter.replaceWith(newFooter);
              }
              cartDrawer.classList.remove('is-empty');
              cartDrawer.open();
            })
            .catch(function(e) { console.error('Cart drawer update error:', e); });
        }

        /* Update cart count */
        fetch('/cart.js')
          .then(function(r) { return r.json(); })
          .then(function(cart) {
            updateCartCount(cart.item_count);
          })
          .catch(function() {});
      })
      .catch(function(err) {
        console.error('Add to cart error:', err);
        /* Fallback: redirect to cart */
        window.location = '/cart';
      })
      .finally(function() {
        if (submitBtn) {
          setTimeout(function() {
            submitBtn.removeAttribute('aria-disabled');
            submitBtn.style.opacity = '';
            submitBtn.style.pointerEvents = '';
          }, 1500);
        }
      });
    }, true); /* Use capture to intercept before product-form.js if present */
  })();
</script>

