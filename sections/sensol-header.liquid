{%- style -%}
  .sensol-header-section {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 1000;
    background-color: #F7F4F0;
    transition: box-shadow 0.5s ease;
  }

  .sensol-header-section.scrolled {
    box-shadow: 0 1px 0 #E3DFD9;
  }

  [id^="shopify-section-sensol-header"] {
    background: transparent !important;
  }

  .sensol-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    max-width: 1600px;
    margin: 0 auto;
    padding: 0 48px;
    height: 80px;
  }

  .sensol-header__logo {
    display: flex;
    align-items: center;
    text-decoration: none;
    flex-shrink: 0;
  }

  .sensol-header__logo-img {
    max-height: 32px;
    max-width: 120px;
    object-fit: contain;
  }

  .sensol-header__logo-text {
    font-family: 'Inter', sans-serif;
    font-size: 18px;
    font-weight: 300;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: #1A1816;
  }

  .sensol-header__nav {
    display: flex;
    align-items: center;
    gap: 32px;
  }

  .sensol-header__link {
    font-family: 'Inter', sans-serif;
    font-size: 11px;
    font-weight: 400;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: #1A1816;
    text-decoration: none;
    transition: color 0.3s ease;
  }

  .sensol-header__link:hover {
    color: #8A8279;
  }

  .sensol-header__shop-btn {
    font-family: 'Inter', sans-serif;
    font-size: 11px;
    font-weight: 400;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: #F7F4F0;
    background-color: #1A1816;
    padding: 10px 24px;
    text-decoration: none;
    transition: background-color 0.3s ease;
    margin-left: 16px;
  }

  .sensol-header__shop-btn:hover {
    background-color: #2A2826;
  }

  .sensol-header__actions {
    display: flex;
    align-items: center;
    gap: 20px;
  }

  .sensol-header__icon-link {
    display: flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
  }

  .sensol-header__icon {
    color: #1A1816;
    transition: color 0.3s ease;
  }

  .sensol-header__icon-link:hover .sensol-header__icon {
    color: #8A8279;
  }

  .sensol-header__hamburger {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 24px;
    height: 24px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 0;
    position: relative;
    z-index: 1010;
  }

  .sensol-header__hamburger span {
    display: block;
    width: 100%;
    height: 1.5px;
    background-color: #1A1816;
    transition: all 0.4s ease;
  }

  .sensol-header__hamburger.active span:nth-child(1) {
    transform: rotate(45deg) translate(4px, 4px);
  }

  .sensol-header__hamburger.active span:nth-child(2) {
    opacity: 0;
  }

  .sensol-header__hamburger.active span:nth-child(3) {
    transform: rotate(-45deg) translate(4px, -4px);
  }

  /* Mobile drawer */
  .sensol-header__drawer {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: #F7F4F0;
    z-index: 999;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.5s cubic-bezier(0.25, 0.1, 0.25, 1), visibility 0.5s;
    padding: 100px 48px 48px;
    overflow-y: auto;
  }

  .sensol-header__drawer.open {
    opacity: 1;
    visibility: visible;
  }

  .sensol-header__drawer-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 36px;
    height: 100%;
  }

  .sensol-header__drawer-link {
    font-family: 'Inter', sans-serif;
    font-size: 18px;
    font-weight: 300;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: #1A1816;
    text-decoration: none;
  }

  .sensol-header__drawer-shop-btn {
    font-family: 'Inter', sans-serif;
    font-size: 13px;
    font-weight: 400;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: #F7F4F0;
    background-color: #1A1816;
    padding: 14px 40px;
    text-decoration: none;
    margin-top: 16px;
  }

  .sensol-header__drawer-actions {
    display: flex;
    gap: 32px;
    margin-top: 8px;
  }

  .sensol-header__drawer-actions a {
    font-family: 'Inter', sans-serif;
    font-size: 12px;
    font-weight: 400;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #8A8279;
    text-decoration: none;
  }

  body.drawer-open {
    overflow: hidden;
  }

  @media screen and (max-width: 767px) {
    .sensol-header__inner {
      padding: 0 24px;
      height: 64px;
    }
    .sensol-header__nav {
      display: none;
    }
    .sensol-header__hamburger {
      display: flex;
    }
    .sensol-header__logo-img {
      max-height: 24px;
      max-width: 80px;
    }
  }
{%- endstyle -%}

<header class="sensol-header-section" id="sensolHeader">
  <div class="sensol-header__inner">
    <button type="button" class="sensol-header__hamburger" id="sensolHamburger" aria-label="Open menu" aria-expanded="false">
      <span></span>
      <span></span>
      <span></span>
    </button>

    <a href="/" class="sensol-header__logo">
      {%- if section.settings.logo != blank -%}
        <img
          src="{{ section.settings.logo | image_url: width: 200 }}"
          alt="{{ shop.name | escape }}"
          class="sensol-header__logo-img"
          width="{{ section.settings.logo_width }}"
          height="32"
          loading="eager"
        >
      {%- else -%}
        <span class="sensol-header__logo-text">SENSOL</span>
      {%- endif -%}
    </a>

    <nav class="sensol-header__nav">
      {%- for link in linklists[section.settings.menu].links -%}
        <a href="{{ link.url }}" class="sensol-header__link">{{ link.title | upcase }}</a>
      {%- endfor -%}
      <a href="/collections/all" class="sensol-header__shop-btn">SHOP ALL</a>
    </nav>

    <div class="sensol-header__actions">
      {%- if section.settings.show_search -%}
        <a href="/search" class="sensol-header__icon-link" aria-label="Search">
          <svg class="sensol-header__icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="11" cy="11" r="7"/><path d="m21 21-4.35-4.35"/></svg>
        </a>
      {%- endif -%}
      <a href="/account" class="sensol-header__icon-link" aria-label="Account">
        <svg class="sensol-header__icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
      </a>
      <a href="/cart" class="sensol-header__icon-link" aria-label="Cart">
        <svg class="sensol-header__icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z"/><path d="M3 6h18"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>
      </a>
    </div>
  </div>

  <div class="sensol-header__drawer" id="sensolDrawer" aria-hidden="true">
    <div class="sensol-header__drawer-inner">
      {%- for link in linklists[section.settings.menu].links -%}
        <a href="{{ link.url }}" class="sensol-header__drawer-link">{{ link.title | upcase }}</a>
      {%- endfor -%}
      <a href="/collections/all" class="sensol-header__drawer-shop-btn">SHOP ALL</a>
      <div class="sensol-header__drawer-actions">
        <a href="/account">ACCOUNT</a>
        <a href="/cart">CART</a>
      </div>
    </div>
  </div>
</header>

<script>
  (function() {
    var header = document.getElementById('sensolHeader');
    var hamburger = document.getElementById('sensolHamburger');
    var drawer = document.getElementById('sensolDrawer');

    if (!header) return;

    /* Scroll: add subtle bottom border */
    window.addEventListener('scroll', function() {
      if (window.scrollY > 10) {
        header.classList.add('scrolled');
      } else {
        header.classList.remove('scrolled');
      }
    }, { passive: true });

    /* Hamburger: toggle mobile menu */
    if (hamburger && drawer) {
      hamburger.addEventListener('click', function(e) {
        e.stopPropagation();
        var isOpen = drawer.classList.contains('open');
        if (isOpen) {
          drawer.classList.remove('open');
          hamburger.classList.remove('active');
          hamburger.setAttribute('aria-expanded', 'false');
          drawer.setAttribute('aria-hidden', 'true');
          document.body.classList.remove('drawer-open');
        } else {
          drawer.classList.add('open');
          hamburger.classList.add('active');
          hamburger.setAttribute('aria-expanded', 'true');
          drawer.setAttribute('aria-hidden', 'false');
          document.body.classList.add('drawer-open');
        }
      });

      /* Close drawer when clicking a link inside */
      drawer.addEventListener('click', function(e) {
        if (e.target.tagName === 'A') {
          drawer.classList.remove('open');
          hamburger.classList.remove('active');
          hamburger.setAttribute('aria-expanded', 'false');
          drawer.setAttribute('aria-hidden', 'true');
          document.body.classList.remove('drawer-open');
        }
      });
    }
  })();
</script>

{% schema %}
{
  "name": "SENSOL Header",
  "tag": "section",
  "class": "sensol-header-section-wrapper",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo"
    },
    {
      "type": "range",
      "id": "logo_width",
      "min": 50,
      "max": 200,
      "step": 5,
      "unit": "px",
      "default": 120,
      "label": "Logo width"
    },
    {
      "type": "link_list",
      "id": "menu",
      "default": "main-menu",
      "label": "Navigation menu"
    },
    {
      "type": "checkbox",
      "id": "show_search",
      "default": true,
      "label": "Show search icon"
    }
  ],
  "presets": [
    {
      "name": "SENSOL Header"
    }
  ]
}
{% endschema %}
