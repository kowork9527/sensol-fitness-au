{%- style -%}
  /* CRITICAL: Force wrapper transparent — Dawn adds bg to .shopify-section */
  #shopify-section-sensol-header,
  .shopify-section.sensol-header-section-wrapper {
    background: transparent !important;
    margin: 0 !important;
    padding: 0 !important;
  }

  .sensol-header-section {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 1000;
    transition: background-color 0.7s cubic-bezier(0.25, 0.1, 0.25, 1),
                box-shadow 0.7s cubic-bezier(0.25, 0.1, 0.25, 1);
    background-color: transparent;
  }

  .sensol-header-section.scrolled {
    background-color: #F7F4F0;
    box-shadow: 0 1px 0 #D4CEC6;
  }

  .sensol-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 4rem;
    max-width: 1600px;
    margin: 0 auto;
    height: 80px;
  }

  @media (min-width: 768px) {
    .sensol-header__inner {
      height: 96px;
      padding: 0 4rem;
    }
  }

  .sensol-header__logo {
    display: flex;
    align-items: center;
    text-decoration: none;
    flex-shrink: 0;
    position: relative;
    z-index: 10;
  }

  .sensol-header__logo-img {
    height: auto;
    width: auto;
    max-height: 28px;
    max-width: 100px;
    object-fit: contain;
    transition: filter 0.7s ease;
  }

  @media (min-width: 768px) {
    .sensol-header__logo-img {
      max-height: 36px;
      max-width: 120px;
    }
  }

  /* White logo on hero (transparent), normal on scroll */
  .sensol-header-section:not(.scrolled) .sensol-header__logo-img {
    filter: brightness(0) invert(1);
  }

  .sensol-header__nav {
    display: none;
    align-items: center;
    gap: 48px;
  }

  @media (min-width: 768px) {
    .sensol-header__nav {
      display: flex;
    }
  }

  .sensol-header__link {
    font-family: 'Inter', sans-serif;
    font-size: 11px;
    font-weight: 400;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: #ffffff !important;
    text-decoration: none;
    transition: color 0.7s ease, opacity 0.3s ease;
    position: relative;
  }

  .sensol-header__link::after {
    content: '';
    position: absolute;
    bottom: -2px;
    left: 0;
    width: 0;
    height: 1px;
    background: currentColor;
    transition: width 0.3s cubic-bezier(0.25, 0.1, 0.25, 1);
  }

  .sensol-header__link:hover::after {
    width: 100%;
  }

  .sensol-header-section.scrolled .sensol-header__link {
    color: #1A1816 !important;
  }

  .sensol-header__shop-btn {
    font-family: 'Inter', sans-serif;
    font-size: 11px;
    font-weight: 400;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: #ffffff;
    background-color: rgba(255,255,255,0.1);
    padding: 12px 24px;
    text-decoration: none;
    transition: background-color 0.5s ease, color 0.7s ease;
  }

  .sensol-header__shop-btn:hover {
    background-color: rgba(255,255,255,0.2);
  }

  .sensol-header-section.scrolled .sensol-header__shop-btn {
    color: #F7F4F0;
    background-color: #1A1816;
  }

  .sensol-header-section.scrolled .sensol-header__shop-btn:hover {
    background-color: #2a2724;
  }

  .sensol-header__actions {
    display: flex;
    align-items: center;
    gap: 20px;
    position: relative;
    z-index: 10;
  }

  .sensol-header__icon-link {
    display: flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
  }

  .sensol-header__icon {
    color: #ffffff !important;
    transition: color 0.7s ease;
  }

  .sensol-header-section.scrolled .sensol-header__icon {
    color: #1A1816 !important;
  }

  .sensol-header__hamburger {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 24px;
    height: 24px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 0;
    position: relative;
    z-index: 10;
  }

  @media (min-width: 768px) {
    .sensol-header__hamburger {
      display: none;
    }
  }

  .sensol-header__hamburger span {
    display: block;
    width: 100%;
    height: 1px;
    background-color: #ffffff !important;
    transition: all 0.5s ease;
  }

  .sensol-header-section.scrolled .sensol-header__hamburger span {
    background-color: #1A1816 !important;
  }

  .sensol-header__hamburger.active span:nth-child(1) {
    transform: rotate(45deg) translate(4px, 4px);
  }

  .sensol-header__hamburger.active span:nth-child(2) {
    opacity: 0;
  }

  .sensol-header__hamburger.active span:nth-child(3) {
    transform: rotate(-45deg) translate(4px, -4px);
  }

  /* Mobile drawer */
  .sensol-header__drawer {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: #F7F4F0;
    z-index: 999;
    opacity: 0;
    visibility: hidden;
    transition: all 0.7s cubic-bezier(0.25, 0.1, 0.25, 1);
    padding: 100px 48px 48px;
  }

  .sensol-header__drawer.open {
    opacity: 1;
    visibility: visible;
  }

  @media (min-width: 769px) {
    .sensol-header__drawer {
      display: none;
    }
  }

  .sensol-header__drawer-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 40px;
    height: 100%;
  }

  .sensol-header__drawer-link {
    font-family: 'Inter', sans-serif;
    font-size: 14px;
    font-weight: 300;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: #1A1816;
    text-decoration: none;
  }

  .sensol-header__drawer-shop-btn {
    font-family: 'Inter', sans-serif;
    font-size: 11px;
    font-weight: 400;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: #F7F4F0;
    background-color: #1A1816;
    padding: 12px 32px;
    text-decoration: none;
    margin-top: 16px;
  }

  body.drawer-open {
    overflow: hidden;
  }

  @media screen and (max-width: 767px) {
    .sensol-header__inner {
      padding: 0 24px;
      height: 64px;
    }
    .sensol-header__nav {
      display: none;
    }
    .sensol-header__hamburger {
      display: flex;
    }
    .sensol-header__logo-img {
      max-height: 24px;
      max-width: 80px;
    }
  }
{%- endstyle -%}

<header class="sensol-header-section" id="sensolHeader">
  <div class="sensol-header__inner">
    <button class="sensol-header__hamburger" id="sensolHamburger" aria-label="Menu">
      <span></span>
      <span></span>
      <span></span>
    </button>

    <a href="/" class="sensol-header__logo">
      {%- if section.settings.logo_image != blank -%}
        <img
          src="{{ section.settings.logo_image | image_url: width: 200 }}"
          alt="{{ shop.name | escape }}"
          class="sensol-header__logo-img"
          width="{{ section.settings.logo_width }}"
          height="auto"
          loading="eager"
        >
      {%- else -%}
        <img
          src="https://cdn.shopify.com/s/files/1/1020/4263/2324/files/imgi_46_sensol.png?v=1785228479"
          alt="SENSOL"
          class="sensol-header__logo-img"
          width="{{ section.settings.logo_width }}"
          height="auto"
          loading="eager"
        >
      {%- endif -%}
    </a>

    <nav class="sensol-header__nav">
      {%- for link in linklists[section.settings.menu].links -%}
        <a href="{{ link.url }}" class="sensol-header__link">{{ link.title | upcase }}</a>
      {%- endfor -%}
      <a href="/collections/all" class="sensol-header__shop-btn">SHOP ALL</a>
    </nav>

    <div class="sensol-header__actions">
      {%- if section.settings.show_search -%}
        <a href="/search" class="sensol-header__icon-link" aria-label="Search">
          <svg class="sensol-header__icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="11" cy="11" r="7"/><path d="m21 21-4.35-4.35"/></svg>
        </a>
      {%- endif -%}
      <a href="/account" class="sensol-header__icon-link" aria-label="Account">
        <svg class="sensol-header__icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
      </a>
      <a href="/cart" class="sensol-header__icon-link" aria-label="Cart">
        <svg class="sensol-header__icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z"/><path d="M3 6h18"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>
      </a>
    </div>
  </div>

  <div class="sensol-header__drawer" id="sensolDrawer">
    <div class="sensol-header__drawer-inner">
      {%- for link in linklists[section.settings.menu].links -%}
        <a href="{{ link.url }}" class="sensol-header__drawer-link">{{ link.title | upcase }}</a>
      {%- endfor -%}
      <a href="/collections/all" class="sensol-header__drawer-shop-btn">SHOP ALL</a>
      <div class="sensol-header__drawer-actions">
        <a href="/account" class="sensol-header__drawer-link">ACCOUNT</a>
        <a href="/cart" class="sensol-header__drawer-link">CART</a>
      </div>
    </div>
  </div>
</header>

<script>
  (function() {
    var header = document.getElementById('sensolHeader');
    var hamburger = document.getElementById('sensolHamburger');
    var drawer = document.getElementById('sensolDrawer');

    window.addEventListener('scroll', function() {
      if (window.scrollY > 60) {
        header.classList.add('scrolled');
      } else {
        header.classList.remove('scrolled');
      }
    });

    if (hamburger && drawer) {
      hamburger.addEventListener('click', function() {
        hamburger.classList.toggle('active');
        drawer.classList.toggle('open');
        document.body.classList.toggle('drawer-open');
      });
    }
  })();
</script>

{% schema %}
{
  "name": "SENSOL Header",
  "tag": "section",
  "class": "sensol-header-section-wrapper",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo_image",
      "label": "Logo image"
    },
    {
      "type": "range",
      "id": "logo_width",
      "min": 50,
      "max": 200,
      "step": 5,
      "unit": "px",
      "default": 120,
      "label": "Logo width"
    },
    {
      "type": "link_list",
      "id": "menu",
      "default": "main-menu",
      "label": "Navigation menu"
    },
    {
      "type": "checkbox",
      "id": "show_search",
      "default": true,
      "label": "Show search icon"
    }
  ],
  "presets": [
    {
      "name": "SENSOL Header"
    }
  ]
}
{% endschema %}
