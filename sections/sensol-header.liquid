<style>
/* NAV CLICK INLINE FIX - bypasses CSS cache */
.sensol-header-section-wrapper,
#shopify-section-sensol-header {
  position: relative !important;
  z-index: 1000 !important;
}
.sensol-hero-section,
#shopify-section-sensol-hero {
  position: relative !important;
  z-index: 1 !important;
}
.sensol-header__nav,
.sensol-header__nav a,
.sensol-header__link,
.sensol-header__shop-btn,
.sensol-header__actions a,
.sensol-header__actions button,
.sensol-header__drawer-toggle,
.sensol-header__drawer-child-link,
.sensol-header__logo,
.sensol-header__hamburger {
  pointer-events: auto !important;
  position: relative;
  z-index: 1002;
}
</style>
<script>
/* === NAV CLICK JS FIX === */
(function() {
  function navClickFix() {
    // Fix header wrapper z-index
    var headerWrapper = document.querySelector('.sensol-header-section-wrapper') || document.getElementById('shopify-section-sensol-header');
    if (headerWrapper) {
      headerWrapper.style.setProperty('position', 'relative', 'important');
      headerWrapper.style.setProperty('z-index', '1000', 'important');
    }
    
    // Fix hero wrapper z-index - keep it below header
    var heroWrapper = document.querySelector('.sensol-hero-section') || document.getElementById('shopify-section-sensol-hero');
    if (heroWrapper) {
      heroWrapper.style.setProperty('position', 'relative', 'important');
      heroWrapper.style.setProperty('z-index', '1', 'important');
    }
    
    // Ensure all header interactive elements are clickable
    var headerSection = document.querySelector('.sensol-header-section');
    if (headerSection) {
      headerSection.style.setProperty('pointer-events', 'auto', 'important');
    }
    
    var navElements = document.querySelectorAll('.sensol-header__nav a, .sensol-header__link, .sensol-header__shop-btn, .sensol-header__actions a, .sensol-header__actions button, .sensol-header__drawer-toggle, .sensol-header__drawer-child-link, .sensol-header__logo, .sensol-header__hamburger');
    navElements.forEach(function(el) {
      el.style.setProperty('pointer-events', 'auto', 'important');
      el.style.setProperty('position', 'relative');
      el.style.setProperty('z-index', '1002');
    });
  }
  
  // Run immediately
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', navClickFix);
  } else {
    navClickFix();
  }
  
  // Re-run after a delay to catch any dynamic content
  setTimeout(navClickFix, 500);
  setTimeout(navClickFix, 1500);
})();
</script>
