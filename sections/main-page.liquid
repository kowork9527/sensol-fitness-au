{%- if page.handle == 'contact' -%}
  {%- section 'sensol-contact' -%}
{%- elsif page.handle == 'philosophy' -%}
  {%- render 'sensol-philosophy-page' -%}
{%- elsif page.handle == 'shipping-policy' or page.handle contains 'shipping' -%}
  {%- section 'sensol-shipping-hero' -%}
  {%- section 'sensol-shipping-domestic' -%}
  {%- section 'sensol-shipping-fees' -%}
  {%- section 'sensol-shipping-requirements' -%}
  {%- section 'sensol-shipping-dimensions' -%}
  {%- section 'sensol-shipping-international' -%}
  {%- section 'sensol-shipping-issues' -%}
  {%- section 'sensol-shipping-returns' -%}
{%- elsif page.handle == 'refund-policy' or page.handle contains 'refund' or page.handle contains 'return' -%}
  {%- render 'sensol-refund-page' -%}
{%- elsif page.handle == 'terms-of-service' or page.handle contains 'terms' -%}
  {%- render 'sensol-tos-page' -%}
{%- elsif page.handle == 'privacy-policy' or page.handle contains 'privacy' -%}
  {%- render 'sensol-privacy-page' -%}
{%- elsif page.handle == 'warranty' or page.handle contains 'warranty' -%}
  {%- render 'sensol-warranty-page' -%}
{%- elsif page.handle == 'training-system' or page.handle contains 'training' or page.handle == 'app' -%}
  {%- render 'sensol-training-system-page' -%}
{%- elsif page.handle == 'senzine' or page.handle contains 'senzine' -%}
  {%- render 'sensol-senzine-page' -%}
{%- elsif page.handle == 'engineering' or page.handle contains 'engineering' -%}
  {%- render 'sensol-engineering-page' -%}
{%- else -%}
  {{ 'section-main-page.css' | asset_url | stylesheet_tag }}

  {%- style -%}
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
      padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
    }

    @media screen and (min-width: 750px) {
      .section-{{ section.id }}-padding {
        padding-top: {{ section.settings.padding_top }}px;
        padding-bottom: {{ section.settings.padding_bottom }}px;
      }
    }
  {%- endstyle -%}

  <div class="page-width page-width--narrow section-{{ section.id }}-padding">
    <h1 class="main-page-title page-title h0{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--fade-in{% endif %}">
      {{ page.title | escape }}
    </h1>
    <div class="rte{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
      {{ page.content }}
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "t:sections.main-page.name",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    }
  ]
}
{% endschema %}
