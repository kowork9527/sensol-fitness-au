{%- style -%}
  .sc-spt-smart-{{ section.id }} {
    font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
    width: 100%;
    background: #F7F4F0; color: #1A1816;
    border-top: 1px solid #D4CEC6;
    border-bottom: 1px solid #D4CEC6;
  }
  .sc-spt-smart-{{ section.id }}__inner {
    max-width: 1400px; margin: 0 auto;
    padding: 80px 40px;
    display: grid;
    grid-template-columns: 1fr 1.5fr;
    gap: 80px;
    align-items: center;
  }
  .sc-spt-smart-{{ section.id }}__label {
    font-size: 11px; font-weight: 500;
    letter-spacing: 0.3em; text-transform: uppercase;
    color: #8A8279; margin-bottom: 12px;
  }
  .sc-spt-smart-{{ section.id }}__title {
    font-size: clamp(28px, 4vw, 42px);
    font-weight: 300; letter-spacing: 0.08em;
    text-transform: uppercase; margin: 0 0 20px;
  }
  .sc-spt-smart-{{ section.id }}__desc {
    font-size: 14px; line-height: 1.8;
    margin: 0 0 28px; color: #8A8279;
  }
  .sc-spt-smart-{{ section.id }}__features {
    list-style: none; padding: 0; margin: 0;
  }
  .sc-spt-smart-{{ section.id }}__features li {
    font-size: 13px; font-weight: 400;
    letter-spacing: 0.02em;
    padding: 12px 0;
    display: flex; align-items: center; gap: 12px;
    color: #1A1816;
    border-top: 1px solid #D4CEC6;
  }
  .sc-spt-smart-{{ section.id }}__features li:last-child {
    border-bottom: 1px solid #D4CEC6;
  }
  .sc-spt-smart-{{ section.id }}__features li::before {
    content: '';
    width: 4px; height: 4px;
    background: #1A1816;
    flex-shrink: 0;
  }
  .sc-spt-smart-{{ section.id }}__visual {
    aspect-ratio: 16/10;
    background: #fff;
    overflow: hidden;
  }
  .sc-spt-smart-{{ section.id }}__visual-placeholder {
    width: 100%; height: 100%;
    display: flex; align-items: center; justify-content: center;
    font-family: 'JetBrains Mono', monospace;
    font-size: 14px; letter-spacing: 0.2em;
    text-transform: uppercase;
    color: #8A8279;
  }

  @media screen and (max-width: 1024px) {
    .sc-spt-smart-{{ section.id }}__inner {
      grid-template-columns: 1fr; gap: 40px;
    }
  }
  @media screen and (max-width: 768px) {
    .sc-spt-smart-{{ section.id }}__inner { padding: 60px 20px; }
  }
{%- endstyle -%}

<section class="sc-spt-smart-{{ section.id }}">
  <div class="sc-spt-smart-{{ section.id }}__inner">
    <div class="sc-spt-smart-{{ section.id }}__content">
      <p class="sc-spt-smart-{{ section.id }}__label">Series 01</p>
      <h2 class="sc-spt-smart-{{ section.id }}__title">Smart Series</h2>
      <p class="sc-spt-smart-{{ section.id }}__desc">Digital weight reformers powered by servo motors. 0.5 kg precision, dual-function Pilates and strength training, AI-driven coaching.</p>
      <ul class="sc-spt-smart-{{ section.id }}__features">
        <li>Digital weight control - 0.5 kg increments</li>
        <li>Dual-function: Pilates + Strength training</li>
        <li>Servo motor driven resistance system</li>
        <li>Vesta Sensol App with AI coaching</li>
      </ul>
    </div>
    <div class="sc-spt-smart-{{ section.id }}__visual">
      <div class="sc-spt-smart-{{ section.id }}__visual-placeholder">Smart Series</div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Collection Spotlight Smart",
  "tag": "section",
  "class": "sensol-spotlight-smart",
  "settings": [],
  "presets": [{ "name": "Collection Spotlight Smart" }]
}
{% endschema %}
