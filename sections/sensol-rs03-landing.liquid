{%- liquid
  assign p = product
-%}
{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: 160px;
    padding-bottom: 60px;
    padding-left: 20px;
    padding-right: 20px;
    background: #F7F4F0;
  }
  .rs03-product-{{ section.id }} {
    max-width: 1200px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 60px;
    align-items: start;
    font-family: 'Inter', sans-serif;
    color: #1A1816;
  }
  .rs03-gallery-{{ section.id }} {
    position: sticky;
    top: 100px;
  }
  .rs03-gallery-main-{{ section.id }} {
    aspect-ratio: 1 / 1;
    background: #fff;
    overflow: hidden;
    margin-bottom: 16px;
  }
  .rs03-gallery-main-{{ section.id }} img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .rs03-gallery-thumbs-{{ section.id }} {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 8px;
  }
  .rs03-gallery-thumb-{{ section.id }} {
    aspect-ratio: 1 / 1;
    background: #fff;
    overflow: hidden;
    cursor: pointer;
    border: 2px solid transparent;
    transition: border-color 0.2s;
  }
  .rs03-gallery-thumb-{{ section.id }}:hover {
    border-color: #1A1816;
  }
  .rs03-gallery-thumb-{{ section.id }} img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .rs03-info-{{ section.id }} {
    padding: 20px 0;
  }
  .rs03-info-title-{{ section.id }} {
    font-size: 32px;
    font-weight: 300;
    letter-spacing: 0.04em;
    margin: 0 0 16px;
    color: #1A1816;
  }
  .rs03-info-price-{{ section.id }} {
    font-size: 24px;
    font-weight: 400;
    color: #1A1816;
    margin-bottom: 24px;
    letter-spacing: 0.02em;
  }
  .rs03-info-price-{{ section.id }} s {
    color: #8A8279;
    margin-right: 12px;
    font-size: 18px;
  }
  .rs03-info-stock-{{ section.id }} {
    font-size: 12px;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    margin-bottom: 32px;
    padding: 8px 16px;
    display: inline-block;
  }
  .rs03-info-stock-in-{{ section.id }} {
    background: #E8F5E9;
    color: #2E7D32;
  }
  .rs03-info-stock-out-{{ section.id }} {
    background: #FFEBEE;
    color: #C62828;
  }
  .rs03-qty-{{ section.id }} {
    display: flex;
    align-items: center;
    gap: 16px;
    margin-bottom: 24px;
  }
  .rs03-qty-label-{{ section.id }} {
    font-size: 12px;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: #8A8279;
  }
  .rs03-qty-input-{{ section.id }} {
    width: 80px;
    padding: 12px;
    border: 1px solid #D4CEC6;
    background: #fff;
    font-size: 16px;
    text-align: center;
  }
  .rs03-add-{{ section.id }} {
    width: 100%;
    padding: 20px;
    background: #1A1816;
    color: #F7F4F0;
    border: none;
    font-size: 14px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    cursor: pointer;
    transition: background 0.3s;
    font-weight: 500;
  }
  .rs03-add-{{ section.id }}:hover {
    background: #2A2826;
  }
  .rs03-add-{{ section.id }}:disabled {
    background: #8A8279;
    cursor: not-allowed;
  }
  @media screen and (max-width: 768px) {
    .rs03-product-{{ section.id }} {
      grid-template-columns: 1fr;
      gap: 32px;
    }
    .rs03-gallery-{{ section.id }} {
      position: static;
    }
    .rs03-info-title-{{ section.id }} {
      font-size: 24px;
    }
    .rs03-info-price-{{ section.id }} {
      font-size: 20px;
    }
  }
{%- endstyle -%}

<div class="section-{{ section.id }}-padding">
  <div class="rs03-product-{{ section.id }}">
    <div class="rs03-gallery-{{ section.id }}">
      <div class="rs03-gallery-main-{{ section.id }}">
        {%- if p.featured_image -%}
          {{ p.featured_image | image_url: width: 1200 | image_tag: loading: 'eager' }}
        {%- else -%}
          <div style="display:flex;align-items:center;justify-content:center;height:100%;color:#8A8279">No image</div>
        {%- endif -%}
      </div>
      {%- if p.images.size > 1 -%}
        <div class="rs03-gallery-thumbs-{{ section.id }}">
          {%- for img in p.images limit: 4 -%}
            <div class="rs03-gallery-thumb-{{ section.id }}">
              {{ img | image_url: width: 300 | image_tag: loading: 'lazy' }}
            </div>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>

    <div class="rs03-info-{{ section.id }}">
      <h1 class="rs03-info-title-{{ section.id }}">{{ p.title | default: 'Sensol RS03' }}</h1>

      <div class="rs03-info-price-{{ section.id }}">
        {%- if p.compare_at_price > p.price -%}
          <s>{{ p.compare_at_price | money }}</s>
        {%- endif -%}
        {{ p.price | money }}
      </div>

      {%- if p.available -%}
        <div class="rs03-info-stock-{{ section.id }} rs03-info-stock-in-{{ section.id }}">In Stock</div>
      {%- else -%}
        <div class="rs03-info-stock-{{ section.id }} rs03-info-stock-out-{{ section.id }}">Sold Out</div>
      {%- endif -%}

      {%- form 'product', p, id: 'product-form-', class: 'rs03-form-' -%}
        <div class="rs03-qty-{{ section.id }}">
          <label class="rs03-qty-label-{{ section.id }}" for="Quantity-{{ section.id }}">Quantity</label>
          <input class="rs03-qty-input-{{ section.id }}" type="number" id="Quantity-{{ section.id }}" name="quantity" value="1" min="1">
        </div>

        <button class="rs03-add-{{ section.id }}" type="submit" name="add" {%- unless p.available -%}disabled{%- endunless -%}>
          {%- if p.available -%}Add to Cart{%- else -%}Sold Out{%- endif -%}
        </button>
      {%- endform -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "RS03 Product",
  "tag": "section",
  "class": "rs03-product-section",
  "settings": [
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 300,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 160
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 60
    }
  ],
  "presets": [
    {"name": "RS03 Product"}
  ]
}
{% endschema %}
