{%- comment -%}RS03 Landing v1 - MINIMAL{%- endcomment -%}
<div style="font-family:sans-serif;color:#1A1816">
  <h1>{{ section.settings.title }}</h1>
  <p>{{ section.settings.subtitle }}</p>
  {%- if section.settings.image != blank -%}
    <img src="{{ section.settings.image | image_url: width: 1200 }}" alt="" style="max-width:100%">
  {%- else -%}
    <p>No image set</p>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "RS03 Landing v1",
  "tag": "section",
  "class": "rs03-v1",
  "settings": [
    { "type": "text", "id": "title", "label": "Title", "default": "SENSOL RS03" },
    { "type": "text", "id": "subtitle", "label": "Subtitle", "default": "Maximum Control. Expanded Movement." },
    { "type": "image_picker", "id": "image", "label": "Image" }
  ],
  "presets": [
    { "name": "RS03 Landing v1" }
  ]
}
{% endschema %}
