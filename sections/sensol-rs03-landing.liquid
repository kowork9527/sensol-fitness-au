    <h2 class="sensol-rs03__cta-heading">{{ section.settings.cta_heading }}</h2>
    <p class="sensol-rs03__cta-text">{{ section.settings.cta_text }}</p>
    <a href="{{ section.settings.cta_url }}" class="sensol-rs03__btn sensol-rs03__btn--light">{{ section.settings.cta_btn_text }}</a>
  </section>

</div>

{% schema %}
{
  "name": "SENSOL RS03 Landing",
  "tag": "section",
  "class": "sensol-rs03-landing",
  "settings": [
    {"type": "header", "content": "Hero"},
    {"type": "image_picker", "id": "hero_image", "label": "Hero Background Image"},
    {"type": "text", "id": "hero_tag", "label": "Hero Tag", "default": "Next Generation Smart Reformer"},
    {"type": "text", "id": "hero_title", "label": "Hero Title", "default": "RS03"},
    {"type": "textarea", "id": "hero_subtitle", "label": "Hero Subtitle", "default": "Precision in motion. The RS03 redefines what a smart reformer can be — engineered for control, built for results."},
    {"type": "text", "id": "hero_price", "label": "Price Display", "default": "A$2,400"},
    {"type": "text", "id": "hero_price_note", "label": "Price Note", "default": "Free shipping in Australia"},
    {"type": "text", "id": "hero_cta_text", "label": "Hero CTA Text", "default": "Order Now"},
    {"type": "text", "id": "hero_cta_url", "label": "Hero CTA URL", "default": "/products/sensol-one"},

    {"type": "header", "content": "Introduction"},
    {"type": "text", "id": "intro_label", "label": "Label", "default": "Engineered Movement"},
    {"type": "text", "id": "intro_heading", "label": "Heading", "default": "Designed Around You"},
    {"type": "textarea", "id": "intro_text", "label": "Text", "default": "The RS03 is Sensol's flagship smart reformer — where adaptive resistance meets fluid motion. Every detail, from the precision-machined carriage to the whisper-quiet glide system, is designed to move with your body, not against it."},
    {"type": "image_picker", "id": "intro_image", "label": "Intro Image (800x1000px, 4:5)"},

    {"type": "header", "content": "Key Specs"},
    {"type": "text", "id": "spec1_value", "label": "Spec 1 Value", "default": "16"},
    {"type": "text", "id": "spec1_label", "label": "Spec 1 Label", "default": "Resistance Levels"},
    {"type": "text", "id": "spec1_desc", "label": "Spec 1 Description", "default": "Adaptive magnetic resistance with micro-adjustments"},
    {"type": "text", "id": "spec2_value", "label": "Spec 2 Value", "default": "360\u00b0"},
    {"type": "text", "id": "spec2_label", "label": "Spec 2 Label", "default": "Motion Range"},
    {"type": "text", "id": "spec2_desc", "label": "Spec 2 Description", "default": "Full-spectrum movement freedom for unrestricted training"},
    {"type": "text", "id": "spec3_value", "label": "Spec 3 Value", "default": "<8ms"},
    {"type": "text", "id": "spec3_label", "label": "Spec 3 Label", "default": "Response Time"},
    {"type": "text", "id": "spec3_desc", "label": "Spec 3 Description", "default": "Near-instant resistance adjustment for seamless transitions"},

    {"type": "header", "content": "Smart Resistance"},
    {"type": "text", "id": "resist_label", "label": "Label", "default": "Adaptive Resistance"},
    {"type": "text", "id": "resist_heading", "label": "Heading", "default": "Resistance That Thinks With You"},
    {"type": "textarea", "id": "resist_text", "label": "Text", "default": "16 levels of magnetic resistance adapt in real-time to your force output. The RS03 doesn't just resist — it responds, creating a training experience that's both intuitive and progressive."},
    {"type": "image_picker", "id": "resist_image", "label": "Resistance Image (800x1000px, 4:5)"},
    {"type": "text", "id": "resist_f1_title", "label": "Feature 1 Title", "default": "Auto-Adjust"},
    {"type": "text", "id": "resist_f1_text", "label": "Feature 1 Text", "default": "Resistance adapts to your output in real-time"},
    {"type": "text", "id": "resist_f2_title", "label": "Feature 2 Title", "default": "Manual Override"},
    {"type": "text", "id": "resist_f2_text", "label": "Feature 2 Text", "default": "16 precise levels at your fingertips"},
    {"type": "text", "id": "resist_f3_title", "label": "Feature 3 Title", "default": "Progressive Load"},
    {"type": "text", "id": "resist_f3_text", "label": "Feature 3 Text", "default": "Automatically increases as you get stronger"},

