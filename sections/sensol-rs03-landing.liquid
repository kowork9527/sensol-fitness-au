{%- comment -%} ===== PRODUCT IMAGE PULL ===== Auto-pulls images from the assigned product ===== {%- endcomment -%}
{%- if product -%}
  {%- assign p_img_0 = product.featured_image -%}
  {%- assign p_img_1 = product.images[1] | default: product.featured_image -%}
  {%- assign p_img_2 = product.images[2] | default: product.featured_image -%}
  {%- assign p_img_3 = product.images[3] | default: product.featured_image -%}
  {%- assign p_img_4 = product.images[4] | default: product.featured_image -%}
  {%- assign p_img_5 = product.images[5] | default: product.featured_image -%}
  {%- assign p_imgs_count = product.images | size -%}
{%- else -%}
  {%- assign p_img_0 = blank -%}
  {%- assign p_img_1 = blank -%}
  {%- assign p_img_2 = blank -%}
  {%- assign p_img_3 = blank -%}
  {%- assign p_img_4 = blank -%}
  {%- assign p_img_5 = blank -%}
  {%- assign p_imgs_count = 0 -%}
{%- endif -%}

{%- style -%}
.sensol-rs03 { font-family: 'Inter', sans-serif; color: #1A1816; background: #F7F4F0; }
.sensol-rs03 *, .sensol-rs03 *::before, .sensol-rs03 *::after { box-sizing: border-box; margin: 0; padding: 0; }

/* ===== HERO ===== */
.sensol-rs03__hero { position: relative; min-height: 100vh; display: flex; align-items: center; justify-content: center; overflow: hidden; background: #1A1816; }
.sensol-rs03__hero-img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; opacity: 0.65; }
.sensol-rs03__hero-content { position: relative; z-index: 2; text-align: center; padding: 80px 24px; max-width: 900px; }
.sensol-rs03__hero-tag { font-size: 10px; letter-spacing: 0.25em; text-transform: uppercase; color: #D4CEC6; margin-bottom: 24px; }
.sensol-rs03__hero-title { font-size: clamp(48px, 10vw, 96px); font-weight: 200; letter-spacing: 0.15em; text-transform: uppercase; color: #F7F4F0; line-height: 1.0; margin-bottom: 24px; }
.sensol-rs03__hero-sub { font-size: clamp(15px, 1.8vw, 18px); font-weight: 300; color: #B5ADA4; line-height: 1.6; max-width: 600px; margin: 0 auto 40px; }
.sensol-rs03__hero-price { font-size: 26px; font-weight: 300; color: #F7F4F0; letter-spacing: 0.05em; margin-bottom: 12px; }
.sensol-rs03__hero-price-note { font-size: 12px; color: #8A8279; font-weight: 400; margin-bottom: 36px; letter-spacing: 0.1em; }
.sensol-rs03__hero-cta-row { display: flex; gap: 16px; justify-content: center; flex-wrap: wrap; }
.sensol-rs03__btn { display: inline-block; padding: 16px 48px; font-size: 11px; letter-spacing: 0.2em; text-transform: uppercase; text-decoration: none; font-weight: 500; transition: all 0.3s ease; cursor: pointer; border: none; }
.sensol-rs03__btn--light { background: #F7F4F0; color: #1A1816; }
.sensol-rs03__btn--light:hover { background: #D4CEC6; }
.sensol-rs03__btn--outline-light { background: transparent; color: #F7F4F0; border: 1px solid #F7F4F0; }
.sensol-rs03__btn--outline-light:hover { background: #F7F4F0; color: #1A1816; }
.sensol-rs03__btn--outline-dark { background: transparent; color: #1A1816; border: 1px solid #1A1816; }
.sensol-rs03__btn--outline-dark:hover { background: #1A1816; color: #F7F4F0; }

/* ===== SECTION COMMON ===== */
.sensol-rs03__section { padding: 100px 24px; max-width: 1400px; margin: 0 auto; }
.sensol-rs03__section--dark { background: #1A1816; color: #F7F4F0; }
.sensol-rs03__section--dark .sensol-rs03__label { color: #8A8279; }
.sensol-rs03__section--dark .sensol-rs03__heading { color: #F7F4F0; }
.sensol-rs03__section--dark .sensol-rs03__text { color: #B5ADA4; }
.sensol-rs03__label { font-size: 10px; letter-spacing: 0.25em; text-transform: uppercase; color: #8A8279; margin-bottom: 16px; }
.sensol-rs03__heading { font-size: clamp(28px, 4vw, 48px); font-weight: 300; letter-spacing: 0.1em; text-transform: uppercase; line-height: 1.15; margin-bottom: 24px; }
.sensol-rs03__text { font-size: 16px; line-height: 1.7; color: #8A8279; max-width: 640px; }
.sensol-rs03__text--center { margin: 0 auto; text-align: center; }

/* ===== INCLUDED LIST ===== */
.sensol-rs03__included { background: #1A1816; padding: 80px 24px; }
.sensol-rs03__included-inner { max-width: 1200px; margin: 0 auto; }
.sensol-rs03__included-title { font-size: 14px; letter-spacing: 0.25em; text-transform: uppercase; color: #B5ADA4; text-align: center; margin-bottom: 48px; }
.sensol-rs03__included-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 0; border-top: 1px solid #2A2826; }
.sensol-rs03__included-item { padding: 32px 24px; text-align: center; border-bottom: 1px solid #2A2826; border-right: 1px solid #2A2826; }
.sensol-rs03__included-item:nth-child(4n) { border-right: none; }
.sensol-rs03__included-name { font-size: 13px; color: #F7F4F0; letter-spacing: 0.05em; }

/* ===== TWO COLUMN ===== */
.sensol-rs03__two-col { display: grid; grid-template-columns: 1fr 1fr; gap: 80px; align-items: center; }
.sensol-rs03__two-col--reverse { direction: rtl; }
.sensol-rs03__two-col--reverse > * { direction: ltr; }
.sensol-rs03__img-wrap { overflow: hidden; background: #D4CEC6; }
.sensol-rs03__img-wrap img { width: 100%; height: 100%; object-fit: cover; display: block; }
.sensol-rs03__img-wrap--portrait { aspect-ratio: 4/5; }
.sensol-rs03__img-wrap--landscape { aspect-ratio: 16/9; }
.sensol-rs03__img-wrap--square { aspect-ratio: 1/1; }

/* ===== SPEC STRIP ===== */
.sensol-rs03__spec-strip { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1px; background: #D4CEC6; }
.sensol-rs03__spec-cell { background: #F7F4F0; padding: 56px 32px; text-align: center; }
.sensol-rs03__spec-value { font-size: clamp(36px, 5vw, 56px); font-weight: 200; letter-spacing: 0.05em; margin-bottom: 8px; }
.sensol-rs03__spec-label { font-size: 10px; letter-spacing: 0.2em; text-transform: uppercase; color: #8A8279; }

/* ===== SYSTEM 4-FEATURE ===== */
.sensol-rs03__system { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1px; background: #D4CEC6; }
.sensol-rs03__system-cell { background: #F7F4F0; padding: 60px 32px; }
.sensol-rs03__system-cell--dark { background: #1A1816; }
.sensol-rs03__system-num { font-size: 11px; letter-spacing: 0.25em; color: #8A8279; margin-bottom: 24px; }
.sensol-rs03__system-cell--dark .sensol-rs03__system-num { color: #B5ADA4; }
.sensol-rs03__system-title { font-size: 18px; font-weight: 400; letter-spacing: 0.05em; margin-bottom: 12px; color: #1A1816; }
.sensol-rs03__system-cell--dark .sensol-rs03__system-title { color: #F7F4F0; }
.sensol-rs03__system-text { font-size: 13px; line-height: 1.6; color: #8A8279; }
.sensol-rs03__system-cell--dark .sensol-rs03__system-text { color: #B5ADA4; }
.sensol-rs03__system-highlight { font-size: 14px; color: #1A1816; font-weight: 500; margin-bottom: 4px; }
.sensol-rs03__system-cell--dark .sensol-rs03__system-highlight { color: #F7F4F0; }

/* ===== SPEC TABLE ===== */
.sensol-rs03__table { width: 100%; max-width: 900px; margin: 60px auto 0; border-collapse: collapse; }
.sensol-rs03__table tr { border-bottom: 1px solid #D4CEC6; }
.sensol-rs03__section--dark .sensol-rs03__table tr { border-bottom-color: #2A2826; }
.sensol-rs03__table td { padding: 18px 0; font-size: 14px; }
.sensol-rs03__table td:first-child { color: #8A8279; letter-spacing: 0.05em; text-transform: uppercase; font-size: 11px; width: 40%; }
.sensol-rs03__table td:last-child { font-weight: 400; }
.sensol-rs03__section--dark .sensol-rs03__table td:last-child { color: #F7F4F0; }

/* ===== GALLERY ===== */
.sensol-rs03__gallery { padding: 100px 24px; max-width: 1400px; margin: 0 auto; }
.sensol-rs03__gallery-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 1px; background: #D4CEC6; }
.sensol-rs03__gallery-item { background: #1A1816; aspect-ratio: 1/1; overflow: hidden; }
.sensol-rs03__gallery-item img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform 0.8s cubic-bezier(0.25, 0.1, 0.25, 1); }
.sensol-rs03__gallery-item:hover img { transform: scale(1.03); }

/* ===== CTA ===== */
.sensol-rs03__cta { text-align: center; padding: 120px 24px; background: #1A1816; }
.sensol-rs03__cta-heading { font-size: clamp(32px, 5vw, 56px); font-weight: 200; letter-spacing: 0.15em; text-transform: uppercase; color: #F7F4F0; margin-bottom: 16px; }
.sensol-rs03__cta-text { font-size: 15px; color: #8A8279; margin-bottom: 40px; letter-spacing: 0.05em; }

/* ===== RESPONSIVE ===== */
@media (max-width: 768px) {
  .sensol-rs03__hero { min-height: 80vh; }
  .sensol-rs03__hero-content { padding: 60px 20px; }
  .sensol-rs03__section { padding: 60px 20px; }
  .sensol-rs03__two-col { grid-template-columns: 1fr; gap: 40px; }
  .sensol-rs03__two-col--reverse { direction: ltr; }
  .sensol-rs03__spec-strip { grid-template-columns: 1fr; }
  .sensol-rs03__system { grid-template-columns: 1fr 1fr; }
  .sensol-rs03__included-grid { grid-template-columns: 1fr 1fr; }
  .sensol-rs03__included-item:nth-child(4n) { border-right: 1px solid #2A2826; }
  .sensol-rs03__included-item:nth-child(2n) { border-right: none; }
  .sensol-rs03__gallery-grid { grid-template-columns: 1fr; }
  .sensol-rs03__hero-cta-row { flex-direction: column; align-items: center; }
  .sensol-rs03__hero-price { font-size: 22px; }
}
{%- endstyle -%}

<div class="sensol-rs03">

  {%- comment -%} ===== 1. HERO ===== {%- endcomment -%}
  <section class="sensol-rs03__hero">
    {%- if section.settings.hero_image_override -%}
      <img class="sensol-rs03__hero-img" src="{{ section.settings.hero_image_override | image_url: width: 1920 }}" alt="SENSOL RS03" loading="eager" width="1920" height="1080">
    {%- elsif p_img_0 -%}
      <img class="sensol-rs03__hero-img" src="{{ p_img_0 | image_url: width: 1920 }}" alt="SENSOL RS03" loading="eager" width="1920" height="1080">
    {%- endif -%}
    <div class="sensol-rs03__hero-content">
      <p class="sensol-rs03__hero-tag">{{ section.settings.hero_tag }}</p>
      <h1 class="sensol-rs03__hero-title">{{ section.settings.hero_title }}</h1>
      <p class="sensol-rs03__hero-sub">{{ section.settings.hero_subtitle }}</p>
      {%- if section.settings.show_price -%}
        <p class="sensol-rs03__hero-price">{{ section.settings.hero_price }}</p>
        <p class="sensol-rs03__hero-price-note">{{ section.settings.hero_price_note }}</p>
      {%- endif -%}
      <div class="sensol-rs03__hero-cta-row">
        <a href="{{ section.settings.hero_cta_url }}" class="sensol-rs03__btn sensol-rs03__btn--light">{{ section.settings.hero_cta_text }}</a>
        <a href="{{ section.settings.hero_cta2_url }}" class="sensol-rs03__btn sensol-rs03__btn--outline-light">{{ section.settings.hero_cta2_text }}</a>
      </div>
    </div>
  </section>

  {%- comment -%} ===== 2. EVERYTHING INCLUDED ===== {%- endcomment -%}
  <section class="sensol-rs03__included">
    <div class="sensol-rs03__included-inner">
      <p class="sensol-rs03__included-title">{{ section.settings.included_title }}</p>
      <div class="sensol-rs03__included-grid">
        {%- for i in (1..8) -%}
          {%- assign item_key = 'included_' | append: i -%}
          {%- assign item_val = section.settings[item_key] -%}
          {%- if item_val != blank -%}
            <div class="sensol-rs03__included-item">
              <p class="sensol-rs03__included-name">{{ item_val }}</p>
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  </section>

  {%- comment -%} ===== 3. OVERVIEW ===== {%- endcomment -%}
  <section class="sensol-rs03__section">
    <p class="sensol-rs03__label" style="text-align:center;">{{ section.settings.overview_label }}</p>
    <h2 class="sensol-rs03__heading" style="text-align:center; max-width: 800px; margin: 0 auto 24px;">{{ section.settings.overview_heading }}</h2>
    <p class="sensol-rs03__text sensol-rs03__text--center">{{ section.settings.overview_text }}</p>
  </section>

  {%- comment -%} ===== 4. DIGITAL WEIGHT (image 2) ===== {%- endcomment -%}
  <section class="sensol-rs03__section sensol-rs03__section--dark">
    <div class="sensol-rs03__two-col">
      <div class="sensol-rs03__img-wrap sensol-rs03__img-wrap--portrait">
        {%- if section.settings.digital_image_override -%}
          <img src="{{ section.settings.digital_image_override | image_url: width: 1000 }}" alt="Digital Weight" width="1000" height="1250" loading="lazy">
        {%- elsif p_img_1 -%}
          <img src="{{ p_img_1 | image_url: width: 1000 }}" alt="Digital Weight" width="1000" height="1250" loading="lazy">
        {%- endif -%}
      </div>
      <div>
        <p class="sensol-rs03__label">{{ section.settings.digital_label }}</p>
        <h2 class="sensol-rs03__heading">{{ section.settings.digital_heading }}</h2>
        <p class="sensol-rs03__text">{{ section.settings.digital_text }}</p>
      </div>
    </div>
  </section>

  {%- comment -%} ===== 5. WHY SENSOL (image 3) ===== {%- endcomment -%}
  <section class="sensol-rs03__section">
    <div class="sensol-rs03__two-col sensol-rs03__two-col--reverse">
      <div>
        <p class="sensol-rs03__label">{{ section.settings.why_label }}</p>
        <h2 class="sensol-rs03__heading">{{ section.settings.why_heading }}</h2>
        <p class="sensol-rs03__text">{{ section.settings.why_text }}</p>
      </div>
      <div class="sensol-rs03__img-wrap sensol-rs03__img-wrap--portrait">
        {%- if section.settings.why_image_override -%}
          <img src="{{ section.settings.why_image_override | image_url: width: 1000 }}" alt="Why Sensol" width="1000" height="1250" loading="lazy">
        {%- elsif p_img_2 -%}
          <img src="{{ p_img_2 | image_url: width: 1000 }}" alt="Why Sensol" width="1000" height="1250" loading="lazy">
        {%- endif -%}
      </div>
    </div>
  </section>

  {%- comment -%} ===== 6. DUAL-FUNCTION DESIGN (image 4) ===== {%- endcomment -%}
  <section class="sensol-rs03__section sensol-rs03__section--dark">
    <div class="sensol-rs03__two-col">
      <div class="sensol-rs03__img-wrap sensol-rs03__img-wrap--portrait">
        {%- if section.settings.dual_image_override -%}
          <img src="{{ section.settings.dual_image_override | image_url: width: 1000 }}" alt="Dual-Function" width="1000" height="1250" loading="lazy">
        {%- elsif p_img_3 -%}
          <img src="{{ p_img_3 | image_url: width: 1000 }}" alt="Dual-Function" width="1000" height="1250" loading="lazy">
        {%- endif -%}
      </div>
      <div>
        <p class="sensol-rs03__label">{{ section.settings.dual_label }}</p>
        <h2 class="sensol-rs03__heading">{{ section.settings.dual_heading }}</h2>
        <p class="sensol-rs03__text">{{ section.settings.dual_text }}</p>
      </div>
    </div>
  </section>

  {%- comment -%} ===== 7. SPEC STRIP (3 key numbers) ===== {%- endcomment -%}
  <div class="sensol-rs03__spec-strip">
    <div class="sensol-rs03__spec-cell">
      <div class="sensol-rs03__spec-value">{{ section.settings.spec1_value }}</div>
      <div class="sensol-rs03__spec-label">{{ section.settings.spec1_label }}</div>
    </div>
    <div class="sensol-rs03__spec-cell">
      <div class="sensol-rs03__spec-value">{{ section.settings.spec2_value }}</div>
      <div class="sensol-rs03__spec-label">{{ section.settings.spec2_label }}</div>
    </div>
    <div class="sensol-rs03__spec-cell">
      <div class="sensol-rs03__spec-value">{{ section.settings.spec3_value }}</div>
      <div class="sensol-rs03__spec-label">{{ section.settings.spec3_label }}</div>
    </div>
  </div>

  {%- comment -%} ===== 8. SENSOL SYSTEM — 4 features ===== {%- endcomment -%}
  <section class="sensol-rs03__section">
    <p class="sensol-rs03__label" style="text-align:center;">{{ section.settings.system_label }}</p>
    <h2 class="sensol-rs03__heading" style="text-align:center;">{{ section.settings.system_heading }}</h2>
    <p class="sensol-rs03__text sensol-rs03__text--center" style="margin-bottom: 60px;">{{ section.settings.system_text }}</p>
    <div class="sensol-rs03__system">
      <div class="sensol-rs03__system-cell">
        <div class="sensol-rs03__system-num">01 — {{ section.settings.sys1_label }}</div>
        <p class="sensol-rs03__system-title">{{ section.settings.sys1_title }}</p>
        <p class="sensol-rs03__system-highlight">{{ section.settings.sys1_highlight }}</p>
        <p class="sensol-rs03__system-text">{{ section.settings.sys1_text }}</p>
      </div>
      <div class="sensol-rs03__system-cell sensol-rs03__system-cell--dark">
        <div class="sensol-rs03__system-num">02 — {{ section.settings.sys2_label }}</div>
        <p class="sensol-rs03__system-title">{{ section.settings.sys2_title }}</p>
        <p class="sensol-rs03__system-highlight">{{ section.settings.sys2_highlight }}</p>
        <p class="sensol-rs03__system-text">{{ section.settings.sys2_text }}</p>
      </div>
      <div class="sensol-rs03__system-cell">
        <div class="sensol-rs03__system-num">03 — {{ section.settings.sys3_label }}</div>
        <p class="sensol-rs03__system-title">{{ section.settings.sys3_title }}</p>
        <p class="sensol-rs03__system-highlight">{{ section.settings.sys3_highlight }}</p>
        <p class="sensol-rs03__system-text">{{ section.settings.sys3_text }}</p>
      </div>
      <div class="sensol-rs03__system-cell sensol-rs03__system-cell--dark">
        <div class="sensol-rs03__system-num">04 — {{ section.settings.sys4_label }}</div>
        <p class="sensol-rs03__system-title">{{ section.settings.sys4_title }}</p>
        <p class="sensol-rs03__system-highlight">{{ section.settings.sys4_highlight }}</p>
        <p class="sensol-rs03__system-text">{{ section.settings.sys4_text }}</p>
      </div>
    </div>
  </section>

  {%- comment -%} ===== 9. GALLERY (images 5+) ===== {%- endcomment -%}
  {%- if p_imgs_count > 4 -%}
    <section class="sensol-rs03__gallery">
      <p class="sensol-rs03__label" style="text-align:center;">{{ section.settings.gallery_label }}</p>
      <h2 class="sensol-rs03__heading" style="text-align:center; margin-bottom: 48px;">{{ section.settings.gallery_heading }}</h2>
      <div class="sensol-rs03__gallery-grid">
        {%- for img in product.images offset: 4 -%}
          <div class="sensol-rs03__gallery-item">
            <img src="{{ img | image_url: width: 800 }}" alt="{{ img.alt | default: product.title }}" width="800" height="800" loading="lazy">
          </div>
        {%- endfor -%}
      </div>
    </section>
  {%- endif -%}

  {%- comment -%} ===== 10. FULL SPECS TABLE ===== {%- endcomment -%}
  <section class="sensol-rs03__section sensol-rs03__section--dark">
    <p class="sensol-rs03__label" style="text-align:center;">{{ section.settings.specs_label }}</p>
    <h2 class="sensol-rs03__heading" style="text-align:center;">{{ section.settings.specs_heading }}</h2>
    <table class="sensol-rs03__table">
      <tr><td>{{ section.settings.spec_row1_label }}</td><td>{{ section.settings.spec_row1_value }}</td></tr>
      <tr><td>{{ section.settings.spec_row2_label }}</td><td>{{ section.settings.spec_row2_value }}</td></tr>
      <tr><td>{{ section.settings.spec_row3_label }}</td><td>{{ section.settings.spec_row3_value }}</td></tr>
      <tr><td>{{ section.settings.spec_row4_label }}</td><td>{{ section.settings.spec_row4_value }}</td></tr>
      <tr><td>{{ section.settings.spec_row5_label }}</td><td>{{ section.settings.spec_row5_value }}</td></tr>
      <tr><td>{{ section.settings.spec_row6_label }}</td><td>{{ section.settings.spec_row6_value }}</td></tr>
      <tr><td>{{ section.settings.spec_row7_label }}</td><td>{{ section.settings.spec_row7_value }}</td></tr>
      <tr><td>{{ section.settings.spec_row8_label }}</td><td>{{ section.settings.spec_row8_value }}</td></tr>
    </table>
  </section>

  {%- comment -%} ===== 11. CTA ===== {%- endcomment -%}
  <section class="sensol-rs03__cta">
    <h2 class="sensol-rs03__cta-heading">{{ section.settings.cta_heading }}</h2>
    <p class="sensol-rs03__cta-text">{{ section.settings.cta_text }}</p>
    <a href="{{ section.settings.cta_url }}" class="sensol-rs03__btn sensol-rs03__btn--light">{{ section.settings.cta_btn_text }}</a>
  </section>

</div>

{% schema %}
{
  "name": "SENSOL RS03 Landing",
  "tag": "section",
  "class": "sensol-rs03-landing",
  "settings": [
    {"type": "header", "content": "Hero"},
    {"type": "text", "id": "hero_tag", "label": "Hero Tag", "default": "Smart Pilates Machine"},
    {"type": "text", "id": "hero_title", "label": "Hero Title", "default": "Sensol RS03"},
    {"type": "textarea", "id": "hero_subtitle", "label": "Hero Subtitle", "default": "Maximum control. Expanded movement. The most advanced expression of the Sensol system — engineered for those who demand more from every session."},
    {"type": "checkbox", "id": "show_price", "label": "Show Price", "default": true},
    {"type": "text", "id": "hero_price", "label": "Price Display", "default": "A$2,400"},
    {"type": "text", "id": "hero_price_note", "label": "Price Note", "default": "Free domestic shipping · 30-day guarantee"},
    {"type": "text", "id": "hero_cta_text", "label": "Primary CTA Text", "default": "Order Now"},
    {"type": "text", "id": "hero_cta_url", "label": "Primary CTA URL", "default": "/products/sensol-one-plus"},
