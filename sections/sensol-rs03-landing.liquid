{%- style -%}
.sensol-rs03 { font-family: 'Inter', sans-serif; color: #1A1816; background: #F7F4F0; }
.sensol-rs03 *, .sensol-rs03 *::before, .sensol-rs03 *::after { box-sizing: border-box; margin: 0; padding: 0; }

/* ===== HERO ===== */
.sensol-rs03__hero { position: relative; min-height: 100vh; display: flex; align-items: center; justify-content: center; overflow: hidden; background: #1A1816; }
.sensol-rs03__hero-img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; opacity: 0.45; }
.sensol-rs03__hero-content { position: relative; z-index: 2; text-align: center; padding: 80px 24px; max-width: 900px; }
.sensol-rs03__hero-tag { font-size: 10px; letter-spacing: 0.25em; text-transform: uppercase; color: #D4CEC6; margin-bottom: 24px; }
.sensol-rs03__hero-title { font-size: clamp(40px, 8vw, 80px); font-weight: 200; letter-spacing: 0.15em; text-transform: uppercase; color: #F7F4F0; line-height: 1.05; margin-bottom: 24px; }
.sensol-rs03__hero-sub { font-size: clamp(16px, 2vw, 20px); font-weight: 300; color: #B5ADA4; line-height: 1.6; max-width: 640px; margin: 0 auto 40px; }
.sensol-rs03__hero-price { font-size: 28px; font-weight: 300; color: #F7F4F0; letter-spacing: 0.05em; margin-bottom: 40px; }
.sensol-rs03__hero-price span { font-size: 14px; color: #8A8279; font-weight: 400; }
.sensol-rs03__btn { display: inline-block; padding: 16px 48px; font-size: 11px; letter-spacing: 0.2em; text-transform: uppercase; text-decoration: none; font-weight: 500; transition: all 0.3s ease; cursor: pointer; border: none; }
.sensol-rs03__btn--light { background: #F7F4F0; color: #1A1816; }
.sensol-rs03__btn--light:hover { background: #D4CEC6; }
.sensol-rs03__btn--dark { background: #1A1816; color: #F7F4F0; }
.sensol-rs03__btn--dark:hover { background: #2A2826; }
.sensol-rs03__btn--outline { background: transparent; color: #1A1816; border: 1px solid #1A1816; }
.sensol-rs03__btn--outline:hover { background: #1A1816; color: #F7F4F0; }

/* ===== SECTION COMMON ===== */
.sensol-rs03__section { padding: 100px 24px; max-width: 1400px; margin: 0 auto; }
.sensol-rs03__section--dark { background: #1A1816; color: #F7F4F0; }
.sensol-rs03__section--dark .sensol-rs03__label { color: #8A8279; }
.sensol-rs03__section--dark .sensol-rs03__heading { color: #F7F4F0; }
.sensol-rs03__section--dark .sensol-rs03__text { color: #B5ADA4; }
.sensol-rs03__label { font-size: 10px; letter-spacing: 0.25em; text-transform: uppercase; color: #8A8279; margin-bottom: 16px; }
.sensol-rs03__heading { font-size: clamp(28px, 4vw, 48px); font-weight: 300; letter-spacing: 0.1em; text-transform: uppercase; line-height: 1.15; margin-bottom: 24px; }
.sensol-rs03__text { font-size: 16px; line-height: 1.7; color: #8A8279; max-width: 640px; }
.sensol-rs03__text--center { margin: 0 auto; text-align: center; }

/* ===== SPECS GRID ===== */
.sensol-rs03__specs { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1px; background: #D4CEC6; margin: 80px auto; max-width: 1200px; }
.sensol-rs03__spec { background: #F7F4F0; padding: 48px 32px; text-align: center; }
.sensol-rs03__spec-value { font-size: clamp(32px, 5vw, 56px); font-weight: 200; letter-spacing: 0.05em; margin-bottom: 8px; }
.sensol-rs03__spec-label { font-size: 10px; letter-spacing: 0.2em; text-transform: uppercase; color: #8A8279; }
.sensol-rs03__spec-desc { font-size: 13px; color: #8A8279; margin-top: 8px; line-height: 1.5; }

/* ===== TWO COLUMN ===== */
.sensol-rs03__two-col { display: grid; grid-template-columns: 1fr 1fr; gap: 80px; align-items: center; }
.sensol-rs03__two-col--reverse { direction: rtl; }
.sensol-rs03__two-col--reverse > * { direction: ltr; }
.sensol-rs03__img-wrap { overflow: hidden; }
.sensol-rs03__img-wrap img { width: 100%; height: 100%; object-fit: cover; display: block; }
.sensol-rs03__img-wrap--portrait { aspect-ratio: 4/5; }
.sensol-rs03__img-wrap--landscape { aspect-ratio: 16/9; }

/* ===== FEATURES ===== */
.sensol-rs03__features { display: grid; grid-template-columns: repeat(3, 1fr); gap: 60px; margin-top: 60px; }
.sensol-rs03__feature { text-align: center; }
.sensol-rs03__feature-icon { width: 48px; height: 48px; margin: 0 auto 20px; display: flex; align-items: center; justify-content: center; }
.sensol-rs03__feature-icon svg { width: 100%; height: 100%; stroke: #8A8279; stroke-width: 1; fill: none; }
.sensol-rs03__section--dark .sensol-rs03__feature-icon svg { stroke: #B5ADA4; }
.sensol-rs03__feature-title { font-size: 11px; letter-spacing: 0.15em; text-transform: uppercase; margin-bottom: 12px; }
.sensol-rs03__feature-text { font-size: 14px; line-height: 1.6; color: #8A8279; }
.sensol-rs03__section--dark .sensol-rs03__feature-text { color: #B5ADA4; }

/* ===== SPECS TABLE ===== */
.sensol-rs03__table { width: 100%; max-width: 900px; margin: 60px auto 0; border-collapse: collapse; }
.sensol-rs03__table tr { border-bottom: 1px solid #D4CEC6; }
.sensol-rs03__section--dark .sensol-rs03__table tr { border-bottom-color: #2A2826; }
.sensol-rs03__table td { padding: 16px 0; font-size: 14px; }
.sensol-rs03__table td:first-child { color: #8A8279; letter-spacing: 0.05em; text-transform: uppercase; font-size: 11px; width: 40%; }
.sensol-rs03__table td:last-child { font-weight: 400; }
.sensol-rs03__section--dark .sensol-rs03__table td:first-child { color: #8A8279; }
.sensol-rs03__section--dark .sensol-rs03__table td:last-child { color: #F7F4F0; }

/* ===== TECH STRIP ===== */
.sensol-rs03__tech-strip { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1px; background: #D4CEC6; }
.sensol-rs03__tech-item { background: #1A1816; padding: 60px 32px; text-align: center; }
.sensol-rs03__tech-value { font-size: 36px; font-weight: 200; color: #F7F4F0; letter-spacing: 0.05em; margin-bottom: 8px; }
.sensol-rs03__tech-label { font-size: 10px; letter-spacing: 0.2em; text-transform: uppercase; color: #8A8279; }

/* ===== CTA ===== */
.sensol-rs03__cta { text-align: center; padding: 120px 24px; background: #1A1816; }
.sensol-rs03__cta-heading { font-size: clamp(32px, 5vw, 56px); font-weight: 200; letter-spacing: 0.15em; text-transform: uppercase; color: #F7F4F0; margin-bottom: 16px; }
.sensol-rs03__cta-text { font-size: 16px; color: #8A8279; margin-bottom: 40px; }

/* ===== RESPONSIVE ===== */
@media (max-width: 768px) {
  .sensol-rs03__hero { min-height: 80vh; }
  .sensol-rs03__hero-content { padding: 60px 20px; }
  .sensol-rs03__section { padding: 60px 20px; }
  .sensol-rs03__two-col { grid-template-columns: 1fr; gap: 40px; }
  .sensol-rs03__two-col--reverse { direction: ltr; }
  .sensol-rs03__specs { grid-template-columns: 1fr; margin: 40px auto; }
  .sensol-rs03__features { grid-template-columns: 1fr; gap: 40px; }
  .sensol-rs03__tech-strip { grid-template-columns: repeat(2, 1fr); }
  .sensol-rs03__hero-price { font-size: 22px; }
}
{%- endstyle -%}

<div class="sensol-rs03">

  {%- comment -%} ===== 1. HERO ===== {%- endcomment -%}
  <section class="sensol-rs03__hero">
    {% if section.settings.hero_image %}<img class="sensol-rs03__hero-img" src="{{ section.settings.hero_image | image_url: width: 1920 }}" alt="SENSOL RS03" width="1920" height="1080">{% endif %}
