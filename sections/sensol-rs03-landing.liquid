{%- comment -%}
  RS03 Landing Page Section
  Auto-pulls images from the current product, with optional manual overrides.
  Includes: Hero, Stats, Overview, 3 Features, Included List, Spec Strip,
           System Cards, Videos, Full Specs, Reviews (Judge.me), Q&A, CTA
{%- endcomment -%}

{%- liquid
  assign p = product | default: nil
  assign hero_img = section.settings.hero_image_override
  if hero_img == blank and p and p.featured_image
    assign hero_img = p.featured_image
  endif

  assign feat1_img = section.settings.feature1_image_override
  if feat1_img == blank and p and p.images[1]
    assign feat1_img = p.images[1]
  endif

  assign feat2_img = section.settings.feature2_image_override
  if feat2_img == blank and p and p.images[2]
    assign feat2_img = p.images[2]
  endif

  assign feat3_img = section.settings.feature3_image_override
  if feat3_img == blank and p and p.images[3]
    assign feat3_img = p.images[3]
  endif

  assign vid_blocks = section.blocks | where: 'type', 'video'
-%}

<style>
.r-rs03 { font-family: -apple-system, BlinkMacSystemFont, 'Inter', sans-serif; color: #1A1816; }
.r-rs03 * { box-sizing: border-box; }
.r-rs03 img { max-width: 100%; height: auto; display: block; }

/* Hero */
.r-rs03 .r-hero { display: flex; min-height: 100vh; background: #1A1816; color: #F7F4F0; }
.r-rs03 .r-hero__img { flex: 1 1 50%; background: #1A1816; position: relative; overflow: hidden; }
.r-rs03 .r-hero__img img { width: 100%; height: 100%; object-fit: cover; position: absolute; inset: 0; }
.r-rs03 .r-hero__img-placeholder { width: 100%; height: 100%; min-height: 400px; display: flex; align-items: center; justify-content: center; font-size: 11px; letter-spacing: 0.2em; color: #8A8279; border: 1px dashed #8A8279; }
.r-rs03 .r-hero__text { flex: 1 1 50%; padding: 80px 60px; display: flex; flex-direction: column; justify-content: center; }
.r-rs03 .r-hero__eyebrow { font-size: 12px; letter-spacing: 0.3em; color: #8A8279; margin: 0 0 24px; text-transform: uppercase; }
.r-rs03 .r-hero__title { font-size: 72px; font-weight: 200; letter-spacing: 0.05em; line-height: 1; margin: 0 0 32px; }
.r-rs03 .r-hero__desc { font-size: 16px; line-height: 1.8; color: #D4CEC6; margin: 0 0 40px; max-width: 480px; }
.r-rs03 .r-hero__price { font-size: 28px; font-weight: 300; margin: 0 0 12px; }
.r-rs03 .r-hero__sub { font-size: 13px; color: #8A8279; margin: 0 0 48px; }
.r-rs03 .r-hero__cta { display: flex; gap: 16px; }
.r-rs03 .r-btn-primary { background: #F7F4F0; color: #1A1816; padding: 18px 36px; text-decoration: none; font-size: 12px; letter-spacing: 0.2em; text-transform: uppercase; border: none; cursor: pointer; }
.r-rs03 .r-btn-secondary { background: transparent; color: #F7F4F0; padding: 18px 36px; text-decoration: none; font-size: 12px; letter-spacing: 0.2em; text-transform: uppercase; border: 1px solid #F7F4F0; cursor: pointer; }

/* Stats Bar */
.r-rs03 .r-stats { display: grid; grid-template-columns: repeat(4, 1fr); border-top: 1px solid #D4CEC6; border-bottom: 1px solid #D4CEC6; }
.r-rs03 .r-stats__item { padding: 48px 32px; text-align: center; border-right: 1px solid #D4CEC6; }
.r-rs03 .r-stats__item:last-child { border-right: none; }
.r-rs03 .r-stats__num { font-size: 48px; font-weight: 200; line-height: 1; margin: 0 0 8px; }
.r-rs03 .r-stats__label { font-size: 11px; letter-spacing: 0.2em; color: #8A8279; text-transform: uppercase; }

/* Section base */
.r-rs03 .r-section { padding: 120px 60px; }
.r-rs03 .r-section--dark { background: #1A1816; color: #F7F4F0; }
.r-rs03 .r-section--linen { background: #F7F4F0; }
.r-rs03 .r-section-head { text-align: center; max-width: 800px; margin: 0 auto 80px; }
.r-rs03 .r-section-head__eyebrow { font-size: 12px; letter-spacing: 0.3em; color: #8A8279; margin: 0 0 20px; text-transform: uppercase; }
.r-rs03 .r-section-head__title { font-size: 56px; font-weight: 200; line-height: 1.1; margin: 0; letter-spacing: 0.02em; }

/* Overview */
.r-rs03 .r-overview { text-align: center; }
.r-rs03 .r-overview p { font-size: 18px; line-height: 1.8; max-width: 720px; margin: 0 auto; color: #4A4642; }

/* Features */
.r-rs03 .r-feature { display: grid; grid-template-columns: 1fr 1fr; gap: 0; min-height: 80vh; }
.r-rs03 .r-feature--reverse .r-feature__img { order: 2; }
.r-rs03 .r-feature__img { background: #1A1816; position: relative; overflow: hidden; min-height: 500px; }
.r-rs03 .r-feature__img img { width: 100%; height: 100%; object-fit: cover; position: absolute; inset: 0; }
.r-rs03 .r-feature__img-placeholder { width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; font-size: 11px; letter-spacing: 0.2em; color: #8A8279; min-height: 500px; }
.r-rs03 .r-feature__text { padding: 100px 80px; display: flex; flex-direction: column; justify-content: center; background: #F7F4F0; }
.r-rs03 .r-feature__num { font-size: 11px; letter-spacing: 0.3em; color: #8A8279; margin: 0 0 20px; }
.r-rs03 .r-feature__title { font-size: 44px; font-weight: 200; line-height: 1.1; margin: 0 0 24px; }
.r-rs03 .r-feature__desc { font-size: 16px; line-height: 1.8; color: #4A4642; margin: 0 0 40px; }
.r-rs03 .r-feature__table { width: 100%; border-collapse: collapse; }
.r-rs03 .r-feature__table td { padding: 12px 0; border-bottom: 1px solid #D4CEC6; font-size: 14px; }
.r-rs03 .r-feature__table td:first-child { color: #8A8279; width: 40%; }

/* Included */
.r-rs03 .r-included { background: #F7F4F0; }
.r-rs03 .r-included__grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 0; max-width: 1200px; margin: 0 auto; border-top: 1px solid #1A1816; border-left: 1px solid #1A1816; }
.r-rs03 .r-included__item { padding: 32px 24px; border-right: 1px solid #1A1816; border-bottom: 1px solid #1A1816; }
.r-rs03 .r-included__num { font-size: 11px; letter-spacing: 0.2em; color: #8A8279; margin: 0 0 12px; }
.r-rs03 .r-included__name { font-size: 16px; font-weight: 400; }

/* Spec strip */
.r-rs03 .r-specstrip { display: grid; grid-template-columns: repeat(3, 1fr); background: #1A1816; color: #F7F4F0; border-top: 1px solid #8A8279; border-bottom: 1px solid #8A8279; }
.r-rs03 .r-specstrip__item { padding: 60px 40px; text-align: center; border-right: 1px solid #8A8279; }
.r-rs03 .r-specstrip__item:last-child { border-right: none; }
.r-rs03 .r-specstrip__num { font-size: 64px; font-weight: 200; line-height: 1; margin: 0 0 12px; }
.r-rs03 .r-specstrip__label { font-size: 11px; letter-spacing: 0.2em; color: #8A8279; text-transform: uppercase; }

/* System cards */
.r-rs03 .r-system { display: grid; grid-template-columns: repeat(2, 1fr); }
.r-rs03 .r-system__card { padding: 80px 60px; min-height: 360px; }
.r-rs03 .r-system__card--dark { background: #1A1816; color: #F7F4F0; }
.r-rs03 .r-system__card--linen { background: #F7F4F0; color: #1A1816; }
.r-rs03 .r-system__num { font-size: 14px; letter-spacing: 0.3em; margin: 0 0 24px; }
.r-rs03 .r-system__title { font-size: 32px; font-weight: 300; margin: 0 0 16px; letter-spacing: 0.02em; }
.r-rs03 .r-system__big { font-size: 72px; font-weight: 200; line-height: 1; margin: 0 0 12px; }
.r-rs03 .r-system__desc { font-size: 14px; line-height: 1.7; }

/* Videos */
.r-rs03 .r-videos__grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 24px; max-width: 1200px; margin: 0 auto; }
.r-rs03 .r-video { aspect-ratio: 16/9; background: #1A1816; position: relative; overflow: hidden; }
.r-rs03 .r-video video, .r-video .r-video__poster img { width: 100%; height: 100%; object-fit: cover; }
.r-rs03 .r-video__placeholder { width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; color: #8A8279; font-size: 11px; letter-spacing: 0.2em; border: 1px dashed #8A8279; }
.r-rs03 .r-video__play { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; cursor: pointer; }
.r-rs03 .r-video__play::before { content: ''; width: 0; height: 0; border-left: 24px solid #F7F4F0; border-top: 16px solid transparent; border-bottom: 16px solid transparent; margin-left: 6px; }
.r-rs03 .r-video__meta { position: absolute; left: 16px; bottom: 16px; color: #F7F4F0; font-size: 11px; letter-spacing: 0.15em; text-transform: uppercase; }
.r-rs03 .r-video__duration { position: absolute; right: 16px; bottom: 16px; color: #F7F4F0; font-size: 11px; letter-spacing: 0.1em; background: rgba(0,0,0,0.5); padding: 4px 8px; }
.r-rs03 .r-video__label { position: absolute; top: 16px; left: 16px; color: #F7F4F0; font-size: 10px; letter-spacing: 0.2em; background: rgba(0,0,0,0.5); padding: 4px 10px; text-transform: uppercase; }

/* Full specs */
.r-rs03 .r-fullspecs { background: #F7F4F0; }
.r-rs03 .r-fullspecs__list { max-width: 900px; margin: 0 auto; border-top: 1px solid #1A1816; }
.r-rs03 .r-fullspecs__row { display: flex; justify-content: space-between; padding: 20px 0; border-bottom: 1px solid #D4CEC6; font-size: 14px; }
.r-rs03 .r-fullspecs__row span:first-child { color: #8A8279; letter-spacing: 0.1em; text-transform: uppercase; font-size: 12px; }

/* Reviews */
.r-rs03 .r-reviews__summary { text-align: center; max-width: 800px; margin: 0 auto 60px; }
.r-rs03 .r-reviews__score { font-size: 64px; font-weight: 200; }
.r-rs03 .r-reviews__bars { display: flex; flex-direction: column; gap: 8px; max-width: 400px; margin: 24px auto; }
.r-rs03 .r-reviews__bar { display: flex; align-items: center; gap: 12px; font-size: 12px; }
.r-rs03 .r-reviews__bar-label { width: 30px; }
.r-rs03 .r-reviews__bar-track { flex: 1; height: 4px; background: #D4CEC6; }
.r-rs03 .r-reviews__bar-fill { height: 100%; background: #1A1816; }
.r-rs03 .r-reviews__write { display: block; width: fit-content; margin: 32px auto 0; background: #1A1816; color: #F7F4F0; padding: 16px 32px; text-decoration: none; font-size: 12px; letter-spacing: 0.2em; text-transform: uppercase; }

/* Q&A */
.r-rs03 .r-qa__list { max-width: 800px; margin: 0 auto; }
.r-rs03 .r-qa__item { padding: 32px 0; border-bottom: 1px solid #D4CEC6; }
.r-rs03 .r-qa__q { font-size: 18px; font-weight: 500; margin: 0 0 12px; }
.r-rs03 .r-qa__a { font-size: 15px; line-height: 1.7; color: #4A4642; margin: 0; }

/* CTA */
.r-rs03 .r-cta { background: #1A1816; color: #F7F4F0; text-align: center; padding: 120px 60px; }
.r-rs03 .r-cta__title { font-size: 96px; font-weight: 200; letter-spacing: 0.05em; margin: 0 0 16px; }
.r-rs03 .r-cta__sub { font-size: 18px; color: #D4CEC6; margin: 0 0 40px; }
.r-rs03 .r-cta__price { font-size: 32px; font-weight: 300; margin: 0 0 48px; }
.r-rs03 .r-cta__btn { display: inline-block; background: #F7F4F0; color: #1A1816; padding: 20px 60px; text-decoration: none; font-size: 12px; letter-spacing: 0.2em; text-transform: uppercase; }
.r-rs03 .r-cta__payments { display: flex; justify-content: center; gap: 12px; flex-wrap: wrap; margin: 48px 0 24px; }
.r-rs03 .r-cta__pay { padding: 8px 16px; border: 1px solid #8A8279; font-size: 11px; letter-spacing: 0.1em; text-transform: uppercase; color: #D4CEC6; }
.r-rs03 .r-cta__afterpay { font-size: 12px; color: #8A8279; margin: 0 0 48px; }
.r-rs03 .r-cta__share-label { font-size: 11px; letter-spacing: 0.2em; color: #8A8279; text-transform: uppercase; margin: 0 0 16px; }
.r-rs03 .r-cta__share { display: flex; justify-content: center; gap: 16px; }
.r-rs03 .r-cta__share a { width: 40px; height: 40px; border: 1px solid #8A8279; display: flex; align-items: center; justify-content: center; color: #D4CEC6; text-decoration: none; font-size: 14px; transition: all 0.2s; }
.r-rs03 .r-cta__share a:hover { background: #F7F4F0; color: #1A1816; border-color: #F7F4F0; }

/* Responsive */
@media (max-width: 968px) {
  .r-rs03 .r-hero { flex-direction: column; min-height: auto; }
  .r-rs03 .r-hero__img, .r-rs03 .r-hero__text { flex: 1 1 auto; }
  .r-rs03 .r-hero__img { min-height: 45vh; }
  .r-rs03 .r-hero__text { padding: 48px 24px; }
  .r-rs03 .r-hero__title { font-size: 48px; }
  .r-rs03 .r-hero__cta { flex-direction: column; }
  .r-rs03 .r-hero__cta a { width: 100%; text-align: center; }
  .r-rs03 .r-stats { grid-template-columns: repeat(2, 1fr); }
  .r-rs03 .r-stats__item:nth-child(2) { border-right: none; }
  .r-rs03 .r-stats__item:nth-child(1), .r-rs03 .r-stats__item:nth-child(2) { border-bottom: 1px solid #D4CEC6; }
  .r-rs03 .r-section { padding: 60px 24px; }
  .r-rs03 .r-section-head { margin-bottom: 40px; }
  .r-rs03 .r-section-head__title { font-size: 36px; }
  .r-rs03 .r-feature { grid-template-columns: 1fr; min-height: auto; }
  .r-rs03 .r-feature--reverse .r-feature__img { order: 0; }
  .r-rs03 .r-feature__img, .r-rs03 .r-feature__img-placeholder { min-height: 35vh; }
  .r-rs03 .r-feature__text { padding: 48px 24px; }
  .r-rs03 .r-feature__title { font-size: 28px; }
  .r-rs03 .r-included__grid { grid-template-columns: repeat(2, 1fr); }
  .r-rs03 .r-specstrip { grid-template-columns: 1fr; }
  .r-rs03 .r-specstrip__item { border-right: none; border-bottom: 1px solid #8A8279; }
  .r-rs03 .r-specstrip__item:last-child { border-bottom: none; }
  .r-rs03 .r-specstrip__num { font-size: 48px; }
  .r-rs03 .r-system { grid-template-columns: 1fr; }
  .r-rs03 .r-system__card { padding: 40px 24px; }
  .r-rs03 .r-system__big { font-size: 56px; }
  .r-rs03 .r-videos__grid { grid-template-columns: 1fr; }
  .r-rs03 .r-fullspecs__row { flex-direction: column; gap: 4px; }
  .r-rs03 .r-cta { padding: 60px 24px; }
  .r-rs03 .r-cta__title { font-size: 56px; }
  .r-rs03 .r-cta__payments { gap: 8px; }
  .r-rs03 .r-cta__pay { font-size: 10px; padding: 6px 10px; }
}
</style>

<div class="r-rs03">

  <!-- 1. HERO -->
  <section class="r-hero">
    <div class="r-hero__img">
      {%- if hero_img -%}
        <img src="{{ hero_img | image_url: width: 1600 }}" alt="{{ hero_img.alt | escape }}" loading="eager" width="1600" height="1067">
      {%- else -%}
        <div class="r-hero__img-placeholder">PRODUCT IMAGE — HERO</div>
      {%- endif -%}
    </div>
    <div class="r-hero__text">
      {%- if section.settings.hero_eyebrow != blank -%}
        <p class="r-hero__eyebrow">{{ section.settings.hero_eyebrow }}</p>
      {%- endif -%}
      <h1 class="r-hero__title">{{ section.settings.hero_title }}</h1>
      {%- if section.settings.hero_desc != blank -%}
        <p class="r-hero__desc">{{ section.settings.hero_desc }}</p>
      {%- endif -%}
      <p class="r-hero__price">{{ section.settings.hero_price }}</p>
      <p class="r-hero__sub">{{ section.settings.hero_sub }}</p>
      <div class="r-hero__cta">
        <a href="{{ section.settings.hero_cta_url | default: '#'" }}" class="r-btn-primary">{{ section.settings.hero_cta_text }}</a>
        <a href="{{ section.settings.hero_cta2_url | default: '#' }}" class="r-btn-secondary">{{ section.settings.hero_cta2_text }}</a>
      </div>
    </div>
  </section>

  <!-- 2. STATS BAR -->
  <section class="r-stats">
    {%- for block in section.blocks -%}
      {%- if block.type == 'stat' -%}
        <div class="r-stats__item" {{ block.shopify_attributes }}>
          <p class="r-stats__num">{{ block.settings.number }}</p>
          <p class="r-stats__label">{{ block.settings.label }}</p>
        </div>
      {%- endif -%}
    {%- endfor -%}
    {%- if section.blocks | where: 'type', 'stat' | size == 0 -%}
      <div class="r-stats__item"><p class="r-stats__num">45kg</p><p class="r-stats__label">Digital Weight</p></div>
      <div class="r-stats__item"><p class="r-stats__num">360°</p><p class="r-stats__label">Motion Range</p></div>
      <div class="r-stats__item"><p class="r-stats__num">0.2m²</p><p class="r-stats__label">Footprint</p></div>
      <div class="r-stats__item"><p class="r-stats__num">&lt;25dB</p><p class="r-stats__label">Noise</p></div>
    {%- endif -%}
  </section>

  <!-- 3. OVERVIEW -->
  <section class="r-section r-section--linen r-overview">
    {%- if section.settings.overview_eyebrow != blank -%}
      <p class="r-section-head__eyebrow">{{ section.settings.overview_eyebrow }}</p>
    {%- endif -%}
    <h2 class="r-section-head__title">{{ section.settings.overview_title }}</h2>
    <p>{{ section.settings.overview_desc }}</p>
  </section>

  <!-- 4-6. FEATURES -->
  {%- for i in (1..3) -%}
    {%- assign f_num = 'feature' | append: i | append: '_number' -%}
    {%- assign f_title = 'feature' | append: i | append: '_title' -%}
    {%- assign f_desc = 'feature' | append: i | append: '_desc' -%}
    {%- assign f_img_key = 'feat' | append: i | append: '_img' -%}
    {%- assign f_img = f_img_key | replace: 'feat', 'feature' -%}
    {%- assign img_var = feat1_img -%}
    {%- if i == 2 -%}{%- assign img_var = feat2_img -%}{%- endif -%}
    {%- if i == 3 -%}{%- assign img_var = feat3_img -%}{%- endif -%}
    <section class="r-feature {% if i == 2 or i == 4 %}r-feature--reverse{% endif %}">
      <div class="r-feature__img">
        {%- if img_var -%}
          <img src="{{ img_var | image_url: width: 1200 }}" alt="{{ img_var.alt | escape }}" loading="lazy" width="1200" height="800">
        {%- else -%}
          <div class="r-feature__img-placeholder">PRODUCT IMAGE #{{ i | plus: 1 }}</div>
        {%- endif -%}
      </div>
      <div class="r-feature__text">
        <p class="r-feature__num">{{ section.settings[f_num] }}</p>
        <h2 class="r-feature__title">{{ section.settings[f_title] }}</h2>
        <p class="r-feature__desc">{{ section.settings[f_desc] }}</p>
        <table class="r-feature__table">
          {%- for block in section.blocks -%}
            {%- if block.type == 'spec' and block.settings.feature_index == i -%}
              <tr><td>{{ block.settings.label }}</td><td>{{ block.settings.value }}</td></tr>
            {%- endif -%}
          {%- endfor -%}
        </table>
      </div>
    </section>
  {%- endfor -%}

  <!-- 7. INCLUDED -->
  <section class="r-section r-included">
    <div class="r-section-head">
      <p class="r-section-head__eyebrow">In the box</p>
      <h2 class="r-section-head__title">{{ section.settings.included_title }}</h2>
    </div>
    <div class="r-included__grid">
      {%- for block in section.blocks -%}
        {%- if block.type == 'included' -%}
          <div class="r-included__item" {{ block.shopify_attributes }}>
            <p class="r-included__num">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</p>
            <p class="r-included__name">{{ block.settings.name }}</p>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </section>

  <!-- 8. SPEC STRIP -->
  <section class="r-specstrip">
    {%- for block in section.blocks -%}
      {%- if block.type == 'specstrip' -%}
        <div class="r-specstrip__item" {{ block.shopify_attributes }}>
          <p class="r-specstrip__num">{{ block.settings.number }}</p>
          <p class="r-specstrip__label">{{ block.settings.label }}</p>
        </div>
      {%- endif -%}
    {%- endfor -%}
  </section>

  <!-- 9. SYSTEM 4 CARDS -->
  <section class="r-system">
    {%- for block in section.blocks -%}
      {%- if block.type == 'system' -%}
        <div class="r-system__card {% if forloop.index is even %}r-system__card--linen{% else %}r-system__card--dark{% endif %}" {{ block.shopify_attributes }}>
          <p class="r-system__num">0{{ forloop.index }} —</p>
          <h3 class="r-system__title">{{ block.settings.title }}</h3>
          <p class="r-system__big">{{ block.settings.big_number }}</p>
          <p class="r-system__desc">{{ block.settings.desc }}</p>
        </div>
      {%- endif -%}
    {%- endfor -%}
  </section>

  <!-- 10. VIDEOS -->
  <section class="r-section r-section--linen">
    <div class="r-section-head">
      <p class="r-section-head__eyebrow">In motion</p>
      <h2 class="r-section-head__title">{{ section.settings.videos_title }}</h2>
    </div>
    <div class="r-videos__grid">
      {%- if vid_blocks.size > 0 -%}
        {%- for block in vid_blocks -%}
          <div class="r-video" {{ block.shopify_attributes }}>
            {%- if block.settings.video != blank -%}
              {{ block.settings.video | video_tag: autoplay: false, loop: false, controls: true, muted: false, image_size: '1200x' }}
            {%- elsif block.settings.preview_image != blank -%}
              <div class="r-video__poster"><img src="{{ block.settings.preview_image | image_url: width: 1200 }}" alt="{{ block.settings.label }}" loading="lazy" width="1200" height="675"></div>
            {%- else -%}
              <div class="r-video__placeholder">VIDEO — {{ forloop.index }}</div>
            {%- endif -%}
            {%- if block.settings.label != blank -%}
              <span class="r-video__label">{{ block.settings.label }}</span>
            {%- endif -%}
            {%- if block.settings.duration != blank -%}
              <span class="r-video__duration">{{ block.settings.duration }}</span>
            {%- endif -%}
            <div class="r-video__play"></div>
          </div>
        {%- endfor -%}
      {%- else -%}
        <div class="r-video"><div class="r-video__placeholder">VIDEO — 1</div></div>
        <div class="r-video"><div class="r-video__placeholder">VIDEO — 2</div></div>
        <div class="r-video"><div class="r-video__placeholder">VIDEO — 3</div></div>
        <div class="r-video"><div class="r-video__placeholder">VIDEO — 4</div></div>
      {%- endif -%}
    </div>
  </section>

  <!-- 11. FULL SPECS -->
  <section class="r-section r-fullspecs">
    <div class="r-section-head">
      <p class="r-section-head__eyebrow">Specifications</p>
      <h2 class="r-section-head__title">{{ section.settings.fullspecs_title }}</h2>
    </div>
    <div class="r-fullspecs__list">
      {%- for block in section.blocks -%}
        {%- if block.type == 'fullspec' -%}
          <div class="r-fullspecs__row" {{ block.shopify_attributes }}>
            <span>{{ block.settings.label }}</span>
            <span>{{ block.settings.value }}</span>
          </div>
        {%- endif -%}
    {%- endfor -%}
    </div>
  </section>

  <!-- 12. REVIEWS (Judge.me) -->
  <section class="r-section r-section--linen">
    <div class="r-section-head">
      <p class="r-section-head__eyebrow">Customer Reviews</p>
      <h2 class="r-section-head__title">{{ section.settings.reviews_title }}</h2>
    </div>
    <div class="r-reviews__summary">
      <p style="font-size:13px;letter-spacing:0.2em;color:#8A8279;margin:0 0 12px">POWERED BY JUDGE.ME</p>
      <p class="r-reviews__score">4.8</p>
      <p style="font-size:14px;color:#8A8279;margin:0">★★★★★ · 128 reviews</p>
      <div class="r-reviews__bars">
        <div class="r-reviews__bar"><span class="r-reviews__bar-label">5★</span><span class="r-reviews__bar-track"><span class="r-reviews__bar-fill" style="width:78%"></span></span></div>
        <div class="r-reviews__bar"><span class="r-reviews__bar-label">4★</span><span class="r-reviews__bar-track"><span class="r-reviews__bar-fill" style="width:15%"></span></span></div>
        <div class="r-reviews__bar"><span class="r-reviews__bar-label">3★</span><span class="r-reviews__bar-track"><span class="r-reviews__bar-fill" style="width:4%"></span></span></div>
        <div class="r-reviews__bar"><span class="r-reviews__bar-label">2★</span><span class="r-reviews__bar-track"><span class="r-reviews__bar-fill" style="width:2%"></span></span></div>
        <div class="r-reviews__bar"><span class="r-reviews__bar-label">1★</span><span class="r-reviews__bar-track"><span class="r-reviews__bar-fill" style="width:1%"></span></span></div>
      </div>
      <a href="#" class="r-reviews__write">Write a Review</a>
    </div>
    {%- if p -%}
      <div id="judgeme_product_reviews" class="jdgm-widget jdgm-review-widget" data-product-id="{{ p.id }}" data-product-title="{{ p.title | escape }}" data-product-url="{{ p.url }}"></div>
    {%- else -%}
      <p style="text-align:center;color:#8A8279;font-size:14px">Reviews will appear here once the product is published and Judge.me is activated.</p>
    {%- endif -%}
  </section>

  <!-- 13. Q&A -->
  <section class="r-section r-section--linen">
    <div class="r-section-head">
      <p class="r-section-head__eyebrow">Questions & Answers</p>
      <h2 class="r-section-head__title">{{ section.settings.qa_title }}</h2>
    </div>
    <div class="r-qa__list">
      {%- if p and p.metafields.custom.faq -%}
        {%- for faq in p.metafields.custom.faq -%}
          <div class="r-qa__item">
            <p class="r-qa__q">Q. {{ faq.question }}</p>
            <p class="r-qa__a">A. {{ faq.answer }}</p>
          </div>
        {%- endfor -%}
      {%- else -%}
        <div class="r-qa__item"><p class="r-qa__q">Q. Is the Sensol RS03 suitable for beginners?</p><p class="r-qa__a">A. Yes. The RS03 supports a 0-100% resistance range and comes with guided training courses via the Sensol App, making it suitable for all levels from complete beginners to advanced athletes.</p></div>
        <div class="r-qa__item"><p class="r-qa__q">Q. How much space do I need?</p><p class="r-qa__a">A. The RS03 has a compact 0.2m² footprint and stores upright when not in use, making it ideal for apartments and home studios.</p></div>
        <div class="r-qa__item"><p class="r-qa__q">Q. What is the difference between RS03 and Sensol One?</p><p class="r-qa__a">A. The RS03 is our most advanced reformer with up to 45kg of digital resistance, enhanced Pilates cable system, and 360° motion range. Sensol One is the original model with 30kg resistance and a more streamlined feature set.</p></div>
        <div class="r-qa__item"><p class="r-qa__q">Q. What warranty is included?</p><p class="r-qa__a">A. Every Sensol product comes with a lifetime frame warranty, 5-year mechanical warranty, and 30-day change-of-mind returns.</p></div>
        <div class="r-qa__item"><p class="r-qa__q">Q. Does the Sensol App come included?</p><p class="r-qa__a">A. Yes. Every RS03 includes complimentary access to the Sensol App with 100+ guided Pilates, strength, and hybrid classes designed by expert trainers.</p></div>
        <div class="r-qa__item"><p class="r-qa__q">Q. How difficult is assembly?</p><p class="r-qa__a">A. The RS03 arrives 95% pre-assembled. Setup typically takes 10-15 minutes with the included tools and step-by-step guide.</p></div>
      {%- endif -%}
      <p style="text-align:center;margin-top:48px"><a href="#" class="r-reviews__write" style="background:transparent;color:#1A1816;border:1px solid #1A1816">Ask a Question</a></p>
    </div>
  </section>

  <!-- 14. CTA -->
  <section class="r-cta">
    <h2 class="r-cta__title">{{ section.settings.cta_title }}</h2>
    <p class="r-cta__sub">{{ section.settings.cta_sub }}</p>
    <p class="r-cta__price">{{ section.settings.cta_price }}</p>
    <a href="{{ section.settings.cta_url | default: '/cart/add?id=' | append: p.id }}" class="r-cta__btn">{{ section.settings.cta_btn_text }}</a>
    <div class="r-cta__payments">
      <span class="r-cta__pay">PayPal</span>
      <span class="r-cta__pay">Afterpay</span>
      <span class="r-cta__pay">Shop Pay</span>
      <span class="r-cta__pay">Apple Pay</span>
      <span class="r-cta__pay">Google Pay</span>
      <span class="r-cta__pay">Visa/MC</span>
    </div>
    <p class="r-cta__afterpay">or 4 interest-free payments of {{ section.settings.cta_afterpay_amount }} with Afterpay</p>
    <p class="r-cta__share-label">Share</p>
    <div class="r-cta__share">
      <a href="https://www.facebook.com/sharer/sharer.php?u={{ shop.url }}{{ p.url | default: '/' }}" target="_blank" rel="noopener" aria-label="Facebook">f</a>
      <a href="https://www.instagram.com/" target="_blank" rel="noopener" aria-label="Instagram">ig</a>
      <a href="https://twitter.com/intent/tweet?url={{ shop.url }}{{ p.url | default: '/' }}" target="_blank" rel="noopener" aria-label="X">x</a>
      <a href="https://pinterest.com/pin/create/button/?url={{ shop.url }}{{ p.url | default: '/' }}" target="_blank" rel="noopener" aria-label="Pinterest">p</a>
      <a href="#" onclick="navigator.clipboard.writeText('{{ shop.url }}{{ p.url | default: '/' }}');this.textContent='✓';setTimeout(()=>this.textContent='🔗',2000);return false" aria-label="Copy Link">⌘</a>
    </div>
  </section>

</div>

