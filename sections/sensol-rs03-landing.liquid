{%- comment -%}
  Sensol RS03 Landing Page
  Auto-pulls from product images when available.
  All sections with editable overrides via schema.
{%- endcomment -%}

{%- liquid
  assign p = product | default: null
  assign has_product = false
  if p and p.id != blank
    assign has_product = true
  endif

  assign hero_img = section.settings.hero_image_override
  unless hero_img != blank and hero_img != empty
    if has_product and p.featured_image
      assign hero_img = p.featured_image
    endif
  endunless

  assign intro_img = section.settings.intro_image_override
  unless intro_img != blank and intro_img != empty
    if has_product and p.images[1]
      assign intro_img = p.images[1]
    endif
  endunless

  assign resist_img = section.settings.resist_image_override
  unless resist_img != blank and resist_img != empty
    if has_product and p.images[2]
      assign resist_img = p.images[2]
    endif
  endunless

  assign motion_img = section.settings.motion_image_override
  unless motion_img != blank and motion_img != empty
    if has_product and p.images[3]
      assign motion_img = p.images[3]
    endif
  endunless

  assign fold_img = section.settings.fold_image_override
  unless fold_img != blank and fold_img != empty
    if has_product and p.images[4]
      assign fold_img = p.images[4]
    endif
  endunless
-%}

<style>
  .rs03-{{ section.id }} { font-family: 'Inter', -apple-system, sans-serif; color: #1A1816; -webkit-font-smoothing: antialiased; }

  /* ============ HERO ============ */
  .rs03-{{ section.id }} .r-hero { display: grid; grid-template-columns: 1fr 1fr; min-height: 100vh; }
  .rs03-{{ section.id }} .r-hero__image { position: relative; background: #1A1816; overflow: hidden; }
  .rs03-{{ section.id }} .r-hero__image img { width: 100%; height: 100%; object-fit: cover; }
  .rs03-{{ section.id }} .r-hero__content { display: flex; flex-direction: column; justify-content: center; padding: 100px 80px; background: #F7F4F0; }
  .rs03-{{ section.id }} .r-hero__tag { font-size: 10px; letter-spacing: 0.3em; text-transform: uppercase; color: #8A8279; margin-bottom: 32px; }
  .rs03-{{ section.id }} .r-hero__title { font-size: clamp(48px, 6vw, 88px); font-weight: 200; letter-spacing: 0.1em; line-height: 1.1; margin: 0 0 32px; color: #1A1816; }
  .rs03-{{ section.id }} .r-hero__title span { display: block; font-size: 18px; font-weight: 300; letter-spacing: 0.05em; margin-top: 24px; color: #8A8279; }
  .rs03-{{ section.id }} .r-hero__sub { font-size: 16px; line-height: 1.8; color: #8A8279; margin-bottom: 40px; max-width: 540px; }
  .rs03-{{ section.id }} .r-hero__price { font-size: 48px; font-weight: 200; color: #1A1816; letter-spacing: 0.05em; margin-bottom: 8px; }
  .rs03-{{ section.id }} .r-hero__price-note { font-size: 11px; letter-spacing: 0.15em; text-transform: uppercase; color: #8A8279; margin-bottom: 40px; }
  .rs03-{{ section.id }} .r-hero__cta-row { display: flex; gap: 16px; flex-wrap: wrap; }
  .rs03-{{ section.id }} .r-btn { display: inline-block; padding: 18px 32px; font-size: 11px; letter-spacing: 0.25em; text-transform: uppercase; text-decoration: none; transition: all 0.3s ease; font-family: inherit; cursor: pointer; }
  .rs03-{{ section.id }} .r-btn--dark { background: #1A1816; color: #F7F4F0; border: 1px solid #1A1816; }
  .rs03-{{ section.id }} .r-btn--light { background: #F7F4F0; color: #1A1816; border: 1px solid #1A1816; }
  .rs03-{{ section.id }} .r-btn--outline { background: transparent; color: #1A1816; border: 1px solid #1A1816; }
  .rs03-{{ section.id }} .r-btn--outline-light { background: transparent; color: #F7F4F0; border: 1px solid #F7F4F0; }

  /* ============ STATS BAR ============ */
  .rs03-{{ section.id }} .r-stats { display: grid; grid-template-columns: repeat(4, 1fr); border-top: 1px solid #D4CEC6; border-bottom: 1px solid #D4CEC6; background: #F7F4F0; }
  .rs03-{{ section.id }} .r-stat { padding: 56px 24px; text-align: center; border-right: 1px solid #D4CEC6; }
  .rs03-{{ section.id }} .r-stat:last-child { border-right: none; }
  .rs03-{{ section.id }} .r-stat__value { font-size: 56px; font-weight: 200; letter-spacing: 0.02em; line-height: 1; margin-bottom: 8px; color: #1A1816; }
  .rs03-{{ section.id }} .r-stat__value small { font-size: 16px; color: #8A8279; font-weight: 300; }
  .rs03-{{ section.id }} .r-stat__label { font-size: 10px; letter-spacing: 0.25em; text-transform: uppercase; color: #8A8279; }

  /* ============ OVERVIEW ============ */
  .rs03-{{ section.id }} .r-overview { background: #F7F4F0; text-align: center; padding: 180px 80px; }
  .rs03-{{ section.id }} .r-overview__label { font-size: 10px; letter-spacing: 0.3em; text-transform: uppercase; color: #8A8279; margin-bottom: 32px; }
  .rs03-{{ section.id }} .r-overview__heading { font-size: clamp(40px, 6vw, 72px); font-weight: 200; letter-spacing: 0.05em; line-height: 1.15; max-width: 1000px; margin: 0 auto 32px; color: #1A1816; }
  .rs03-{{ section.id }} .r-overview__heading em { font-style: normal; font-weight: 400; color: #8A8279; }
  .rs03-{{ section.id }} .r-overview__text { font-size: 17px; line-height: 1.8; color: #8A8279; max-width: 720px; margin: 0 auto; }

  /* ============ FEATURE BLOCKS ============ */
  .rs03-{{ section.id }} .r-feature { display: grid; grid-template-columns: 1.1fr 1fr; min-height: 700px; }
  .rs03-{{ section.id }} .r-feature--reverse { grid-template-columns: 1fr 1.1fr; }
  .rs03-{{ section.id }} .r-feature--reverse .r-feature__image { order: 2; }
  .rs03-{{ section.id }} .r-feature__image { position: relative; overflow: hidden; background: #1A1816; }
  .rs03-{{ section.id }} .r-feature__image img { width: 100%; height: 100%; object-fit: cover; }
  .rs03-{{ section.id }} .r-feature__content { display: flex; flex-direction: column; justify-content: center; padding: 100px 80px; }
  .rs03-{{ section.id }} .r-feature__num { font-size: 11px; letter-spacing: 0.3em; color: #8A8279; margin-bottom: 24px; }
  .rs03-{{ section.id }} .r-feature__heading { font-size: clamp(32px, 4vw, 48px); font-weight: 200; letter-spacing: 0.05em; line-height: 1.15; margin-bottom: 24px; color: #1A1816; }
  .rs03-{{ section.id }} .r-feature--dark .r-feature__heading { color: #F7F4F0; }
  .rs03-{{ section.id }} .r-feature__divider { width: 40px; height: 1px; background: #D4CEC6; margin: 24px 0; }
  .rs03-{{ section.id }} .r-feature--dark .r-feature__divider { background: #2A2826; }
  .rs03-{{ section.id }} .r-feature__text { font-size: 15px; line-height: 1.8; color: #8A8279; margin-bottom: 32px; }
  .rs03-{{ section.id }} .r-feature--dark .r-feature__text { color: #B5ADA4; }
  .rs03-{{ section.id }} .r-feature__points { list-style: none; margin: 0; padding: 0; }
  .rs03-{{ section.id }} .r-feature__points li { padding: 14px 0; border-bottom: 1px solid #D4CEC6; font-size: 13px; letter-spacing: 0.05em; display: flex; justify-content: space-between; align-items: center; color: #1A1816; }
  .rs03-{{ section.id }} .r-feature--dark .r-feature__points li { border-bottom-color: #2A2826; color: #F7F4F0; }
  .rs03-{{ section.id }} .r-feature__points li span:last-child { color: #1A1816; font-weight: 500; }
  .rs03-{{ section.id }} .r-feature--dark .r-feature__points li span:last-child { color: #F7F4F0; }

  /* ============ INCLUDED ============ */
  .rs03-{{ section.id }} .r-included { background: #1A1816; padding: 120px 80px; }
  .rs03-{{ section.id }} .r-included__label { text-align: center; font-size: 10px; letter-spacing: 0.3em; text-transform: uppercase; color: #B5ADA4; margin-bottom: 64px; }
  .rs03-{{ section.id }} .r-included__grid { display: grid; grid-template-columns: repeat(4, 1fr); max-width: 1200px; margin: 0 auto; border-top: 1px solid #2A2826; border-left: 1px solid #2A2826; }
  .rs03-{{ section.id }} .r-included__item { padding: 36px 24px; text-align: center; border-right: 1px solid #2A2826; border-bottom: 1px solid #2A2826; }
  .rs03-{{ section.id }} .r-included__num { font-size: 10px; letter-spacing: 0.2em; color: #8A8279; margin-bottom: 12px; }
  .rs03-{{ section.id }} .r-included__name { font-size: 13px; color: #F7F4F0; letter-spacing: 0.05em; }

  /* ============ SPEC STRIP ============ */
  .rs03-{{ section.id }} .r-spec-strip { display: grid; grid-template-columns: repeat(3, 1fr); border-top: 1px solid #D4CEC6; border-bottom: 1px solid #D4CEC6; background: #F7F4F0; }
  .rs03-{{ section.id }} .r-spec-strip__cell { padding: 64px 40px; text-align: center; border-right: 1px solid #D4CEC6; }
  .rs03-{{ section.id }} .r-spec-strip__cell:last-child { border-right: none; }
  .rs03-{{ section.id }} .r-spec-strip__value { font-size: 48px; font-weight: 200; letter-spacing: 0.05em; margin-bottom: 8px; color: #1A1816; }
  .rs03-{{ section.id }} .r-spec-strip__value small { font-size: 18px; color: #8A8279; }
  .rs03-{{ section.id }} .r-spec-strip__label { font-size: 10px; letter-spacing: 0.25em; text-transform: uppercase; color: #8A8279; }

  /* ============ SYSTEM 4-CARDS ============ */
  .rs03-{{ section.id }} .r-system { padding: 140px 80px; background: #F7F4F0; }
  .rs03-{{ section.id }} .r-system__head { text-align: center; max-width: 720px; margin: 0 auto 80px; }
  .rs03-{{ section.id }} .r-system__heading { font-size: clamp(36px, 5vw, 56px); font-weight: 200; letter-spacing: 0.05em; margin: 16px 0; color: #1A1816; }
  .rs03-{{ section.id }} .r-system__sub { font-size: 15px; color: #8A8279; line-height: 1.7; }
  .rs03-{{ section.id }} .r-system__grid { display: grid; grid-template-columns: repeat(4, 1fr); max-width: 1400px; margin: 0 auto; }
  .rs03-{{ section.id }} .r-system-card { padding: 56px 36px; border: 1px solid #D4CEC6; margin: -0.5px; min-height: 320px; display: flex; flex-direction: column; background: #F7F4F0; }
  .rs03-{{ section.id }} .r-system-card--dark { background: #1A1816; border-color: #1A1816; }
  .rs03-{{ section.id }} .r-system-card__num { font-size: 10px; letter-spacing: 0.3em; color: #8A8279; margin-bottom: auto; }
  .rs03-{{ section.id }} .r-system-card--dark .r-system-card__num { color: #B5ADA4; }
  .rs03-{{ section.id }} .r-system-card__highlight { font-size: 36px; font-weight: 200; color: #1A1816; margin: 32px 0 8px; letter-spacing: 0.02em; }
  .rs03-{{ section.id }} .r-system-card--dark .r-system-card__highlight { color: #F7F4F0; }
  .rs03-{{ section.id }} .r-system-card__highlight small { font-size: 14px; color: #8A8279; }
  .rs03-{{ section.id }} .r-system-card--dark .r-system-card__highlight small { color: #B5ADA4; }
  .rs03-{{ section.id }} .r-system-card__title { font-size: 20px; font-weight: 400; letter-spacing: 0.03em; color: #1A1816; margin-bottom: 12px; }
  .rs03-{{ section.id }} .r-system-card--dark .r-system-card__title { color: #F7F4F0; }
  .rs03-{{ section.id }} .r-system-card__text { font-size: 13px; line-height: 1.7; color: #8A8279; }
  .rs03-{{ section.id }} .r-system-card--dark .r-system-card__text { color: #B5ADA4; }

  /* ============ VIDEO ============ */
  .rs03-{{ section.id }} .r-video { padding: 140px 80px; background: #1A1816; }
  .rs03-{{ section.id }} .r-video__head { text-align: center; margin-bottom: 64px; }
  .rs03-{{ section.id }} .r-video__label { font-size: 10px; letter-spacing: 0.3em; text-transform: uppercase; color: #B5ADA4; margin-bottom: 16px; }
  .rs03-{{ section.id }} .r-video__heading { font-size: clamp(36px, 5vw, 56px); font-weight: 200; letter-spacing: 0.05em; color: #F7F4F0; margin-bottom: 16px; }
  .rs03-{{ section.id }} .r-video__sub { font-size: 14px; color: #8A8279; letter-spacing: 0.05em; }
  .rs03-{{ section.id }} .r-video__grid { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; max-width: 1400px; margin: 0 auto; }
  .rs03-{{ section.id }} .r-video__item { position: relative; aspect-ratio: 16/9; background: #2A2826; overflow: hidden; cursor: pointer; }
  .rs03-{{ section.id }} .r-video__item img { width: 100%; height: 100%; object-fit: cover; opacity: 0.7; transition: all 0.6s ease; }
  .rs03-{{ section.id }} .r-video__item:hover img { opacity: 0.5; }
  .rs03-{{ section.id }} .r-video__play { position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); width: 72px; height: 72px; border: 1px solid #F7F4F0; display: flex; align-items: center; justify-content: center; transition: all 0.4s ease; }
  .rs03-{{ section.id }} .r-video__item:hover .r-video__play { background: #F7F4F0; }
  .rs03-{{ section.id }} .r-video__play::before { content: ''; width: 0; height: 0; border-style: solid; border-width: 10px 0 10px 16px; border-color: transparent transparent transparent #F7F4F0; margin-left: 4px; transition: border-color 0.4s ease; }
  .rs03-{{ section.id }} .r-video__item:hover .r-video__play::before { border-color: transparent transparent transparent #1A1816; }
  .rs03-{{ section.id }} .r-video__label { position: absolute; bottom: 20px; left: 24px; font-size: 10px; letter-spacing: 0.25em; text-transform: uppercase; color: #F7F4F0; }
  .rs03-{{ section.id }} .r-video__duration { position: absolute; bottom: 20px; right: 24px; font-size: 10px; letter-spacing: 0.15em; color: #B5ADA4; background: rgba(26,24,22,0.8); padding: 4px 10px; }

  /* ============ SPECS TABLE ============ */
  .rs03-{{ section.id }} .r-specs { padding: 140px 80px; background: #1A1816; }
  .rs03-{{ section.id }} .r-specs__head { text-align: center; margin-bottom: 80px; }
  .rs03-{{ section.id }} .r-specs__heading { font-size: clamp(36px, 5vw, 56px); font-weight: 200; letter-spacing: 0.05em; color: #F7F4F0; }
  .rs03-{{ section.id }} .r-specs__table { max-width: 900px; margin: 0 auto; }
  .rs03-{{ section.id }} .r-specs__row { display: grid; grid-template-columns: 1fr 2fr; padding: 24px 0; border-bottom: 1px solid #2A2826; align-items: center; }
  .rs03-{{ section.id }} .r-specs__row:last-child { border-bottom: none; }
  .rs03-{{ section.id }} .r-specs__row-label { font-size: 10px; letter-spacing: 0.25em; text-transform: uppercase; color: #8A8279; }
  .rs03-{{ section.id }} .r-specs__row-value { font-size: 15px; color: #F7F4F0; font-weight: 300; letter-spacing: 0.03em; }

  /* ============ REVIEWS (Judge.me host) ============ */
  .rs03-{{ section.id }} .r-reviews { padding: 140px 80px; background: #F7F4F0; }
  .rs03-{{ section.id }} .r-reviews__head { max-width: 1280px; margin: 0 auto 16px; }
  .rs03-{{ section.id }} .r-reviews__powered { font-size: 9px; letter-spacing: 0.2em; text-transform: uppercase; color: #8A8279; }
  .rs03-{{ section.id }} .r-reviews__heading { font-size: 48px; font-weight: 300; letter-spacing: 0.1em; margin: 8px 0 0; color: #1A1816; }
  .rs03-{{ section.id }} #judgeme_product_reviews { margin-top: 40px; }

  /* ============ Q&A ============ */
  .rs03-{{ section.id }} .r-qa { padding: 140px 80px; background: #1A1816; }
  .rs03-{{ section.id }} .r-qa__head { text-align: center; margin-bottom: 80px; }
  .rs03-{{ section.id }} .r-qa__heading { font-size: clamp(36px, 5vw, 56px); font-weight: 200; letter-spacing: 0.05em; color: #F7F4F0; margin-bottom: 16px; }
  .rs03-{{ section.id }} .r-qa__sub { font-size: 14px; color: #8A8279; letter-spacing: 0.05em; }
  .rs03-{{ section.id }} .r-qa__list { max-width: 1000px; margin: 0 auto; }
  .rs03-{{ section.id }} .r-qa__item { padding: 32px 0; border-bottom: 1px solid #2A2826; }
  .rs03-{{ section.id }} .r-qa__q { font-size: 16px; color: #F7F4F0; font-weight: 400; letter-spacing: 0.02em; margin-bottom: 16px; }
  .rs03-{{ section.id }} .r-qa__q::before { content: 'Q.'; color: #8A8279; margin-right: 16px; font-size: 12px; letter-spacing: 0.2em; }
  .rs03-{{ section.id }} .r-qa__a { font-size: 14px; line-height: 1.8; color: #B5ADA4; }
  .rs03-{{ section.id }} .r-qa__a::before { content: 'A.'; color: #8A8279; margin-right: 16px; font-size: 12px; letter-spacing: 0.2em; }
  .rs03-{{ section.id }} .r-qa__ask { text-align: center; margin-top: 64px; }

  /* ============ CTA ============ */
  .rs03-{{ section.id }} .r-cta { padding: 180px 80px; background: #1A1816; text-align: center; border-top: 1px solid #2A2826; }
  .rs03-{{ section.id }} .r-cta__heading { font-size: clamp(48px, 7vw, 88px); font-weight: 200; letter-spacing: 0.08em; color: #F7F4F0; margin-bottom: 24px; }
  .rs03-{{ section.id }} .r-cta__sub { font-size: 15px; color: #8A8279; margin-bottom: 48px; letter-spacing: 0.05em; }
  .rs03-{{ section.id }} .r-cta__price { font-size: 24px; font-weight: 200; color: #F7F4F0; margin-bottom: 40px; letter-spacing: 0.05em; }
  .rs03-{{ section.id }} .r-cta__pay { display: flex; justify-content: center; gap: 12px; margin: 32px 0 16px; flex-wrap: wrap; }
  .rs03-{{ section.id }} .r-pay { padding: 10px 20px; border: 1px solid #2A2826; font-size: 10px; letter-spacing: 0.2em; text-transform: uppercase; color: #B5ADA4; min-width: 100px; text-align: center; }
  .rs03-{{ section.id }} .r-cta__afterpay { font-size: 12px; color: #8A8279; margin-bottom: 32px; letter-spacing: 0.05em; }
  .rs03-{{ section.id }} .r-cta__share { display: flex; justify-content: center; align-items: center; gap: 16px; margin-top: 40px; padding-top: 40px; border-top: 1px solid #2A2826; flex-wrap: wrap; }
  .rs03-{{ section.id }} .r-cta__share-label { font-size: 10px; letter-spacing: 0.25em; text-transform: uppercase; color: #8A8279; }
  .rs03-{{ section.id }} .r-cta__share-icons { display: flex; gap: 12px; }
  .rs03-{{ section.id }} .r-share-btn { width: 40px; height: 40px; border: 1px solid #2A2826; display: flex; align-items: center; justify-content: center; color: #B5ADA4; text-decoration: none; transition: all 0.4s ease; }
  .rs03-{{ section.id }} .r-share-btn:hover { border-color: #F7F4F0; color: #F7F4F0; }
  .rs03-{{ section.id }} .r-share-btn svg { width: 16px; height: 16px; fill: currentColor; }

  /* ============ RESPONSIVE — TABLET ============ */
  @media (max-width: 968px) {
    .rs03-{{ section.id }} .r-hero { grid-template-columns: 1fr; min-height: auto; }
    .rs03-{{ section.id }} .r-hero__image { height: 60vh; min-height: 400px; }
    .rs03-{{ section.id }} .r-hero__content { padding: 64px 32px; }
    .rs03-{{ section.id }} .r-hero__cta-row .r-btn { flex: 1; text-align: center; padding: 18px 16px; }
    .rs03-{{ section.id }} .r-stats { grid-template-columns: 1fr 1fr; }
    .rs03-{{ section.id }} .r-stat:nth-child(odd) { border-right: 1px solid #D4CEC6; }
    .rs03-{{ section.id }} .r-stat:nth-child(even) { border-right: none; }
    .rs03-{{ section.id }} .r-stat:nth-child(1), .rs03-{{ section.id }} .r-stat:nth-child(2) { border-bottom: 1px solid #D4CEC6; }
    .rs03-{{ section.id }} .r-overview { padding: 100px 32px; }
    .rs03-{{ section.id }} .r-feature { grid-template-columns: 1fr; min-height: auto; }
    .rs03-{{ section.id }} .r-feature--reverse .r-feature__image { order: 0; }
    .rs03-{{ section.id }} .r-feature__image { height: 50vh; min-height: 360px; }
    .rs03-{{ section.id }} .r-feature__content { padding: 64px 32px; }
    .rs03-{{ section.id }} .r-included { padding: 80px 32px; }
    .rs03-{{ section.id }} .r-included__grid { grid-template-columns: 1fr 1fr; }
    .rs03-{{ section.id }} .r-system { padding: 80px 32px; }
    .rs03-{{ section.id }} .r-system__grid { grid-template-columns: 1fr 1fr; }
    .rs03-{{ section.id }} .r-system-card { border: 1px solid #D4CEC6; margin: -0.5px; }
    .rs03-{{ section.id }} .r-video { padding: 80px 32px; }
    .rs03-{{ section.id }} .r-specs { padding: 80px 32px; }
    .rs03-{{ section.id }} .r-reviews { padding: 80px 32px; }
    .rs03-{{ section.id }} .r-qa { padding: 80px 32px; }
    .rs03-{{ section.id }} .r-cta { padding: 100px 32px; }
  }

  /* ============ RESPONSIVE — MOBILE ============ */
  @media (max-width: 640px) {
    .rs03-{{ section.id }} .r-hero__image { height: 45vh; min-height: 300px; }
    .rs03-{{ section.id }} .r-hero__content { padding: 48px 20px; }
    .rs03-{{ section.id }} .r-hero__title { font-size: 36px; letter-spacing: 0.1em; }
    .rs03-{{ section.id }} .r-hero__title span { font-size: 14px; }
    .rs03-{{ section.id }} .r-hero__sub { font-size: 14px; }
    .rs03-{{ section.id }} .r-hero__price { font-size: 32px; }
    .rs03-{{ section.id }} .r-hero__cta-row { flex-direction: column; gap: 12px; }
    .rs03-{{ section.id }} .r-hero__cta-row .r-btn { width: 100%; text-align: center; }
    .rs03-{{ section.id }} .r-stats { grid-template-columns: 1fr; }
    .rs03-{{ section.id }} .r-stat { border-right: none; border-bottom: 1px solid #D4CEC6; padding: 28px 20px; }
    .rs03-{{ section.id }} .r-stat:last-child { border-bottom: none; }
    .rs03-{{ section.id }} .r-stat__value { font-size: 36px; }
    .rs03-{{ section.id }} .r-overview { padding: 64px 20px; }
    .rs03-{{ section.id }} .r-overview__heading { font-size: 28px; }
    .rs03-{{ section.id }} .r-overview__text { font-size: 14px; }
