<script>
  (function() {
    var copyBtns = document.querySelectorAll('.r-share-copy');
    copyBtns.forEach(function(btn) {
      btn.addEventListener('click', function(e) {
        e.preventDefault();
        var url = btn.getAttribute('data-url');
        if (navigator.clipboard) {
          navigator.clipboard.writeText(url).then(function() {
            var original = btn.innerHTML;
            btn.innerHTML = '<svg viewBox="0 0 24 24" style="width:16px;height:16px;fill:none;stroke:currentColor;stroke-width:2;"><polyline points="20 6 9 17 4 12" stroke="currentColor" fill="none"/></svg>';
            setTimeout(function() { btn.innerHTML = original; }, 2000);
          });
        }
      });
    });
  })();
</script>

