      <p class="sensol-rs03__hero-tag">{{ section.settings.hero_tag }}</p>
      <h1 class="sensol-rs03__hero-title">{{ section.settings.hero_title }}</h1>
      <p class="sensol-rs03__hero-sub">{{ section.settings.hero_subtitle }}</p>
      <p class="sensol-rs03__hero-price">{{ section.settings.hero_price }} <span>{{ section.settings.hero_price_note }}</span></p>
      <a href="{{ section.settings.hero_cta_url }}" class="sensol-rs03__btn sensol-rs03__btn--light">{{ section.settings.hero_cta_text }}</a>
    </div>
  </section>

  {%- comment -%} ===== 2. INTRO ===== {%- endcomment -%}
  <section class="sensol-rs03__section">
    <div class="sensol-rs03__two-col">
      <div>
        <p class="sensol-rs03__label">{{ section.settings.intro_label }}</p>
        <h2 class="sensol-rs03__heading">{{ section.settings.intro_heading }}</h2>
        <p class="sensol-rs03__text">{{ section.settings.intro_text }}</p>
      </div>
      <div class="sensol-rs03__img-wrap sensol-rs03__img-wrap--portrait">
        {% if section.settings.intro_image %}<img src="{{ section.settings.intro_image | image_url: width: 800 }}" alt="RS03 Detail" width="800" height="1000">{% endif %}
      </div>
    </div>
  </section>

  {%- comment -%} ===== 3. KEY SPECS ===== {%- endcomment -%}
  <div class="sensol-rs03__specs">
    <div class="sensol-rs03__spec">
      <div class="sensol-rs03__spec-value">{{ section.settings.spec1_value }}</div>
      <div class="sensol-rs03__spec-label">{{ section.settings.spec1_label }}</div>
      <div class="sensol-rs03__spec-desc">{{ section.settings.spec1_desc }}</div>
    </div>
    <div class="sensol-rs03__spec">
      <div class="sensol-rs03__spec-value">{{ section.settings.spec2_value }}</div>
      <div class="sensol-rs03__spec-label">{{ section.settings.spec2_label }}</div>
      <div class="sensol-rs03__spec-desc">{{ section.settings.spec2_desc }}</div>
    </div>
    <div class="sensol-rs03__spec">
      <div class="sensol-rs03__spec-value">{{ section.settings.spec3_value }}</div>
      <div class="sensol-rs03__spec-label">{{ section.settings.spec3_label }}</div>
      <div class="sensol-rs03__spec-desc">{{ section.settings.spec3_desc }}</div>
    </div>
  </div>

  {%- comment -%} ===== 4. SMART RESISTANCE ===== {%- endcomment -%}
  <section class="sensol-rs03__section sensol-rs03__section--dark">
    <div class="sensol-rs03__two-col sensol-rs03__two-col--reverse">
      <div>
        <p class="sensol-rs03__label">{{ section.settings.resist_label }}</p>
        <h2 class="sensol-rs03__heading">{{ section.settings.resist_heading }}</h2>
        <p class="sensol-rs03__text">{{ section.settings.resist_text }}</p>
      </div>
      <div class="sensol-rs03__img-wrap sensol-rs03__img-wrap--portrait">
        {% if section.settings.resist_image %}<img src="{{ section.settings.resist_image | image_url: width: 800 }}" alt="Smart Resistance" width="800" height="1000">{% endif %}
      </div>
    </div>
    <div class="sensol-rs03__features" style="margin-top: 60px;">
      <div class="sensol-rs03__feature">
        <div class="sensol-rs03__feature-icon"><svg viewBox="0 0 48 48"><circle cx="24" cy="24" r="18"/><path d="M24 12v12l8 8"/></svg></div>
        <p class="sensol-rs03__feature-title">{{ section.settings.resist_f1_title }}</p>
        <p class="sensol-rs03__feature-text">{{ section.settings.resist_f1_text }}</p>
      </div>
      <div class="sensol-rs03__feature">
        <div class="sensol-rs03__feature-icon"><svg viewBox="0 0 48 48"><rect x="6" y="6" width="36" height="36" rx="2"/><path d="M14 24h20M24 14v20"/></svg></div>
        <p class="sensol-rs03__feature-title">{{ section.settings.resist_f2_title }}</p>
        <p class="sensol-rs03__feature-text">{{ section.settings.resist_f2_text }}</p>
      </div>
      <div class="sensol-rs03__feature">
        <div class="sensol-rs03__feature-icon"><svg viewBox="0 0 48 48"><path d="M6 24c0-10 8-18 18-18s18 8 18 18-8 18-18 18"/><path d="M24 16v8l6 6"/></svg></div>
        <p class="sensol-rs03__feature-title">{{ section.settings.resist_f3_title }}</p>
        <p class="sensol-rs03__feature-text">{{ section.settings.resist_f3_text }}</p>
      </div>
    </div>
  </section>

  {%- comment -%} ===== 5. MOTION RANGE ===== {%- endcomment -%}
  <section class="sensol-rs03__section">
    <div class="sensol-rs03__two-col">
      <div>
        <p class="sensol-rs03__label">{{ section.settings.motion_label }}</p>
        <h2 class="sensol-rs03__heading">{{ section.settings.motion_heading }}</h2>
        <p class="sensol-rs03__text">{{ section.settings.motion_text }}</p>
      </div>
      <div class="sensol-rs03__img-wrap sensol-rs03__img-wrap--portrait">
        {% if section.settings.motion_image %}<img src="{{ section.settings.motion_image | image_url: width: 800 }}" alt="360 Motion" width="800" height="1000">{% endif %}
      </div>
    </div>
  </section>

  {%- comment -%} ===== 6. TECH STRIP ===== {%- endcomment -%}
  <div class="sensol-rs03__tech-strip">
    <div class="sensol-rs03__tech-item">
      <div class="sensol-rs03__tech-value">{{ section.settings.tech1_value }}</div>
      <div class="sensol-rs03__tech-label">{{ section.settings.tech1_label }}</div>
    </div>
    <div class="sensol-rs03__tech-item">
      <div class="sensol-rs03__tech-value">{{ section.settings.tech2_value }}</div>
      <div class="sensol-rs03__tech-label">{{ section.settings.tech2_label }}</div>
    </div>
    <div class="sensol-rs03__tech-item">
      <div class="sensol-rs03__tech-value">{{ section.settings.tech3_value }}</div>
      <div class="sensol-rs03__tech-label">{{ section.settings.tech3_label }}</div>
    </div>
    <div class="sensol-rs03__tech-item">
      <div class="sensol-rs03__tech-value">{{ section.settings.tech4_value }}</div>
      <div class="sensol-rs03__tech-label">{{ section.settings.tech4_label }}</div>
    </div>
  </div>

  {%- comment -%} ===== 7. APP & CONNECTIVITY ===== {%- endcomment -%}
  <section class="sensol-rs03__section sensol-rs03__section--dark">
    <div class="sensol-rs03__two-col sensol-rs03__two-col--reverse">
      <div>
        <p class="sensol-rs03__label">{{ section.settings.app_label }}</p>
        <h2 class="sensol-rs03__heading">{{ section.settings.app_heading }}</h2>
        <p class="sensol-rs03__text">{{ section.settings.app_text }}</p>
      </div>
      <div class="sensol-rs03__img-wrap sensol-rs03__img-wrap--portrait">
        {% if section.settings.app_image %}<img src="{{ section.settings.app_image | image_url: width: 800 }}" alt="App" width="800" height="1000">{% endif %}
      </div>
    </div>
    <div class="sensol-rs03__features" style="margin-top: 60px;">
      <div class="sensol-rs03__feature">
        <div class="sensol-rs03__feature-icon"><svg viewBox="0 0 48 48"><rect x="10" y="4" width="28" height="40" rx="4"/><path d="M20 38h8"/></svg></div>
        <p class="sensol-rs03__feature-title">{{ section.settings.app_f1_title }}</p>
        <p class="sensol-rs03__feature-text">{{ section.settings.app_f1_text }}</p>
      </div>
      <div class="sensol-rs03__feature">
        <div class="sensol-rs03__feature-icon"><svg viewBox="0 0 48 48"><path d="M8 36l8-12 8 8 8-16 8 12"/></svg></div>
        <p class="sensol-rs03__feature-title">{{ section.settings.app_f2_title }}</p>
        <p class="sensol-rs03__feature-text">{{ section.settings.app_f2_text }}</p>
      </div>
      <div class="sensol-rs03__feature">
        <div class="sensol-rs03__feature-icon"><svg viewBox="0 0 48 48"><circle cx="24" cy="24" r="8"/><path d="M24 4v4M24 40v4M4 24h4M40 24h4M10.1 10.1l2.8 2.8M35.1 35.1l2.8 2.8M10.1 37.9l2.8-2.8M35.1 12.9l2.8-2.8"/></svg></div>
        <p class="sensol-rs03__feature-title">{{ section.settings.app_f3_title }}</p>
        <p class="sensol-rs03__feature-text">{{ section.settings.app_f3_text }}</p>
      </div>
    </div>
  </section>

  {%- comment -%} ===== 8. DESIGN & CRAFT ===== {%- endcomment -%}
  <section class="sensol-rs03__section">
    <div class="sensol-rs03__two-col">
      <div>
        <p class="sensol-rs03__label">{{ section.settings.design_label }}</p>
        <h2 class="sensol-rs03__heading">{{ section.settings.design_heading }}</h2>
        <p class="sensol-rs03__text">{{ section.settings.design_text }}</p>
      </div>
      <div class="sensol-rs03__img-wrap sensol-rs03__img-wrap--portrait">
        {% if section.settings.design_image %}<img src="{{ section.settings.design_image | image_url: width: 800 }}" alt="Design" width="800" height="1000">{% endif %}
      </div>
    </div>
  </section>

  {%- comment -%} ===== 9. FULL SPECS TABLE ===== {%- endcomment -%}
  <section class="sensol-rs03__section sensol-rs03__section--dark">
    <p class="sensol-rs03__label" style="text-align:center;">{{ section.settings.specs_label }}</p>
    <h2 class="sensol-rs03__heading" style="text-align:center;">{{ section.settings.specs_heading }}</h2>
    <table class="sensol-rs03__table">
      <tr><td>{{ section.settings.spec_row1_label }}</td><td>{{ section.settings.spec_row1_value }}</td></tr>
      <tr><td>{{ section.settings.spec_row2_label }}</td><td>{{ section.settings.spec_row2_value }}</td></tr>
      <tr><td>{{ section.settings.spec_row3_label }}</td><td>{{ section.settings.spec_row3_value }}</td></tr>
      <tr><td>{{ section.settings.spec_row4_label }}</td><td>{{ section.settings.spec_row4_value }}</td></tr>
      <tr><td>{{ section.settings.spec_row5_label }}</td><td>{{ section.settings.spec_row5_value }}</td></tr>
      <tr><td>{{ section.settings.spec_row6_label }}</td><td>{{ section.settings.spec_row6_value }}</td></tr>
      <tr><td>{{ section.settings.spec_row7_label }}</td><td>{{ section.settings.spec_row7_value }}</td></tr>
      <tr><td>{{ section.settings.spec_row8_label }}</td><td>{{ section.settings.spec_row8_value }}</td></tr>
    </table>
  </section>

  {%- comment -%} ===== 10. CTA ===== {%- endcomment -%}
