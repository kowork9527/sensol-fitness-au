{%- liquid
  assign s = section.settings
  assign p = product
  assign hero_img = s.hero_image
  if hero_img == blank and p and p.featured_image
    assign hero_img = p.featured_image
  endif
  assign ov_img = s.ov_image
  if ov_img == blank and p and p.images.size > 1
    assign ov_img = p.images[1]
  endif
-%}
<style>
#shopify-section-{{ section.id }}{font-family:'Inter',sans-serif;color:#1A1816;background:#F7F4F0;display:block;width:100%}
#shopify-section-{{ section.id }} *{box-sizing:border-box}
#shopify-section-{{ section.id }} .rs03-hero{position:relative;min-height:90vh;background:#1A1816;display:grid;grid-template-columns:1.1fr 1fr;overflow:hidden}
#shopify-section-{{ section.id }} .rs03-hero__img{position:relative;overflow:hidden;background:#2A2826;min-height:500px}
#shopify-section-{{ section.id }} .rs03-hero__img img{width:100%;height:100%;object-fit:cover;display:block;position:absolute;inset:0}
#shopify-section-{{ section.id }} .rs03-hero__content{display:flex;flex-direction:column;justify-content:center;padding:100px 80px;color:#F7F4F0}
#shopify-section-{{ section.id }} .rs03-tag{font-size:10px;letter-spacing:.3em;text-transform:uppercase;color:#B5ADA4;margin-bottom:32px}
#shopify-section-{{ section.id }} .rs03-title{font-size:clamp(48px,6vw,80px);font-weight:200;letter-spacing:.04em;line-height:1;margin:0 0 24px;color:#F7F4F0}
#shopify-section-{{ section.id }} .rs03-sub{font-size:16px;font-weight:300;color:#B5ADA4;line-height:1.7;max-width:480px;margin-bottom:40px}
#shopify-section-{{ section.id }} .rs03-cta{display:inline-block;padding:18px 48px;background:#F7F4F0;color:#1A1816;text-decoration:none;font-size:11px;letter-spacing:.3em;text-transform:uppercase;font-weight:500;transition:.4s;cursor:pointer}
#shopify-section-{{ section.id }} .rs03-cta:hover{background:#B5ADA4}
#shopify-section-{{ section.id }} .rs03-stats{display:grid;grid-template-columns:repeat(4,1fr);border-top:1px solid #D4CEC6;border-bottom:1px solid #D4CEC6;background:#F7F4F0}
#shopify-section-{{ section.id }} .rs03-stat{padding:48px 32px;text-align:center;border-right:1px solid #D4CEC6}
#shopify-section-{{ section.id }} .rs03-stat:last-child{border-right:none}
#shopify-section-{{ section.id }} .rs03-stat__num{font-size:48px;font-weight:200;letter-spacing:.05em;color:#1A1816;line-height:1;margin-bottom:8px}
#shopify-section-{{ section.id }} .rs03-stat__lbl{font-size:10px;letter-spacing:.25em;text-transform:uppercase;color:#8A8279}
#shopify-section-{{ section.id }} .rs03-section{padding:120px 60px}
#shopify-section-{{ section.id }} .rs03-section--dark{background:#1A1816;color:#F7F4F0}
#shopify-section-{{ section.id }} .rs03-section__head{text-align:center;margin-bottom:80px;max-width:800px;margin-left:auto;margin-right:auto}
#shopify-section-{{ section.id }} .rs03-section__eyebrow{font-size:10px;letter-spacing:.3em;text-transform:uppercase;color:#8A8279;margin-bottom:20px}
#shopify-section-{{ section.id }} .rs03-section--dark .rs03-section__eyebrow{color:#B5ADA4}
#shopify-section-{{ section.id }} .rs03-section__title{font-size:clamp(32px,4vw,48px);font-weight:300;letter-spacing:.06em;line-height:1.1;margin:0}
#shopify-section-{{ section.id }} .rs03-overview{display:grid;grid-template-columns:1fr 1fr;gap:80px;align-items:center;max-width:1400px;margin:0 auto}
#shopify-section-{{ section.id }} .rs03-overview__img{aspect-ratio:4/5;background:#D4CEC6;overflow:hidden}
#shopify-section-{{ section.id }} .rs03-overview__img img{width:100%;height:100%;object-fit:cover}
#shopify-section-{{ section.id }} .rs03-overview__text h2{font-size:36px;font-weight:300;letter-spacing:.04em;margin:0 0 24px}
#shopify-section-{{ section.id }} .rs03-overview__text p{font-size:16px;line-height:1.8;color:#1A1816;margin:0 0 16px}
#shopify-section-{{ section.id }} .rs03-features{display:grid;grid-template-columns:repeat(3,1fr);gap:48px;max-width:1400px;margin:0 auto}
#shopify-section-{{ section.id }} .rs03-feature{padding:48px 32px;border:1px solid #D4CEC6;background:#fff}
#shopify-section-{{ section.id }} .rs03-feature__num{font-size:12px;letter-spacing:.2em;color:#8A8279;margin-bottom:24px}
#shopify-section-{{ section.id }} .rs03-feature__title{font-size:22px;font-weight:400;letter-spacing:.05em;margin:0 0 16px;color:#1A1816}
#shopify-section-{{ section.id }} .rs03-feature__desc{font-size:14px;line-height:1.7;color:#8A8279;margin:0}
#shopify-section-{{ section.id }} .rs03-included{display:grid;grid-template-columns:repeat(2,1fr);gap:24px;max-width:1000px;margin:0 auto}
#shopify-section-{{ section.id }} .rs03-included__item{display:flex;align-items:center;gap:16px;padding:20px;border-bottom:1px solid #D4CEC6}
#shopify-section-{{ section.id }} .rs03-included__check{width:20px;height:20px;border:1px solid #1A1816;border-radius:50%;display:flex;align-items:center;justify-content:center;flex-shrink:0}
#shopify-section-{{ section.id }} .rs03-included__check::after{content:'';width:8px;height:8px;background:#1A1816;border-radius:50%}
#shopify-section-{{ section.id }} .rs03-included__name{font-size:14px;letter-spacing:.05em;color:#1A1816}
#shopify-section-{{ section.id }} .rs03-specstrip{display:grid;grid-template-columns:repeat(4,1fr);background:#2A2826;padding:60px 0}
#shopify-section-{{ section.id }} .rs03-specstrip__item{text-align:center;border-right:1px solid #1A1816;padding:0 24px}
#shopify-section-{{ section.id }} .rs03-specstrip__item:last-child{border-right:none}
#shopify-section-{{ section.id }} .rs03-specstrip__label{font-size:10px;letter-spacing:.25em;text-transform:uppercase;color:#8A8279;margin-bottom:12px}
#shopify-section-{{ section.id }} .rs03-specstrip__value{font-size:18px;font-weight:300;letter-spacing:.05em;color:#F7F4F0}
#shopify-section-{{ section.id }} .rs03-systems{display:grid;grid-template-columns:repeat(2,1fr);gap:48px;max-width:1400px;margin:0 auto}
#shopify-section-{{ section.id }} .rs03-system{padding:48px;border:1px solid #D4CEC6;background:#F7F4F0}
#shopify-section-{{ section.id }} .rs03-system__num{width:48px;height:48px;background:#1A1816;color:#F7F4F0;display:flex;align-items:center;justify-content:center;font-size:18px;margin-bottom:24px;letter-spacing:.05em}
#shopify-section-{{ section.id }} .rs03-system__title{font-size:20px;font-weight:400;letter-spacing:.05em;margin:0 0 12px;color:#1A1816}
#shopify-section-{{ section.id }} .rs03-system__desc{font-size:14px;line-height:1.7;color:#8A8279;margin:0}
#shopify-section-{{ section.id }} .rs03-videos{display:grid;grid-template-columns:repeat(2,1fr);gap:32px;max-width:1200px;margin:0 auto}
#shopify-section-{{ section.id }} .rs03-video{aspect-ratio:16/9;background:#1A1816;overflow:hidden}
#shopify-section-{{ section.id }} .rs03-video video,#shopify-section-{{ section.id }} .rs03-video iframe{width:100%;height:100%;object-fit:cover;border:0;display:block}
#shopify-section-{{ section.id }} .rs03-video__label{padding:16px 0;font-size:12px;letter-spacing:.2em;text-transform:uppercase;color:#8A8279}
#shopify-section-{{ section.id }} .rs03-specs{max-width:900px;margin:0 auto}
#shopify-section-{{ section.id }} .rs03-specs__row{display:grid;grid-template-columns:200px 1fr;padding:20px 0;border-bottom:1px solid #D4CEC6;font-size:14px;gap:24px}
#shopify-section-{{ section.id }} .rs03-specs__lbl{letter-spacing:.1em;text-transform:uppercase;color:#8A8279;font-size:11px}
#shopify-section-{{ section.id }} .rs03-specs__val{color:#1A1816;letter-spacing:.03em}
#shopify-section-{{ section.id }} .rs03-reviews{max-width:900px;margin:0 auto;display:grid;grid-template-columns:repeat(2,1fr);gap:32px}
#shopify-section-{{ section.id }} .rs03-review{padding:32px;border:1px solid #D4CEC6;background:#fff}
#shopify-section-{{ section.id }} .rs03-review__stars{color:#B5ADA4;letter-spacing:2px;margin-bottom:12px;font-size:14px}
#shopify-section-{{ section.id }} .rs03-review__title{font-size:16px;font-weight:500;margin:0 0 8px;color:#1A1816}
#shopify-section-{{ section.id }} .rs03-review__body{font-size:14px;line-height:1.7;color:#1A1816;margin:0 0 16px}
#shopify-section-{{ section.id }} .rs03-review__author{font-size:12px;letter-spacing:.1em;text-transform:uppercase;color:#8A8279}
#shopify-section-{{ section.id }} .rs03-qa{max-width:800px;margin:0 auto}
#shopify-section-{{ section.id }} .rs03-qa__item{padding:24px 0;border-bottom:1px solid #D4CEC6}
#shopify-section-{{ section.id }} .rs03-qa__q{font-size:16px;font-weight:500;color:#1A1816;margin:0 0 12px;letter-spacing:.03em}
#shopify-section-{{ section.id }} .rs03-qa__a{font-size:14px;line-height:1.7;color:#8A8279;margin:0}
#shopify-section-{{ section.id }} .rs03-cta-block{text-align:center;padding:120px 40px;background:#1A1816;color:#F7F4F0}
#shopify-section-{{ section.id }} .rs03-cta-block h2{font-size:48px;font-weight:200;letter-spacing:.04em;margin:0 0 24px}
#shopify-section-{{ section.id }} .rs03-cta-block p{font-size:16px;color:#B5ADA4;margin:0 0 40px;max-width:600px;margin-left:auto;margin-right:auto;line-height:1.7}
#shopify-section-{{ section.id }} .rs03-payments{display:flex;justify-content:center;gap:12px;margin-top:32px;flex-wrap:wrap}
#shopify-section-{{ section.id }} .rs03-payments__item{font-size:10px;letter-spacing:.2em;text-transform:uppercase;color:#B5ADA4;padding:8px 16px;border:1px solid #2A2826}
#shopify-section-{{ section.id }} .rs03-share{display:flex;justify-content:center;gap:16px;margin-top:40px}
#shopify-section-{{ section.id }} .rs03-share a{width:40px;height:40px;border:1px solid #2A2826;border-radius:50%;display:flex;align-items:center;justify-content:center;color:#B5ADA4;text-decoration:none;font-size:12px}
@media(max-width:968px){
  #shopify-section-{{ section.id }} .rs03-hero{grid-template-columns:1fr;min-height:auto}
  #shopify-section-{{ section.id }} .rs03-hero__content{padding:60px 24px}
  #shopify-section-{{ section.id }} .rs03-hero__img{aspect-ratio:4/3;min-height:300px}
  #shopify-section-{{ section.id }} .rs03-stats{grid-template-columns:repeat(2,1fr)}
  #shopify-section-{{ section.id }} .rs03-stat{border-bottom:1px solid #D4CEC6}
  #shopify-section-{{ section.id }} .rs03-section{padding:60px 20px}
  #shopify-section-{{ section.id }} .rs03-overview{grid-template-columns:1fr;gap:40px}
  #shopify-section-{{ section.id }} .rs03-features{grid-template-columns:1fr;gap:24px}
  #shopify-section-{{ section.id }} .rs03-included{grid-template-columns:1fr}
  #shopify-section-{{ section.id }} .rs03-specstrip{grid-template-columns:repeat(2,1fr);padding:40px 20px}
  #shopify-section-{{ section.id }} .rs03-specstrip__item{padding:20px;border-bottom:1px solid #1A1816}
  #shopify-section-{{ section.id }} .rs03-systems{grid-template-columns:1fr;gap:24px}
  #shopify-section-{{ section.id }} .rs03-videos{grid-template-columns:1fr}
  #shopify-section-{{ section.id }} .rs03-specs__row{grid-template-columns:1fr;gap:8px}
  #shopify-section-{{ section.id }} .rs03-reviews{grid-template-columns:1fr}
  #shopify-section-{{ section.id }} .rs03-cta-block{padding:60px 20px}
  #shopify-section-{{ section.id }} .rs03-cta-block h2{font-size:32px}
}
</style>

{%- comment -%}HERO{%- endcomment -%}
<section class="rs03-hero">
  <div class="rs03-hero__content">
    {%- if s.hero_eyebrow != blank -%}<div class="rs03-tag">{{ s.hero_eyebrow }}</div>{%- endif -%}
    <h1 class="rs03-title">{{ s.hero_title }}</h1>
    {%- if s.hero_subtitle != blank -%}<p class="rs03-sub">{{ s.hero_subtitle }}</p>{%- endif -%}
    {%- if s.hero_cta_text != blank -%}
      <div><a href="{{ s.hero_cta_link | default: '/products/sensol-one-plus' }}" class="rs03-cta">{{ s.hero_cta_text }}</a></div>
    {%- endif -%}
  </div>
  <div class="rs03-hero__img">
    {%- if hero_img != blank -%}
      {{ hero_img | image_url: width: 1400 | image_tag: loading: 'eager', widths: '700, 1400' }}
    {%- endif -%}
  </div>
</section>

{%- comment -%}STATS{%- endcomment -%}
<section class="rs03-stats">
  {%- for i in (1..4) -%}
    {%- assign num_key = 'stat_' | append: i | append: '_num' -%}
    {%- assign lbl_key = 'stat_' | append: i | append: '_lbl' -%}
    <div class="rs03-stat">
      <div class="rs03-stat__num">{{ s[num_key] }}</div>
      <div class="rs03-stat__lbl">{{ s[lbl_key] }}</div>
    </div>
  {%- endfor -%}
</section>

{%- comment -%}OVERVIEW{%- endcomment -%}
<section class="rs03-section">
  <div class="rs03-section__head">
    {%- if s.ov_eyebrow != blank -%}<div class="rs03-section__eyebrow">{{ s.ov_eyebrow }}</div>{%- endif -%}
    <h2 class="rs03-section__title">{{ s.ov_title }}</h2>
  </div>
  <div class="rs03-overview">
    <div class="rs03-overview__img">
      {%- if ov_img != blank -%}
        {{ ov_img | image_url: width: 900 | image_tag: loading: 'lazy', widths: '450, 900' }}
      {%- endif -%}
    </div>
    <div class="rs03-overview__text">
      {%- if s.ov_body != blank -%}{{ s.ov_body }}{%- else -%}
        <h2>Engineered for the Modern Home</h2>
        <p>The RS03 is built on a precision aluminum frame, finished in our Sydney workshop. Every component is selected for its material integrity, its acoustic profile, and the quality of movement it produces.</p>
        <p>This is not a fitness machine. It is a piece of spatial design, made to perform.</p>
      {%- endif -%}
    </div>
  </div>
</section>

{%- comment -%}FEATURES 3 cards{%- endcomment -%}
<section class="rs03-section rs03-section--dark">
  <div class="rs03-section__head">
    {%- if s.feat_eyebrow != blank -%}<div class="rs03-section__eyebrow">{{ s.feat_eyebrow }}</div>{%- endif -%}
    <h2 class="rs03-section__title" style="color:#F7F4F0">{{ s.feat_title }}</h2>
  </div>
  <div class="rs03-features">
    {%- for i in (1..3) -%}
      {%- assign t_key = 'feat_' | append: i | append: '_title' -%}
      {%- assign d_key = 'feat_' | append: i | append: '_desc' -%}
      {%- assign n_key = 'feat_' | append: i | append: '_num' -%}
      <div class="rs03-feature">
        <div class="rs03-feature__num">{{ s[n_key] }}</div>
        <h3 class="rs03-feature__title">{{ s[t_key] }}</h3>
        <p class="rs03-feature__desc">{{ s[d_key] }}</p>
      </div>
    {%- endfor -%}
  </div>
</section>

{%- comment -%}INCLUDED{%- endcomment -%}
<section class="rs03-section">
  <div class="rs03-section__head">
    {%- if s.inc_eyebrow != blank -%}<div class="rs03-section__eyebrow">{{ s.inc_eyebrow }}</div>{%- endif -%}
    <h2 class="rs03-section__title">{{ s.inc_title }}</h2>
  </div>
  <div class="rs03-included">
    {%- for i in (1..8) -%}
      {%- assign n_key = 'inc_' | append: i | append: '_name' -%}
      {%- if s[n_key] != blank -%}
        <div class="rs03-included__item">
          <div class="rs03-included__check"></div>
          <div class="rs03-included__name">{{ s[n_key] }}</div>
        </div>
      {%- endif -%}
    {%- endfor -%}
  </div>
</section>

{%- comment -%}SPEC STRIP{%- endcomment -%}
<section class="rs03-specstrip">
  {%- for i in (1..4) -%}
    {%- assign l_key = 'spec_' | append: i | append: '_label' -%}
    {%- assign v_key = 'spec_' | append: i | append: '_value' -%}
    <div class="rs03-specstrip__item">
      <div class="rs03-specstrip__label">{{ s[l_key] }}</div>
      <div class="rs03-specstrip__value">{{ s[v_key] }}</div>
    </div>
  {%- endfor -%}
</section>

{%- comment -%}SYSTEMS 4 cards{%- endcomment -%}
<section class="rs03-section rs03-section--dark">
  <div class="rs03-section__head">
    {%- if s.sys_eyebrow != blank -%}<div class="rs03-section__eyebrow">{{ s.sys_eyebrow }}</div>{%- endif -%}
    <h2 class="rs03-section__title" style="color:#F7F4F0">{{ s.sys_title }}</h2>
  </div>
  <div class="rs03-systems">
    {%- for block in section.blocks -%}
      {%- if block.type == 'system' -%}
        <div class="rs03-system">
          <div class="rs03-system__num">{{ block.settings.number }}</div>
          <h3 class="rs03-system__title">{{ block.settings.title }}</h3>
          <p class="rs03-system__desc">{{ block.settings.desc }}</p>
        </div>
      {%- endif -%}
    {%- endfor -%}
  </div>
</section>

{%- comment -%}VIDEOS{%- endcomment -%}
{%- assign has_videos = false -%}
{%- for block in section.blocks -%}
  {%- if block.type == 'video' and block.settings.video != blank -%}
    {%- assign has_videos = true -%}
  {%- endif -%}
{%- endfor -%}
{%- if has_videos -%}
<section class="rs03-section">
  <div class="rs03-section__head">
    {%- if s.vid_eyebrow != blank -%}<div class="rs03-section__eyebrow">{{ s.vid_eyebrow }}</div>{%- endif -%}
    <h2 class="rs03-section__title">{{ s.vid_title }}</h2>
  </div>
  <div class="rs03-videos">
    {%- for block in section.blocks -%}
      {%- if block.type == 'video' -%}
        <div>
          <div class="rs03-video">
            {%- if block.settings.video != blank -%}
              {{ block.settings.video | video_tag: autoplay: false, loop: false, controls: true }}
            {%- elsif block.settings.video_url != blank -%}
              <iframe src="{{ block.settings.video_url }}" allowfullscreen></iframe>
            {%- endif -%}
          </div>
          {%- if block.settings.label != blank -%}<div class="rs03-video__label">{{ block.settings.label }}</div>{%- endif -%}
        </div>
      {%- endif -%}
    {%- endfor -%}
  </div>
</section>
{%- endif -%}

{%- comment -%}FULL SPECS{%- endcomment -%}
<section class="rs03-section">
  <div class="rs03-section__head">
    {%- if s.full_eyebrow != blank -%}<div class="rs03-section__eyebrow">{{ s.full_eyebrow }}</div>{%- endif -%}
    <h2 class="rs03-section__title">{{ s.full_title }}</h2>
  </div>
  <div class="rs03-specs">
    {%- for block in section.blocks -%}
      {%- if block.type == 'fullspec' -%}
        <div class="rs03-specs__row">
          <div class="rs03-specs__lbl">{{ block.settings.label }}</div>
          <div class="rs03-specs__val">{{ block.settings.value }}</div>
        </div>
      {%- endif -%}
    {%- endfor -%}
  </div>
</section>

{%- comment -%}REVIEWS{%- endcomment -%}
<section class="rs03-section">
  <div class="rs03-section__head">
    <div class="rs03-section__eyebrow">{{ s.rev_eyebrow }}</div>
    <h2 class="rs03-section__title">{{ s.rev_title }}</h2>
  </div>
  <div class="rs03-reviews">
    {%- for block in section.blocks -%}
      {%- if block.type == 'review' -%}
        <div class="rs03-review">
          <div class="rs03-review__stars">
            {%- assign r = block.settings.rating | at_least: 1 -%}
            {%- for star in (1..r) -%}★{%- endfor -%}
          </div>
          {%- if block.settings.title != blank -%}<h4 class="rs03-review__title">{{ block.settings.title }}</h4>{%- endif -%}
          {%- if block.settings.body != blank -%}<p class="rs03-review__body">{{ block.settings.body }}</p>{%- endif -%}
          <div class="rs03-review__author">— {{ block.settings.author }} | {{ block.settings.date }}</div>
        </div>
      {%- endif -%}
    {%- endfor -%}
  </div>
  {%- if p -%}
    <div id="judgeme_product_reviews" data-product-id="{{ p.id }}" class="jdgm-widget jdgm-reviews-widget" style="margin-top:60px"></div>
  {%- endif -%}
</section>

{%- comment -%}Q&A{%- endcomment -%}
<section class="rs03-section">
  <div class="rs03-section__head">
    <div class="rs03-section__eyebrow">{{ s.qa_eyebrow }}</div>
    <h2 class="rs03-section__title">{{ s.qa_title }}</h2>
  </div>
  <div class="rs03-qa">
    {%- for block in section.blocks -%}
      {%- if block.type == 'qa' -%}
        <div class="rs03-qa__item">
          <h3 class="rs03-qa__q">{{ block.settings.q }}</h3>
          <p class="rs03-qa__a">{{ block.settings.a }}</p>
        </div>
      {%- endif -%}
    {%- endfor -%}
  </div>
</section>

{%- comment -%}CTA BLOCK{%- endcomment -%}
<section class="rs03-cta-block">
  {%- if s.cta_eyebrow != blank -%}<div class="rs03-section__eyebrow" style="color:#B5ADA4;margin-bottom:20px">{{ s.cta_eyebrow }}</div>{%- endif -%}
  <h2>{{ s.cta_title }}</h2>
  {%- if s.cta_text != blank -%}<p>{{ s.cta_text }}</p>{%- endif -%}
  {%- if s.cta_btn_text != blank -%}
    <a href="{{ s.cta_btn_link | default: '/products/sensol-one-plus' }}" class="rs03-cta">{{ s.cta_btn_text }}</a>
  {%- endif -%}
  <div class="rs03-payments">
    <div class="rs03-payments__item">PayPal</div>
    <div class="rs03-payments__item">Afterpay</div>
    <div class="rs03-payments__item">Shop Pay</div>
    <div class="rs03-payments__item">Apple Pay</div>
