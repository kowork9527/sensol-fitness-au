{%- liquid
  assign s = section.settings
-%}
<style>
#shopify-section-{{ section.id }} .sp-video{font-family:'Inter',sans-serif;background:#1A1816;color:#F7F4F0;padding:120px 0;overflow:hidden}
#shopify-section-{{ section.id }} .sp-video__header{max-width:800px;margin:0 auto 60px;padding:0 40px;text-align:center}
#shopify-section-{{ section.id }} .sp-video__track-wrap{max-width:1400px;margin:0 auto}
#shopify-section-{{ section.id }} .sp-video__eyebrow{font-size:11px;font-weight:500;letter-spacing:0.35em;text-transform:uppercase;color:#B5ADA4;margin-bottom:24px}
#shopify-section-{{ section.id }} .sp-video__title{font-size:clamp(28px,4vw,44px);font-weight:200;letter-spacing:0.04em;max-width:600px;margin:0 auto;line-height:1.2}
#shopify-section-{{ section.id }} .sp-video__track{display:flex;gap:20px;overflow-x:auto;scroll-snap-type:x mandatory;-webkit-overflow-scrolling:touch;padding:0 40px 24px;scrollbar-width:none;-ms-overflow-style:none;cursor:grab;justify-content:center;min-width:0}
#shopify-section-{{ section.id }} .sp-video__track::-webkit-scrollbar{display:none}
#shopify-section-{{ section.id }} .sp-video__track:active{cursor:grabbing}
#shopify-section-{{ section.id }} .sp-video__card{flex:0 0 auto;width:280px;scroll-snap-align:center;position:relative}
#shopify-section-{{ section.id }} .sp-video__frame{aspect-ratio:9/16;background:#2A2826;overflow:hidden;position:relative;cursor:pointer;border-radius:4px;border:1px solid #333}
#shopify-section-{{ section.id }} .sp-video__frame img,#shopify-section-{{ section.id }} .sp-video__frame video{width:100%;height:100%;object-fit:cover}
#shopify-section-{{ section.id }} .sp-video__overlay{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;background:rgba(0,0,0,0.3);transition:background 0.4s cubic-bezier(0.25,0.1,0.25,1)}
#shopify-section-{{ section.id }} .sp-video__overlay:hover{background:rgba(0,0,0,0.15)}
#shopify-section-{{ section.id }} .sp-video__play{width:56px;height:56px;border:2px solid rgba(255,255,255,0.8);border-radius:50%;display:flex;align-items:center;justify-content:center;transition:transform 0.3s cubic-bezier(0.25,0.1,0.25,1);background:rgba(0,0,0,0.2)}
#shopify-section-{{ section.id }} .sp-video__play svg{width:20px;height:20px;fill:#fff;margin-left:3px}
#shopify-section-{{ section.id }} .sp-video__card:hover .sp-video__play{transform:scale(1.1)}
#shopify-section-{{ section.id }} .sp-video__caption{padding:16px 0 0;text-align:center}
#shopify-section-{{ section.id }} .sp-video__card-title{font-size:12px;font-weight:500;letter-spacing:0.15em;text-transform:uppercase;color:#F7F4F0}
#shopify-section-{{ section.id }} .sp-video__duration{font-family:'JetBrains Mono',monospace;font-size:11px;color:#8A8279;margin-top:6px}
#shopify-section-{{ section.id }} .sp-video__hint{text-align:center;font-size:10px;letter-spacing:0.3em;text-transform:uppercase;color:#8A8279;margin-top:40px}
@media(max-width:768px){
#shopify-section-{{ section.id }} .sp-video{padding:80px 0}
#shopify-section-{{ section.id }} .sp-video__card{width:240px}
#shopify-section-{{ section.id }} .sp-video__track{padding:0 20px 20px;gap:16px}
#shopify-section-{{ section.id }} .sp-video__header{padding:0 20px;margin-bottom:40px}
}
</style>

<section class="sp-video">
  <div class="sp-video__header">
    {%- if s.eyebrow != blank -%}
    <div class="sp-video__eyebrow">{{ s.eyebrow }}</div>
    {%- endif -%}
    {%- if s.title != blank -%}
    <h2 class="sp-video__title">{{ s.title }}</h2>
    {%- endif -%}
  </div>
  <div class="sp-video__track" id="spVideoTrack-{{ section.id }}">
    {%- for block in section.blocks -%}
      {%- if block.type == 'video_card' -%}
      <div class="sp-video__card" {{ block.shopify_attributes }}>
        <div class="sp-video__frame" data-video-card="{{ block.id }}">
          {%- if block.settings.video_url != blank -%}
            <video src="{{ block.settings.video_url }}" poster="{% if block.settings.poster_image != blank %}{{ block.settings.poster_image | image_url: width: 600 }}{% else %}{{ 'site-product-rs02pro.jpeg' | asset_url }}{% endif %}" preload="none" playsinline muted></video>
          {%- elsif block.settings.poster_image != blank -%}
            <img src="{{ block.settings.poster_image | image_url: width: 600 }}" alt="{{ block.settings.title | escape }}" loading="lazy" width="600" height="1067">
          {%- else -%}
            <img src="{{ 'editorial-1.webp' | asset_url }}" alt="{{ block.settings.title | escape }}" loading="lazy" width="600" height="1067">
          {%- endif -%}
          <div class="sp-video__overlay">
            <div class="sp-video__play"><svg viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg></div>
          </div>
        </div>
        <div class="sp-video__caption">
          <div class="sp-video__card-title">{{ block.settings.title }}</div>
          {%- if block.settings.duration != blank -%}
          <div class="sp-video__duration">{{ block.settings.duration }}</div>
          {%- endif -%}
        </div>
      </div>
      {%- endif -%}
    {%- endfor -%}
  </div>
  {%- if s.show_hint -%}
  <div class="sp-video__hint">Swipe to explore &rarr;</div>
  {%- endif -%}
</section>

<script>
(function(){
  var track = document.getElementById('spVideoTrack-{{ section.id }}');
  if(!track) return;
  var isDown=false,startX,scrollLeft;
  track.addEventListener('mousedown',function(e){isDown=true;startX=e.pageX-track.offsetLeft;scrollLeft=track.scrollLeft});
  track.addEventListener('mouseleave',function(){isDown=false});
  track.addEventListener('mouseup',function(){isDown=false});
  track.addEventListener('mousemove',function(e){if(!isDown)return;e.preventDefault();var x=e.pageX-track.offsetLeft;track.scrollLeft=scrollLeft-(x-startX)});
  var frames=track.querySelectorAll('[data-video-card]');
  frames.forEach(function(f){f.addEventListener('click',function(){var v=f.querySelector('video');var ov=f.querySelector('.sp-video__overlay');if(v){v.play();if(ov)ov.style.display='none'}})});
})();
</script>

{% schema %}
{
  "name": "SP Video Carousel",
  "tag": "section",
  "class": "sp-video-section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "See It Move" },
    { "type": "text", "id": "title", "label": "Title", "default": "Precision in motion." },
    { "type": "checkbox", "id": "show_hint", "label": "Show swipe hint", "default": true }
  ],
  "blocks": [
    {
      "type": "video_card",
      "name": "Video Card",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Full Showcase" },
        { "type": "text", "id": "duration", "label": "Duration", "default": "0:21" },
        { "type": "image_picker", "id": "poster_image", "label": "Poster image" },
        { "type": "url", "id": "video_url", "label": "Video URL (mp4)" }
      ]
    }
  ],
  "presets": [{ "name": "SP Video Carousel", "blocks": [{ "type": "video_card" }, { "type": "video_card" }, { "type": "video_card" }] }]
}
{% endschema %}
