{%- liquid
  assign s = section.settings
  assign has_video = false
  for block in section.blocks
    if block.settings.video != blank or block.settings.video_url != blank
      assign has_video = true
    endif
  endfor
-%}
{%- if has_video -%}
<style>
#shopify-section-{{ section.id }} .sp-video{font-family:'Inter',sans-serif;background:#1A1816;color:#F7F4F0;padding:120px 0;overflow:hidden}
#shopify-section-{{ section.id }} .sp-video__header{max-width:800px;margin:0 auto 60px;padding:0 40px;text-align:center}
#shopify-section-{{ section.id }} .sp-video__eyebrow{font-size:11px;font-weight:500;letter-spacing:0.35em;text-transform:uppercase;color:#B5ADA4;margin-bottom:24px}
#shopify-section-{{ section.id }} .sp-video__title{font-size:clamp(28px,4vw,44px);font-weight:200;letter-spacing:0.04em;max-width:640px;margin:0 auto;line-height:1.2;color:#F7F4F0!important}
#shopify-section-{{ section.id }} .sp-video__grid{display:flex;flex-wrap:wrap;justify-content:center;align-items:flex-start;gap:28px;max-width:1280px;margin:0 auto;padding:0 40px}
#shopify-section-{{ section.id }} .sp-video__card{flex:1 1 360px;max-width:520px;min-width:0}
#shopify-section-{{ section.id }} .sp-video__frame{aspect-ratio:16/9;background:#2A2826;border-radius:4px;overflow:hidden;position:relative;cursor:pointer}
#shopify-section-{{ section.id }} .sp-video__frame video{width:100%;height:100%;object-fit:cover;display:block}
#shopify-section-{{ section.id }} .sp-video__overlay{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;background:rgba(0,0,0,0.3);transition:background 0.4s cubic-bezier(0.25,0.1,0.25,1);border:none;padding:0;width:100%;cursor:pointer}
#shopify-section-{{ section.id }} .sp-video__overlay:hover{background:rgba(0,0,0,0.15)}
#shopify-section-{{ section.id }} .sp-video__overlay.is-hidden{display:none}
#shopify-section-{{ section.id }} .sp-video__play{width:56px;height:56px;border:2px solid rgba(255,255,255,0.8);border-radius:50%;display:flex;align-items:center;justify-content:center;transition:transform 0.3s cubic-bezier(0.25,0.1,0.25,1);background:rgba(0,0,0,0.2)}
#shopify-section-{{ section.id }} .sp-video__play svg{width:20px;height:20px;fill:#fff;margin-left:3px}
#shopify-section-{{ section.id }} .sp-video__card:hover .sp-video__play{transform:scale(1.1)}
#shopify-section-{{ section.id }} .sp-video__overlay:focus-visible{outline:2px solid #B5ADA4;outline-offset:2px}
#shopify-section-{{ section.id }} .sp-video__caption{padding:20px 4px 0;text-align:center}
#shopify-section-{{ section.id }} .sp-video__card-title{font-size:12px;font-weight:500;letter-spacing:0.15em;text-transform:uppercase;color:#F7F4F0}
#shopify-section-{{ section.id }} .sp-video__meta{font-family:'JetBrains Mono',monospace;font-size:11px;color:#8A8279;margin-top:6px}
@media(max-width:768px){
#shopify-section-{{ section.id }} .sp-video{padding:80px 0}
#shopify-section-{{ section.id }} .sp-video__header{padding:0 20px;margin-bottom:40px}
#shopify-section-{{ section.id }} .sp-video__grid{padding:0 20px;gap:32px}
#shopify-section-{{ section.id }} .sp-video__card{flex:1 1 100%;max-width:560px}
}
</style>

<section class="sp-video">
  <div class="sp-video__header">
    {%- if s.eyebrow != blank -%}
    <div class="sp-video__eyebrow">{{ s.eyebrow }}</div>
    {%- endif -%}
    {%- if s.title != blank -%}
    <h2 class="sp-video__title">{{ s.title }}</h2>
    {%- endif -%}
  </div>
  <div class="sp-video__grid" id="spVideoGrid-{{ section.id }}">
    {%- for block in section.blocks -%}
      {%- liquid
        assign v = block.settings.video
        assign vurl = block.settings.video_url
        assign poster = block.settings.poster_image
      -%}
      {%- if v != blank or vurl != blank -%}
      <div class="sp-video__card" {{ block.shopify_attributes }}>
        <div class="sp-video__frame" data-video-card="{{ block.id }}">
          {%- if v != blank -%}
            {{ v | video_tag: image_size: '960x', class: 'sp-video__el', playsinline: true, preload: 'metadata' }}
          {%- elsif vurl != blank -%}
            {%- if poster != blank -%}
              {%- assign poster_url = poster | image_url: width: 960 -%}
              <video src="{{ vurl }}" poster="{{ poster_url }}" preload="metadata" playsinline class="sp-video__el"></video>
            {%- else -%}
              <video src="{{ vurl }}" preload="metadata" playsinline class="sp-video__el"></video>
            {%- endif -%}
          {%- endif -%}
          <button type="button" class="sp-video__overlay" data-video-overlay aria-label="Play video: {{ block.settings.title | escape }}">
            <span class="sp-video__play"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5v14l11-7z"/></svg></span>
          </button>
        </div>
        <div class="sp-video__caption">
          {%- if block.settings.title != blank -%}
          <div class="sp-video__card-title">{{ block.settings.title }}</div>
          {%- endif -%}
          {%- if block.settings.meta != blank -%}
          <div class="sp-video__meta">{{ block.settings.meta }}</div>
          {%- endif -%}
        </div>
      </div>
      {%- endif -%}
    {%- endfor -%}
  </div>
</section>

<script>
(function(){
  var grid = document.getElementById('spVideoGrid-{{ section.id }}');
  if(!grid) return;
  var cards = grid.querySelectorAll('[data-video-card]');
  cards.forEach(function(frame){
    var overlay = frame.querySelector('[data-video-overlay]');
    var video = frame.querySelector('video');
    if(!video || !overlay) return;
    overlay.addEventListener('click', function(){
      video.setAttribute('controls','controls');
      overlay.classList.add('is-hidden');
      var p = video.play();
      if(p && p.catch) p.catch(function(){});
    });
    video.addEventListener('ended', function(){
      overlay.classList.remove('is-hidden');
      video.removeAttribute('controls');
    });
    video.addEventListener('pause', function(){
      if(video.currentTime > 0 && !video.ended) return;
    });
  });
})();
</script>
{%- endif -%}

{% schema %}
{
  "name": "SP Workout Samples",
  "tag": "section",
  "class": "sp-video-section",
  "max_blocks": 4,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Senzine On Demand" },
    { "type": "text", "id": "title", "label": "Title", "default": "Sample our expert-led workouts." }
  ],
  "blocks": [
    {
      "type": "video_card",
      "name": "Workout Video",
      "settings": [
        { "type": "video", "id": "video", "label": "Video (upload, preferred)" },
        { "type": "url", "id": "video_url", "label": "External video URL (mp4 fallback)" },
        { "type": "image_picker", "id": "poster_image", "label": "Poster image (external URL mode only)" },
        { "type": "text", "id": "title", "label": "Title", "default": "Full-Body Reformer Flow" },
        { "type": "text", "id": "meta", "label": "Meta (duration / level)", "default": "20 min · All levels" }
      ]
    }
  ],
  "presets": [{ "name": "SP Workout Samples", "blocks": [{ "type": "video_card" }] }]
}
{% endschema %}
