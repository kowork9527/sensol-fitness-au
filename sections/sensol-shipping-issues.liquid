<section class="sc-ship-issues-{{ section.id }}">
  <div class="sc-ship-issues-{{ section.id }}__inner">
    <div class="sc-ship-issues-{{ section.id }}__header">
      <span class="sc-ship-issues-{{ section.id }}__num">05</span>
      <div class="sc-ship-issues-{{ section.id }}__line"></div>
    </div>
    <h2 class="sc-ship-issues-{{ section.id }}__title">Delivery<br>Issues</h2>
    <div class="sc-ship-issues-{{ section.id }}__cards">
      <div class="sc-ship-issues-{{ section.id }}__card">
        <span class="sc-ship-issues-{{ section.id }}__card-tag">A</span>
        <h3 class="sc-ship-issues-{{ section.id }}__card-title">Missed Delivery</h3>
        <ol class="sc-ship-issues-{{ section.id }}__steps">
          <li>Attempt redelivery within the next 1–2 business days</li>
          <li>If redelivery fails, hold the item at a local depot for collection</li>
        </ol>
        <p class="sc-ship-issues-{{ section.id }}__note">Contact the courier directly using your tracking number to arrange redelivery or depot collection.</p>
      </div>
      <div class="sc-ship-issues-{{ section.id }}__card">
        <span class="sc-ship-issues-{{ section.id }}__card-tag">B</span>
        <h3 class="sc-ship-issues-{{ section.id }}__card-title">Damaged Delivery</h3>
        <ol class="sc-ship-issues-{{ section.id }}__steps">
          <li>Take photographs of the damage immediately</li>
          <li>Contact us within 48 hours of receiving the delivery</li>
          <li>Keep all original packaging materials</li>
          <li>Do not attempt to use the damaged product</li>
        </ol>
        <p class="sc-ship-issues-{{ section.id }}__note">We will arrange a replacement or repair based on the nature of the damage.</p>
      </div>
      <div class="sc-ship-issues-{{ section.id }}__card">
        <span class="sc-ship-issues-{{ section.id }}__card-tag">C</span>
        <h3 class="sc-ship-issues-{{ section.id }}__card-title">Lost Delivery</h3>
        <ol class="sc-ship-issues-{{ section.id }}__steps">
          <li>Check with neighbours or building management</li>
          <li>Contact the courier directly to investigate</li>
          <li>If unresolved after 5 business days, contact us and we will file a carrier investigation</li>
        </ol>
        <p class="sc-ship-issues-{{ section.id }}__note">For heavy-goods courier services, compensation for lost shipments is limited. We will work with you and the carrier to resolve any delivery issues as quickly as possible.</p>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Shipping Issues",
  "tag": "section",
  "class": "sensol-shipping-issues-section",
  "settings": [],
  "presets": [{ "name": "Shipping Issues" }]
}
{% endschema %}

{%- style -%}
  .sc-ship-issues-{{ section.id }} {
    background: #F7F4F0;
    font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
    color: #1A1816;
  }
  .sc-ship-issues-{{ section.id }}__inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 6rem 3rem 0;
  }
  .sc-ship-issues-{{ section.id }}__header {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    margin-bottom: 2rem;
  }
  .sc-ship-issues-{{ section.id }}__num {
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.25em;
    color: #B5ADA4;
  }
  .sc-ship-issues-{{ section.id }}__line {
    flex: 1;
    height: 1px;
    background: #D4CEC6;
  }
  .sc-ship-issues-{{ section.id }}__title {
    font-size: clamp(28px, 4vw, 44px);
    font-weight: 200;
    letter-spacing: 0.06em;
    line-height: 1.2;
    margin-bottom: 4rem;
  }
  .sc-ship-issues-{{ section.id }}__cards {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0;
    border-top: 1px solid #D4CEC6;
  }
  .sc-ship-issues-{{ section.id }}__card {
    padding: 2.5rem 2rem 3rem;
    border-right: 1px solid #D4CEC6;
  }
  .sc-ship-issues-{{ section.id }}__card:last-child { border-right: none; }
  .sc-ship-issues-{{ section.id }}__card-tag {
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.2em;
    color: #B5ADA4;
    display: block;
    margin-bottom: 1.25rem;
  }
  .sc-ship-issues-{{ section.id }}__card-title {
    font-size: 17px;
    font-weight: 400;
    letter-spacing: 0.02em;
    color: #1A1816;
    margin-bottom: 1.5rem;
  }
  .sc-ship-issues-{{ section.id }}__steps {
    list-style: none;
    counter-reset: step;
    padding: 0;
    margin: 0 0 1.5rem;
  }
  .sc-ship-issues-{{ section.id }}__steps li {
    counter-increment: step;
    font-size: 13px;
    font-weight: 300;
    line-height: 1.7;
    color: #8A8279;
    padding: 0.6rem 0 0.6rem 2rem;
    position: relative;
    border-bottom: 1px solid #D4CEC6;
  }
  .sc-ship-issues-{{ section.id }}__steps li:last-child { border-bottom: none; }
  .sc-ship-issues-{{ section.id }}__steps li::before {
    content: counter(step, decimal-leading-zero);
    position: absolute;
    left: 0;
    top: 0.6rem;
    font-size: 11px;
    font-weight: 500;
    color: #B5ADA4;
  }
  .sc-ship-issues-{{ section.id }}__note {
    font-size: 12px;
    font-weight: 300;
    line-height: 1.6;
    color: #8A8279;
  }
  @media (max-width: 768px) {
    .sc-ship-issues-{{ section.id }}__inner { padding: 4rem 1.5rem 0; }
    .sc-ship-issues-{{ section.id }}__cards { grid-template-columns: 1fr; }
    .sc-ship-issues-{{ section.id }}__card {
      border-right: none;
      border-bottom: 1px solid #D4CEC6;
      padding: 2rem 0;
    }
    .sc-ship-issues-{{ section.id }}__card:last-child { border-bottom: none; }
  }
{%- endstyle -%}
