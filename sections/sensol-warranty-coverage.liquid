{% schema %}{"name":"SENSOL Warranty Coverage","tag":"section","class":"sensol-warranty-coverage-section","settings":[],"presets":[{"name":"SENSOL Warranty Coverage"}]}{% endschema %}
{%- style -%}
.sensol-warranty-coverage-section{margin:0;padding:0;background:#F7F4F0}.sensol-warranty-coverage{max-width:900px;margin:0 auto;padding:80px 2rem 0;font-family:'Inter',sans-serif}.sensol-warranty-coverage__grid{display:grid;grid-template-columns:repeat(4,1fr);gap:1px;background:#D4CEC6}.sensol-warranty-coverage__card{background:#F7F4F0;padding:2.5rem 1.5rem;text-align:center}.sensol-warranty-coverage__icon{font-size:1.75rem;margin-bottom:.75rem;opacity:.6;display:block}.sensol-warranty-coverage__value{font-size:2.5rem;font-weight:200;letter-spacing:-.03em;line-height:1;margin-bottom:.5rem;color:#1A1816;display:block}.sensol-warranty-coverage__label{font-size:.6875rem;font-weight:500;letter-spacing:.12em;text-transform:uppercase;color:#8A8279;display:block}.sensol-warranty-coverage__note{font-size:.75rem;color:#8A8279;margin-top:.5rem;font-weight:300;display:block}@media(max-width:768px){.sensol-warranty-coverage__grid{grid-template-columns:repeat(2,1fr)}}@media(max-width:480px){.sensol-warranty-coverage__grid{grid-template-columns:1fr}}@media(max-width:749px){.sensol-warranty-coverage{padding:48px 1.5rem 0}.sensol-warranty-coverage__card{padding:2rem 1rem}.sensol-warranty-coverage__value{font-size:2rem}}
{%- endstyle -%}
