      <div class="sensol-warranty-coverage__card"><div class="sensol-warranty-coverage__icon">&#9881;</div><div class="sensol-warranty-coverage__value">3</div><div class="sensol-warranty-coverage__label">Years &mdash; Electronics</div><div class="sensol-warranty-coverage__note">Motor &amp; control systems</div></div>
      <div class="sensol-warranty-coverage__card"><div class="sensol-warranty-coverage__icon">&#9881;</div><div class="sensol-warranty-coverage__value">2</div><div class="sensol-warranty-coverage__label">Years &mdash; Components</div><div class="sensol-warranty-coverage__note">Resistance &amp; mechanical</div></div>
      <div class="sensol-warranty-coverage__card"><div class="sensol-warranty-coverage__icon">&#9881;</div><div class="sensol-warranty-coverage__value">1</div><div class="sensol-warranty-coverage__label">Year &mdash; Wear Parts</div><div class="sensol-warranty-coverage__note">Cables, straps, upholstery</div></div>
    </div>
  </div>
</section>
{% schema %}{"name":"SENSOL Warranty Coverage","tag":"section","class":"sensol-warranty-coverage-section","settings":[],"presets":[{"name":"SENSOL Warranty Coverage"}]}{% endschema %}
{%- style -%}
.sensol-warranty-coverage-section{margin:0;padding:0;background:#F7F4F0}
.sensol-warranty-coverage-section .sensol-warranty-coverage{max-width:900px;margin:0 auto;padding:100px 2rem 0;font-family:'Inter',sans-serif}
.sensol-warranty-coverage-section .sensol-warranty-coverage__grid{display:grid;grid-template-columns:repeat(4,1fr);gap:1px;background:#D4CEC6}
.sensol-warranty-coverage-section .sensol-warranty-coverage__card{background:#F7F4F0;padding:3.5rem 2rem;text-align:center}
.sensol-warranty-coverage-section .sensol-warranty-coverage__icon{font-size:1.5rem;margin-bottom:1rem;opacity:0.5;display:block}
.sensol-warranty-coverage-section .sensol-warranty-coverage__value{font-size:clamp(2.5rem,4vw,3.5rem);font-weight:500;letter-spacing:-0.03em;line-height:1;margin-bottom:0.75rem;color:#1A1816;display:block}
.sensol-warranty-coverage-section .sensol-warranty-coverage__label{font-size:1.125rem;font-weight:500;letter-spacing:0.1em;text-transform:uppercase;color:#8A8279;display:block;line-height:1.4}
.sensol-warranty-coverage-section .sensol-warranty-coverage__note{font-size:1rem;color:#8A8279;margin-top:0.75rem;font-weight:500;display:block}
@media(max-width:768px){.sensol-warranty-coverage-section .sensol-warranty-coverage-section .sensol-warranty-coverage__grid{grid-template-columns:repeat(2,1fr)}.sensol-warranty-coverage-section .sensol-warranty-coverage__card{padding:2.5rem 1.5rem}}
@media(max-width:480px){.sensol-warranty-coverage-section .sensol-warranty-coverage-section .sensol-warranty-coverage__grid{grid-template-columns:1fr}.sensol-warranty-coverage-section .sensol-warranty-coverage__card{padding:2.25rem 1.5rem}.sensol-warranty-coverage-section .sensol-warranty-coverage__value{font-size:2.75rem}}
@media(max-width:749px){.sensol-warranty-coverage-section .sensol-warranty-coverage-section .sensol-warranty-coverage{padding:64px 1.5rem 0}}
{%- endstyle -%}
