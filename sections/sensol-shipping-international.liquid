<section class="sensol-shipping-intl-section">
  <div class="sensol-shipping-intl">
    <div class="sensol-shipping-intl__col">
      <h3 class="sensol-shipping-intl__title">New Zealand Shipping</h3>
      <p class="sensol-shipping-intl__text">We are currently <strong>not shipping to New Zealand</strong>. New Zealand delivery will be available in the future as we expand our international operations.</p>
      <p class="sensol-shipping-intl__text" style="margin-top:1rem">When available:</p>
      <ul class="sensol-shipping-intl__list">
        <li>International courier with full tracking</li>
        <li>Estimated delivery: 5&ndash;10 business days</li>
        <li>Duty threshold: NZD 1,000 &mdash; orders below this are free of import duty</li>
        <li>Shipping fees displayed at checkout before purchase</li>
      </ul>
    </div>
    <div class="sensol-shipping-intl__col">
      <h3 class="sensol-shipping-intl__title">International Shipping</h3>
      <p class="sensol-shipping-intl__text">We do not currently ship to countries other than Australia. International shipping options may be added in the future. Please <a class="sensol-shipping-intl__link" href="/pages/contact">contact us</a> if you are outside Australia and interested in our products.</p>
      <h3 class="sensol-shipping-intl__title" style="margin-top:2rem">Order Tracking</h3>
      <p class="sensol-shipping-intl__text">Once dispatched, you will receive an email with your tracking number, a link to track your shipment online, and the estimated delivery date. If you have not received tracking information within 3 business days, please <a class="sensol-shipping-intl__link" href="/pages/contact">contact us</a>.</p>
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Shipping International",
  "tag": "section",
  "class": "sensol-shipping-international",
  "settings": [],
  "presets": [
    {
      "name": "SENSOL Shipping International"
    }
  ]
}
{% endschema %}
{%- style -%}
.sensol-shipping-intl-section{background:#1A1816;padding:100px 0;margin:80px 0 0}
.sensol-shipping-intl-section .sensol-shipping-intl{max-width:1040px;margin:0 auto;padding:0 2rem;display:grid;grid-template-columns:1fr 1fr;gap:80px}
.sensol-shipping-intl-section .sensol-shipping-intl__title{font-size:1.5rem;font-weight:300;letter-spacing:-0.01em;color:#F7F4F0;margin-bottom:1.5rem}
.sensol-shipping-intl-section .sensol-shipping-intl__text{font-size:1.125rem;color:#8A8279;line-height:1.8;margin-bottom:0.75rem}
.sensol-shipping-intl-section .sensol-shipping-intl__list{list-style:none;margin-top:0.5rem}
.sensol-shipping-intl-section .sensol-shipping-intl__list li{padding:0 0 0 1.25rem;position:relative;margin-bottom:0.5rem;font-size:1.125rem;color:#8A8279;line-height:1.8}
.sensol-shipping-intl-section .sensol-shipping-intl__list li::before{content:'\2014';position:absolute;left:0;color:#B5ADA4}
.sensol-shipping-intl-section .sensol-shipping-intl__link{color:#F7F4F0;text-decoration:underline;text-underline-offset:3px;text-decoration-color:#B5ADA4}
@media(max-width:900px){.sensol-shipping-intl-section .sensol-shipping-intl-section .sensol-shipping-intl{grid-template-columns:1fr;gap:48px}}
@media(max-width:749px){.sensol-shipping-intl-section .sensol-shipping-intl-section{padding:64px 0;margin:56px 0 0}}
{%- endstyle -%}
