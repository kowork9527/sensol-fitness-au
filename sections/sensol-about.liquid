{%- style -%}
  /* ───── About Page ───── */
  .sensol-about {
    font-family: 'Inter', sans-serif;
    color: #1A1816;
  }

  /* ── Opening ── */
  .sensol-about__opening {
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 8rem 0;
  }

  .sensol-about__opening-inner {
    max-width: 900px;
    text-align: center;
    padding: 0 2.5rem;
  }

  .sensol-about__opening-label {
    font-size: 10px;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    font-weight: 300;
    color: #8A8279;
    margin-bottom: 2rem;
  }

  .sensol-about__opening-title {
    font-size: clamp(36px, 6vw, 80px);
    font-weight: 200;
    letter-spacing: 0.08em;
    line-height: 1.1;
    text-transform: uppercase;
  }

  .sensol-about__opening-rule {
    width: 60px;
    height: 1px;
    background: #8A8279;
    margin: 2.5rem auto;
  }

  .sensol-about__opening-subtitle {
    font-size: clamp(15px, 1.2vw, 18px);
    font-weight: 300;
    letter-spacing: 0.06em;
    color: #8A8279;
    max-width: 560px;
    margin: 0 auto;
    line-height: 1.7;
  }

  /* ── Section shared ── */
  .sensol-about__section {
    padding: 6rem 0;
  }

  .sensol-about__container {
    max-width: 1600px;
    margin: 0 auto;
    padding: 0 48px;
  }

  .sensol-about__container--narrow {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 48px;
  }

  .sensol-about__container--text {
    max-width: 800px;
    margin: 0 auto;
    padding: 0 48px;
  }

  .sensol-about__label {
    font-size: 10px;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    font-weight: 300;
    color: #8A8279;
    margin-bottom: 3rem;
  }

  .sensol-about__heading-lg {
    font-size: clamp(24px, 3.5vw, 40px);
    font-weight: 200;
    letter-spacing: 0.05em;
    line-height: 1.2;
  }

  .sensol-about__body {
    font-size: 15px;
    font-weight: 300;
    line-height: 1.8;
    color: #8A8279;
  }

  .sensol-about__body strong {
    font-weight: 400;
    color: #1A1816;
  }

  /* ── Story grid ── */
  .sensol-about__story-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
    align-items: start;
  }

  .sensol-about__story-grid .sensol-about__body + .sensol-about__body {
    margin-top: 1.5rem;
  }

  /* ── Timeline ── */
  .sensol-about__timeline-item {
    display: grid;
    grid-template-columns: 140px 1fr;
    gap: 2rem;
    padding: 2.5rem 0;
    border-top: 1px solid #E3DFD9;
  }

  .sensol-about__timeline-year {
    font-size: 32px;
    font-weight: 200;
    letter-spacing: 0.05em;
    color: #1A1816;
    padding-top: 0.2rem;
  }

  .sensol-about__timeline-heading {
    font-size: 13px;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    font-weight: 300;
    margin-bottom: 1rem;
  }

  .sensol-about__timeline-body {
    font-size: 14px;
    font-weight: 300;
    line-height: 1.8;
    color: #8A8279;
  }

  .sensol-about__timeline-body + .sensol-about__timeline-body {
    margin-top: 1rem;
  }

  .sensol-about__stat-row {
    display: flex;
    gap: 2rem;
    margin-top: 1rem;
  }

  .sensol-about__stat-value {
    font-size: 24px;
    font-weight: 200;
    letter-spacing: 0.02em;
  }

  .sensol-about__stat-label {
    font-size: 10px;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    font-weight: 300;
    color: #8A8279;
  }

  /* ── Product line ── */
  .sensol-about__product-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
    border-top: 1px solid #E3DFD9;
    padding-top: 2rem;
    margin-top: 3rem;
  }

  .sensol-about__product-card {
    border-top: 1px solid #E3DFD9;
    padding-top: 1.5rem;
  }

  .sensol-about__product-series-label {
    font-size: 10px;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    font-weight: 300;
    color: #8A8279;
    margin-bottom: 1rem;
  }

  .sensol-about__product-name {
    font-size: 20px;
    font-weight: 200;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    margin-bottom: 1rem;
  }

  .sensol-about__product-desc {
    font-size: 13px;
    font-weight: 300;
    line-height: 1.8;
    color: #8A8279;
  }

  /* ── Australia section ── */
  .sensol-about__au {
    background: #1A1816;
    color: #F7F4F0;
  }

  .sensol-about__au-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
    align-items: start;
  }

  .sensol-about__au-body {
    font-size: 14px;
    font-weight: 300;
    line-height: 1.8;
    color: rgba(247,244,240,0.55);
  }

  .sensol-about__au-body + .sensol-about__au-body {
    margin-top: 1rem;
  }

  .sensol-about__city-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
    margin-top: 2rem;
  }

  .sensol-about__city {
    text-align: center;
    padding: 1.5rem 0;
    border: 1px solid rgba(247,244,240,0.12);
  }

  .sensol-about__city-name {
    font-size: 12px;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    font-weight: 300;
  }

  .sensol-about__au-info {
    margin-top: 3rem;
    padding-top: 2rem;
    border-top: 1px solid rgba(247,244,240,0.12);
  }

  .sensol-about__au-info-label {
    font-size: 10px;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    font-weight: 300;
    color: rgba(247,244,240,0.4);
    margin-bottom: 0.75rem;
  }

  .sensol-about__au-info-value {
    font-size: 14px;
    font-weight: 300;
    color: rgba(247,244,240,0.7);
    line-height: 1.6;
  }

  /* ── Commitment ── */
  .sensol-about__quote {
    font-size: clamp(24px, 3vw, 40px);
    font-weight: 200;
    letter-spacing: 0.08em;
    line-height: 1.3;
    text-transform: uppercase;
    margin-bottom: 3rem;
  }

  .sensol-about__commitment-body {
    font-size: 15px;
    font-weight: 300;
    line-height: 1.8;
    color: #8A8279;
    max-width: 640px;
    text-align: left;
    margin: 0 auto;
  }

  .sensol-about__commitment-body + .sensol-about__commitment-body {
    margin-top: 1.5rem;
  }

  /* ── Company info ── */
  .sensol-about__company-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
    border-top: 1px solid #E3DFD9;
    padding-top: 3rem;
    margin-top: 4rem;
  }

  .sensol-about__company-label {
    font-size: 10px;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    font-weight: 300;
    color: #8A8279;
    margin-bottom: 0.75rem;
  }

  .sensol-about__company-value {
    font-size: 13px;
    font-weight: 300;
    line-height: 1.6;
  }

  .sensol-about__company-value a {
    color: #1A1816;
    text-decoration: none;
    border-bottom: 1px solid #D4CEC6;
  }

  /* ── Image ── */
  .sensol-about__img-wrap {
    aspect-ratio: 3/4;
    overflow: hidden;
    background: #EDEAE5;
  }

  .sensol-about__img-wrap--landscape {
    aspect-ratio: 4/5;
  }

  .sensol-about__img-wrap img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* ── Responsive ── */
  @media screen and (max-width: 767px) {
    .sensol-about__section { padding: 4rem 0; }
    .sensol-about__container,
    .sensol-about__container--narrow,
    .sensol-about__container--text { padding: 0 24px; }
    .sensol-about__opening { min-height: 80vh; padding: 6rem 0; }
    .sensol-about__story-grid { grid-template-columns: 1fr; gap: 2rem; }
    .sensol-about__timeline-item { grid-template-columns: 80px 1fr; gap: 1rem; }
    .sensol-about__timeline-year { font-size: 24px; }
    .sensol-about__product-grid { grid-template-columns: 1fr; }
    .sensol-about__au-grid { grid-template-columns: 1fr; gap: 2rem; }
    .sensol-about__company-grid { grid-template-columns: 1fr; gap: 1.5rem; }
  }

  @media screen and (min-width: 768px) and (max-width: 1024px) {
    .sensol-about__container { padding: 0 32px; }
    .sensol-about__story-grid { gap: 3rem; }
  }
{%- endstyle -%}

<div class="sensol-about">

  {%- comment -%} ── OPENING ── {%- endcomment -%}
  <section class="sensol-about__opening">
    <div class="sensol-about__opening-inner">
      <p class="sensol-about__opening-label">{{ section.settings.opening_label }}</p>
      <h1 class="sensol-about__opening-title">{{ section.settings.opening_title }}</h1>
      <div class="sensol-about__opening-rule"></div>
      <p class="sensol-about__opening-subtitle">{{ section.settings.opening_subtitle }}</p>
    </div>
  </section>

  {%- comment -%} ── THE BEGINNING ── {%- endcomment -%}
  <section class="sensol-about__section">
    <div class="sensol-about__container">
      <p class="sensol-about__label">{{ section.settings.origin_label }}</p>
      <div class="sensol-about__story-grid">
        <div>
          <h2 class="sensol-about__heading-lg" style="margin-bottom:2rem;">{{ section.settings.origin_title }}</h2>
          <p class="sensol-about__body">{{ section.settings.origin_para1 }}</p>
          <p class="sensol-about__body">{{ section.settings.origin_para2 }}</p>
          <p class="sensol-about__body">{{ section.settings.origin_para3 }}</p>
          <p class="sensol-about__body">{{ section.settings.origin_para4 }}</p>
        </div>
        <div>
          <div class="sensol-about__img-wrap">
            {%- if section.settings.origin_image != blank -%}
              <img src="{{ section.settings.origin_image | image_url: width: 800 }}" alt="Sensol Digital Weight System" loading="lazy" width="800" height="1067">
            {%- else -%}
              <div style="width:100%;height:100%;background:#EDEAE5;display:flex;align-items:center;justify-content:center;">
                <span style="font-size:11px;letter-spacing:0.15em;text-transform:uppercase;color:#8A8279;">Origin Image</span>
              </div>
            {%- endif -%}
          </div>
        </div>
      </div>
    </div>
  </section>

  {%- comment -%} ── THE JOURNEY (TIMELINE) ── {%- endcomment -%}
  <section class="sensol-about__section" style="background:#EDEAE5;">
    <div class="sensol-about__container--narrow">
      <p class="sensol-about__label">{{ section.settings.journey_label }}</p>

      <div class="sensol-about__timeline-item">
        <span class="sensol-about__timeline-year">{{ section.settings.timeline_2023_year }}</span>
        <div>
          <h3 class="sensol-about__timeline-heading">{{ section.settings.timeline_2023_heading }}</h3>
          <p class="sensol-about__timeline-body">{{ section.settings.timeline_2023_body1 }}</p>
          <p class="sensol-about__timeline-body">{{ section.settings.timeline_2023_body2 }}</p>
          <div class="sensol-about__stat-row">
            <div>
              <span class="sensol-about__stat-value">{{ section.settings.timeline_2023_stat1_val }}</span>
              <span class="sensol-about__stat-label">{{ section.settings.timeline_2023_stat1_label }}</span>
            </div>
            <div>
              <span class="sensol-about__stat-value">{{ section.settings.timeline_2023_stat2_val }}</span>
              <span class="sensol-about__stat-label">{{ section.settings.timeline_2023_stat2_label }}</span>
            </div>
          </div>
        </div>
      </div>

      <div class="sensol-about__timeline-item">
        <span class="sensol-about__timeline-year">{{ section.settings.timeline_2024_year }}</span>
        <div>
          <h3 class="sensol-about__timeline-heading">{{ section.settings.timeline_2024_heading }}</h3>
          <p class="sensol-about__timeline-body">{{ section.settings.timeline_2024_body1 }}</p>
          <p class="sensol-about__timeline-body">{{ section.settings.timeline_2024_body2 }}</p>
        </div>
      </div>

      <div class="sensol-about__timeline-item">
        <span class="sensol-about__timeline-year">{{ section.settings.timeline_2025_year }}</span>
        <div>
          <h3 class="sensol-about__timeline-heading">{{ section.settings.timeline_2025_heading }}</h3>
          <p class="sensol-about__timeline-body">{{ section.settings.timeline_2025_body1 }}</p>
          <p class="sensol-about__timeline-body">{{ section.settings.timeline_2025_body2 }}</p>
        </div>
      </div>

      <div class="sensol-about__timeline-item">
        <span class="sensol-about__timeline-year">{{ section.settings.timeline_2026_year }}</span>
        <div>
          <h3 class="sensol-about__timeline-heading">{{ section.settings.timeline_2026_heading }}</h3>
          <p class="sensol-about__timeline-body">{{ section.settings.timeline_2026_body1 }}</p>
          <p class="sensol-about__timeline-body">{{ section.settings.timeline_2026_body2 }}</p>
        </div>
      </div>
    </div>
  </section>

  {%- comment -%} ── THE LINE (PRODUCTS) ── {%- endcomment -%}
  <section class="sensol-about__section">
    <div class="sensol-about__container--narrow">
      <p class="sensol-about__label">{{ section.settings.line_label }}</p>
      <h2 class="sensol-about__heading-lg" style="max-width:600px;">{{ section.settings.line_title }}</h2>
      <p class="sensol-about__body" style="margin-top:1.5rem;max-width:600px;">{{ section.settings.line_intro }}</p>

      <div class="sensol-about__product-grid">
        <div class="sensol-about__product-card">
          <p class="sensol-about__product-series-label">Smart Series</p>
          <h3 class="sensol-about__product-name">RS02</h3>
          <p class="sensol-about__product-desc">{{ section.settings.rs02_desc }}</p>
        </div>
        <div class="sensol-about__product-card">
          <p class="sensol-about__product-series-label">Smart Series</p>
          <h3 class="sensol-about__product-name">RS02 PRO</h3>
          <p class="sensol-about__product-desc">{{ section.settings.rs02_pro_desc }}</p>
        </div>
        <div class="sensol-about__product-card">
          <p class="sensol-about__product-series-label">Flex Series</p>
          <h3 class="sensol-about__product-name">FLEX AIR</h3>
          <p class="sensol-about__product-desc">{{ section.settings.flex_air_desc }}</p>
        </div>
      </div>

      <div style="margin-top:3rem;padding-top:2rem;border-top:1px solid #E3DFD9;">
        <p class="sensol-about__body" style="max-width:700px;">{{ section.settings.line_closing }}</p>
      </div>
    </div>
  </section>

  {%- comment -%} ── GROWING IN THE US ── {%- endcomment -%}
  <section class="sensol-about__section">
    <div class="sensol-about__container">
      <div class="sensol-about__story-grid">
        <div>
          <div class="sensol-about__img-wrap sensol-about__img-wrap--landscape">
            {%- if section.settings.us_image != blank -%}
              <img src="{{ section.settings.us_image | image_url: width: 1000 }}" alt="Sensol training in a modern living space" loading="lazy" width="1000" height="1250">
            {%- else -%}
              <div style="width:100%;height:100%;background:#EDEAE5;display:flex;align-items:center;justify-content:center;">
                <span style="font-size:11px;letter-spacing:0.15em;text-transform:uppercase;color:#8A8279;">US Market Image</span>
              </div>
            {%- endif -%}
          </div>
        </div>
        <div>
          <p class="sensol-about__label" style="margin-bottom:1rem;">{{ section.settings.us_label }}</p>
          <h2 class="sensol-about__heading-lg" style="margin-bottom:2rem;">{{ section.settings.us_title }}</h2>
          <p class="sensol-about__body">{{ section.settings.us_para1 }}</p>
          <p class="sensol-about__body">{{ section.settings.us_para2 }}</p>
          <p class="sensol-about__body">{{ section.settings.us_para3 }}</p>
        </div>
      </div>
    </div>
  </section>

  {%- comment -%} ── AUSTRALIA ── {%- endcomment -%}
  <section class="sensol-about__section sensol-about__au">
    <div class="sensol-about__container">
      <div class="sensol-about__au-grid">
        <div>
          <p class="sensol-about__label" style="color:rgba(247,244,240,0.4);margin-bottom:1rem;">{{ section.settings.au_label }}</p>
          <h2 class="sensol-about__heading-lg" style="color:#F7F4F0;margin-bottom:2rem;">{{ section.settings.au_title }}</h2>
          <p class="sensol-about__au-body">{{ section.settings.au_para1 }}</p>
          <p class="sensol-about__au-body">{{ section.settings.au_para2 }}</p>
        </div>
        <div>
          <p class="sensol-about__label" style="color:rgba(247,244,240,0.4);margin-bottom:1rem;">Local Warehousing</p>
          <div class="sensol-about__city-grid">
            <div class="sensol-about__city">
              <span class="sensol-about__city-name">Melbourne</span>
            </div>
            <div class="sensol-about__city">
              <span class="sensol-about__city-name">Brisbane</span>
            </div>
            <div class="sensol-about__city">
              <span class="sensol-about__city-name">Sydney</span>
            </div>
          </div>
          <div class="sensol-about__au-info">
            <p class="sensol-about__au-info-label">Distributor</p>
            <p class="sensol-about__au-info-value">{{ section.settings.au_distributor }}</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  {%- comment -%} ── COMMITMENT ── {%- endcomment -%}
  <section class="sensol-about__section">
    <div class="sensol-about__container--text" style="text-align:center;">
      <p class="sensol-about__label">{{ section.settings.commitment_label }}</p>
      <p class="sensol-about__quote">{{ section.settings.commitment_quote }}</p>
      <p class="sensol-about__commitment-body">{{ section.settings.commitment_para1 }}</p>
      <p class="sensol-about__commitment-body">{{ section.settings.commitment_para2 }}</p>
    </div>
  </section>

  {%- comment -%} ── COMPANY INFO ── {%- endcomment -%}
  <section class="sensol-about__section" style="padding-top:0;">
    <div class="sensol-about__container--narrow">
      <div class="sensol-about__company-grid">
        <div>
          <p class="sensol-about__company-label">Company</p>
          <p class="sensol-about__company-value">{{ section.settings.company_info }}</p>
        </div>
        <div>
          <p class="sensol-about__company-label">Contact</p>
          <p class="sensol-about__company-value"><a href="mailto:{{ section.settings.contact_email }}">{{ section.settings.contact_email }}</a></p>
        </div>
        <div>
          <p class="sensol-about__company-label">Follow</p>
          <p class="sensol-about__company-value">
            <a href="{{ section.settings.instagram_url }}" target="_blank" rel="noopener">Instagram</a><br>
            <a href="{{ section.settings.youtube_url }}" target="_blank" rel="noopener">YouTube</a>
          </p>
        </div>
      </div>
    </div>
  </section>

</div>

{% schema %}
{
  "name": "SENSOL About",
  "tag": "section",
  "class": "sensol-about-section",
  "settings": [
    { "type": "header", "content": "Opening" },
    { "type": "text", "id": "opening_label", "label": "Opening label", "default": "About Sensol" },
    { "type": "text", "id": "opening_title", "label": "Opening title", "default": "A New Language of Training" },
    { "type": "textarea", "id": "opening_subtitle", "label": "Opening subtitle", "default": "Where strength meets precision, and movement becomes design. Founded in 2022, we design intelligent training systems that merge performance, technology, and spatial aesthetics." },

    { "type": "header", "content": "The Beginning" },
    { "type": "text", "id": "origin_label", "label": "Section label", "default": "01 — The Beginning" },
    { "type": "text", "id": "origin_title", "label": "Origin title", "default": "The story starts with a question that had no good answer" },
    { "type": "textarea", "id": "origin_para1", "label": "Paragraph 1", "default": "Why does serious strength training demand an entire room, a wall of weights, and a tolerance for noise?" },
    { "type": "textarea", "id": "origin_para2", "label": "Paragraph 2", "default": "For over a decade, the engineering team behind SENSOL — based in Shanghai and operating under Thunderbird Tech Limited — worked quietly at the intersection of robotics, motor control, and fitness biomechanics." },
    { "type": "textarea", "id": "origin_para3", "label": "Paragraph 3", "default": "Their goal was deceptively simple: compress the function of an entire gym into a single piece of furniture. Not a multi-station cable machine. Not a foldable bench with plates. Something fundamentally new." },
    { "type": "textarea", "id": "origin_para4", "label": "Paragraph 4", "default": "That vision became the Digital Weight System — a motor-driven resistance engine controlled by software, replacing iron plates with precise, instant, silent load. It was a concept that had been attempted before, but never in a form this compact, this quiet, and this precise." },
    { "type": "image_picker", "id": "origin_image", "label": "Origin image" },

    { "type": "header", "content": "The Journey — 2023" },
    { "type": "text", "id": "journey_label", "label": "Section label", "default": "02 — The Journey" },
    { "type": "text", "id": "timeline_2023_year", "label": "Year", "default": "2023" },
    { "type": "text", "id": "timeline_2023_heading", "label": "Heading", "default": "Going Public" },
    { "type": "textarea", "id": "timeline_2023_body1", "label": "Body 1", "default": "After years of prototyping and iteration, SENSOL made its public debut. The first product, the TB02 Smart Fitness Bench, launched simultaneously on Kickstarter and Indiegogo. The response was immediate — backers from the United States, Europe, and Asia pledged support." },
    { "type": "textarea", "id": "timeline_2023_body2", "label": "Body 2", "default": "That same month, SENSOL was featured on Product Hunt, earning recognition as one of the most innovative new products in the smart home fitness space." },
    { "type": "text", "id": "timeline_2023_stat1_val", "label": "Stat 1 value", "default": "HK$550K" },
    { "type": "text", "id": "timeline_2023_stat1_label", "label": "Stat 1 label", "default": "Raised" },
    { "type": "text", "id": "timeline_2023_stat2_val", "label": "Stat 2 value", "default": "2" },
    { "type": "text", "id": "timeline_2023_stat2_label", "label": "Stat 2 label", "default": "Platforms" },

    { "type": "header", "content": "The Journey — 2024" },
    { "type": "text", "id": "timeline_2024_year", "label": "Year", "default": "2024" },
    { "type": "text", "id": "timeline_2024_heading", "label": "Heading", "default": "Shipping, Refining, Listening" },
    { "type": "textarea", "id": "timeline_2024_body1", "label": "Body 1", "default": "By January 2024, all crowdfunding units had been shipped. Deliveries reached backers across the western and eastern United States, Europe, and Asia. But shipping was only the beginning." },
    { "type": "textarea", "id": "timeline_2024_body2", "label": "Body 2", "default": "The real work started when people started training on SENSOL in their homes — and started telling us what worked, what confused them, and what they wished the system could do. That feedback drove rapid iteration. The SENSOL Smart App evolved through multiple updates, adding Bluetooth direct control, weight unit switching, custom workout creation, real-time performance analytics, and an expanding library of guided classes." },

    { "type": "header", "content": "The Journey — 2025" },
    { "type": "text", "id": "timeline_2025_year", "label": "Year", "default": "2025" },
    { "type": "text", "id": "timeline_2025_heading", "label": "Heading", "default": "Senzine: Where Movement Meets Thought" },
    { "type": "textarea", "id": "timeline_2025_body1", "label": "Body 1", "default": "Beyond the hardware, SENSOL has always been about a philosophy of training. In 2025, we launched Senzine — SENSOL's internal publication. Each issue distills a single idea — control, resistance, stillness — into a tactile experience, designed to be felt as much as it is read." },
    { "type": "textarea", "id": "timeline_2025_body2", "label": "Body 2", "default": "Released in quiet intervals, Senzine carries fragments of movement philosophy, reflections on design, and moments of attention. It is not a catalogue. It is not a manual. It is an invitation to think differently about why you train." },

    { "type": "header", "content": "The Journey — 2026" },
    { "type": "text", "id": "timeline_2026_year", "label": "Year", "default": "2026" },
    { "type": "text", "id": "timeline_2026_heading", "label": "Heading", "default": "Crossing to Australia" },
    { "type": "textarea", "id": "timeline_2026_body1", "label": "Body 1", "default": "As SENSOL's reputation grew, one market kept surfacing in community feedback, media inquiries, and direct customer requests: Australia. Australian fitness culture is distinct — it values quality, it values design, and it has zero patience for equipment that can't be delivered quickly or supported locally." },
    { "type": "textarea", "id": "timeline_2026_body2", "label": "Body 2", "default": "That's why Dute Fitness (Australia) Pty. Ltd. was established. Registered in Victoria in July 2026, Dute Fitness is the exclusive Australian distributor for SENSOL. Every unit sold through sensolfitness.com.au is covered by local warranty, supported by a local team, and shipped from a local warehouse." },

    { "type": "header", "content": "The Line (Products)" },
    { "type": "text", "id": "line_label", "label": "Section label", "default": "03 — The Line" },
    { "type": "text", "id": "line_title", "label": "Title", "default": "Three expressions. One philosophy." },
    { "type": "textarea", "id": "line_intro", "label": "Intro", "default": "The original TB02 proved that the concept worked. The next challenge was making SENSOL accessible to more people, at more fitness levels, in more spaces — from motor-driven precision to spring-based flow." },
    { "type": "textarea", "id": "rs02_desc", "label": "RS02 description", "default": "The refined dual-servo digital weight platform. Motor-driven, software-controlled, AI-enhanced. The foundation of the SENSOL training experience." },
    { "type": "textarea", "id": "rs02_pro_desc", "label": "RS02 PRO description", "default": "Premium features and expanded resistance programming. For those who demand the most from every rep — more data, more control, more precision." },
    { "type": "textarea", "id": "flex_air_desc", "label": "FLEX AIR description", "default": "Spring-based resistance in the same iconic form. The SENSOL design philosophy without the motor system — lighter, more accessible, Pilates-inspired." },
    { "type": "textarea", "id": "line_closing", "label": "Closing paragraph", "default": "Every product shares the same design DNA — compact, intentional, and built around the human body. From the motor-driven precision of the Smart Series to the spring-based flow of the Flex Series, the same conviction runs through every curve, every material, every mechanism." },

    { "type": "header", "content": "Growing in the US" },
    { "type": "text", "id": "us_label", "label": "Section label", "default": "04 — Growing in the US" },
    { "type": "text", "id": "us_title", "label": "Title", "default": "From crowdfunding to retail shelves" },
    { "type": "textarea", "id": "us_para1", "label": "Paragraph 1", "default": "SENSOL's presence in the US market grew steadily after the initial crowdfunding deliveries. The brand established sensolfitness.com as its direct-to-consumer channel, and in 2026 partnered with Vesta Fitness as its official retail partner — making SENSOL the first smart fitness bench available for hands-on trial and in-stock purchase through a US retailer." },
    { "type": "textarea", "id": "us_para2", "label": "Paragraph 2", "default": "By 2026, SENSOL had become a recognised name in the smart home gym category — listed alongside Tonal, Speediance, and Oxefit in major product roundups and buyer's guides." },
    { "type": "textarea", "id": "us_para3", "label": "Paragraph 3", "default": "The SENSOL Smart App continued to serve the North American user base with AI-driven coaching, a growing library of on-demand classes, and seamless integration across the entire product line." },
    { "type": "image_picker", "id": "us_image", "label": "US market image" },

    { "type": "header", "content": "Australia" },
    { "type": "text", "id": "au_label", "label": "Section label", "default": "05 — Australia" },
    { "type": "text", "id": "au_title", "label": "Title", "default": "Built for Australia. Backed locally." },
    { "type": "textarea", "id": "au_para1", "label": "Paragraph 1", "default": "This isn't a grey-market import operation. Every unit sold through sensolfitness.com.au is covered by local warranty, supported by a local team, and shipped from a local warehouse." },
    { "type": "textarea", "id": "au_para2", "label": "Paragraph 2", "default": "We believe Australian fitness enthusiasts deserve the same seamless, design-forward training experience that SENSOL delivers worldwide — backed by inventory you can count on and people who answer the phone." },
    { "type": "textarea", "id": "au_distributor", "label": "Distributor info", "default": "Dute Fitness (Australia) Pty. Ltd.\nACN 700 632 337\nRegistered in Victoria, Australia" },

    { "type": "header", "content": "Commitment" },
    { "type": "text", "id": "commitment_label", "label": "Section label", "default": "Our Commitment" },
    { "type": "text", "id": "commitment_quote", "label": "Quote", "default": "Make it easy. Do it real." },
    { "type": "textarea", "id": "commitment_para1", "label": "Paragraph 1", "default": "From the first prototype in Shanghai to crowdfunding backers in California, from retail shelves in the United States to warehouses in Melbourne — SENSOL's mission has never changed: make serious strength training more precise, more accessible, and more beautiful." },
    { "type": "textarea", "id": "commitment_para2", "label": "Paragraph 2", "default": "Every product we build, every app update we ship, every Senzine issue we publish is driven by that conviction." },

