{%- style -%}
  .sensol-about { font-family: 'Inter', sans-serif; color: #1A1816; background: #F7F4F0; }

  .sensol-about__section { padding: 6rem 0; }
  .sensol-about__container { max-width: 1400px; margin: 0 auto; padding: 0 3rem; }
  .sensol-about__container--narrow { max-width: 860px; margin: 0 auto; padding: 0 3rem; }

  .sensol-about__label {
    font-size: 10px; letter-spacing: 0.2em; text-transform: uppercase;
    font-weight: 400; color: #8A8279; margin-bottom: 1.5rem;
  }
  .sensol-about__heading {
    font-size: clamp(28px, 4vw, 44px); font-weight: 200;
    letter-spacing: 0.06em; line-height: 1.2; margin-bottom: 2rem;
  }
  .sensol-about__heading--lg {
    font-size: clamp(36px, 5vw, 56px); font-weight: 200;
    letter-spacing: 0.08em; line-height: 1.15;
  }
  .sensol-about__body {
    font-size: 15px; font-weight: 300; line-height: 1.8;
    color: #4A4640; margin-bottom: 1.25rem;
  }
  .sensol-about__body:last-child { margin-bottom: 0; }

  /* ── Opening ── */
  .sensol-about__opening {
    position: relative; min-height: 90vh; display: flex;
    align-items: center; justify-content: center; overflow: hidden;
    background: #1A1816;
  }
  .sensol-about__opening-bg {
    position: absolute; inset: 0; width: 100%; height: 100%;
    object-fit: cover; opacity: 0.55;
  }
  .sensol-about__opening-inner {
    position: relative; z-index: 1; text-align: center;
    color: #F7F4F0; padding: 0 2rem; max-width: 900px;
  }
  .sensol-about__opening-brand {
    font-size: clamp(48px, 8vw, 96px); font-weight: 200;
    letter-spacing: 0.2em; text-transform: uppercase;
    margin-bottom: 1.5rem; line-height: 1;
  }
  .sensol-about__opening-tagline {
    font-size: clamp(18px, 2.5vw, 28px); font-weight: 200;
    letter-spacing: 0.1em; margin-bottom: 1rem;
  }
  .sensol-about__opening-subtitle {
    font-size: 15px; font-weight: 300; line-height: 1.7;
    color: rgba(247,244,240,0.6); max-width: 600px; margin: 0 auto;
  }

  /* ── Story grid ── */
  .sensol-about__grid {
    display: grid; grid-template-columns: 1.1fr 0.9fr;
    gap: 5rem; align-items: start;
  }
  .sensol-about__grid--reverse { grid-template-columns: 0.9fr 1.1fr; }
  .sensol-about__grid--reverse .sensol-about__grid-text { order: 2; }

  .sensol-about__img-wrap {
    width: 100%; aspect-ratio: 4/5; overflow: hidden; background: #EDEAE5;
  }
  .sensol-about__img-wrap img {
    width: 100%; height: 100%; object-fit: cover; display: block;
  }
  .sensol-about__img-placeholder {
    width: 100%; height: 100%; background: #EDEAE5;
    display: flex; align-items: center; justify-content: center;
  }
  .sensol-about__img-placeholder span {
    font-size: 10px; letter-spacing: 0.15em; text-transform: uppercase;
    color: #8A8279;
  }

  /* ── Specs row ── */
  .sensol-about__specs {
    display: grid; grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem; margin-top: 2.5rem; padding-top: 2rem;
    border-top: 1px solid #D4CEC6;
  }
  .sensol-about__spec-value {
    font-size: 28px; font-weight: 200; letter-spacing: 0.05em;
    display: block; margin-bottom: 0.25rem;
  }
  .sensol-about__spec-label {
    font-size: 10px; letter-spacing: 0.15em; text-transform: uppercase;
    font-weight: 300; color: #8A8279;
  }

  /* ── Product line ── */
  .sensol-about__series {
    margin-bottom: 3rem;
  }
  .sensol-about__series:last-child { margin-bottom: 0; }
  .sensol-about__series-label {
    font-size: 12px; letter-spacing: 0.15em; text-transform: uppercase;
    font-weight: 400; color: #1A1816; margin-bottom: 0.5rem;
  }
  .sensol-about__series-models {
    font-size: 14px; font-weight: 300; color: #8A8279;
    margin-bottom: 1rem;
  }
  .sensol-about__series-desc {
    font-size: 14px; font-weight: 300; line-height: 1.8;
    color: #4A4640; max-width: 700px;
  }

  /* ── Australia ── */
  .sensol-about__au {
    background: #1A1816; color: #F7F4F0;
  }
  .sensol-about__au .sensol-about__heading { color: #F7F4F0; }
  .sensol-about__au .sensol-about__label { color: rgba(247,244,240,0.4); }
  .sensol-about__au .sensol-about__body { color: rgba(247,244,240,0.6); }
  .sensol-about__au-commitments {
    margin-top: 2.5rem; list-style: none; padding: 0;
  }
  .sensol-about__au-commitments li {
    font-size: 14px; font-weight: 300; line-height: 1.7;
    color: rgba(247,244,240,0.7); padding: 0.75rem 0;
    border-bottom: 1px solid rgba(247,244,240,0.1);
  }
  .sensol-about__au-cities {
    display: flex; gap: 1rem; margin-top: 2rem; flex-wrap: wrap;
  }
  .sensol-about__au-city {
    font-size: 11px; letter-spacing: 0.15em; text-transform: uppercase;
    font-weight: 300; color: rgba(247,244,240,0.5);
    padding: 0.5rem 1rem; border: 1px solid rgba(247,244,240,0.15);
  }

  /* ── Pilates ── */
  .sensol-about__pilates-audience {
    margin-top: 2.5rem; padding-top: 2rem;
    border-top: 1px solid #D4CEC6;
  }
  .sensol-about__audience-label {
    font-size: 12px; letter-spacing: 0.1em; text-transform: uppercase;
    font-weight: 400; margin-bottom: 1rem; color: #1A1816;
  }
  .sensol-about__audience-body {
    font-size: 14px; font-weight: 300; line-height: 1.8;
    color: #4A4640; margin-bottom: 1rem;
  }

  /* ── Commitment ── */
  .sensol-about__commitment {
    text-align: center; padding: 8rem 0;
  }
  .sensol-about__commitment-quote {
    font-size: clamp(28px, 4vw, 48px); font-weight: 200;
    letter-spacing: 0.1em; line-height: 1.3;
    text-transform: uppercase; margin-bottom: 3rem;
  }
  .sensol-about__commitment-body {
    font-size: 15px; font-weight: 300; line-height: 1.8;
    color: #4A4640; max-width: 640px; margin: 0 auto 1.25rem;
  }

  /* ── Company info ── */
  .sensol-about__company {
    border-top: 1px solid #D4CEC6; padding-top: 3rem;
    display: grid; grid-template-columns: repeat(2, 1fr);
    gap: 2rem;
  }
  .sensol-about__company-label {
    font-size: 10px; letter-spacing: 0.15em; text-transform: uppercase;
    font-weight: 300; color: #8A8279; margin-bottom: 0.75rem;
  }
  .sensol-about__company-value {
    font-size: 13px; font-weight: 300; line-height: 1.7;
  }
  .sensol-about__company-value a {
    color: #1A1816; text-decoration: none;
    border-bottom: 1px solid #D4CEC6;
  }

  /* ── Responsive ── */
  @media screen and (max-width: 767px) {
    .sensol-about__section { padding: 4rem 0; }
    .sensol-about__container,
    .sensol-about__container--narrow { padding: 0 24px; }
    .sensol-about__opening { min-height: 80vh; padding: 5rem 0; }
    .sensol-about__grid, .sensol-about__grid--reverse { grid-template-columns: 1fr; gap: 2rem; }
    .sensol-about__grid--reverse .sensol-about__grid-text { order: 0; }
    .sensol-about__specs { grid-template-columns: 1fr; gap: 1rem; }
    .sensol-about__company { grid-template-columns: 1fr; gap: 1.5rem; }
    .sensol-about__commitment { padding: 5rem 0; }
  }
  @media screen and (min-width: 768px) and (max-width: 1024px) {
    .sensol-about__container { padding: 0 32px; }
    .sensol-about__grid, .sensol-about__grid--reverse { gap: 3rem; }
  }
{%- endstyle -%}

<div class="sensol-about">

  {%- comment -%} ── OPENING ── {%- endcomment -%}
  <section class="sensol-about__opening">
    {%- if section.settings.hero_image != blank -%}
      <img class="sensol-about__opening-bg" src="{{ section.settings.hero_image | image_url: width: 2000 }}" alt="Sensol" loading="eager" width="2000" height="1125">
    {%- endif -%}
    <div class="sensol-about__opening-inner">
      <h1 class="sensol-about__opening-brand">{{ section.settings.opening_brand }}</h1>
      <p class="sensol-about__opening-tagline">{{ section.settings.opening_tagline }}</p>
      <p class="sensol-about__opening-subtitle">{{ section.settings.opening_subtitle }}</p>
    </div>
  </section>

  {%- comment -%} ── OUR STORY ── {%- endcomment -%}
  <section class="sensol-about__section">
    <div class="sensol-about__container">
      <p class="sensol-about__label">{{ section.settings.story_label }}</p>
      <div class="sensol-about__grid">
        <div class="sensol-about__grid-text">
          <h2 class="sensol-about__heading">{{ section.settings.story_title }}</h2>
          <p class="sensol-about__body">{{ section.settings.story_para1 }}</p>
          <p class="sensol-about__body">{{ section.settings.story_para2 }}</p>
          <p class="sensol-about__body">{{ section.settings.story_para3 }}</p>
          <div class="sensol-about__specs">
            <div>
              <span class="sensol-about__spec-value">{{ section.settings.spec1_value }}</span>
              <span class="sensol-about__spec-label">{{ section.settings.spec1_label }}</span>
            </div>
            <div>
              <span class="sensol-about__spec-value">{{ section.settings.spec2_value }}</span>
              <span class="sensol-about__spec-label">{{ section.settings.spec2_label }}</span>
            </div>
            <div>
              <span class="sensol-about__spec-value">{{ section.settings.spec3_value }}</span>
              <span class="sensol-about__spec-label">{{ section.settings.spec3_label }}</span>
            </div>
          </div>
        </div>
        <div>
          <div class="sensol-about__img-wrap">
            {%- if section.settings.story_image != blank -%}
              <img src="{{ section.settings.story_image | image_url: width: 800 }}" alt="Sensol machine in home environment" loading="lazy" width="800" height="1000">
            {%- else -%}
              <div class="sensol-about__img-placeholder"><span>Story Image</span></div>
            {%- endif -%}
          </div>
        </div>
      </div>
    </div>
  </section>

  {%- comment -%} ── PUBLIC LAUNCH ── {%- endcomment -%}
  <section class="sensol-about__section" style="background:#EDEAE5;">
    <div class="sensol-about__container">
      <p class="sensol-about__label">{{ section.settings.launch_label }}</p>
      <div class="sensol-about__grid sensol-about__grid--reverse">
        <div class="sensol-about__grid-text">
          <h2 class="sensol-about__heading">{{ section.settings.launch_title }}</h2>
          <p class="sensol-about__body">{{ section.settings.launch_para1 }}</p>
          <p class="sensol-about__body">{{ section.settings.launch_para2 }}</p>
          <p class="sensol-about__body">{{ section.settings.launch_para3 }}</p>
        </div>
        <div>
          <div class="sensol-about__img-wrap">
            {%- if section.settings.launch_image != blank -%}
              <img src="{{ section.settings.launch_image | image_url: width: 800 }}" alt="Sensol crowdfunding campaign" loading="lazy" width="800" height="1000">
            {%- else -%}
              <div class="sensol-about__img-placeholder"><span>Launch Image</span></div>
            {%- endif -%}
          </div>
        </div>
      </div>
    </div>
  </section>

  {%- comment -%} ── THE PRODUCT LINE ── {%- endcomment -%}
  <section class="sensol-about__section">
    <div class="sensol-about__container">
      <p class="sensol-about__label">{{ section.settings.line_label }}</p>
      <h2 class="sensol-about__heading">{{ section.settings.line_title }}</h2>
      <p class="sensol-about__body" style="max-width:700px;margin-bottom:3rem;">{{ section.settings.line_intro }}</p>

      <div class="sensol-about__series">
        <p class="sensol-about__series-label">Smart Series</p>
        <p class="sensol-about__series-models">RS02 / RS02 PRO / RS03 / RS03 PRO</p>
        <p class="sensol-about__series-desc">{{ section.settings.smart_series_desc }}</p>
      </div>

      <div class="sensol-about__series">
        <p class="sensol-about__series-label">Flex Series</p>
        <p class="sensol-about__series-models">FLEX AIR / FLEX / FLEX PRO</p>
        <p class="sensol-about__series-desc">{{ section.settings.flex_series_desc }}</p>
      </div>

      <div style="margin-top:3rem;padding-top:2rem;border-top:1px solid #D4CEC6;">
        <p class="sensol-about__body" style="max-width:700px;">{{ section.settings.line_closing }}</p>
      </div>

      {%- if section.settings.line_image != blank -%}
        <div class="sensol-about__img-wrap" style="aspect-ratio:16/9;margin-top:3rem;">
          <img src="{{ section.settings.line_image | image_url: width: 1400 }}" alt="Sensol product lineup" loading="lazy" width="1400" height="788">
        </div>
      {%- endif -%}
    </div>
  </section>

  {%- comment -%} ── THREE YEARS IN THE US ── {%- endcomment -%}
  <section class="sensol-about__section" style="background:#EDEAE5;">
    <div class="sensol-about__container--narrow">
      <p class="sensol-about__label">{{ section.settings.us_label }}</p>
      <h2 class="sensol-about__heading">{{ section.settings.us_title }}</h2>
      <p class="sensol-about__body">{{ section.settings.us_para1 }}</p>
      <p class="sensol-about__body">{{ section.settings.us_para2 }}</p>
      <p class="sensol-about__body">{{ section.settings.us_para3 }}</p>
    </div>
  </section>

  {%- comment -%} ── AUSTRALIA ── {%- endcomment -%}
  <section class="sensol-about__section sensol-about__au">
    <div class="sensol-about__container">
      <p class="sensol-about__label">{{ section.settings.au_label }}</p>
      <h2 class="sensol-about__heading">{{ section.settings.au_title }}</h2>
      <div class="sensol-about__grid" style="margin-top:2rem;">
        <div>
          <p class="sensol-about__body">{{ section.settings.au_para1 }}</p>
          <p class="sensol-about__body">{{ section.settings.au_para2 }}</p>
          <p class="sensol-about__body" style="font-weight:400;color:rgba(247,244,240,0.85);">{{ section.settings.au_para3 }}</p>
          <ul class="sensol-about__au-commitments">
            <li>{{ section.settings.au_commit1 }}</li>
            <li>{{ section.settings.au_commit2 }}</li>
            <li>{{ section.settings.au_commit3 }}</li>
            <li>{{ section.settings.au_commit4 }}</li>
          </ul>
          <p class="sensol-about__body" style="margin-top:2rem;font-style:italic;">{{ section.settings.au_closing }}</p>
        </div>
        <div>
          {%- if section.settings.au_image != blank -%}
            <div class="sensol-about__img-wrap">
              <img src="{{ section.settings.au_image | image_url: width: 800 }}" alt="Sensol in Australia" loading="lazy" width="800" height="1000">
            </div>
          {%- else -%}
            <div class="sensol-about__img-wrap">
              <div class="sensol-about__img-placeholder"><span>Australia Image</span></div>
            </div>
          {%- endif -%}
          <div class="sensol-about__au-cities">
            <span class="sensol-about__au-city">Melbourne</span>
            <span class="sensol-about__au-city">Sydney</span>
            <span class="sensol-about__au-city">Brisbane</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  {%- comment -%} ── BUILT FOR PILATES ── {%- endcomment -%}
  <section class="sensol-about__section">
    <div class="sensol-about__container">
      <p class="sensol-about__label">{{ section.settings.pilates_label }}</p>
      <div class="sensol-about__grid">
        <div class="sensol-about__grid-text">
          <h2 class="sensol-about__heading">{{ section.settings.pilates_title }}</h2>
          <p class="sensol-about__body">{{ section.settings.pilates_para1 }}</p>
          <p class="sensol-about__body">{{ section.settings.pilates_para2 }}</p>
          <div class="sensol-about__pilates-audience">
            <p class="sensol-about__audience-label">For Studio Owners</p>
            <p class="sensol-about__audience-body">{{ section.settings.pilates_studio }}</p>
          </div>
          <div class="sensol-about__pilates-audience">
            <p class="sensol-about__audience-label">For Home Users</p>
            <p class="sensol-about__audience-body">{{ section.settings.pilates_home }}</p>
          </div>
        </div>
        <div>
          <div class="sensol-about__img-wrap">
            {%- if section.settings.pilates_image != blank -%}
              <img src="{{ section.settings.pilates_image | image_url: width: 800 }}" alt="Pilates movement on Sensol" loading="lazy" width="800" height="1000">
            {%- else -%}
              <div class="sensol-about__img-placeholder"><span>Pilates Image</span></div>
            {%- endif -%}
          </div>
        </div>
      </div>
    </div>
  </section>

  {%- comment -%} ── COMMITMENT ── {%- endcomment -%}
  <section class="sensol-about__commitment">
    <div class="sensol-about__container--narrow">
      <p class="sensol-about__commitment-quote">{{ section.settings.commitment_quote }}</p>
      <p class="sensol-about__commitment-body">{{ section.settings.commitment_para1 }}</p>
      <p class="sensol-about__commitment-body">{{ section.settings.commitment_para2 }}</p>
      <p class="sensol-about__commitment-body" style="margin-top:2rem;font-style:italic;color:#8A8279;">{{ section.settings.commitment_para3 }}</p>
    </div>
  </section>

  {%- comment -%} ── COMPANY INFO ── {%- endcomment -%}
  <section class="sensol-about__section" style="padding-top:0;">
    <div class="sensol-about__container--narrow">
      <div class="sensol-about__company">
        <div>
          <p class="sensol-about__company-label">Distribution</p>
          <p class="sensol-about__company-value">{{ section.settings.company_distributor }}</p>
        </div>
        <div>
          <p class="sensol-about__company-label">Contact</p>
          <p class="sensol-about__company-value">
            <a href="mailto:{{ section.settings.contact_email }}">{{ section.settings.contact_email }}</a><br>
            {{ section.settings.contact_extra }}
          </p>
        </div>
        <div>
          <p class="sensol-about__company-label">Trademarks and Patents</p>
          <p class="sensol-about__company-value">{{ section.settings.company_legal }}</p>
        </div>
        <div>
          <p class="sensol-about__company-label">Follow</p>
          <p class="sensol-about__company-value">
            <a href="{{ section.settings.instagram_url }}" target="_blank" rel="noopener">Instagram</a><br>
            <a href="{{ section.settings.youtube_url }}" target="_blank" rel="noopener">YouTube</a>
          </p>
        </div>
      </div>
    </div>
  </section>

</div>

{% schema %}
{
  "name": "SENSOL About",
  "tag": "section",
  "class": "sensol-about-section",
  "settings": [
    { "type": "header", "content": "Opening (Hero)" },
    { "type": "image_picker", "id": "hero_image", "label": "Hero background image" },
    { "type": "text", "id": "opening_brand", "label": "Brand name", "default": "SENSOL" },
    { "type": "text", "id": "opening_tagline", "label": "Tagline", "default": "A new language of training." },
    { "type": "textarea", "id": "opening_subtitle", "label": "Subtitle", "default": "Where strength meets precision, and movement becomes design." },

    { "type": "header", "content": "Our Story" },
    { "type": "text", "id": "story_label", "label": "Section label", "default": "01 — Our Story" },
    { "type": "text", "id": "story_title", "label": "Title", "default": "Redefining home fitness" },
    { "type": "textarea", "id": "story_para1", "label": "Paragraph 1", "default": "Sensol was founded in 2022 with a clear mission: to redefine home fitness through intelligent, space-efficient equipment that delivers studio-grade training without compromise." },
    { "type": "textarea", "id": "story_para2", "label": "Paragraph 2", "default": "The concept was built on a simple observation. Traditional home fitness equipment forced users to choose between performance and practicality — machines were either effective but bulky, or compact but limited. Sensol set out to eliminate that trade-off." },
    { "type": "textarea", "id": "story_para3", "label": "Paragraph 3", "default": "After more than ten years of engineering and prototyping, the first Sensol machine combined digital weight technology, robotic arms with 145-degree range of motion, and a compact form factor that folds for storage. The result is a product line that delivers up to 120 kg of resistance, supports over 200 movements across three training modes, and fits into real living spaces." },
    { "type": "text", "id": "spec1_value", "label": "Spec 1 value", "default": "120 kg" },
    { "type": "text", "id": "spec1_label", "label": "Spec 1 label", "default": "Max Resistance" },
    { "type": "text", "id": "spec2_value", "label": "Spec 2 value", "default": "200+" },
    { "type": "text", "id": "spec2_label", "label": "Spec 2 label", "default": "Movements" },
    { "type": "text", "id": "spec3_value", "label": "Spec 3 value", "default": "145°" },
    { "type": "text", "id": "spec3_label", "label": "Spec 3 label", "default": "Range of Motion" },
    { "type": "image_picker", "id": "story_image", "label": "Story image" },

    { "type": "header", "content": "Public Launch" },
    { "type": "text", "id": "launch_label", "label": "Section label", "default": "02 — Public Launch" },
    { "type": "text", "id": "launch_title", "label": "Title", "default": "From concept to community" },
    { "type": "textarea", "id": "launch_para1", "label": "Paragraph 1", "default": "In September 2023, Sensol launched simultaneously on Kickstarter and Indiegogo. The Kickstarter campaign reached 533% of its funding goal, drawing supporters from the United States, Canada, Europe, and the Asia-Pacific region." },
    { "type": "textarea", "id": "launch_para2", "label": "Paragraph 2", "default": "Later that year, Sensol was featured on Product Hunt, expanding its reach within the global technology and design community." },
    { "type": "textarea", "id": "launch_para3", "label": "Paragraph 3", "default": "By early 2024, all backer orders had been fulfilled across the US, Europe, and Asia-Pacific, with machines placed in real homes rather than test environments." },
    { "type": "image_picker", "id": "launch_image", "label": "Launch image" },

    { "type": "header", "content": "The Product Line" },
    { "type": "text", "id": "line_label", "label": "Section label", "default": "03 — The Product Line" },
    { "type": "text", "id": "line_title", "label": "Title", "default": "Two series. One standard." },
    { "type": "textarea", "id": "line_intro", "label": "Intro", "default": "Following the original Sensol, the product range expanded to serve different training needs and budgets." },
    { "type": "textarea", "id": "smart_series_desc", "label": "Smart Series description", "default": "Full digital weight technology with 0.5 kg precision increments, robotic arms (0–145°), AI-driven coaching, and complete app integration. This series represents Sensol's most complete engineering." },
