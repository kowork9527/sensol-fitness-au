<section class="sensol-shipping-returns-section">
  <div class="sensol-shipping-returns">
    <div class="sensol-shipping-returns__divider"></div>
    <p class="sensol-shipping-returns__label">06</p>
    <h2 class="sensol-shipping-returns__title">Returns &amp; Exchanges</h2>
    <div class="sensol-shipping-returns__body">
      <p>For information about returns and exchanges, please see our <a class="sensol-shipping-returns__link" href="/policies/refund-policy">Refund Policy</a>.</p>
      <p>For any shipping-related questions, contact <a class="sensol-shipping-returns__link" href="mailto:support@sensolfitness.com.au">support@sensolfitness.com.au</a> &mdash; response within 1 business day.</p>
    </div>
  </div>
</section>
{% schema %}{"name":"SENSOL Shipping Returns","tag":"section","class":"sensol-shipping-returns-section","settings":[],"presets":[{"name":"SENSOL Shipping Returns"}]}{% endschema %}
{%- style -%}
.sensol-shipping-returns-section{background:#F7F4F0;padding:0}
.sensol-shipping-returns-section .sensol-shipping-returns{max-width:1040px;margin:0 auto;padding:80px 2rem 100px}
.sensol-shipping-returns-section .sensol-shipping-returns__divider{width:48px;height:1px;background:#D4CEC6;margin-bottom:48px}
.sensol-shipping-returns-section .sensol-shipping-returns__label{font-size:0.75rem;font-weight:600;letter-spacing:0.2em;text-transform:uppercase;color:#B5ADA4;margin-bottom:1rem}
.sensol-shipping-returns-section .sensol-shipping-returns__title{font-size:clamp(2rem,3vw,2.75rem);font-weight:300;letter-spacing:-0.01em;line-height:1.2;margin-bottom:24px;color:#1A1816}
.sensol-shipping-returns-section .sensol-shipping-returns__body{font-size:1.5rem;font-weight:400;color:#8A8279;line-height:1.75}
.sensol-shipping-returns-section .sensol-shipping-returns__body p{margin-bottom:1rem}
.sensol-shipping-returns-section .sensol-shipping-returns__link{color:#1A1816;text-decoration:underline;text-underline-offset:3px;text-decoration-color:#B5ADA4;text-decoration-thickness:0.5px}
@media(max-width:749px){.sensol-shipping-returns-section .sensol-shipping-returns{padding:56px 1.5rem 80px}.sensol-shipping-returns-section .sensol-shipping-returns__title{font-size:1.75rem}.sensol-shipping-returns-section .sensol-shipping-returns__body{font-size:1.25rem}}
{%- endstyle -%}
