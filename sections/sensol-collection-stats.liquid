{%- style -%}
  .sc-stats-{{ section.id }} {
    background: #F7F4F0;
    border-top: 1px solid #D4CEC6;
    font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
    color: #1A1816;
  }
  .sc-stats-{{ section.id }}__inner {
    max-width: 1400px; margin: 0 auto;
    padding: 48px 40px;
    display: flex; align-items: center; justify-content: center;
    gap: 64px; flex-wrap: wrap;
  }
  .sc-stats-{{ section.id }}__item { text-align: center; }
  .sc-stats-{{ section.id }}__num {
    font-size: 32px; font-weight: 200;
    letter-spacing: 0.04em; margin-bottom: 2px;
  }
  .sc-stats-{{ section.id }}__label {
    font-size: 10px; font-weight: 500;
    letter-spacing: 0.25em; text-transform: uppercase;
    color: #8A8279;
  }
  .sc-stats-{{ section.id }}__divider {
    width: 1px; height: 40px;
    background: #D4CEC6;
  }
  @media screen and (max-width: 768px) {
    .sc-stats-{{ section.id }}__inner { gap: 32px; padding: 32px 20px; }
    .sc-stats-{{ section.id }}__divider { display: none; }
  }
{%- endstyle -%}

{%- assign s1n = section.settings.stat1_num -%}
{%- assign s1l = section.settings.stat1_label -%}
{%- assign s2n = section.settings.stat2_num -%}
{%- assign s2l = section.settings.stat2_label -%}
{%- assign s3n = section.settings.stat3_num -%}
{%- assign s3l = section.settings.stat3_label -%}
{%- assign s4n = section.settings.stat4_num -%}
{%- assign s4l = section.settings.stat4_label -%}

{%- case collection.handle -%}
  {%- when 'smart-series' -%}
    {%- assign s1n = '4' -%}{%- assign s1l = 'Products' -%}
    {%- assign s2n = '0.5 kg' -%}{%- assign s2l = 'Precision' -%}
    {%- assign s3n = '$2,900-$4,100' -%}{%- assign s3l = 'Price Range AUD' -%}
    {%- assign s4n = '200+' -%}{%- assign s4l = 'Movements' -%}
  {%- when 'mechanical-series' -%}
    {%- assign s1n = '3' -%}{%- assign s1l = 'Products' -%}
    {%- assign s2n = '0.2 m2' -%}{%- assign s2l = 'Storage Folded' -%}
    {%- assign s3n = '$950-$2,600' -%}{%- assign s3l = 'Price Range AUD' -%}
    {%- assign s4n = '25 kg' -%}{%- assign s4l = 'Lightest Weight' -%}
  {%- when 'flex-series' -%}
    {%- assign s1n = '2' -%}{%- assign s1l = 'Products' -%}
    {%- assign s2n = '0.2 m2' -%}{%- assign s2l = 'Storage Folded' -%}
    {%- assign s3n = '$950-$1,750' -%}{%- assign s3l = 'Price Range AUD' -%}
    {%- assign s4n = '25 kg' -%}{%- assign s4l = 'Lightest Weight' -%}
{%- endcase -%}

<section class="sc-stats-{{ section.id }}">
  <div class="sc-stats-{{ section.id }}__inner">
    <div class="sc-stats-{{ section.id }}__item">
      <p class="sc-stats-{{ section.id }}__num">{{ s1n }}</p>
      <p class="sc-stats-{{ section.id }}__label">{{ s1l }}</p>
    </div>
    <div class="sc-stats-{{ section.id }}__divider"></div>
    <div class="sc-stats-{{ section.id }}__item">
      <p class="sc-stats-{{ section.id }}__num">{{ s2n }}</p>
      <p class="sc-stats-{{ section.id }}__label">{{ s2l }}</p>
    </div>
    <div class="sc-stats-{{ section.id }}__divider"></div>
    <div class="sc-stats-{{ section.id }}__item">
      <p class="sc-stats-{{ section.id }}__num">{{ s3n }}</p>
      <p class="sc-stats-{{ section.id }}__label">{{ s3l }}</p>
    </div>
    <div class="sc-stats-{{ section.id }}__divider"></div>
    <div class="sc-stats-{{ section.id }}__item">
      <p class="sc-stats-{{ section.id }}__num">{{ s4n }}</p>
      <p class="sc-stats-{{ section.id }}__label">{{ s4l }}</p>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Collection Stats",
  "tag": "section",
  "class": "sensol-collection-stats",
  "settings": [
    { "type": "text", "id": "stat1_num", "label": "Stat 1 Number", "default": "7" },
    { "type": "text", "id": "stat1_label", "label": "Stat 1 Label", "default": "Products" },
    { "type": "text", "id": "stat2_num", "label": "Stat 2 Number", "default": "2" },
    { "type": "text", "id": "stat2_label", "label": "Stat 2 Label", "default": "Series" },
    { "type": "text", "id": "stat3_num", "label": "Stat 3 Number", "default": "$950-$4,100" },
    { "type": "text", "id": "stat3_label", "label": "Stat 3 Label", "default": "Price Range AUD" },
    { "type": "text", "id": "stat4_num", "label": "Stat 4 Number", "default": "200+" },
    { "type": "text", "id": "stat4_label", "label": "Stat 4 Label", "default": "Movements" }
  ],
  "presets": [{ "name": "Collection Stats" }]
}
{% endschema %}
