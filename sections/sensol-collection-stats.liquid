/* Auto-generated */
{%- style -%}
  .sc-stats-{{ section.id }} {
    background: #F7F4F0;
    border-top: 1px solid #D4CEC6;
    font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
    color: #1A1816;
  }
  .sc-stats-{{ section.id }}__inner {
    max-width: 1400px; margin: 0 auto;
    padding: 48px 40px;
    display: flex; align-items: center; justify-content: center;
    gap: 64px; flex-wrap: wrap;
  }
  .sc-stats-{{ section.id }}__item { text-align: center; }
  .sc-stats-{{ section.id }}__num {
    font-size: 32px; font-weight: 200;
    letter-spacing: 0.04em; margin-bottom: 2px;
  }
  .sc-stats-{{ section.id }}__label {
    font-size: 10px; font-weight: 500;
    letter-spacing: 0.25em; text-transform: uppercase;
    color: #8A8279;
  }
  .sc-stats-{{ section.id }}__divider {
    width: 1px; height: 40px;
    background: #D4CEC6;
  }
  @media screen and (max-width: 768px) {
    .sc-stats-{{ section.id }}__inner { gap: 32px; padding: 32px 20px; }
    .sc-stats-{{ section.id }}__divider { display: none; }
  }
{%- endstyle -%}

{%- comment -%} Determine per-series stats based on collection handle {%- endcomment -%}
{%- case collection.handle -%}
  {%- when 'smart-series' -%}
    {%- assign stat_nums = '04,01,04,$1,580-$4,100,128+' | split: ',' -%}
    {%- assign stat_labels = 'Products,Series,Movements,Price Range AUD,Movements' | split: ',' -%}
    {%- assign stat_show = 'true,true,true,true,true' | split: ',' -%}
  {%- when 'mechanical-series' -%}
    {%- assign stat_nums = '03,01,03,$950-$1,990,150+' | split: ',' -%}
    {%- assign stat_labels = 'Products,Series,Movements,Price Range AUD,Movements' | split: ',' -%}
    {%- assign stat_show = 'true,true,true,true,true' | split: ',' -%}
  {%- when 'flex-series' -%}
    {%- assign stat_nums = '03,01,03,$1,490-$1,890,80+' | split: ',' -%}
    {%- assign stat_labels = 'Products,Series,Movements,Price Range AUD,Movements' | split: ',' -%}
    {%- assign stat_show = 'true,true,true,true,true' | split: ',' -%}
  {%- else -%}
    {%- assign stat_nums = '7,2,$950-$4,100,200+' | split: ',' -%}
    {%- assign stat_labels = 'Products,Series,Price Range AUD,Movements' | split: ',' -%}
    {%- assign stat_show = 'true,true,true,true' | split: ',' -%}
{%- endcase -%}

<section class="sc-stats-{{ section.id }}">
  <div class="sc-stats-{{ section.id }}__inner">
    {%- for i in (0..3) -%}
      {%- assign num = stat_nums[i] -%}
      {%- assign label = stat_labels[i] -%}
      {%- assign show = stat_show[i] -%}
      {%- if show == 'true' and num != blank -%}
        <div class="sc-stats-{{ section.id }}__item">
          <p class="sc-stats-{{ section.id }}__num">{{ num }}</p>
          <p class="sc-stats-{{ section.id }}__label">{{ label }}</p>
        </div>
        {%- unless forloop.last -%}
          <div class="sc-stats-{{ section.id }}__divider"></div>
        {%- endunless -%}
      {%- endif -%}
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Series Stats",
  "tag": "section",
  "class": "sensol-collection-stats",
  "settings": []
}
{% endschema %}
