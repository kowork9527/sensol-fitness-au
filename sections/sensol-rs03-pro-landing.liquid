{%- liquid
  assign p = product
-%}
{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom | default: 80 }}px;
    padding-left: 20px;
    padding-right: 20px;
    background: #F7F4F0;
    box-sizing: border-box;
  }
  .section-{{ section.id }}-padding *,
  .section-{{ section.id }}-padding *::before,
  .section-{{ section.id }}-padding *::after {
    box-sizing: border-box;
  }
  /* Breadcrumb */
  .rs03pro-breadcrumb-{{ section.id }} {
    max-width: 1200px;
    margin: 0 auto 24px;
    font-size: 12px;
    color: #8A8279;
    letter-spacing: 0.05em;
  }
  .rs03pro-breadcrumb-{{ section.id }} a {
    color: #8A8279;
    text-decoration: none;
    transition: color 0.2s;
  }
  .rs03pro-breadcrumb-{{ section.id }} a:hover {
    color: #1A1816;
  }
  .rs03pro-breadcrumb-{{ section.id }} span {
    margin: 0 8px;
  }
  .rs03pro-product-{{ section.id }} {
    max-width: 1200px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 60px;
    align-items: start;
    font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
    color: #1A1816;
    min-width: 0;
  }
  .rs03pro-gallery-{{ section.id }} {
    position: sticky;
    top: 20px;
    min-width: 0;
    max-width: 100%;
  }
  .rs03pro-gallery-main-{{ section.id }} {
    aspect-ratio: 1 / 1;
    background: #fff;
    overflow: hidden;
    margin-bottom: 16px;
    cursor: zoom-in;
    position: relative;
    min-width: 0;
    max-width: 100%;
  }
  .rs03pro-gallery-main-{{ section.id }} img {
    width: 100% !important;
    height: 100% !important;
    max-width: 100% !important;
    object-fit: cover;
    display: block;
    transition: transform 0.3s;
  }
  .rs03pro-gallery-main-{{ section.id }}:hover img {
    transform: scale(1.02);
  }
  .rs03pro-gallery-thumbs-{{ section.id }} {
    display: flex;
    gap: 10px;
    overflow-x: auto;
    scroll-behavior: smooth;
    -webkit-overflow-scrolling: touch;
    padding-bottom: 6px;
  }
  .rs03pro-gallery-thumbs-{{ section.id }}::-webkit-scrollbar {
    height: 4px;
  }
  .rs03pro-gallery-thumbs-{{ section.id }}::-webkit-scrollbar-track {
    background: transparent;
  }
  .rs03pro-gallery-thumbs-{{ section.id }}::-webkit-scrollbar-thumb {
    background: rgba(0,0,0,0.15);
    border-radius: 2px;
  }
  .rs03pro-gallery-thumb-{{ section.id }} {
    flex: 0 0 72px;
    width: 72px;
    height: 72px;
    background: #fff;
    overflow: hidden;
    cursor: pointer;
    border: 2px solid transparent;
    border-radius: 6px;
    transition: border-color 0.2s;
  }
  .rs03pro-gallery-thumb-{{ section.id }}:hover,
  .rs03pro-gallery-thumb-{{ section.id }}.active {
    border-color: #1A1816;
  }
  .rs03pro-gallery-thumb-{{ section.id }} img {
    width: 100% !important;
    height: 100% !important;
    max-width: 100% !important;
    object-fit: cover;
    display: block;
  }
  .rs03pro-gallery-main-wrapper-{{ section.id }} {
    position: relative;
    margin-bottom: 16px;
    min-width: 0;
    max-width: 100%;
  }
  .rs03pro-gallery-nav-{{ section.id }} {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 48px;
    height: 48px;
    background: rgba(255,255,255,0.92);
    border: none;
    border-radius: 50%;
    font-size: 28px;
    line-height: 1;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 10;
    opacity: 0.65;
    transition: opacity 0.3s, background 0.2s;
    color: #1A1816;
  }
  .rs03pro-gallery-main-wrapper-{{ section.id }}:hover .rs03pro-gallery-nav-{{ section.id }} {
    opacity: 1;
  }
  .rs03pro-gallery-nav-{{ section.id }}:hover {
    background: rgba(255,255,255,1);
  }
  .rs03pro-gallery-nav-prev-{{ section.id }} { left: 12px; }
  .rs03pro-gallery-nav-next-{{ section.id }} { right: 12px; }

  .rs03pro-lightbox-nav-{{ section.id }} {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 56px;
    height: 56px;
    background: rgba(255,255,255,0.15);
    border: 1px solid rgba(255,255,255,0.3);
    border-radius: 50%;
    color: #fff;
    font-size: 32px;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 10001;
    transition: background 0.2s;
  }
  .rs03pro-lightbox-nav-{{ section.id }}:hover {
    background: rgba(255,255,255,0.3);
  }
  .rs03pro-lightbox-nav-prev-{{ section.id }} { left: 30px; }
  .rs03pro-lightbox-nav-next-{{ section.id }} { right: 30px; }
  .rs03pro-info-{{ section.id }} {
    padding: 20px 0;
    min-width: 0;
  }
  .rs03pro-info-brand-{{ section.id }} {
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: #8A8279;
    margin-bottom: 12px;
  }
  .rs03pro-info-title-{{ section.id }} {
    font-size: 36px;
    font-weight: 300;
    letter-spacing: 0.04em;
    margin: 0 0 8px;
    color: #1A1816;
  }
  .rs03pro-info-subtitle-{{ section.id }} {
    font-size: 16px;
    color: #8A8279;
    margin-bottom: 16px;
  }
  .rs03pro-info-reviews-{{ section.id }} {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 16px;
    font-size: 13px;
    color: #8A8279;
  }
  .rs03pro-info-stars-{{ section.id }} {
    color: #F5A623;
    letter-spacing: 2px;
  }
  .rs03pro-info-model-{{ section.id }} {
    font-size: 12px;
    color: #8A8279;
    letter-spacing: 0.05em;
    margin-bottom: 24px;
    padding-bottom: 24px;
    border-bottom: 1px solid #D4CEC6;
  }
  .rs03pro-info-price-{{ section.id }} {
    font-size: 28px;
    font-weight: 400;
    color: #1A1816;
    margin-bottom: 8px;
    letter-spacing: 0.02em;
  }
  .rs03pro-info-price-{{ section.id }} s {
    color: #8A8279;
    margin-right: 12px;
    font-size: 18px;
  }
  .rs03pro-info-afterpay-{{ section.id }} {
    font-size: 13px;
    color: #8A8279;
    margin-bottom: 24px;
  }
  .rs03pro-info-badges-{{ section.id }} {
    display: flex;
    gap: 16px;
    flex-wrap: wrap;
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #8A8279;
    margin-bottom: 24px;
    padding-bottom: 24px;
    border-bottom: 1px solid #D4CEC6;
  }
  .rs03pro-info-stock-{{ section.id }} {
    font-size: 12px;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    margin-bottom: 24px;
    padding: 8px 16px;
    display: inline-block;
  }
  .rs03pro-info-stock-in-{{ section.id }} {
    background: #E8F5E9;
    color: #2E7D32;
  }
  .rs03pro-info-stock-out-{{ section.id }} {
    background: #FFEBEE;
    color: #C62828;
  }
  .rs03pro-qty-{{ section.id }} {
    display: flex;
    align-items: center;
    gap: 16px;
    margin-bottom: 16px;
  }
  .rs03pro-qty-label-{{ section.id }} {
    font-size: 12px;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: #8A8279;
  }
  .rs03pro-qty-input-{{ section.id }} {
    width: 80px;
    padding: 12px;
    border: 1px solid #D4CEC6;
    background: #fff;
    font-size: 16px;
    text-align: center;
  }
  .rs03pro-add-{{ section.id }} {
    width: 100%;
    padding: 20px;
    background: #1A1816;
    color: #F7F4F0;
    border: none;
    font-size: 14px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    cursor: pointer;
    transition: background 0.3s;
    font-weight: 500;
    margin-bottom: 12px;
  }
  .rs03pro-add-{{ section.id }}:hover {
    background: #2A2826;
  }
  .rs03pro-add-{{ section.id }}:disabled {
    background: #8A8279;
    cursor: not-allowed;
  }
  .rs03pro-payment-buttons-{{ section.id }} {
    width: 100%;
    margin-bottom: 32px;
  }
  .rs03pro-payment-buttons-{{ section.id }} .shopify-payment-button {
    width: 100%;
  }
  .rs03pro-payment-buttons-{{ section.id }} .shopify-payment-button__button {
    width: 100%;
    padding: 16px;
    background: #fff;
    border: 1px solid #D4CEC6;
    font-size: 12px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #8A8279;
    text-align: center;
  }
  .rs03pro-features-{{ section.id }} {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .rs03pro-features-{{ section.id }} li {
    font-size: 14px;
    line-height: 1.6;
    color: #1A1816;
    padding: 8px 0;
    padding-left: 20px;
    position: relative;
  }
  .rs03pro-features-{{ section.id }} li::before {
    content: '\2022';
    position: absolute;
    left: 0;
    color: #8A8279;
  }
  /* Lightbox */
  .rs03pro-lightbox-{{ section.id }} {
    display: none;
    position: fixed;
    inset: 0;
    background: rgba(0,0,0,0.95);
    z-index: 9999;
    align-items: center;
    justify-content: center;
    cursor: zoom-out;
  }
  .rs03pro-lightbox-{{ section.id }}.active {
    display: flex;
  }
  .rs03pro-lightbox-{{ section.id }} img {
    max-width: 90vw;
    max-height: 90vh;
    object-fit: contain;
  }
  .rs03pro-lightbox-close-{{ section.id }} {
    position: absolute;
    top: 20px;
    right: 20px;
    width: 40px;
    height: 40px;
    background: none;
    border: 1px solid #fff;
    color: #fff;
    font-size: 24px;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  @media screen and (max-width: 990px) {
    .rs03pro-product-{{ section.id }} {
      grid-template-columns: 1fr;
      gap: 40px;
    }
    .rs03pro-gallery-{{ section.id }} {
      position: static;
    }
    .rs03pro-info-title-{{ section.id }} {
      font-size: 32px;
    }
    .rs03pro-info-price-{{ section.id }} {
      font-size: 26px;
    }
  }
  @media screen and (max-width: 768px) {
    .rs03pro-product-{{ section.id }} {
      grid-template-columns: 1fr;
      gap: 32px;
    }
    .rs03pro-gallery-main-{{ section.id }} {
      aspect-ratio: 4 / 5;
    }
    .rs03pro-gallery-thumb-{{ section.id }} {
      flex: 0 0 60px;
      width: 60px;
      height: 60px;
    }
    .rs03pro-info-title-{{ section.id }} {
      font-size: 28px;
    }
    .rs03pro-info-price-{{ section.id }} {
      font-size: 24px;
    }
    .rs03pro-info-badges-{{ section.id }} {
      flex-direction: column;
      gap: 8px;
    }
  }
  @media screen and (max-width: 480px) {
    .section-{{ section.id }}-padding {
      padding-left: 16px;
      padding-right: 16px;
    }
    .rs03pro-info-title-{{ section.id }} {
      font-size: 24px;
    }
    .rs03pro-info-price-{{ section.id }} {
      font-size: 22px;
    }
  }

  .rs03pro-pay-icons-{{ section.id }} {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px;
    margin-top: 16px;
  }
  .rs03pro-pay-icons-{{ section.id }} svg.rs03pro-pay-icon {
    width: 38px;
    height: auto;
    border-radius: 3px;
  }
  /* Variant color swatches */
  .rs03pro-variants-{{ section.id }} { margin: 0 0 22px 0; }
  .rs03pro-variant-label-{{ section.id }} { font-size: 14px; color: #8A857D; margin-bottom: 12px; letter-spacing: 0.02em; }
  .rs03pro-variant-label-value-{{ section.id }} { color: #1A1816; font-weight: 600; }
  .rs03pro-swatches-{{ section.id }} { display: flex; flex-wrap: wrap; gap: 12px; }
  .rs03pro-swatch-{{ section.id }} { width: 40px; height: 40px; border-radius: 50%; border: 1px solid #E5E0D8; background: transparent; padding: 0; cursor: pointer; position: relative; display: inline-flex; align-items: center; justify-content: center; transition: border-color 0.2s ease, box-shadow 0.2s ease; }
  .rs03pro-swatch-{{ section.id }}:hover { border-color: #1A1816; }
  .rs03pro-swatch-{{ section.id }}.is-selected { border-color: #1A1816; box-shadow: 0 0 0 1px #1A1816; }
  .rs03pro-swatch-dot-{{ section.id }} { width: 30px; height: 30px; border-radius: 50%; display: block; }
  .rs03pro-swatch-{{ section.id }}.is-unavailable { cursor: not-allowed; }
  .rs03pro-swatch-{{ section.id }}.is-unavailable .rs03pro-swatch-dot-{{ section.id }} { opacity: 0.35; }
  .rs03pro-swatch-{{ section.id }}.is-unavailable::after { content: ''; position: absolute; top: 50%; left: 50%; width: 34px; height: 1.5px; background: #8A857D; transform: translate(-50%, -50%) rotate(-45deg); }
  /* Backorder / pre-order notice */
  .rs03pro-backorder-note-{{ section.id }} { display: flex; align-items: flex-start; gap: 14px; background: #FDF6E7; border: 1.5px solid #D9A13B; border-left: 4px solid #D9A13B; border-radius: 10px; padding: 14px 16px; margin: 0 0 20px 0; animation: rs03pro-backorder-in-{{ section.id }} 0.3s ease; }
  .rs03pro-backorder-icon-{{ section.id }} { flex-shrink: 0; width: 38px; height: 38px; border-radius: 50%; background: #D9A13B; color: #FFFFFF; display: flex; align-items: center; justify-content: center; }
  .rs03pro-backorder-icon-{{ section.id }} svg { width: 20px; height: 20px; }
  .rs03pro-backorder-text-{{ section.id }} { flex: 1; min-width: 0; }
  .rs03pro-backorder-title-{{ section.id }} { display: block; font-size: 12.5px; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; color: #7A5514; margin-bottom: 3px; }
  .rs03pro-backorder-msg-{{ section.id }} { font-size: 14.5px; line-height: 1.55; font-weight: 500; color: #4A3A15; margin: 0; }
  @keyframes rs03pro-backorder-in-{{ section.id }} { from { opacity: 0; transform: translateY(-4px); } to { opacity: 1; transform: none; } }
  @media screen and (max-width: 749px) {
    .rs03pro-backorder-note-{{ section.id }} { gap: 11px; padding: 12px 13px; }
    .rs03pro-backorder-icon-{{ section.id }} { width: 32px; height: 32px; }
    .rs03pro-backorder-icon-{{ section.id }} svg { width: 17px; height: 17px; }
    .rs03pro-backorder-msg-{{ section.id }} { font-size: 13.5px; }
  }
  {%- endstyle -%}

<div class="section-{{ section.id }}-padding">
  <!-- Breadcrumb Navigation -->
  <nav class="rs03pro-breadcrumb-{{ section.id }}" aria-label="Breadcrumb">
    <a href="/">Home</a>
    <span>/</span>
    <a href="/collections/all">Products</a>
    <span>/</span>
    <a href="/collections/reformers">Reformers</a>
    <span>/</span>
    <span style="color:#1A1816">{{ p.title | default: 'Sensol RS03 PRO' }}</span>
  </nav>

  <div class="rs03pro-product-{{ section.id }}">
    <div class="rs03pro-gallery-{{ section.id }}">
      <div class="rs03pro-gallery-main-wrapper-{{ section.id }}">
        <div class="rs03pro-gallery-main-{{ section.id }}" id="rs03proMainImage-{{ section.id }}">
          {%- if p.featured_image -%}
            {{ p.featured_image | image_url: width: 1200 | image_tag: loading: 'eager', id: 'rs03proMainImg', class: 'rs03pro-main-img', widths: '200,300,400,500,600,800,1000,1200', sizes: '(max-width: 768px) 100vw, 50vw' }}
          {%- else -%}
            <div style="display:flex;align-items:center;justify-content:center;height:100%;color:#8A8279">No image</div>
          {%- endif -%}
        </div>
        <button class="rs03pro-gallery-nav-{{ section.id }} rs03pro-gallery-nav-prev-{{ section.id }}" id="rs03proPrev-{{ section.id }}" aria-label="Previous image">&#8249;</button>
        <button class="rs03pro-gallery-nav-{{ section.id }} rs03pro-gallery-nav-next-{{ section.id }}" id="rs03proNext-{{ section.id }}" aria-label="Next image">&#8250;</button>
      </div>
      {%- if p.images.size > 1 -%}
        <div class="rs03pro-gallery-thumbs-{{ section.id }}" id="rs03proThumbs-{{ section.id }}">
          {%- for img in p.images -%}
            <div class="rs03pro-gallery-thumb-{{ section.id }}{% if forloop.first %} active{% endif %}" data-image="{{ img | image_url: width: 1200 }}" data-index="{{ forloop.index0 }}">
              {{ img | image_url: width: 300 | image_tag: loading: 'lazy', class: 'rs03pro-thumb-img' }}
            </div>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>

    <div class="rs03pro-info-{{ section.id }}">
      <div class="rs03pro-info-brand-{{ section.id }}">SENSOL FITNESS</div>
      <h1 class="rs03pro-info-title-{{ section.id }}">{{ p.title | default: 'Sensol RS03 PRO' }}</h1>
      <div class="rs03pro-info-subtitle-{{ section.id }}">{{ section.settings.subtitle | default: 'The Studio. Reimagined for Home.' }}</div>
      
      <!-- Judge.me Review Stars -->
      <div class="rs03pro-info-reviews-{{ section.id }}">
        <span class="rs03pro-info-stars-{{ section.id }}">&#9733;&#9733;&#9733;&#9733;&#9733;</span>
        <span>4.9 (89 reviews)</span>
      </div>
      
      <div class="rs03pro-info-model-{{ section.id }}">{{ section.settings.model_info | default: 'Model RS03 PRO / Flagship Smart Reformer · SKU: SNSL-RS03-PRO-AU' }}</div>

      <div class="rs03pro-info-price-{{ section.id }}">
        {%- if p.compare_at_price > p.price -%}
          <s>{{ p.compare_at_price | money }}</s>
        {%- endif -%}
        {{ p.price | money }} AUD
      </div>
      <div class="rs03pro-info-afterpay-{{ section.id }}">or 4 interest-free payments of {{ p.price | divided_by: 4 | money }} with Afterpay</div>

      <div class="rs03pro-info-badges-{{ section.id }}">
        <span>LIFETIME WARRANTY</span>
        <span>FREE DOMESTIC SHIPPING</span>
        <span>30-DAY MONEY-BACK</span>
      </div>

      {%- assign sv = p.selected_or_first_available_variant -%}
      {%- assign sv_sellable = false -%}
      {%- if sv.available or sv.inventory_policy == 'continue' -%}
        {%- assign sv_sellable = true -%}
      {%- endif -%}
      {%- if sv.available == false -%}
        <div class="rs03pro-info-stock-{{ section.id }} rs03pro-info-stock-out-{{ section.id }}">Sold Out</div>
      {%- elsif sv.inventory_quantity == 0 -%}
        <div class="rs03pro-info-stock-{{ section.id }} rs03pro-info-stock-in-{{ section.id }}">Available to Order</div>
      {%- else -%}
        <div class="rs03pro-info-stock-{{ section.id }} rs03pro-info-stock-in-{{ section.id }}">In Stock</div>
      {%- endif -%}

      {%- if p.options.size == 1 and p.variants.size > 1 -%}
      <div class="rs03pro-variants-{{ section.id }}" id="rs03pro-variant-picker-{{ section.id }}">
        <div class="rs03pro-variant-label-{{ section.id }}">
          <span class="rs03pro-variant-label-name-{{ section.id }}">{{ p.options_with_values.first.name }}:</span>
          <span class="rs03pro-variant-label-value-{{ section.id }}" data-variant-selected-name>{{ p.selected_or_first_available_variant.title }}</span>
        </div>
        <div class="rs03pro-swatches-{{ section.id }}" aria-label="{{ p.options_with_values.first.name | escape }}">
          {%- for v in p.variants -%}
            {%- assign c_name = v.title | strip | downcase -%}
            {%- if c_name == 'black' -%}
              {%- assign c_hex = '#1A1816' -%}
            {%- elsif c_name == 'black brown' -%}
              {%- assign c_hex = '#3D2C22' -%}
            {%- elsif c_name == 'deep brown' -%}
              {%- assign c_hex = '#5B4636' -%}
            {%- elsif c_name == 'beige' -%}
              {%- assign c_hex = '#E2D8C6' -%}
            {%- elsif c_name == 'light gray' or c_name == 'light grey' -%}
              {%- assign c_hex = '#CEC9C2' -%}
            {%- elsif c_name == 'gray' or c_name == 'grey' -%}
              {%- assign c_hex = '#A5A19A' -%}
            {%- elsif c_name == 'light green' -%}
              {%- assign c_hex = '#BCCBB2' -%}
            {%- else -%}
              {%- assign c_hex = '#A5A19A' -%}
            {%- endif -%}
            {%- if v.available or v.inventory_policy == 'continue' -%}
              {%- assign v_sellable = true -%}
            {%- else -%}
              {%- assign v_sellable = false -%}
            {%- endif -%}
            <button type="button"
              class="rs03pro-swatch-{{ section.id }}{% if v.id == p.selected_or_first_available_variant.id %} is-selected{% endif %}{% unless v_sellable %} is-unavailable{% endunless %}"
              data-variant-id="{{ v.id }}"
              data-variant-title="{{ v.title | escape }}"
              data-variant-price="{{ v.price | money }}"
              data-variant-compare="{% if v.compare_at_price > v.price %}{{ v.compare_at_price | money }}{% endif %}"
              data-variant-afterpay="{{ v.price | divided_by: 4 | money }}"
              data-variant-available="{% if v_sellable %}true{% else %}false{% endif %}"
              data-variant-state="{% if v.available == false %}sold_out{% elsif v.inventory_quantity == 0 %}backorder{% else %}in_stock{% endif %}"
              title="{{ v.title | escape }}"
              aria-label="{{ v.title | escape }}{% unless v_sellable %} — sold out{% endunless %}"
              aria-pressed="{% if v.id == p.selected_or_first_available_variant.id %}true{% else %}false{% endif %}">
              <span class="rs03pro-swatch-dot-{{ section.id }}" style="background-color: {{ c_hex }};"></span>
            </button>
          {%- endfor -%}
        </div>
      </div>
      {%- endif -%}
      {%- assign sv_state = 'in_stock' -%}
      {%- if sv.available == false -%}
        {%- assign sv_state = 'sold_out' -%}
      {%- elsif sv.inventory_quantity == 0 -%}
        {%- assign sv_state = 'backorder' -%}
      {%- endif -%}
      {%- if section.settings.backorder_notice != blank and sv_state == 'backorder' -%}
      <div class="rs03pro-backorder-note-{{ section.id }}" data-backorder-note role="alert">
        <div class="rs03pro-backorder-icon-{{ section.id }}" aria-hidden="true">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 18V6a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2v11a1 1 0 0 0 1 1h2"/><path d="M15 18H9"/><path d="M19 18h2a1 1 0 0 0 1-1v-3.65a1 1 0 0 0-.22-.624l-3.48-4.35A1 1 0 0 0 17.52 8H14"/><circle cx="17" cy="18" r="2"/><circle cx="7" cy="18" r="2"/></svg>
        </div>
        <div class="rs03pro-backorder-text-{{ section.id }}">
          {%- if section.settings.backorder_title != blank -%}
          <span class="rs03pro-backorder-title-{{ section.id }}">{{ section.settings.backorder_title }}</span>
          {%- endif -%}
          <p class="rs03pro-backorder-msg-{{ section.id }}">{{ section.settings.backorder_notice | escape | newline_to_br }}</p>
        </div>
      </div>
      {%- endif -%}
      {%- form 'product', p, id: 'product-form-rs03pro-' -%}
        <input type="hidden" name="id" value="{{ p.selected_or_first_available_variant.id }}" class="product-variant-id">
        <div class="subscriptions_app_embed_block"></div>
        <div class="rs03pro-qty-{{ section.id }}">
          <label class="rs03pro-qty-label-{{ section.id }}" for="Quantity-pro-{{ section.id }}">Quantity</label>
          <input class="rs03pro-qty-input-{{ section.id }}" type="number" id="Quantity-pro-{{ section.id }}" name="quantity" value="1" min="1">
        </div>

        <button class="rs03pro-add-{{ section.id }}" type="submit" name="add" {%- unless sv_sellable -%}disabled{%- endunless -%}>
          {%- if sv_sellable -%}Add to Cart{%- else -%}Sold Out{%- endif -%}
        </button>
        
        <!-- Dynamic Payment Buttons -->
        <div class="rs03pro-payment-buttons-{{ section.id }}">
          {{ form | payment_button }}
        </div>

        {%- if shop.enabled_payment_types.size > 0 -%}
          <div class="rs03pro-pay-icons-{{ section.id }}" aria-label="Supported payment methods">
            {%- for type in shop.enabled_payment_types -%}
              {{ type | payment_type_svg_tag: 'rs03pro-pay-icon' }}
            {%- endfor -%}
          </div>
        {%- endif -%}
      {%- endform -%}

      <ul class="rs03pro-features-{{ section.id }}">
        <li>Enhanced Pilates cable system — studio-grade movement</li>
        <li>500W servo motor · 45 kg digital resistance · 1 kg precision</li>
        <li>0–145° adjustable arm range · 8 positions · quick-release</li>
        <li>Dual-function: Reformer + Strength · 200+ movements</li>
        <li>Free Vesta Sensol App — 300+ classes, AI coaching, no subscription</li>
      </ul>
    </div>
  </div>
</div>

<!-- Lightbox v2 gallery updated -->
<div class="rs03pro-lightbox-{{ section.id }}" id="rs03proLightbox-{{ section.id }}">
  <button class="rs03pro-lightbox-close-{{ section.id }}" id="rs03proLightboxClose-{{ section.id }}">×</button>
  <button class="rs03pro-lightbox-nav-{{ section.id }} rs03pro-lightbox-nav-prev-{{ section.id }}" id="rs03proLightboxPrev-{{ section.id }}" aria-label="Previous">&#8249;</button>
  <img src="" alt="Product image" id="rs03proLightboxImg-{{ section.id }}">
  <button class="rs03pro-lightbox-nav-{{ section.id }} rs03pro-lightbox-nav-next-{{ section.id }}" id="rs03proLightboxNext-{{ section.id }}" aria-label="Next">&#8250;</button>
</div>

<script>
(function() {
  var sectionId = '{{ section.id }}';
  var mainImg = document.getElementById('rs03proMainImg');
  var mainContainer = document.getElementById('rs03proMainImage-' + sectionId);
  var thumbs = document.querySelectorAll('.rs03pro-gallery-thumb-' + sectionId);
  var prevBtn = document.getElementById('rs03proPrev-' + sectionId);
  var nextBtn = document.getElementById('rs03proNext-' + sectionId);
  var lightbox = document.getElementById('rs03proLightbox-' + sectionId);
  var lightboxImg = document.getElementById('rs03proLightboxImg-' + sectionId);
  var lightboxClose = document.getElementById('rs03proLightboxClose-' + sectionId);
  var lightboxPrev = document.getElementById('rs03proLightboxPrev-' + sectionId);
  var lightboxNext = document.getElementById('rs03proLightboxNext-' + sectionId);

  var images = [];
  thumbs.forEach(function(thumb) {
    images.push(thumb.getAttribute('data-image'));
  });
  if (images.length === 0 && mainImg) {
    images.push(mainImg.src);
  }
  var currentIndex = 0;

  function showImage(index) {
    if (images.length === 0) return;
    if (index < 0) index = images.length - 1;
    if (index >= images.length) index = 0;
    currentIndex = index;
    if (mainImg) {
      mainImg.src = images[index];
      mainImg.removeAttribute('srcset');
      mainImg.removeAttribute('sizes');
    }
    thumbs.forEach(function(t, i) { t.classList.toggle('active', i === index); });
    // Auto-scroll thumbs to keep active one visible
    if (thumbs[currentIndex] && thumbs[currentIndex].scrollIntoView) {
      thumbs[currentIndex].scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'nearest' });
    }
  }

  thumbs.forEach(function(thumb, i) {
    thumb.addEventListener('click', function() { showImage(i); });
  });
  if (prevBtn) {
    prevBtn.addEventListener('click', function(e) { e.stopPropagation(); showImage(currentIndex - 1); });
  }
  if (nextBtn) {
    nextBtn.addEventListener('click', function(e) { e.stopPropagation(); showImage(currentIndex + 1); });
  }

  if (mainContainer) {
    mainContainer.addEventListener('click', function() {
      if (lightboxImg && images[currentIndex]) { lightboxImg.src = images[currentIndex]; }
      lightbox.classList.add('active');
      document.body.style.overflow = 'hidden';
    });
  }

  function closeLightbox() {
    lightbox.classList.remove('active');
    document.body.style.overflow = '';
  }
  if (lightboxClose) { lightboxClose.addEventListener('click', closeLightbox); }
  if (lightbox) {
    lightbox.addEventListener('click', function(e) { if (e.target === lightbox) closeLightbox(); });
  }
  if (lightboxPrev) {
    lightboxPrev.addEventListener('click', function(e) {
      e.stopPropagation();
      var ni = (currentIndex - 1 + images.length) % images.length;
      currentIndex = ni;
      lightboxImg.src = images[ni];
    });
  }
  if (lightboxNext) {
    lightboxNext.addEventListener('click', function(e) {
      e.stopPropagation();
      var ni = (currentIndex + 1) % images.length;
      currentIndex = ni;
      lightboxImg.src = images[ni];
    });
  }
  document.addEventListener('keydown', function(e) {
    if (!lightbox.classList.contains('active')) return;
    if (e.key === 'Escape') closeLightbox();
    if (e.key === 'ArrowLeft') {
      var ni = (currentIndex - 1 + images.length) % images.length;
      currentIndex = ni; lightboxImg.src = images[ni];
    }
    if (e.key === 'ArrowRight') {
      var ni = (currentIndex + 1) % images.length;
      currentIndex = ni; lightboxImg.src = images[ni];
    }
  });
})();
  /* Variant color swatch picker */
  (function() {
    var wrap = document.getElementById('rs03pro-variant-picker-{{ section.id }}');
    if (!wrap) return;
    var form = wrap.parentNode.querySelector('form');
    if (!form) return;
    var idInput = form.querySelector('.product-variant-id');
    var addBtn = form.querySelector('button[name="add"]');
    var labelValue = wrap.querySelector('[data-variant-selected-name]');
    var root = wrap.parentNode;
    var priceEl = root.querySelector('.rs03pro-info-price-{{ section.id }}');
    var afterpayEl = root.querySelector('.rs03pro-info-afterpay-{{ section.id }}');
    var stockEl = root.querySelector('.rs03pro-info-stock-{{ section.id }}');
    var noteEl = root.querySelector('[data-backorder-note]');
    var swatches = wrap.querySelectorAll('.rs03pro-swatch-{{ section.id }}');
    swatches.forEach(function(btn) {
      btn.addEventListener('click', function() {
        swatches.forEach(function(b) {
          b.classList.remove('is-selected');
          b.setAttribute('aria-pressed', 'false');
        });
        btn.classList.add('is-selected');
        btn.setAttribute('aria-pressed', 'true');
        if (idInput) idInput.value = btn.getAttribute('data-variant-id');
        if (labelValue) labelValue.textContent = btn.getAttribute('data-variant-title');
        var avail = btn.getAttribute('data-variant-available') === 'true';
        var state = btn.getAttribute('data-variant-state') || (avail ? 'in_stock' : 'sold_out');
        if (priceEl) {
          var compare = btn.getAttribute('data-variant-compare');
          var price = btn.getAttribute('data-variant-price');
          priceEl.innerHTML = (compare ? '<s>' + compare + '</s> ' : '') + price + ' AUD';
        }
        if (afterpayEl) afterpayEl.textContent = 'or 4 interest-free payments of ' + btn.getAttribute('data-variant-afterpay') + ' with Afterpay';
        if (stockEl) {
          stockEl.classList.toggle('rs03pro-info-stock-in-{{ section.id }}', avail);
          stockEl.classList.toggle('rs03pro-info-stock-out-{{ section.id }}', !avail);
          stockEl.textContent = state === 'in_stock' ? 'In Stock' : (state === 'backorder' ? 'Available to Order' : 'Sold Out');
        }
        if (noteEl) noteEl.style.display = state === 'backorder' ? '' : 'none';
        if (addBtn) {
          addBtn.disabled = !avail;
          addBtn.textContent = avail ? 'Add to Cart' : 'Sold Out';
        }
      });
    });
  })();
</script>

{% schema %}
{
  "name": "Sensol RS03 PRO Landing",
  "tag": "section",
  "class": "rs03-pro-landing-section",
  "settings": [
    {
      "type": "header",
      "content": "Product Landing Section"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "The Studio. Reimagined for Home."
    },
    {
      "type": "text",
      "id": "model_info",
      "label": "Model Info",
      "default": "Model RS03 PRO / Flagship Smart Reformer · SKU: SNSL-RS03-PRO-AU"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 200,
      "step": 10,
      "unit": "px",
      "label": "Top padding",
      "default": 140
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 200,
      "step": 10,
      "unit": "px",
      "label": "Bottom padding",
      "default": 80
    },
    {
      "type": "header",
      "content": "Pre-order notice"
    },
    {
      "type": "text",
      "id": "backorder_title",
      "label": "Notice title",
      "default": "Pre-Order Notice"
    },
    {
      "type": "textarea",
      "id": "backorder_notice",
      "label": "Notice message",
      "default": "This item is currently on pre-order and will ship as soon as new stock arrives.",
      "info": "Shows prominently above the Add to Cart button when the selected variant is sellable but out of stock (Continue selling enabled). Add your shipping date here."
    }
  ],
  "presets": [
    {
      "name": "Sensol RS03 PRO Landing"
    }
  ]
}
{% endschema %}
