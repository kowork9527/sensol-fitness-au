{%- liquid
  assign p = product
-%}
{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom | default: 80 }}px;
    padding-left: 20px;
    padding-right: 20px;
    background: #F7F4F0;
  }
  /* Breadcrumb */
  .rs03pro-breadcrumb-{{ section.id }} {
    max-width: 1200px;
    margin: 0 auto 24px;
    font-size: 12px;
    color: #8A8279;
    letter-spacing: 0.05em;
  }
  .rs03pro-breadcrumb-{{ section.id }} a {
    color: #8A8279;
    text-decoration: none;
    transition: color 0.2s;
  }
  .rs03pro-breadcrumb-{{ section.id }} a:hover {
    color: #1A1816;
  }
  .rs03pro-breadcrumb-{{ section.id }} span {
    margin: 0 8px;
  }
  .rs03pro-product-{{ section.id }} {
    max-width: 1200px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 60px;
    align-items: start;
    font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
    color: #1A1816;
  }
  .rs03pro-gallery-{{ section.id }} {
    position: sticky;
    top: 100px;
  }
  .rs03pro-gallery-main-{{ section.id }} {
    aspect-ratio: 1 / 1;
    background: #fff;
    overflow: hidden;
    margin-bottom: 16px;
    cursor: zoom-in;
    position: relative;
  }
  .rs03pro-gallery-main-{{ section.id }} img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s;
  }
  .rs03pro-gallery-main-{{ section.id }}:hover img {
    transform: scale(1.02);
  }
  .rs03pro-gallery-thumbs-{{ section.id }} {
    display: flex;
    gap: 10px;
    overflow-x: auto;
    scroll-behavior: smooth;
    -webkit-overflow-scrolling: touch;
    padding-bottom: 6px;
  }
  .rs03pro-gallery-thumbs-{{ section.id }}::-webkit-scrollbar {
    height: 4px;
  }
  .rs03pro-gallery-thumbs-{{ section.id }}::-webkit-scrollbar-track {
    background: transparent;
  }
  .rs03pro-gallery-thumbs-{{ section.id }}::-webkit-scrollbar-thumb {
    background: rgba(0,0,0,0.15);
    border-radius: 2px;
  }
  .rs03pro-gallery-thumb-{{ section.id }} {
    flex: 0 0 72px;
    width: 72px;
    height: 72px;
    background: #fff;
    overflow: hidden;
    cursor: pointer;
    border: 2px solid transparent;
    border-radius: 6px;
    transition: border-color 0.2s;
  }
  .rs03pro-gallery-thumb-{{ section.id }}:hover,
  .rs03pro-gallery-thumb-{{ section.id }}.active {
    border-color: #1A1816;
  }
  .rs03pro-gallery-thumb-{{ section.id }} img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .rs03pro-gallery-main-wrapper-{{ section.id }} {
    position: relative;
    margin-bottom: 16px;
  }
  .rs03pro-gallery-nav-{{ section.id }} {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 48px;
    height: 48px;
    background: rgba(255,255,255,0.92);
    border: none;
    border-radius: 50%;
    font-size: 28px;
    line-height: 1;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 5;
    opacity: 0.65;
    transition: opacity 0.3s, background 0.2s;
    color: #1A1816;
  }
  .rs03pro-gallery-main-wrapper-{{ section.id }}:hover .rs03pro-gallery-nav-{{ section.id }} {
    opacity: 1;
  }
  .rs03pro-gallery-nav-{{ section.id }}:hover {
    background: rgba(255,255,255,1);
  }
  .rs03pro-gallery-nav-prev-{{ section.id }} { left: 12px; }
  .rs03pro-gallery-nav-next-{{ section.id }} { right: 12px; }

  .rs03pro-lightbox-nav-{{ section.id }} {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 56px;
    height: 56px;
    background: rgba(255,255,255,0.15);
    border: 1px solid rgba(255,255,255,0.3);
    border-radius: 50%;
    color: #fff;
    font-size: 32px;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 10001;
    transition: background 0.2s;
  }
  .rs03pro-lightbox-nav-{{ section.id }}:hover {
    background: rgba(255,255,255,0.3);
  }
  .rs03pro-lightbox-nav-prev-{{ section.id }} { left: 30px; }
  .rs03pro-lightbox-nav-next-{{ section.id }} { right: 30px; }
  .rs03pro-info-{{ section.id }} {
    padding: 20px 0;
  }
  .rs03pro-info-brand-{{ section.id }} {
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: #8A8279;
    margin-bottom: 12px;
  }
  .rs03pro-info-title-{{ section.id }} {
    font-size: 36px;
    font-weight: 300;
    letter-spacing: 0.04em;
    margin: 0 0 8px;
    color: #1A1816;
  }
  .rs03pro-info-subtitle-{{ section.id }} {
    font-size: 16px;
    color: #8A8279;
    margin-bottom: 16px;
  }
  .rs03pro-info-reviews-{{ section.id }} {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 16px;
    font-size: 13px;
    color: #8A8279;
  }
  .rs03pro-info-stars-{{ section.id }} {
    color: #F5A623;
    letter-spacing: 2px;
  }
  .rs03pro-info-model-{{ section.id }} {
    font-size: 12px;
    color: #8A8279;
    letter-spacing: 0.05em;
    margin-bottom: 24px;
    padding-bottom: 24px;
    border-bottom: 1px solid #D4CEC6;
  }
  .rs03pro-info-price-{{ section.id }} {
    font-size: 28px;
    font-weight: 400;
    color: #1A1816;
    margin-bottom: 8px;
    letter-spacing: 0.02em;
  }
  .rs03pro-info-price-{{ section.id }} s {
    color: #8A8279;
    margin-right: 12px;
    font-size: 18px;
  }
  .rs03pro-info-afterpay-{{ section.id }} {
    font-size: 13px;
    color: #8A8279;
    margin-bottom: 24px;
  }
  .rs03pro-info-badges-{{ section.id }} {
    display: flex;
    gap: 16px;
    flex-wrap: wrap;
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #8A8279;
    margin-bottom: 24px;
    padding-bottom: 24px;
    border-bottom: 1px solid #D4CEC6;
  }
  .rs03pro-info-stock-{{ section.id }} {
    font-size: 12px;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    margin-bottom: 24px;
    padding: 8px 16px;
    display: inline-block;
  }
  .rs03pro-info-stock-in-{{ section.id }} {
    background: #E8F5E9;
    color: #2E7D32;
  }
  .rs03pro-info-stock-out-{{ section.id }} {
    background: #FFEBEE;
    color: #C62828;
  }
  .rs03pro-qty-{{ section.id }} {
    display: flex;
    align-items: center;
    gap: 16px;
    margin-bottom: 16px;
  }
  .rs03pro-qty-label-{{ section.id }} {
    font-size: 12px;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: #8A8279;
  }
  .rs03pro-qty-input-{{ section.id }} {
    width: 80px;
    padding: 12px;
    border: 1px solid #D4CEC6;
    background: #fff;
    font-size: 16px;
    text-align: center;
  }
  .rs03pro-add-{{ section.id }} {
    width: 100%;
    padding: 20px;
    background: #1A1816;
    color: #F7F4F0;
    border: none;
    font-size: 14px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    cursor: pointer;
    transition: background 0.3s;
    font-weight: 500;
    margin-bottom: 12px;
  }
  .rs03pro-add-{{ section.id }}:hover {
    background: #2A2826;
  }
  .rs03pro-add-{{ section.id }}:disabled {
    background: #8A8279;
    cursor: not-allowed;
  }
  .rs03pro-payment-buttons-{{ section.id }} {
    width: 100%;
    margin-bottom: 32px;
  }
  .rs03pro-payment-buttons-{{ section.id }} .shopify-payment-button {
    width: 100%;
  }
  .rs03pro-payment-buttons-{{ section.id }} .shopify-payment-button__button {
    width: 100%;
    padding: 16px;
    background: #fff;
    border: 1px solid #D4CEC6;
    font-size: 12px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #8A8279;
    text-align: center;
  }
  .rs03pro-features-{{ section.id }} {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .rs03pro-features-{{ section.id }} li {
    font-size: 14px;
    line-height: 1.6;
    color: #1A1816;
    padding: 8px 0;
    padding-left: 20px;
    position: relative;
  }
  .rs03pro-features-{{ section.id }} li::before {
    content: '\2022';
    position: absolute;
    left: 0;
    color: #8A8279;
  }
  /* Lightbox */
  .rs03pro-lightbox-{{ section.id }} {
    display: none;
    position: fixed;
    inset: 0;
    background: rgba(0,0,0,0.95);
    z-index: 9999;
    align-items: center;
    justify-content: center;
    cursor: zoom-out;
  }
  .rs03pro-lightbox-{{ section.id }}.active {
    display: flex;
  }
  .rs03pro-lightbox-{{ section.id }} img {
    max-width: 90vw;
    max-height: 90vh;
    object-fit: contain;
  }
  .rs03pro-lightbox-close-{{ section.id }} {
    position: absolute;
    top: 20px;
    right: 20px;
    width: 40px;
    height: 40px;
    background: none;
    border: 1px solid #fff;
    color: #fff;
    font-size: 24px;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  @media screen and (max-width: 768px) {
    .rs03pro-product-{{ section.id }} {
      grid-template-columns: 1fr;
      gap: 32px;
    }
    .rs03pro-gallery-{{ section.id }} {
      position: static;
    }
    .rs03pro-info-title-{{ section.id }} {
      font-size: 28px;
    }
    .rs03pro-info-price-{{ section.id }} {
      font-size: 24px;
    }
    .rs03pro-info-badges-{{ section.id }} {
      flex-direction: column;
      gap: 8px;
    }
  }
{%- endstyle -%}

<div class="section-{{ section.id }}-padding">
  <!-- Breadcrumb Navigation -->
  <nav class="rs03pro-breadcrumb-{{ section.id }}" aria-label="Breadcrumb">
    <a href="/">Home</a>
    <span>/</span>
    <a href="/collections/all">Products</a>
    <span>/</span>
    <a href="/collections/reformers">Reformers</a>
    <span>/</span>
    <span style="color:#1A1816">{{ p.title | default: 'Sensol RS03 PRO' }}</span>
  </nav>

  <div class="rs03pro-product-{{ section.id }}">
    <div class="rs03pro-gallery-{{ section.id }}">
      <div class="rs03pro-gallery-main-wrapper-{{ section.id }}">
        <div class="rs03pro-gallery-main-{{ section.id }}" id="rs03proMainImage-{{ section.id }}">
          {%- if p.featured_image -%}
            {{ p.featured_image | image_url: width: 1200 | image_tag: loading: 'eager', id: 'rs03proMainImg' }}
          {%- else -%}
            <div style="display:flex;align-items:center;justify-content:center;height:100%;color:#8A8279">No image</div>
          {%- endif -%}
        </div>
        <button class="rs03pro-gallery-nav-{{ section.id }} rs03pro-gallery-nav-prev-{{ section.id }}" id="rs03proPrev-{{ section.id }}" aria-label="Previous image">&#8249;</button>
        <button class="rs03pro-gallery-nav-{{ section.id }} rs03pro-gallery-nav-next-{{ section.id }}" id="rs03proNext-{{ section.id }}" aria-label="Next image">&#8250;</button>
      </div>
      {%- if p.images.size > 1 -%}
        <div class="rs03pro-gallery-thumbs-{{ section.id }}" id="rs03proThumbs-{{ section.id }}">
          {%- for img in p.images -%}
            <div class="rs03pro-gallery-thumb-{{ section.id }}{% if forloop.first %} active{% endif %}" data-image="{{ img | image_url: width: 1200 }}" data-index="{{ forloop.index0 }}">
              {{ img | image_url: width: 300 | image_tag: loading: 'lazy' }}
            </div>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>

    <div class="rs03pro-info-{{ section.id }}">
      <div class="rs03pro-info-brand-{{ section.id }}">SENSOL FITNESS</div>
      <h1 class="rs03pro-info-title-{{ section.id }}">{{ p.title | default: 'Sensol RS03 PRO' }}</h1>
      <div class="rs03pro-info-subtitle-{{ section.id }}">{{ section.settings.subtitle | default: 'The Studio. Reimagined for Home.' }}</div>
      
      <!-- Judge.me Review Stars -->
      <div class="rs03pro-info-reviews-{{ section.id }}">
        <span class="rs03pro-info-stars-{{ section.id }}">&#9733;&#9733;&#9733;&#9733;&#9733;</span>
        <span>4.9 (89 reviews)</span>
      </div>
      
      <div class="rs03pro-info-model-{{ section.id }}">{{ section.settings.model_info | default: 'Model RS03 PRO / Flagship Smart Reformer · SKU: SNSL-RS03-PRO-AU' }}</div>

      <div class="rs03pro-info-price-{{ section.id }}">
        {%- if p.compare_at_price > p.price -%}
          <s>{{ p.compare_at_price | money }}</s>
        {%- endif -%}
        {{ p.price | money }} AUD
      </div>
      <div class="rs03pro-info-afterpay-{{ section.id }}">or 4 interest-free payments of {{ p.price | divided_by: 4 | money }} with Afterpay</div>

      <div class="rs03pro-info-badges-{{ section.id }}">
        <span>LIFETIME WARRANTY</span>
        <span>FREE DOMESTIC SHIPPING</span>
        <span>30-DAY MONEY-BACK</span>
      </div>

      {%- if p.available -%}
        <div class="rs03pro-info-stock-{{ section.id }} rs03pro-info-stock-in-{{ section.id }}">In Stock</div>
      {%- else -%}
        <div class="rs03pro-info-stock-{{ section.id }} rs03pro-info-stock-out-{{ section.id }}">Sold Out</div>
      {%- endif -%}

      {%- form 'product', p, id: 'product-form-rs03pro-' -%}
        <div class="subscriptions_app_embed_block"></div>
        <div class="rs03pro-qty-{{ section.id }}">
          <label class="rs03pro-qty-label-{{ section.id }}" for="Quantity-pro-{{ section.id }}">Quantity</label>
          <input class="rs03pro-qty-input-{{ section.id }}" type="number" id="Quantity-pro-{{ section.id }}" name="quantity" value="1" min="1">
        </div>

        <button class="rs03pro-add-{{ section.id }}" type="submit" name="add" {%- unless p.available -%}disabled{%- endunless -%}>
          {%- if p.available -%}Add to Cart{%- else -%}Sold Out{%- endif -%}
        </button>
        
        <!-- Dynamic Payment Buttons -->
        <div class="rs03pro-payment-buttons-{{ section.id }}">
          {{ form | payment_button }}
        </div>
      {%- endform -%}

      <ul class="rs03pro-features-{{ section.id }}">
        <li>Enhanced Pilates cable system — studio-grade movement</li>
        <li>500W servo motor · 45 kg digital resistance · 1 kg precision</li>
        <li>0–145° adjustable arm range · 8 positions · quick-release</li>
        <li>Dual-function: Reformer + Strength · 200+ movements</li>
        <li>Free Vesta Sensol App — 300+ classes, AI coaching, no subscription</li>
      </ul>
    </div>
  </div>
</div>

<!-- Lightbox v2 gallery updated -->
<div class="rs03pro-lightbox-{{ section.id }}" id="rs03proLightbox-{{ section.id }}">
  <button class="rs03pro-lightbox-close-{{ section.id }}" id="rs03proLightboxClose-{{ section.id }}">×</button>
  <button class="rs03pro-lightbox-nav-{{ section.id }} rs03pro-lightbox-nav-prev-{{ section.id }}" id="rs03proLightboxPrev-{{ section.id }}" aria-label="Previous">&#8249;</button>
  <img src="" alt="Product image" id="rs03proLightboxImg-{{ section.id }}">
  <button class="rs03pro-lightbox-nav-{{ section.id }} rs03pro-lightbox-nav-next-{{ section.id }}" id="rs03proLightboxNext-{{ section.id }}" aria-label="Next">&#8250;</button>
</div>

<script>
(function() {
  var sectionId = '{{ section.id }}';
  var mainImg = document.getElementById('rs03proMainImg');
  var mainContainer = document.getElementById('rs03proMainImage-' + sectionId);
  var thumbs = document.querySelectorAll('.rs03pro-gallery-thumb-' + sectionId);
  var prevBtn = document.getElementById('rs03proPrev-' + sectionId);
  var nextBtn = document.getElementById('rs03proNext-' + sectionId);
  var lightbox = document.getElementById('rs03proLightbox-' + sectionId);
  var lightboxImg = document.getElementById('rs03proLightboxImg-' + sectionId);
  var lightboxClose = document.getElementById('rs03proLightboxClose-' + sectionId);
  var lightboxPrev = document.getElementById('rs03proLightboxPrev-' + sectionId);
  var lightboxNext = document.getElementById('rs03proLightboxNext-' + sectionId);

  var images = [];
  thumbs.forEach(function(thumb) {
    images.push(thumb.getAttribute('data-image'));
  });
  if (images.length === 0 && mainImg) {
    images.push(mainImg.src);
  }
  var currentIndex = 0;

  function showImage(index) {
    if (images.length === 0) return;
    if (index < 0) index = images.length - 1;
    if (index >= images.length) index = 0;
    currentIndex = index;
    if (mainImg) { mainImg.src = images[index]; }
    thumbs.forEach(function(t, i) { t.classList.toggle('active', i === index); });
  }

  thumbs.forEach(function(thumb, i) {
    thumb.addEventListener('click', function() { showImage(i); });
  });
  if (prevBtn) {
    prevBtn.addEventListener('click', function(e) { e.stopPropagation(); showImage(currentIndex - 1); });
  }
  if (nextBtn) {
    nextBtn.addEventListener('click', function(e) { e.stopPropagation(); showImage(currentIndex + 1); });
  }

  if (mainContainer) {
    mainContainer.addEventListener('click', function() {
      if (lightboxImg && images[currentIndex]) { lightboxImg.src = images[currentIndex]; }
      lightbox.classList.add('active');
      document.body.style.overflow = 'hidden';
    });
  }

  function closeLightbox() {
    lightbox.classList.remove('active');
    document.body.style.overflow = '';
  }
  if (lightboxClose) { lightboxClose.addEventListener('click', closeLightbox); }
  if (lightbox) {
    lightbox.addEventListener('click', function(e) { if (e.target === lightbox) closeLightbox(); });
  }
  if (lightboxPrev) {
    lightboxPrev.addEventListener('click', function(e) {
      e.stopPropagation();
      var ni = (currentIndex - 1 + images.length) % images.length;
      currentIndex = ni;
      lightboxImg.src = images[ni];
    });
  }
  if (lightboxNext) {
    lightboxNext.addEventListener('click', function(e) {
      e.stopPropagation();
      var ni = (currentIndex + 1) % images.length;
      currentIndex = ni;
      lightboxImg.src = images[ni];
    });
  }
  document.addEventListener('keydown', function(e) {
    if (!lightbox.classList.contains('active')) return;
    if (e.key === 'Escape') closeLightbox();
    if (e.key === 'ArrowLeft') {
      var ni = (currentIndex - 1 + images.length) % images.length;
      currentIndex = ni; lightboxImg.src = images[ni];
    }
    if (e.key === 'ArrowRight') {
      var ni = (currentIndex + 1) % images.length;
      currentIndex = ni; lightboxImg.src = images[ni];
    }
  });
})();
</script>

{% schema %}
{
  "name": "Sensol RS03 PRO Landing",
  "tag": "section",
  "class": "rs03-pro-landing-section",
  "settings": [
    {
      "type": "header",
      "content": "Product Landing Section"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "The Studio. Reimagined for Home."
    },
    {
      "type": "text",
      "id": "model_info",
      "label": "Model Info",
      "default": "Model RS03 PRO / Flagship Smart Reformer · SKU: SNSL-RS03-PRO-AU"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 200,
      "step": 10,
      "unit": "px",
      "label": "Top padding",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 200,
      "step": 10,
      "unit": "px",
      "label": "Bottom padding",
      "default": 80
    }
  ],
  "presets": [
    {
      "name": "Sensol RS03 PRO Landing"
    }
  ]
}
{% endschema %}
