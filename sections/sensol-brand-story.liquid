<section class="sensol-brand-story-section" id="philosophy">
  <div class="sensol-brand-story">
    <div class="sensol-brand-story__header">
      <p class="sensol-brand-story__label">{{ section.settings.label }}</p>
      <h2 class="sensol-brand-story__title">{{ section.settings.title }}</h2>
    </div>

    <div class="sensol-brand-story__body">
      <div class="sensol-brand-story__text-col">
        <p class="sensol-brand-story__para">{{ section.settings.para1 }}</p>
        <p class="sensol-brand-story__para">{{ section.settings.para2 }}</p>
        <p class="sensol-brand-story__para">{{ section.settings.para3 }}</p>

        <div class="sensol-brand-story__stats">
          <div class="sensol-brand-story__stat">
            <span class="sensol-brand-story__stat-num">{{ section.settings.stat1_num }}</span>
            <span class="sensol-brand-story__stat-label">{{ section.settings.stat1_label }}</span>
          </div>
          <div class="sensol-brand-story__stat">
            <span class="sensol-brand-story__stat-num">{{ section.settings.stat2_num }}</span>
            <span class="sensol-brand-story__stat-label">{{ section.settings.stat2_label }}</span>
          </div>
          <div class="sensol-brand-story__stat">
            <span class="sensol-brand-story__stat-num">{{ section.settings.stat3_num }}</span>
            <span class="sensol-brand-story__stat-label">{{ section.settings.stat3_label }}</span>
          </div>
        </div>
      </div>

      <div class="sensol-brand-story__image-col">
        <img class="sensol-brand-story__image" src="{{ 'section-1.webp' | asset_url }}" alt="Sensol Philosophy" loading="lazy" width="800" height="600">
      </div>
    </div>

    <div class="sensol-brand-story__features">
      <div class="sensol-brand-story__feature">
        <span class="sensol-brand-story__feature-num">01</span>
        <h3 class="sensol-brand-story__feature-title">{{ section.settings.feat1_title }}</h3>
        <p class="sensol-brand-story__feature-desc">{{ section.settings.feat1_desc }}</p>
      </div>
      <div class="sensol-brand-story__feature">
        <span class="sensol-brand-story__feature-num">02</span>
        <h3 class="sensol-brand-story__feature-title">{{ section.settings.feat2_title }}</h3>
        <p class="sensol-brand-story__feature-desc">{{ section.settings.feat2_desc }}</p>
      </div>
      <div class="sensol-brand-story__feature">
        <span class="sensol-brand-story__feature-num">03</span>
        <h3 class="sensol-brand-story__feature-title">{{ section.settings.feat3_title }}</h3>
        <p class="sensol-brand-story__feature-desc">{{ section.settings.feat3_desc }}</p>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "SENSOL Brand Story",
  "tag": "section",
  "class": "sensol-brand-story-section",
  "settings": [
    { "type": "text", "id": "label", "label": "Label", "default": "01 — The Philosophy" },
    { "type": "text", "id": "title", "label": "Title", "default": "Designed around the human form." },
    { "type": "textarea", "id": "para1", "label": "Paragraph 1", "default": "Sensol is redefining the role of fitness in modern living. Founded in 2022, we design intelligent training systems that merge performance, technology, and spatial aesthetics — building a new vision of the future fitness lifestyle." },
    { "type": "textarea", "id": "para2", "label": "Paragraph 2", "default": "Our machines are not merely equipment. They are engineered instruments — each component machined to precision, each resistance curve calibrated for the human body. The result is a training experience that feels less like a workout and more like a practice in control." },
    { "type": "textarea", "id": "para3", "label": "Paragraph 3", "default": "We believe that strength is not about how much you can lift, but how precisely you can move. Every Sensol system is built to help you discover that precision — in your own space, at your own pace, on your own terms." },
    { "type": "text", "id": "stat1_num", "label": "Stat 1 Number", "default": "2022" },
    { "type": "text", "id": "stat1_label", "label": "Stat 1 Label", "default": "Founded" },
    { "type": "text", "id": "stat2_num", "label": "Stat 2 Number", "default": "7" },
    { "type": "text", "id": "stat2_label", "label": "Stat 2 Label", "default": "Products" },
    { "type": "text", "id": "stat3_num", "label": "Stat 3 Number", "default": "∞" },
    { "type": "text", "id": "stat3_label", "label": "Stat 3 Label", "default": "Possibilities" },
    { "type": "text", "id": "feat1_title", "label": "Feature 1 Title", "default": "Adaptive Resistance" },
    { "type": "textarea", "id": "feat1_desc", "label": "Feature 1 Description", "default": "Our magnetic resistance system responds in real time to your movement patterns — adjusting tension mid-rep for a fluid, natural feel that traditional cable systems cannot replicate." },
    { "type": "text", "id": "feat2_title", "label": "Feature 2 Title", "default": "Spatial Design" },
    { "type": "textarea", "id": "feat2_desc", "label": "Feature 2 Description", "default": "Every Sensol machine is designed to live in your space — not dominate it. Clean lines, premium materials, and a footprint that respects the architecture of your home or studio." },
    { "type": "text", "id": "feat3_title", "label": "Feature 3 Title", "default": "Intelligent Motion" },
    { "type": "textarea", "id": "feat3_desc", "label": "Feature 3 Description", "default": "From 360-degree range of motion to whisper-quiet operation at under 25dB, every technical detail serves one purpose: to let you focus entirely on the movement." }
  ],
  "presets": [{ "name": "SENSOL Brand Story" }]
}
{% endschema %}

{%- style -%}
/* ===== SENsol Brand Story — matching Next.js preview ===== */
.sensol-brand-story-section {
  margin: 0;
  padding: 0;
  background: #F7F4F0;
}

.sensol-brand-story {
  max-width: 1600px;
  margin: 0 auto;
  padding: 6rem 2rem;
  font-family: 'Inter', sans-serif;
  color: #1A1816;
}

@media (min-width: 768px) {
  .sensol-brand-story {
    padding: 10rem 4rem;
  }
}

/* Section Label — matching: text-[10px] tracking-brand-lg text-[#8A8279] uppercase mb-16 md:mb-20 */
.sensol-brand-story__label {
  font-size: 10px;
  letter-spacing: 0.2em;
  text-transform: uppercase;
  color: #8A8279;
  margin-bottom: 4rem;
  text-align: left;
}

@media (min-width: 768px) {
  .sensol-brand-story__label {
    margin-bottom: 5rem;
  }
}

/* Header */
.sensol-brand-story__header {
  margin-bottom: 0;
}

/* Title — matching: text-3xl md:text-4xl lg:text-5xl font-extralight leading-[1.12] tracking-wide */
.sensol-brand-story__title {
  font-size: clamp(1.875rem, 4vw, 3rem);
  font-weight: 200;
  letter-spacing: 0.08em;
  line-height: 1.12;
  margin-bottom: 2.5rem;
  text-align: left;
}

@media (min-width: 768px) {
  .sensol-brand-story__title {
    font-size: clamp(2.25rem, 5vw, 3.75rem);
  }
}

@media (min-width: 1024px) {
  .sensol-brand-story__title {
    font-size: 3rem;
  }
}

/* Grid: equal 2 cols — matching Next.js: md:grid-cols-2 gap-16 md:gap-24 */
.sensol-brand-story__body {
  display: grid;
  grid-template-columns: 1fr;
  gap: 4rem;
}

@media (min-width: 768px) {
  .sensol-brand-story__body {
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
  }
}

@media (min-width: 1024px) {
  .sensol-brand-story__body {
    gap: 6rem;
  }
}

/* Text column */
.sensol-brand-story__text-col {
  display: flex;
  flex-direction: column;
  justify-content: center;
  text-align: left;
}

@media (min-width: 768px) {
  .sensol-brand-story__text-col {
  }
  }
}

/* Paragraphs — matching: text-[#8A8279] text-sm md:text-base font-light leading-[1.9] */
.sensol-brand-story__para {
  color: #8A8279;
  font-size: 14px;
  line-height: 1.9;
  font-weight: 300;
  margin-bottom: 1.5rem;
}

@media (min-width: 768px) {
  .sensol-brand-story__para {
    font-size: 16px;
  }
}

.sensol-brand-story__para:last-of-type {
  margin-bottom: 0;
}

/* Stats Row — matching: grid grid-cols-3 gap-8 border-t border-[#D4CEC6] pt-10 */
.sensol-brand-story__stats {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 2rem;
  border-top: 1px solid #D4CEC6;
  padding-top: 2.5rem;
  margin-top: 2.5rem;
}

/* Match HTML class names: stat-num / stat-label */
.sensol-brand-story__stat-num {
  font-size: clamp(1.25rem, 2vw, 1.5rem);
  font-weight: 200;
  letter-spacing: 0.05em;
  color: #1A1816;
  display: block;
  margin-bottom: 0.5rem;
}

@media (min-width: 768px) {
  .sensol-brand-story__stat-num {
    font-size: clamp(1.5rem, 2.5vw, 2rem);
  }
}

.sensol-brand-story__stat-label {
  font-size: 9px;
  letter-spacing: 0.2em;
  text-transform: uppercase;
  color: #8A8279;
  display: block;
}

/* Image Column — matching: relative overflow-hidden */
.sensol-brand-story__image-col {
  position: relative;
  overflow: hidden;
}

.sensol-brand-story__image {
  width: 100%;
  height: auto;
  display: block;
  object-fit: cover;
  aspect-ratio: 3/2;
}

@media (min-width: 768px) {
  .sensol-brand-story__image {
    aspect-ratio: 16/10;
  }
}

/* Image label overlay — matching: absolute bottom-0 left-0 right-0 p-6 bg-gradient-to-t */
.sensol-brand-story__image-overlay {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 1.5rem;
  background: linear-gradient(to top, rgba(26,24,22,0.3), transparent);
  pointer-events: none;
}

/* Features Grid — matching: 3 cols with 1px borders */
.sensol-brand-story__features {
  display: grid;
  grid-template-columns: 1fr;
  gap: 2rem;
  border-top: 1px solid #D4CEC6;
  padding-top: 3rem;
  margin-top: 4rem;
}

@media (min-width: 768px) {
  .sensol-brand-story__features {
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
  }
}

.sensol-brand-story__feature {
  padding-top: 1rem;
}

.sensol-brand-story__feature-num {
  font-size: 10px;
  letter-spacing: 0.15em;
  color: #8A8279;
  display: block;
  margin-bottom: 1rem;
}

.sensol-brand-story__feature-title {
  font-size: 16px;
  font-weight: 400;
  letter-spacing: 0.05em;
  color: #1A1816;
  margin-bottom: 0.75rem;
}

.sensol-brand-story__feature-desc {
  font-size: 13px;
  color: #8A8279;
  line-height: 1.7;
  font-weight: 300;
}
{%- endstyle -%}
