{{ 'sensol-brand-story.css' | asset_url | stylesheet_tag }}

<section class="sensol-brand-story">
  <div class="sensol-brand-story__container">
    <div class="sensol-brand-story__text">
      <p class="sensol-brand-story__number">01 — The Philosophy</p>
      <h2 class="sensol-brand-story__title">{{ section.settings.title | default: 'Engineered for those who see movement as a craft.' }}</h2>
      <p class="sensol-brand-story__body">{{ section.settings.body | default: 'Sensol was founded on a simple conviction: fitness equipment should belong in the same conversation as architecture and design. Not as an afterthought in a garage, but as a considered object in a considered space. Every curve, every material, every mechanism is shaped by the belief that how you train is inseparable from where you train.' }}</p>
      <div class="sensol-brand-story__features">
        <div class="sensol-brand-story__feature">
          <h3 class="sensol-brand-story__feature-title">{{ section.settings.feature1_title | default: 'Adaptive Resistance' }}</h3>
          <p class="sensol-brand-story__feature-desc">{{ section.settings.feature1_desc | default: 'Fluid resistance that adapts to your strength curve — progressive, regressive, or constant.' }}</p>
        </div>
        <div class="sensol-brand-story__feature">
          <h3 class="sensol-brand-story__feature-title">{{ section.settings.feature2_title | default: 'Spatial Design' }}</h3>
          <p class="sensol-brand-story__feature-desc">{{ section.settings.feature2_desc | default: 'Engineered to be a considered object in a considered space — not an afterthought in a garage.' }}</p>
        </div>
        <div class="sensol-brand-story__feature">
          <h3 class="sensol-brand-story__feature-title">{{ section.settings.feature3_title | default: 'Intelligent Motion' }}</h3>
          <p class="sensol-brand-story__feature-desc">{{ section.settings.feature3_desc | default: 'Precision mechanics that respond in under 8ms — seamless, intuitive, and imperceptible.' }}</p>
        </div>
      </div>
    </div>
    <div class="sensol-brand-story__image">
      <img src="{{ 'section-1.webp' | asset_url }}" alt="SENSOL Brand Story" loading="lazy">
    </div>
  </div>
</section>

{% schema %}
{
  "name": "SENSOL Brand Story",
  "tag": "section",
  "class": "sensol-brand-story-section",
  "settings": [
    {"type":"text","id":"title","label":"Title","default":"Engineered for those who see movement as a craft."},
    {"type":"textarea","id":"body","label":"Body Text","default":"Sensol was founded on a simple conviction: fitness equipment should belong in the same conversation as architecture and design."},
    {"type":"text","id":"feature1_title","label":"Feature 1 Title","default":"Adaptive Resistance"},
    {"type":"text","id":"feature1_desc","label":"Feature 1 Description","default":"Fluid resistance that adapts to your strength curve."},
    {"type":"text","id":"feature2_title","label":"Feature 2 Title","default":"Spatial Design"},
    {"type":"text","id":"feature2_desc","label":"Feature 2 Description","default":"Engineered to be a considered object in a considered space."},
    {"type":"text","id":"feature3_title","label":"Feature 3 Title","default":"Intelligent Motion"},
    {"type":"text","id":"feature3_desc","label":"Feature 3 Description","default":"Precision mechanics that respond in under 8ms."},
    {"type":"image_picker","id":"image","label":"Image (overrides default)"}
  ],
  "presets":[{"name":"SENSOL Brand Story"}]
}
{% endschema %}
