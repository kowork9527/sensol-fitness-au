<section class="sensol-brand" style="background-color: {{ section.settings.bg_color }};">
  <div class="sensol-brand__container">
    <div class="sensol-brand__text">
      {%- if section.settings.label != blank -%}
        <p class="sensol-brand__label">{{ section.settings.label }}</p>
      {%- endif -%}

      {%- if section.settings.heading != blank -%}
        <h2 class="sensol-brand__heading">{{ section.settings.heading }}</h2>
      {%- endif -%}

      {%- if section.settings.description != blank -%}
        <p class="sensol-brand__description">{{ section.settings.description }}</p>
      {%- endif -%}

      <div class="sensol-brand__features">
        {%- for block in section.blocks -%}
          <div class="sensol-brand__feature" {{ block.shopify_attributes }}>
            <h3 class="sensol-brand__feature-title">{{ block.settings.title }}</h3>
            <p class="sensol-brand__feature-desc">{{ block.settings.description }}</p>
          </div>
        {%- endfor -%}
      </div>
    </div>

    <div class="sensol-brand__image">
      {%- if section.settings.image != blank -%}
        {{ section.settings.image | image_url: width: 2000 | image_tag: loading: 'lazy', class: 'sensol-brand__img' }}
      {%- else -%}
        <img src="{{ 'section-1.webp' | asset_url }}" alt="SENSOL" class="sensol-brand__img" loading="lazy">
      {%- endif -%}
    </div>
  </div>
</section>

<style>
  .sensol-brand {
    padding: 100px 5%;
  }
  .sensol-brand__container {
    max-width: 1400px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 80px;
    align-items: center;
  }
  .sensol-brand__label {
    font-size: 10px;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: #8A8279;
    margin-bottom: 1.5rem;
  }
  .sensol-brand__heading {
    font-size: clamp(32px, 4vw, 48px);
    font-weight: 300;
    letter-spacing: 0.1em;
    color: #1A1816;
    margin: 0 0 2rem 0;
    line-height: 1.2;
  }
  .sensol-brand__description {
    font-size: 16px;
    font-weight: 300;
    color: #8A8279;
    line-height: 1.7;
    margin: 0 0 3rem 0;
  }
  .sensol-brand__features {
    display: grid;
    gap: 2rem;
    border-top: 1px solid #D4CEC6;
    padding-top: 2rem;
  }
  .sensol-brand__feature-title {
    font-size: 13px;
    font-weight: 400;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: #1A1816;
    margin: 0 0 0.5rem 0;
  }
  .sensol-brand__feature-desc {
    font-size: 14px;
    color: #8A8279;
    line-height: 1.6;
    margin: 0;
  }
  .sensol-brand__img {
    width: 100%;
    height: auto;
    display: block;
  }
  @media (max-width: 749px) {
    .sensol-brand { padding: 60px 5%; }
    .sensol-brand__container { grid-template-columns: 1fr; gap: 40px; }
  }
</style>

{% schema %}
{
  "name": "SENSOL Brand Story",
  "tag": "section",
  "class": "sensol-brand-section",
  "settings": [
    { "type": "text", "id": "label", "label": "Label", "default": "01 — THE PHILOSOPHY" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Where strength meets precision" },
    { "type": "textarea", "id": "description", "label": "Description", "default": "Founded in 2022, Sensol redefines the role of fitness in modern living. We design intelligent training systems that merge performance, technology, and spatial aesthetics — building a new vision of the future fitness lifestyle." },
    { "type": "image_picker", "id": "image", "label": "Image (leave empty for default)" },
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#F7F4F0" }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature",
      "limit": 6,
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Feature" },
        { "type": "textarea", "id": "description", "label": "Description", "default": "Feature description" }
      ]
    }
  ],
  "presets": [
    {
      "name": "SENSOL Brand Story",
      "blocks": [
        { "type": "feature", "settings": { "title": "ADAPTIVE RESISTANCE", "description": "Intelligent resistance that adapts to your body in real-time, providing the perfect challenge at every level." } },
        { "type": "feature", "settings": { "title": "SPATIAL DESIGN", "description": "Every Sensol is designed as an object of beauty — engineered to belong in your living space, not hidden away." } },
        { "type": "feature", "settings": { "title": "INTELLIGENT MOTION", "description": "Precision sensors and smart guidance ensure every movement is controlled, measured, and purposeful." } }
      ]
    }
  ]
}
{% endschema %}
