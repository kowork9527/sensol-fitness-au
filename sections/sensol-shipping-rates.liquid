<section class="sensol-shipping-rates-section">
  <div class="sensol-shipping-rates">
    <div class="sensol-shipping-rates__grid">
      <div class="sensol-shipping-rates__card">
        <div class="sensol-shipping-rates__icon">&#9992;</div>
        <div class="sensol-shipping-rates__value">Free</div>
        <div class="sensol-shipping-rates__label">Standard Shipping</div>
        <div class="sensol-shipping-rates__note">Australia metro areas</div>
      </div>
      <div class="sensol-shipping-rates__card">
        <div class="sensol-shipping-rates__icon">&#128230;</div>
        <div class="sensol-shipping-rates__value">Calculated</div>
        <div class="sensol-shipping-rates__label">Remote &amp; Regional</div>
        <div class="sensol-shipping-rates__note">Quoted at checkout by postcode</div>
      </div>
      <div class="sensol-shipping-rates__card">
        <div class="sensol-shipping-rates__icon">&#9200;</div>
        <div class="sensol-shipping-rates__value">5&ndash;10</div>
        <div class="sensol-shipping-rates__label">Business Days</div>
        <div class="sensol-shipping-rates__note">Standard delivery window</div>
      </div>
      <div class="sensol-shipping-rates__card">
        <div class="sensol-shipping-rates__icon">&#128274;</div>
        <div class="sensol-shipping-rates__value">Insured</div>
        <div class="sensol-shipping-rates__label">Full Coverage</div>
        <div class="sensol-shipping-rates__note">Every shipment fully insured</div>
      </div>
    </div>
  </div>
</section>

{% schema %}{"name":"SENSOL Shipping Rates","tag":"section","class":"sensol-shipping-rates-section","settings":[],"presets":[{"name":"SENSOL Shipping Rates"}]}{% endschema %}

{%- style -%}
.sensol-shipping-rates-section{margin:0;padding:0;background:#F7F4F0}
.sensol-shipping-rates-section .sensol-shipping-rates{max-width:1040px;margin:0 auto;padding:100px 2rem 0;font-family:'Inter',sans-serif}
.sensol-shipping-rates-section .sensol-shipping-rates__grid{display:grid;grid-template-columns:repeat(4,1fr);gap:1px;background:#D4CEC6}
.sensol-shipping-rates-section .sensol-shipping-rates__card{background:#F7F4F0;padding:3.5rem 2rem;text-align:center}
.sensol-shipping-rates-section .sensol-shipping-rates__icon{font-size:1.5rem;margin-bottom:1rem;opacity:0.5;display:block}
.sensol-shipping-rates-section .sensol-shipping-rates__value{font-size:clamp(2rem,4vw,2.75rem);font-weight:400;letter-spacing:-0.03em;line-height:1;margin-bottom:0.75rem;color:#1A1816;display:block}
.sensol-shipping-rates-section .sensol-shipping-rates__label{font-size:1.125rem;font-weight:500;letter-spacing:0.1em;text-transform:uppercase;color:#8A8279;display:block;line-height:1.4}
.sensol-shipping-rates-section .sensol-shipping-rates__note{font-size:1rem;color:#8A8279;margin-top:0.75rem;font-weight:500;display:block}
@media(max-width:768px){.sensol-shipping-rates-section .sensol-shipping-rates__grid{grid-template-columns:repeat(2,1fr)}.sensol-shipping-rates-section .sensol-shipping-rates__card{padding:2.5rem 1.5rem}}
@media(max-width:480px){.sensol-shipping-rates-section .sensol-shipping-rates__grid{grid-template-columns:1fr}.sensol-shipping-rates-section .sensol-shipping-rates__card{padding:2.25rem 1.5rem}}
@media(max-width:749px){.sensol-shipping-rates-section .sensol-shipping-rates{padding:64px 1.5rem 0}}
{%- endstyle -%}
