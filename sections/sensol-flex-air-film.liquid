{% assign flex_product = section.settings.product %}
{% if flex_product == blank %}{% assign flex_product = all_products['sensol-flex-air'] %}{% endif %}
{% assign flex_url = flex_product.url | default: '/products/sensol-flex-air' %}
<section class="air-story" id="air-story-{{ section.id }}">
  <div class="air-scroll">
    <div class="air-scene">
      <div class="air-topline"><span>SENSOL / FLEX AIR</span><a href="{{ flex_url }}">Explore FLEX AIR ↗</a></div>
      <div class="air-heading"><p class="air-kicker">PILATES · CONTINUED</p><h1>{{ section.settings.heading | escape }}</h1><p class="air-lead">{{ section.settings.description | escape }}</p></div>
      <div class="air-film"><video playsinline muted preload="metadata" poster="{{ 'https://raw.githubusercontent.com/kowork9527/sensol-fitness-au/e07ff1d9a26b92f8026d468557872b1f2e1c14d2/images/flex-air-0-f8bbc1ee.webp' }}" aria-label="FLEX AIR demonstration: placing the equipment, adjusting it, sliding and stretching"><source src="{{ 'flex-air-story.mp4' | asset_url }}" type="video/mp4"></video><div class="air-loading" role="status">Preparing your practice…</div></div>
      <div class="air-narrative" aria-live="polite"><span class="air-chapter-number">01 / 05</span><h2>Make room for movement.</h2><p>Place your FLEX AIR. Take a moment. Begin your practice.</p></div>
      <div class="air-bottom"><div class="air-progress"><div></div></div><div class="air-controls"><span class="air-scroll-hint">Scroll to follow the movement ↓</span><button type="button" class="air-play">Play the full film ▶</button></div>
      <nav class="air-chapters" aria-label="Film chapters"><button type="button" data-time="0" aria-current="step">Prepare</button><button type="button" data-time="6">Move</button><button type="button" data-time="22">Connect</button><button type="button" data-time="44">Open</button><button type="button" data-time="54">Continue</button></nav></div>
    </div>
  </div>
  <div class="air-ending"><p class="air-kicker">MAKE IT EASY. DO IT REAL.</p><h2>Your class ends.<br>Your practice continues.</h2><p>For the Pilates movements you have learned, and the time you make to practise them. Meet FLEX AIR.</p><div class="air-ending-links"><a class="air-cta" href="{{ flex_url }}">{{ section.settings.button_label | escape }} ↗</a>{% if flex_product != blank %}<span>{{ flex_product.price | money_with_currency }}</span>{% endif %}</div></div>
</section>
<style>
#air-story-{{ section.id }}{--paper:#f7f4f0;--ink:#1a1816;--muted:#766e65;background:var(--paper);color:var(--ink);font-family:inherit}
.air-story *{box-sizing:border-box}.air-story h1,.air-story h2,.air-story p{margin:0}.air-scroll{height:550vh;position:relative}.air-scene{height:calc(100svh - 80px);min-height:650px;position:sticky;top:80px;overflow:hidden;padding:24px 5vw 20px;background:var(--paper);display:flex;flex-direction:column}.air-topline{display:flex;justify-content:space-between;align-items:center;font-size:10px;letter-spacing:.12em;z-index:3}.air-topline a{color:var(--ink);text-decoration:none;letter-spacing:0}.air-heading{position:absolute;top:75px;left:5vw;z-index:2;pointer-events:none}.air-kicker{font-size:10px;letter-spacing:.2em;margin-bottom:20px!important}.air-heading h1{font-size:clamp(40px,4.8vw,76px);font-weight:300;letter-spacing:-.055em;line-height:1.05;max-width:580px}.air-lead{max-width:330px;font-size:13px;line-height:1.7;color:var(--muted);margin-top:18px!important}.air-film{position:absolute;inset:240px 0 140px;display:flex;justify-content:center;align-items:center}.air-film video{width:100%;height:100%;object-fit:contain;mix-blend-mode:multiply}.air-loading{position:absolute;bottom:10px;font-size:11px;color:var(--muted);background:var(--paper);padding:8px}.air-narrative{position:absolute;right:5vw;bottom:150px;width:290px;z-index:2;padding:18px;background:#f7f4f0ee;border-left:1px solid #c7bcae}.air-chapter-number{font-size:10px;letter-spacing:.15em;color:var(--muted)}.air-narrative h2{font-size:23px;letter-spacing:-.035em;line-height:1.15;margin-top:12px}.air-narrative p{font-size:12px;line-height:1.7;color:var(--muted);margin-top:10px}.air-bottom{margin-top:auto;z-index:3}.air-progress{height:2px;background:#d9d1c7}.air-progress>div{height:100%;width:0;background:var(--ink)}.air-controls{display:flex;justify-content:space-between;align-items:center;gap:15px;margin-top:12px;font-size:10px;color:var(--muted)}.air-play{font:inherit;border:0;border-bottom:1px solid #aaa094;padding:8px;background:transparent;color:var(--ink);cursor:pointer}.air-chapters{display:flex;gap:30px;margin-top:16px}.air-chapters button{font:inherit;font-size:10px;letter-spacing:.07em;padding:6px 0;background:transparent;border:0;border-bottom:1px solid transparent;color:var(--muted);cursor:pointer}.air-chapters button[aria-current="step"]{color:var(--ink);border-color:var(--ink)}.air-ending{padding:100px 8vw 110px;background:var(--ink);color:var(--paper)}.air-ending h2{font-size:clamp(40px,5.5vw,78px);font-weight:300;letter-spacing:-.05em;line-height:1.07}.air-ending>p:not(.air-kicker){max-width:450px;font-size:15px;line-height:1.8;margin-top:28px;color:#c8c0b7}.air-ending-links{display:flex;align-items:center;flex-wrap:wrap;gap:30px;margin-top:32px;font-size:14px}.air-cta{display:inline-block;padding:18px 26px;background:var(--paper);color:var(--ink);text-decoration:none;font-size:13px}.air-story a:focus-visible,.air-story button:focus-visible{outline:2px solid #8a8279;outline-offset:4px}.air-story.air-playing .air-scroll{height:auto}.air-story.air-playing .air-scene{position:relative;top:0}.air-story.air-playing video{mix-blend-mode:normal}.air-story.air-playing .air-heading{opacity:0}.air-story.air-playing .air-narrative{display:none}
@media(max-width:749px){.air-scroll{height:400vh}.air-scene{top:60px;height:calc(100svh - 60px);min-height:600px;padding:20px 6vw}.air-topline{font-size:8px}.air-heading{top:65px;left:6vw}.air-heading h1{font-size:43px;max-width:330px}.air-lead{font-size:12px;max-width:280px;margin-top:12px!important}.air-film{inset:210px -4vw 190px}.air-film video{object-fit:contain}.air-narrative{left:6vw;right:6vw;bottom:125px;width:auto;padding:12px 14px}.air-narrative h2{font-size:20px;margin-top:6px}.air-narrative p{font-size:11px;margin-top:6px}.air-chapters{justify-content:space-between;gap:10px}.air-ending{padding:65px 6vw}.air-story.air-playing .air-film{inset:50px 0 140px}}
@media(prefers-reduced-motion:reduce){.air-scroll{height:auto}.air-scene{position:relative;top:0}.air-scroll-hint{display:none}}
</style>
<script>
(()=>{const root=document.getElementById('air-story-{{ section.id }}');if(!root||root.dataset.ready)return;root.dataset.ready='1';
const video=root.querySelector('video'),wrap=root.querySelector('.air-scroll'),scene=root.querySelector('.air-scene'),progress=root.querySelector('.air-progress>div'),loading=root.querySelector('.air-loading'),play=root.querySelector('.air-play'),hint=root.querySelector('.air-scroll-hint');
const chapters=[{t:0,title:'Make room for movement.',copy:'Place your FLEX AIR. Take a moment. Begin your practice.'},{t:6,title:'Move with intention.',copy:'Watch the carriage travel as the movement unfolds. Support, slide and return.'},{t:22,title:'Connect to the resistance.',copy:'A closer look at the resistance setup, followed by movement with the equipment.'},{t:44,title:'Open into the movement.',copy:'From standing positions to seated stretches. Give each movement its own space.'},{t:54,title:'Keep your practice going.',copy:'A final stretch. A moment to finish. Make room for your next practice.'}];
let free=false,raf=0,current=-1,target=0,seeking=false,disposed=false;const reduced=matchMedia('(prefers-reduced-motion: reduce)').matches;
const updateText=t=>{let idx=0;chapters.forEach((c,i)=>{if(t+.15>=c.t)idx=i;});if(idx===current)return;current=idx;root.querySelector('.air-chapter-number').textContent=String(idx+1).padStart(2,'0')+' / 05';root.querySelector('.air-narrative h2').textContent=chapters[idx].title;root.querySelector('.air-narrative p').textContent=chapters[idx].copy;root.querySelectorAll('.air-chapters button').forEach((b,i)=>{if(i===idx)b.setAttribute('aria-current','step');else b.removeAttribute('aria-current');});};
const seek=()=>{if(free||reduced||seeking||!Number.isFinite(video.duration)||video.readyState<2)return;if(Math.abs(video.currentTime-target)>.08){seeking=true;video.currentTime=target;}};
const render=()=>{raf=0;if(disposed||free||reduced)return;const range=Math.max(1,wrap.offsetHeight-scene.offsetHeight),top=parseFloat(getComputedStyle(scene).top)||0;const ratio=Math.max(0,Math.min(1,(top-wrap.getBoundingClientRect().top)/range));target=ratio*Math.max(0,(video.duration||60.9)-.05);progress.style.width=ratio*100+'%';updateText(target);root.querySelector('.air-heading').style.opacity=String(Math.max(0,1-target/5));seek();};
const scroll=()=>{if(!raf)raf=requestAnimationFrame(render);};window.addEventListener('scroll',scroll,{passive:true});window.addEventListener('resize',scroll);
video.addEventListener('loadeddata',()=>{loading.hidden=true;if(!reduced)scroll();});video.addEventListener('seeked',()=>{seeking=false;seek();});video.addEventListener('error',()=>{loading.textContent='The film could not load. You can still explore FLEX AIR below.';play.disabled=true;});video.addEventListener('timeupdate',()=>{if(free){updateText(video.currentTime);progress.style.width=(video.currentTime/video.duration*100)+'%';}});
play.addEventListener('click',async()=>{free=!free;root.classList.toggle('air-playing',free);video.controls=free||reduced;play.textContent=free?'Return to the scroll story ↓':'Play the full film ▶';hint.textContent=free?'Watch at your own pace':'Scroll to follow the movement ↓';if(free){video.currentTime=0;try{await video.play();}catch(e){video.controls=true;}}else{video.pause();scroll();}});
root.querySelectorAll('.air-chapters button').forEach(b=>b.addEventListener('click',()=>{const t=Number(b.dataset.time);if(free||reduced){video.currentTime=t;updateText(t);}else{const top=parseFloat(getComputedStyle(scene).top)||0;const range=wrap.offsetHeight-scene.offsetHeight;window.scrollTo({top:window.scrollY+wrap.getBoundingClientRect().top-top+t/(video.duration||60.9)*range,behavior:'auto'});scroll();}}));
if(reduced){video.controls=true;play.textContent='Play the full film ▶';}
document.addEventListener('shopify:section:unload',e=>{if(e.detail.sectionId==='{{ section.id }}'){disposed=true;window.removeEventListener('scroll',scroll);window.removeEventListener('resize',scroll);cancelAnimationFrame(raf);video.pause();}});
})();
</script>
{% schema %}
{"name":"FLEX AIR film story","settings":[{"type":"product","id":"product","label":"Featured product"},{"type":"text","id":"heading","label":"Story heading","default":"Your practice continues."},{"type":"textarea","id":"description","label":"Introduction","default":"The movement you learn. The practice you make your own. Meet FLEX AIR."},{"type":"text","id":"button_label","label":"Product button","default":"Explore FLEX AIR"}],"presets":[{"name":"FLEX AIR film story"}]}
{% endschema %}