<section class="sensol-hero" style="background-color: {{ section.settings.bg_color }};">
  <div class="sensol-hero__slider" id="sensol-hero-slider">
    {%- for block in section.blocks -%}
      <div class="sensol-hero__slide{% if forloop.first %} sensol-hero__slide--active{% endif %}" {{ block.shopify_attributes }}>
        <div class="sensol-hero__media">
          {%- if block.settings.image != blank -%}
            {{ block.settings.image | image_url: width: 3840 | image_tag: loading: 'eager', fetchpriority: 'high', class: 'sensol-hero__image' }}
          {%- else -%}
            <div class="sensol-hero__placeholder">
              <span>Upload banner image</span>
            </div>
          {%- endif -%}
        </div>
      </div>
    {%- endfor -%}
  </div>

  <div class="sensol-hero__overlay" style="background: {{ section.settings.overlay_color }};"></div>

  <div class="sensol-hero__content">
    {%- if section.settings.label != blank -%}
      <p class="sensol-hero__label">{{ section.settings.label }}</p>
    {%- endif -%}

    {%- if section.settings.heading != blank -%}
      <h1 class="sensol-hero__heading">{{ section.settings.heading }}</h1>
    {%- endif -%}

    {%- if section.settings.subheading != blank -%}
      <p class="sensol-hero__subheading">{{ section.settings.subheading }}</p>
    {%- endif -%}

    {%- if section.settings.button_label != blank -%}
      <a href="{{ section.settings.button_link }}" class="sensol-hero__button" style="background-color: {{ section.settings.button_bg_color }}; color: {{ section.settings.button_text_color }};">
        {{ section.settings.button_label }}
      </a>
    {%- endif -%}

    {%- if section.blocks.size > 1 -%}
      <div class="sensol-hero__dots">
        {%- for block in section.blocks -%}
          <button class="sensol-hero__dot{% if forloop.first %} sensol-hero__dot--active{% endif %}" data-index="{{ forloop.index0 }}" aria-label="Slide {{ forloop.index }}"></button>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>

<script>
  (function(){
    var slides = document.querySelectorAll('.sensol-hero__slide');
    var dots = document.querySelectorAll('.sensol-hero__dot');
    var current = 0;
    var total = slides.length;
    if (total <= 1) return;

    function goTo(idx) {
      slides[current].classList.remove('sensol-hero__slide--active');
      dots[current].classList.remove('sensol-hero__dot--active');
      current = idx;
      slides[current].classList.add('sensol-hero__slide--active');
      dots[current].classList.add('sensol-hero__dot--active');
    }

    dots.forEach(function(dot) {
      dot.addEventListener('click', function() {
        goTo(parseInt(this.dataset.index));
      });
    });

    setInterval(function() {
      goTo((current + 1) % total);
    }, 6000);
  })();
</script>

<style>
  .sensol-hero {
    position: relative;
    width: 100%;
    height: 100vh;
    overflow: hidden;
  }
  .sensol-hero__slider {
    position: absolute;
    inset: 0;
  }
  .sensol-hero__slide {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 1.2s ease;
  }
  .sensol-hero__slide--active {
    opacity: 1;
  }
  .sensol-hero__media {
    width: 100%;
    height: 100%;
  }
  .sensol-hero__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }
  .sensol-hero__placeholder {
    width: 100%;
    height: 100%;
    background: linear-gradient(135deg, #1A1816 0%, #3a3632 100%);
    display: flex;
    align-items: center;
    justify-content: center;
    color: #8A8279;
    font-family: 'Inter', sans-serif;
    font-size: 14px;
    letter-spacing: 0.15em;
    text-transform: uppercase;
  }
  .sensol-hero__overlay {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }
  .sensol-hero__content {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    color: #F7F4F0;
    padding: 0 24px;
    z-index: 2;
  }
  .sensol-hero__label {
    font-family: 'Inter', sans-serif;
    font-size: 12px;
    font-weight: 300;
    letter-spacing: 0.25em;
    text-transform: uppercase;
    margin-bottom: 20px;
    opacity: 0.8;
  }
  .sensol-hero__heading {
    font-family: 'Inter', sans-serif;
    font-size: clamp(48px, 10vw, 96px);
    font-weight: 200;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    margin-bottom: 24px;
    line-height: 1;
  }
  .sensol-hero__subheading {
    font-family: 'Inter', sans-serif;
    font-size: clamp(14px, 2vw, 18px);
    font-weight: 300;
    letter-spacing: 0.05em;
    max-width: 600px;
    margin-bottom: 40px;
    opacity: 0.9;
    line-height: 1.7;
  }
  .sensol-hero__button {
    display: inline-block;
    padding: 16px 48px;
    font-family: 'Inter', sans-serif;
    font-size: 12px;
    font-weight: 400;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    text-decoration: none;
    transition: opacity 0.3s ease;
  }
  .sensol-hero__button:hover {
    opacity: 0.85;
  }
  .sensol-hero__dots {
    display: flex;
    gap: 12px;
    margin-top: 40px;
  }
  .sensol-hero__dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    border: 1px solid #F7F4F0;
    background: transparent;
    cursor: pointer;
    padding: 0;
    transition: background 0.3s ease;
  }
  .sensol-hero__dot--active {
    background: #F7F4F0;
  }

  @media (max-width: 768px) {
    .sensol-hero {
      height: 100svh;
    }
    .sensol-hero__heading {
      font-size: clamp(36px, 12vw, 56px);
    }
  }
</style>

{% schema %}
{
  "name": "SENSOL Hero",
  "tag": "section",
  "class": "sensol-hero-section",
  "settings": [
    {
      "type": "text",
      "id": "label",
      "label": "Label",
      "default": "A NEW LANGUAGE OF TRAINING"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "SENSOL"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Where strength meets precision, and movement becomes design."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button Label",
      "default": "SHOP ALL"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#1A1816"
    },
    {
      "type": "color",
      "id": "overlay_color",
      "label": "Overlay Color",
      "default": "rgba(26, 24, 22, 0.35)"
    },
    {
      "type": "color",
      "id": "button_bg_color",
      "label": "Button Background",
      "default": "#F7F4F0"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button Text Color",
      "default": "#1A1816"
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Banner Slide",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Banner Image"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "SENSOL Hero",
      "blocks": [
        { "type": "slide" },
        { "type": "slide" },
        { "type": "slide" }
      ]
    }
  ]
}
{% endschema %}
