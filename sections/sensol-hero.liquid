{{ 'section-sensol-hero.css' | asset_url | stylesheet_tag }}

{%- assign slide_count = 0 -%}
{%- for block in section.blocks -%}
  {%- if block.type == 'slide' -%}
    {%- assign slide_count = slide_count | plus: 1 -%}
  {%- endif -%}
{%- endfor -%}

<section class="sensol-hero" id="sensol-hero-{{ section.id }}" data-slide-count="{{ slide_count }}">
  
  {%- comment -%} Slides {%- endcomment -%}
  <div class="sensol-hero__slides">
    {%- for block in section.blocks -%}
      {%- if block.type == 'slide' -%}
        <div class="sensol-hero__slide {% if forloop.first %}active{% endif %}" {{ block.shopify_attributes }}>
          {%- if block.settings.image != blank -%}
            <img src="{{ block.settings.image | image_url: width: 3840 }}" 
                 alt="{{ block.settings.image.alt | escape }}" 
                 loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"
                 fetchpriority="{% if forloop.first %}high{% endif %}"
                 class="sensol-hero__image"
                 width="{{ block.settings.image.width }}"
                 height="{{ block.settings.image.height }}">
          {%- else -%}
            <div class="sensol-hero__placeholder">
              <span>Click "Add slide" and upload a banner image</span>
            </div>
          {%- endif -%}
        </div>
      {%- endif -%}
    {%- endfor -%}
  </div>

  {%- comment -%} Only show overlay and text if there are slides {%- endcomment -%}
  <div class="sensol-hero__overlay" style="background: {{ section.settings.overlay_color }};"></div>
  
  <div class="sensol-hero__content">
    {%- if section.settings.label != blank -%}
      <span class="sensol-hero__label">{{ section.settings.label }}</span>
    {%- endif -%}
    {%- if section.settings.heading != blank -%}
      <h1 class="sensol-hero__heading">{{ section.settings.heading }}</h1>
    {%- endif -%}
    {%- if section.settings.subheading != blank -%}
      <p class="sensol-hero__subheading">{{ section.settings.subheading }}</p>
    {%- endif -%}
    {%- if section.settings.button_label != blank -%}
      <a href="{{ section.settings.button_link }}" class="sensol-hero__button">
        {{ section.settings.button_label }}
      </a>
    {%- endif -%}
  </div>

  {%- if slide_count > 1 -%}
    <div class="sensol-hero__dots">
      {%- for block in section.blocks -%}
        {%- if block.type == 'slide' -%}
          <button class="sensol-hero__dot {% if forloop.first %}active{% endif %}" data-index="{{ forloop.index0 }}" aria-label="Slide {{ forloop.index }}"></button>
        {%- endif -%}
      {%- endfor -%}
    </div>
  {%- endif -%}
</section>

<style>
  .sensol-hero {
    position: relative;
    min-height: 100vh;
    overflow: hidden;
    background: #1A1816;
  }

  .sensol-hero__slides {
    position: absolute;
    inset: 0;
  }

  .sensol-hero__slide {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 1s ease;
  }

  .sensol-hero__slide.active {
    opacity: 1;
  }

  .sensol-hero__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .sensol-hero__placeholder {
    width: 100%;
    height: 100%;
    background: linear-gradient(135deg, #1A1816 0%, #3a3632 100%);
    display: flex;
    align-items: center;
    justify-content: center;
    color: #8A8279;
    font-size: 14px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .sensol-hero__overlay {
    position: absolute;
    inset: 0;
    z-index: 1;
  }

  .sensol-hero__content {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    min-height: 100vh;
    text-align: center;
    padding: 0 24px;
    color: #F7F4F0;
  }

  .sensol-hero__label {
    font-size: 12px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    opacity: 0.8;
    margin-bottom: 24px;
  }

  .sensol-hero__heading {
    font-size: clamp(48px, 10vw, 120px);
    font-weight: 200;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    margin: 0 0 24px;
    line-height: 1;
  }

  .sensol-hero__subheading {
    font-size: clamp(14px, 2vw, 18px);
    font-weight: 300;
    letter-spacing: 0.05em;
    opacity: 0.85;
    max-width: 540px;
    margin: 0 auto 40px;
    line-height: 1.7;
  }

  .sensol-hero__button {
    display: inline-block;
    padding: 14px 40px;
    background: #F7F4F0;
    color: #1A1816;
    text-decoration: none;
    font-size: 12px;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    font-weight: 500;
    transition: opacity 0.3s ease;
  }

  .sensol-hero__button:hover {
    opacity: 0.85;
  }

  .sensol-hero__dots {
    position: absolute;
    bottom: 32px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 3;
    display: flex;
    gap: 8px;
  }

  .sensol-hero__dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    border: 1px solid #F7F4F0;
    background: transparent;
    cursor: pointer;
    padding: 0;
    transition: background 0.3s ease;
  }

  .sensol-hero__dot.active {
    background: #F7F4F0;
  }

  @media (max-width: 768px) {
    .sensol-hero__content {
      padding: 0 20px;
    }
    .sensol-hero__button {
      padding: 12px 32px;
    }
  }
</style>

<script>
  (function() {
    var section = document.getElementById('sensol-hero-{{ section.id }}');
    if (!section) return;
    var slides = section.querySelectorAll('.sensol-hero__slide');
    var dots = section.querySelectorAll('.sensol-hero__dot');
    var current = 0;
    var count = parseInt(section.dataset.slideCount) || 0;
    if (count <= 1) return;

    function goTo(index) {
      slides[current].classList.remove('active');
      if (dots[current]) dots[current].classList.remove('active');
      current = index;
      slides[current].classList.add('active');
      if (dots[current]) dots[current].classList.add('active');
    }

    dots.forEach(function(dot, i) {
      dot.addEventListener('click', function() { goTo(i); });
    });

    setInterval(function() {
      goTo((current + 1) % count);
    }, 6000);
  })();
</script>

{% schema %}
{
  "name": "SENSOL Hero",
  "tag": "section",
  "class": "sensol-hero-section",
  "settings": [
    {
      "type": "text",
      "id": "label",
      "label": "Label",
      "default": "A NEW LANGUAGE OF TRAINING"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "SENSOL"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Where strength meets precision, and movement becomes design."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "SHOP ALL"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "color",
      "id": "overlay_color",
      "label": "Overlay color",
      "default": "rgba(26, 24, 22, 0.35)"
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Banner Slide",
      "limit": 5,
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Banner image"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "SENSOL Hero",
      "blocks": [
        { "type": "slide" },
        { "type": "slide" },
        { "type": "slide" }
      ]
    }
  ]
}
{% endschema %}
