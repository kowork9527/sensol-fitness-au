{{ 'sensol-hero.css' | asset_url | stylesheet_tag }}

{%- assign banners = 'banner-1,banner-2,banner-3' | split: ',' -%}
{%- assign headings = 'A NEW LANGUAGE OF TRAINING,WHERE STRENGTH MEETS PILATES,THE FUTURE OF MODERN TRAINING' | split: ',' -%}
{%- assign subtexts = 'Where strength meets precision, and movement becomes design.,Precision. Control. Redefined.,Smart training for the modern space.' | split: ',' -%}

<section class="sensol-hero" id="sensol-hero">
  <div class="sensol-hero__slider">
    {%- for i in (0..2) -%}
    <div class="sensol-hero__slide{% if forloop.first %} sensol-hero__slide--active{% endif %}" data-slide="{{ forloop.index0 }}">
      <img src="{{ banners[forloop.index0] | append: '.webp' | asset_url }}" alt="{{ headings[forloop.index0] | strip }}" class="sensol-hero__image" loading="{% if forloop.first %}eager{% else %}lazy{% endif %}">
      <div class="sensol-hero__overlay"></div>
      <div class="sensol-hero__content">
        <p class="sensol-hero__label">{{ section.settings.label | default: headings[forloop.index0] | strip }}</p>
        <h1 class="sensol-hero__title">{{ section.settings.heading | default: 'SENSOL' }}</h1>
        <p class="sensol-hero__subtitle">{{ section.settings.subtitle | default: subtexts[forloop.index0] | strip }}</p>
        <a href="{{ section.settings.button_link | default: '/collections/all' }}" class="sensol-hero__btn">{{ section.settings.button_text | default: 'SHOP ALL' }}</a>
      </div>
    </div>
    {%- endfor -%}
  </div>
  <div class="sensol-hero__dots">
    <button class="sensol-hero__dot sensol-hero__dot--active" data-dot="0"></button>
    <button class="sensol-hero__dot" data-dot="1"></button>
    <button class="sensol-hero__dot" data-dot="2"></button>
  </div>
</section>

<script>
(function(){
  const slides=document.querySelectorAll('.sensol-hero__slide');
  const dots=document.querySelectorAll('.sensol-hero__dot');
  let current=0,interval;
  function go(n){
    slides[current].classList.remove('sensol-hero__slide--active');
    dots[current].classList.remove('sensol-hero__dot--active');
    current=n;
    slides[current].classList.add('sensol-hero__slide--active');
    dots[current].classList.add('sensol-hero__dot--active');
  }
  function next(){go((current+1)%slides.length)}
  function start(){interval=setInterval(next,6000)}
  function stop(){clearInterval(interval)}
  dots.forEach(d=>d.addEventListener('click',()=>{stop();go(+d.dataset.dot);start()}));
  start();
})();
</script>

{% schema %}
{
  "name": "SENSOL Hero",
  "tag": "section",
  "class": "sensol-hero-section",
  "settings": [
    {"type":"text","id":"label","label":"Label","default":"A NEW LANGUAGE OF TRAINING"},
    {"type":"text","id":"heading","label":"Heading","default":"SENSOL"},
    {"type":"text","id":"subtitle","label":"Subtitle","default":"Where strength meets precision, and movement becomes design."},
    {"type":"text","id":"button_text","label":"Button Text","default":"SHOP ALL"},
    {"type":"url","id":"button_link","label":"Button Link"}
  ],
  "presets":[{"name":"SENSOL Hero"}]
}
{% endschema %}
