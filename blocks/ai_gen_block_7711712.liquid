  "name": "AI agent hero",
  "settings": [
    { "type": "header", "content": "Background video" },
    { "type": "text", "id": "video_url", "label": "MP4 video URL", "default": "https://d8j0ent1cm9l24.cloudfront.net/user_38xz2xbkVGw3otWXHDIWA1P/hf_20260903_113714_92f54685-af66-4020-8f35-dbb8871d9d32.mp4" },
    { "type": "range", "id": "overlay_opacity", "label": "Dark overlay", "min": 0, "max": 90, "step": 5, "unit": "%", "default": 35 },
    { "type": "header", "content": "Brand and navigation" },
    { "type": "text", "id": "brand_name", "label": "Brand name", "default": "AGENT" },
    { "type": "url", "id": "brand_link", "label": "Brand link" },
    { "type": "url", "id": "benefits_link", "label": "Benefits link" },
    { "type": "url", "id": "about_link", "label": "About link" },
    { "type": "url", "id": "support_link", "label": "Support link" },
    { "type": "url", "id": "faq_link", "label": "FAQ link" },
    { "type": "checkbox", "id": "hide_theme_header", "label": "Hide theme header and footer", "default": false },
    { "type": "header", "content": "Hero content" },
    { "type": "text", "id": "title_line_one", "label": "Title line one", "default": "The agent that thinks," },
    { "type": "text", "id": "title_line_two", "label": "Title line two", "default": "decides, and executes." },
    { "type": "textarea", "id": "description", "label": "Description", "default": "Delegate your entire workflow to an AI that runs 24/7 — you set the goal, it handles everything else." },
    { "type": "text", "id": "cta_label", "label": "Button label", "default": "Deploy your agent" },
    { "type": "url", "id": "cta_link", "label": "Button link" },
    { "type": "text", "id": "note", "label": "Button note", "default": "Free to start · Live in 5 minutes" },
    { "type": "header", "content": "Trust wordmarks" },
    { "type": "text", "id": "wordmark_one", "label": "Wordmark one", "default": "NORTHSTAR" },
    { "type": "text", "id": "wordmark_two", "label": "Wordmark two", "default": "KINETIC" },
    { "type": "text", "id": "wordmark_three", "label": "Wordmark three", "default": "OTHERWISE" },
    { "type": "text", "id": "wordmark_four", "label": "Wordmark four", "default": "FORM / FIELD" },
    { "type": "header", "content": "Typography and layout" },
    { "type": "font_picker", "id": "body_font", "label": "Body font", "default": "assistant_n4" },
    { "type": "font_picker", "id": "heading_font", "label": "Heading font", "default": "assistant_n4" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#FFFFFF" },
    { "type": "color", "id": "button_background", "label": "Button background", "default": "#FFFFFF" },
    { "type": "color", "id": "button_text", "label": "Button text", "default": "#111111" },
    { "type": "color", "id": "button_border", "label": "Button border", "default": "#FFFFFF" },
    { "type": "checkbox", "id": "enable_entrance", "label": "Enable entrance effects", "default": true },
    { "type": "range", "id": "desktop_width_percent", "label": "Desktop width", "min": 50, "max": 100, "step": 5, "unit": "%", "default": 100 }
  ],
  "presets": [{ "name": "AI agent hero" }],
  "tag": null,
  "class": "ai-agent-hero-block"
}
{% endschema %}