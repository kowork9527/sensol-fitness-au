<section class="sensol-marquee" style="background-color: {{ section.settings.bg_color }};">
  <div class="sensol-marquee__track">
    <div class="sensol-marquee__content">
      {%- assign text = section.settings.text | default: 'Make it easy · Do it real' -%}
      <span class="sensol-marquee__text">{{ text }}</span>
      <span class="sensol-marquee__text">{{ text }}</span>
      <span class="sensol-marquee__text">{{ text }}</span>
      <span class="sensol-marquee__text">{{ text }}</span>
    </div>
  </div>
</section>

<style>
  .sensol-marquee {
    padding: 24px 0;
    overflow: hidden;
    white-space: nowrap;
  }
  
  .sensol-marquee__track {
    display: flex;
    animation: sensol-marquee-scroll 30s linear infinite;
  }
  
  .sensol-marquee__content {
    display: flex;
    flex-shrink: 0;
  }
  
  .sensol-marquee__text {
    font-size: 14px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: {{ section.settings.text_color }};
    font-weight: 300;
    padding: 0 2rem;
    flex-shrink: 0;
  }
  
  @keyframes sensol-marquee-scroll {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-50%);
    }
  }
</style>

{% schema %}
{
  "name": "SENSOl Marquee",
  "tag": "section",
  "class": "sensol-marquee-wrapper",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "背景色",
      "default": "#F7F4F0"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "文字颜色",
      "default": "#1A1816"
    },
    {
      "type": "text",
      "id": "text",
      "label": "滚动文字",
      "default": "Make it easy · Do it real"
    }
  ],
  "presets": [
    {
      "name": "SENSOl Marquee"
    }
  ]
}
{% endschema %}
