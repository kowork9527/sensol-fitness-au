<section class="sensol-hero" style="background-color: {{ section.settings.bg_color }};">
  <div class="sensol-hero__media">
    {%- if section.settings.image != blank -%}
      {{ section.settings.image | image_url: width: 3840 | image_tag: width: section.settings.image.width, height: section.settings.image.height, alt: section.settings.image.alt, class: 'sensol-hero__image', loading: 'eager', fetchpriority: 'high' }}
    {%- else -%}
      {{ 'hero-apparel-1' | placeholder_svg_tag: 'sensol-hero__image' }}
    {%- endif -%}
  </div>
  
  <div class="sensol-hero__overlay" style="background: {{ section.settings.overlay_color }};"></div>
  
  <div class="sensol-hero__content">
    {%- if section.settings.label != blank -%}
      <p class="sensol-hero__label">{{ section.settings.label }}</p>
    {%- endif -%}
    
    {%- if section.settings.heading != blank -%}
      <h1 class="sensol-hero__heading">{{ section.settings.heading }}</h1>
    {%- endif -%}
    
    {%- if section.settings.subheading != blank -%}
      <p class="sensol-hero__subheading">{{ section.settings.subheading }}</p>
    {%- endif -%}
    
    {%- if section.settings.button_label != blank -%}
      <a href="{{ section.settings.button_link }}" class="sensol-hero__button" style="background-color: {{ section.settings.button_bg_color }}; color: {{ section.settings.button_text_color }};">
        {{ section.settings.button_label }}
      </a>
    {%- endif -%}
  </div>
</section>

<style>
  .sensol-hero {
    position: relative;
    width: 100%;
    height: 100vh;
    min-height: 600px;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  
  .sensol-hero__media {
    position: absolute;
    inset: 0;
    z-index: 0;
  }
  
  .sensol-hero__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  
  .sensol-hero__overlay {
    position: absolute;
    inset: 0;
    z-index: 1;
  }
  
  .sensol-hero__content {
    position: relative;
    z-index: 2;
    text-align: center;
    padding: 0 2rem;
    max-width: 900px;
  }
  
  .sensol-hero__label {
    font-size: 10px;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: rgba(247, 244, 240, 0.6);
    margin-bottom: 1.5rem;
    font-weight: 400;
  }
  
  .sensol-hero__heading {
    font-size: clamp(48px, 8vw, 96px);
    font-weight: 200;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: #F7F4F0;
    margin: 0 0 1.5rem 0;
    line-height: 1.1;
  }
  
  .sensol-hero__subheading {
    font-size: 16px;
    font-weight: 300;
    color: rgba(247, 244, 240, 0.7);
    margin: 0 0 2.5rem 0;
    line-height: 1.6;
    letter-spacing: 0.02em;
  }
  
  .sensol-hero__button {
    display: inline-block;
    padding: 14px 36px;
    font-size: 11px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    text-decoration: none;
    border: none;
    cursor: pointer;
    transition: opacity 0.3s ease;
  }
  
  .sensol-hero__button:hover {
    opacity: 0.8;
  }
  
  @media (max-width: 749px) {
    .sensol-hero {
      min-height: 500px;
    }
    
    .sensol-hero__content {
      padding: 0 1.5rem;
    }
  }
</style>

{% schema %}
{
  "name": "SENSOl Hero",
  "tag": "section",
  "class": "sensol-hero-wrapper",
  "settings": [
    {
      "type": "header",
      "content": "背景图片"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "图片"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "背景色",
      "default": "#1A1816"
    },
    {
      "type": "color",
      "id": "overlay_color",
      "label": "遮罩颜色",
      "default": "#1A181640"
    },
    {
      "type": "header",
      "content": "文字内容"
    },
    {
      "type": "text",
      "id": "label",
      "label": "标签文字",
      "default": "A NEW LANGUAGE OF TRAINING"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "主标题",
      "default": "SENSOL"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "副标题",
      "default": "Where strength meets precision, and movement becomes design."
    },
    {
      "type": "header",
      "content": "按钮"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "按钮文字",
      "default": "SHOP ALL"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "按钮链接"
    },
    {
      "type": "color",
      "id": "button_bg_color",
      "label": "按钮背景色",
      "default": "#F7F4F0"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "按钮文字色",
      "default": "#1A1816"
    }
  ],
  "presets": [
    {
      "name": "SENSOl Hero"
    }
  ]
}
{% endschema %}
